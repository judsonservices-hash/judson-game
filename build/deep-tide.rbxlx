            <string name="Name">DiveConfig</string>
            <string name="Source"><![CDATA[--!strict
--[[
Deep Tide — DiveConfig   (GDD Appendix B, "DiveConfig" + §5.4 / §9 threshold values)
Source: GDD §3 (vertical traversal rule), §5.4 (auto-surface), §8.8 (air alarm),
        §9 (HUD air thresholds), §11 (acceptance: auto-surface is unevadable).
PURE DATA.
]]

local DiveConfig = {}

-- Vertical traversal (§3 "Vertical traversal rule").
DiveConfig.DescendSpeed = 20 -- studs/s
DiveConfig.AscendSpeed = 28 -- studs/s — ascending is deliberately faster

-- Air / oxygen.
DiveConfig.SurfaceRefillSeconds = 3 -- refill takes 3 s at the surface
DiveConfig.AirAmberSeconds = 40 -- HUD turns amber at 40 s (§9)
DiveConfig.AirAlarmSeconds = 20 -- audible beep starts at 20 s (§8.8)
DiveConfig.AirFastPulseSeconds = 5 -- pulse accelerates at 5 s (§8.8)

-- Depth maths. Sea level is Y 0; depth is reported as -Y at the player's head (§3.0).
DiveConfig.SeaLevelY = 0
DiveConfig.DepthIsNegativeY = true
DiveConfig.HudDepthSuffix = "m" -- 1 stud is displayed as 1 "m" (GDD header)

-- Auto-surface rule (§5.4, §11): at DepthRating + RatingWarningMargin for
-- RatingWarningHoldTime the player is forced to the surface with the rating warning.
DiveConfig.RatingWarningMargin = 20 -- studs above the gear's DepthRating
DiveConfig.RatingWarningHoldTime = 1.5 -- seconds

-- Underwater lighting blend (§3.0, §8.1) — values are the Technical Artist's; the fade length is fixed.
DiveConfig.UnderwaterFadeSeconds = 1.5

-- Forced surfacing (the §5.4 rating rule and the §5.3 step 9 out-of-air rule). A forced ascent
-- teleports the character to this height above sea level, standing in the air over the water they
-- were in — never onto the seabed, never underground. Nothing is lost by being surfaced: the
-- catch log is already banked (§1 step 7, §11).
DiveConfig.ForceSurfaceHeightStuds = 6
DiveConfig.ForceSurfaceMessages = {
	outOfAir = "AIR EMPTY — SURFACED",
	-- The rating wall names itself (§2: "DEPTH RATING EXCEEDED — 90m") and names the rating the
	-- player is wearing, so the number on the HUD is the number in the line. Being surfaced by
	-- your own gear is NOT a §5.4 rod failure: nothing here may read as "LINE TOO WEAK". The
	-- number is GearConfig.Gear[x].depthRating for whatever the player has equipped.
	rating = "GEAR RATING EXCEEDED — RATING %dm — SURFACED",
	-- The same line with the next step attached (§9), for the case where a deeper tier exists:
	-- parameters are that tier's printed name, rating and cost, read from GearConfig.
	ratingWithUpgradeFormat = "GEAR RATING EXCEEDED — RATING %dm — SURFACED · %s %dm (%d C)",
}

-- How often the server pushes `DiveStateChanged` to a player (§9). Not per frame: the air number
-- is drawn from a payload, and 10 Hz reads as smooth for a whole-second countdown.
DiveConfig.StatePushHz = 10

return DiveConfig
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="8">
          <Properties>
            <string name="Name">EconomyConfig</string>
            <string name="Source"><![CDATA[--!strict
--[[
    Deep Tide — EconomyConfig
    Source: GDD §6.1 (starting state), §6.2 (sell values), §6.3 (the three shop SKUs),
            §6.4 (first-upgrade maths), §6.5 (target times), §6.6 (the disabled Robux tab),
            Appendix B ("EconomyConfig").
    PURE DATA. Coins are integers only.

    SellValues repeats FishConfig.Species[x].value on purpose — the economy table has to be
    readable in one place. Modules/ConfigCheck asserts the two never drift apart.
]]

local EconomyConfig = {}

-- Starting state (§6.1). The first dive must be the first payment.
EconomyConfig.StartingCoins = 0
EconomyConfig.StartingRodId = "RustyRod"
EconomyConfig.StartingGearId = "RubberLungs"
EconomyConfig.CatchLogIsUnlimited = true -- slice inventory has no cap
EconomyConfig.SellAllEnabled = true -- no haggling, no price fluctuation, no sell cooldown

-- Sell values in Coins (§6.2).
EconomyConfig.SellValues = {
	SilverSardine = 15,
	SunsetGrouper = 40,
	ReefBass = 90,
	LanternEel = 260,
	GhostRay = 600,
}

-- Real-play fight time and the balance axis (§6.2). Coins/second = value / this.
-- Bare-minimum fight times with perfect play are in §5.5 (5.0 / 5.6 / 6.7 / 8.3 / 11.1 s).
EconomyConfig.FightTimeSeconds = {
	SilverSardine = 7.0,
	SunsetGrouper = 7.8,
	ReefBass = 9.4,
	LanternEel = 11.6,
	GhostRay = 15.5,
}

EconomyConfig.CoinsPerSecondOfFight = {
	SilverSardine = 2.1,
	SunsetGrouper = 5.1,
	ReefBass = 9.6,
	LanternEel = 22.4,
	GhostRay = 38.7,
}

-- Shop presentation order (§6.3): the tank is the recommended first buy, the rod sits
-- below it labelled with the fish it unlocks. Costs and effects live in RodConfig /
-- GearConfig; this table is the shop's own view of the world.
EconomyConfig.ShopOrder = { "ReinforcedTank", "BrassRod" }

EconomyConfig.Shop = {
	ReinforcedTank = {
		sku = "ReinforcedTank",
		category = "Dive gear Tier 2",
		cost = 280,
		recommended = true, -- §6.3 presentation rule: top item, visually recommended
		unlockLabel = "OPENS: THE SHELF",
		unlockCondition = "always visible; greyed until affordable",
	},
	BrassRod = {
		sku = "BrassRod",
		category = "Rod Tier 2",
		cost = 750,
		recommended = false,
		unlockLabel = "UNLOCKS: GHOST RAY (600 C)",
		unlockCondition = "visible from the start",
	},
}

-- §6.6: no monetisation exists in the slice. One disabled tab keeps the layout slot open.
EconomyConfig.DisabledShopTab = {
	label = "—",
	enabled = false,
	note = "reserved for an eventual gamepass / cosmetic tab; no MarketplaceService call exists in the slice",
}

-- Target times in seconds from spawn (§6.5).
EconomyConfig.Targets = {
	FirstUpgradeSeconds = 230, -- 3:50 — Reinforced Tank, 280 C
	FirstUpgradeBandSeconds = { 180, 300 },
	SliceCompleteSeconds = 320, -- 5:20 — standing in The Shelf
	SliceCompleteBandSeconds = { 300, 480 },
	BrassRodDivesAfterGate = 2, -- the session-2 hook, after the slice ends
	BrassRodBandSeconds = { 240, 480 },
	SessionLengthSeconds = { 480, 720 },
}

-- The three routes to 280 C that §6.4 checks the gate against.
EconomyConfig.Routes = {
	Median = { dives = 2, catches = 8, dive1 = 110, dive2 = 185, total = 295, surplus = 15 },
	MinimumSkill = { sardines = 19, total = 285, maxDives = 4 }, -- the balance floor
	Fast = { reefBass = 4, total = 360, dives = 2, surplus = 80 }, -- the highest-value Shallows target
}

-- Tuning alarms (§6.4). If these fire, raise value — never fish density.
EconomyConfig.TuningAlarm = {
	MedianMinutesToFirstUpgrade = 5,
	AlternateSardineValue = 18,
	AlternateTankCost = 250,
}

-- §11: no single dive may produce more than this in the Shallows.
EconomyConfig.MaxShallowsDiveCoins = 700

-- ---------------------------------------------------------------------------
-- Transaction feedback (§9: "never a loss without a reason and a next step";
-- a purchase refusal always says why). Only the wordings live here — every
-- number they print is read from the fish/rod/gear tables at the moment of use.
-- ---------------------------------------------------------------------------
EconomyConfig.SellAllMessage = {
	soldFormat = "SOLD %d FISH — +%d C", -- params: fish sold, coins earned
	emptyFormat = "NOTHING TO SELL — CATCH SOMETHING FIRST",
	seconds = 2,
}

EconomyConfig.PurchaseMessage = {
	-- §6.3: the row's own truth said back — a tank reports its rating and air, a rod reports
	-- the fish it unlocks. Parameters come from GearConfig / RodConfig, never from here.
	gearFormat = "%s EQUIPPED — RATING %dm · AIR %ds",
	rodFormat = "%s EQUIPPED — %s", -- params: rod name, Shop[sku].unlockLabel
	seconds = 3,
	-- Refusals (§9): a shop row is never a button that silently does nothing.
	shortfallFormat = "NOT ENOUGH — %d C SHORT",
	ownedFormat = "ALREADY OWNED — %s",
	unknownFormat = "NOT FOR SALE — %s",
}

-- §9 shop rows: the sticky cost-vs-cash comparison, plus the measured effect of the item so
-- the tank reads as the key to depth (§6.3). Effect strings are built from RodConfig /
-- GearConfig at read time — no rating is copied into this file.
EconomyConfig.ShopRowLabel = {
	affordableFormat = "%d C", -- params: cost
	shortfallFormat = "%d C — NEED %d MORE", -- params: cost, shortfall
	ownedFormat = "OWNED",
	gearEffectFormat = "RATING %dm → %dm · AIR %ds", -- params: current rating, new rating, new air
	rodEffectFormat = "MAX RARITY %s → %s", -- params: current rod cap, new rod cap
}

return EconomyConfig
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="9">
          <Properties>
            <string name="Name">FightConfig</string>
            <string name="Source"><![CDATA[--!strict
--[[
Deep Tide — FightConfig   (GDD Appendix B, "FightConfig (frameworks for §5.3)" + §5.1-§5.3)
Source: GDD §5.1 (cast), §5.2 (hook set), §5.3 (tension mini-game), §5.6 (cooldowns), §9 (failure lines).
PURE DATA. Every number the Tension mini-game needs; FishingService reads it, never hard-codes.
]]

local FightConfig = {}

-- Needle and safe zone (§5.3 steps 1-2).
FightConfig.NeedleRiseRate = 0.55 -- T += this x dt while holding
FightConfig.NeedleFallRate = 0.75 -- T -= this x dt while released
FightConfig.NeedleStart = 0.35 -- T on entry
FightConfig.ZoneJitterAmp = 0.05 -- random jitter on the zone centre S
FightConfig.ZoneJitterInterval = 0.40 -- re-rolled every 0.4 s
-- GAP IN §5.3, flagged to the design owner: §5.3 step 1 fixes the needle's rates and §5.3 step 2 /
-- §5.5 fix each species' zone speed, and for three of the five species the second out-runs the
-- first — the safe zone sweeps faster than the needle can ever move, so the fish is unlandable by
-- any input policy at all (perfect or human). Peak sweep = 2 pi x zoneHz x zoneAmp:
--   Silver Sardine 0.28/s   Sunset Grouper 0.55/s   Reef Bass 1.01/s
--   Lantern Eel 1.67/s      Ghost Ray 2.38/s
-- against a needle that rises at 0.55/s and falls at 0.75/s. A player can only hold the band if
-- the needle out-paces the zone *and* still has the speed left to close the +/-ZoneJitterAmp step
-- the zone takes every ZoneJitterInterval. That gives the ceiling Modules/Tension derives from
-- these three numbers (NeedleRiseRate - ZoneJitterAmp / ZoneJitterInterval = 0.425 track/s) and
-- clamps the offending species' zoneHz to it. No §5.5 number is edited: FishConfig still carries
-- the GDD's printed zoneHz/zoneAmp, and Tension applies the ceiling at fight start.

-- Over-tension and the snap (§5.3 step 4).
FightConfig.SnapBand = 0.02 -- within this of T_max...
FightConfig.SnapHoldTime = 0.40 -- ...continuously for this long => line snaps
FightConfig.HoldMeterMax = 100 -- H in [0, 100]
FightConfig.HoldDrainBase = 9 -- drain = (base + slope x out-of-zone) x strainMult
FightConfig.HoldDrainSlope = 3
-- GAP IN §5.3, resolved here and flagged to the design owner: the GDD says the hold meter starts
-- at 0 and that `H <= 0` loses the fish, which cannot both be true — the first out-of-zone tick
-- would end the fight before the player has pressed anything (the needle starts at 0.35, which is
-- already outside the Ghost Ray's 0.06 half-width). The meter therefore starts with this much of
-- the meter already banked, which is the same fairness rule §5.1 step 3 applies to the hook-set
-- window: the fish may not escape before the player has had a chance to react.
FightConfig.HoldMeterStart = 25

-- Cast and hook set (§5.1, §5.2).
FightConfig.CastRange = 25 -- studs
FightConfig.CastFacingDot = 0.3 -- target must be this "in front" of the camera
FightConfig.CastTweenTime = 0.6 -- seconds for the line to reach the fish
FightConfig.CastAbortDistance = 20 -- abort if the player moves this far from the target
FightConfig.LineRetractSeconds = 0.4 -- retract time on abort / miss
FightConfig.HookSetZoneMin = 0.65 -- press between 65% and 100% of the shrink
FightConfig.HookSetGraceSeconds = 0.30 -- grace after the window closes
FightConfig.LandedTweenSeconds = 0.9 -- win tween: fish to the rod tip (§5.3 step 6)

-- Presentation numbers that the mini-game and HUD share (§5.3 UI, §9).
FightConfig.TrackWidthPixels = 360
FightConfig.TrackScreenHeightFraction = 0.45
FightConfig.FailureMessageSeconds = 2 -- how long a failure line stays on screen (§9)
FightConfig.CatchMessageSeconds = 2 -- how long the landed-fish line stays on screen (§1 step 6)
FightConfig.SnapFlashSeconds = 0.4 -- white flash on a snap, hook-set-time or over-tension (§5.3 step 8, §5.4)
FightConfig.FightTickHz = 30 -- the server ticks the fight at this rate (§5.3)
-- §5.2 step 7 / §5.3 steps 7-8: how long the fish runs after each kind of loss, before it settles
-- back into its behaviour pattern. The eligibility waits it then serves are in Cooldowns below.
FightConfig.MissFleeSeconds = 3 -- miss the hook set -> flees as if startled for 3 s
FightConfig.EscapeFleeSeconds = 3 -- throw the hook -> flees 3 s
FightConfig.SnapFleeSeconds = 5 -- line snap -> flees 5 s, then respawns in its band

-- Input keys (§1 step 5, §5.3, §9: one key, never re-learned).
FightConfig.Keys = {
    Cast = "E",
    Fight = "E",
    Abort = "Q",
}

-- Cooldowns in seconds (§5.6).
FightConfig.Cooldowns = {
    cast = 1.0, -- successful cast -> next cast
    missHook = 0.4, -- missed hook set
    escape = 1.0, -- fish escape (H <= 0 or Q)
    snap = 2.0, -- line reset after a snap (rod greyed, countdown shown)
    respawnMiss = 8, -- fish eligible again after a missed hook set
    respawnSnap = 15, -- fish respawns elsewhere in its band after a snap
    respawnEscape = 20, -- fish eligible again after an escape (counted from the respawn)
}

-- The three loss explanations (§5.3, §9). Never a loss without a reason and a next step.
-- `outOfAir` is the fourth way to lose a fish, added by the GDD's own oxygen rule (§5.3 step 9:
-- "oxygen keeps draining throughout all three phases"; §0 lever 2: the tank is a clock on the
-- reward). §9 names three messages, so this one is written in the same voice and the same shape:
-- what happened, then what to do about it.
FightConfig.FailMessages = {
    weakLine = "LINE TOO WEAK — UPGRADE ROD (750 C)",
    snap = "LINE SNAPPED — TOO MUCH TENSION",
    escape = "IT GOT AWAY — KEEP THE NEEDLE IN THE GREEN",
    outOfAir = "OUT OF AIR — THE FISH GOT AWAY",
}

-- The two losses §9 does not name: the player never hooked the fish (§5.2 step 7) and the cast
-- came apart because they swam off (§5.1 step 4). Same voice, same shape as the three above.
FightConfig.MissMessages = {
    missedHookSet = "IT GOT AWAY — PRESS E AS THE RING CLOSES",
    castAborted = "CAST BROKE — STAY WITH THE FISH",
}

-- The one good message (§1 step 6): the fish is banked, not yet paid. Values only become Coins at
-- the Tide Trader (§6.2), so this line says BANKED and quotes what the trader will pay.
-- Format: species name, then value in Coins.
FightConfig.CatchMessageFormat = "%s BANKED — %d C AT THE TRADER"

-- Fights re-roll the safe zone's jitter every ZoneJitterInterval; a seeded generator keeps a
-- fight reproducible (see Modules/Rng — the same seed produces the same fight twice).
FightConfig.RandomSeed = 20261013

return FightConfig
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="10">
          <Properties>
            <string name="Name">FishConfig</string>
            <string name="Source"><![CDATA[--!strict
--[[
    Deep Tide — FishConfig
    Source: GDD §4.2 (species table), §4.1 (rarity ladder), §4.3 (behaviour specs),
            §4.5 (spawn behaviour), §5.5 (mini-game tuning), Appendix B (canonical field shape).

    PURE DATA. No logic, no derived values, no tuning number anywhere else in the codebase.

    Per species:
      value         Coins paid by SELL ALL (§6.2)
      depthBand     { shallow, deep } in studs — a species never spawns outside its band (§4.5)
      liveAtStart   live population at server start (Appendix C: 48/10/6/7/3 = 79)
      parts         primitives per fish (Appendix C: 1, Eel 2)
      mini          every input to the Tension mini-game (§5.3 / §5.5) — FishingService reads it
      behaviourCfg  every input to the behaviour state machine (§4.3) — FishService reads it
      strainMult by rarity lives in RarityConfig.StrainMult (§4.1) — §5.5's per-species column repeats it.
]]

local FishConfig = {}

-- Species ids in GDD table order (§4.2 rows 1-5).
FishConfig.Order = { "SilverSardine", "SunsetGrouper", "ReefBass", "LanternEel", "GhostRay" }

-- Sum of liveAtStart below (§4.5, Appendix C: 48 + 10 + 6 + 7 + 3 = 74).
-- (Was recorded as 79, which is the arithmetic slip in the GDD's own §4.5 line: 48+10+6+7+3 = 74,
--  and 74 fish + 7 Lantern Eel lures = the 81 fish Parts Appendix A quotes.)
FishConfig.TotalLiveAtServerStart = 74

-- §4.2's silhouette/colour read, as a budget. Every species carries a `visual` block (below) with
-- one `trim` part and an optional `light`; the totals are what the fish code will actually create,
-- because they are the sums of `liveAtStart` (48 + 10 + 6 + 7 + 3).
--   trim parts   = 74 (one per fish, parented to the body so it is destroyed with it)
--   trim lights  = 10 (7 Lantern Eel lures + 3 Ghost Ray edge lights — the two Shelf species only)
-- Counted by tools/worldtest/visual_harness.luau against the real spawn, and by
-- LightingConfig.Budget.Lights for the whole world's light total.
FishConfig.VisualBudget = {
    TrimParts = 74,
    TrimLights = 10,
}

-- Rules that apply to every species (§4.5).
FishConfig.SpawnRules = {
    RespawnSeconds = 15, -- a caught or despawned fish returns to its home node after 15 s
    MaxSpawnsPerBurst = 1, -- a spawner never spawns more than 1 fish per...
    SpawnBurstIntervalSeconds = 3, -- ...3 s (prevents a wall of fish appearing after a wipe)
    DespawnPlayerDistance = 400, -- despawns (without value) if further than 400 studs...
    DespawnAfterSeconds = 20, -- ...from any player for 20 s
    MovementHz = 20, -- server-authoritative repositioning rate; clients interpolate (§4.3)
    NeverShallowerThanStuds = 110, -- no Shelf fish can ever be found above 110 studs (§4.5)
    -- §4.3 is built from "random" values (anchor walks, orbit phases, scatter, jitter). They are
    -- all drawn from one seeded generator so a run is reproducible: the same seed spawns the same
    -- fish, swims the same paths and produces the same fights twice (tools/worldtest/fish_harness).
    RandomSeed = 20261013,
    -- A stalled frame (a server hitch, a Studio breakpoint) must not teleport every fish: the
    -- movement loop clamps a step to this many seconds before advancing anything.
    MaxStepSeconds = 0.25,
}

FishConfig.Species = {
    SilverSardine = {
        id = "SilverSardine",
        name = "Silver Sardine",
        rarity = "Common",
        value = 15,
        depthBand = { 5, 30 },
        zone = "Shallows",
        behaviour = "School",
        liveAtStart = 48, -- 8 schools x 6 fish (§4.5)
        parts = 1,
        size = Vector3.new(1.2, 0.5, 0.35),
        color = Color3.fromRGB(206, 212, 222),
        material = Enum.Material.Metal, -- §4.2 also asks for 0.2 "shininess" (Technical Artist)
        transparency = 0.15,
        visualCue = "Tiny bright dart, moves as a shimmering ribbon — the only fish brighter than the water.",
        -- §4.2's silhouette read, in numbers the fish code can build. `trim` is ONE extra part; it
        -- is parented to the body part, so it follows the fish and is destroyed with it. `offset` is
        -- body-local (+X is the long axis, +Y up), so a strip stays on top of the fish whatever way
        -- it is swimming.
        visual = {
            band = "Shallows",
            trim = {
                placement = "shimmer strip",
                size = Vector3.new(1.05, 0.06, 0.06),
                offset = Vector3.new(0, 0.28, 0),
                color = Color3.fromRGB(236, 242, 255),
                transparency = 0.35,
            },
            -- 48 of these — the most numerous fish in the world — so a per-fish PointLight is the one
            -- thing this species may never have (LightingConfig.Budget.Lights).
            light = nil,
        },
        mini = {
            zoneHalfWidth = 0.20,
            zoneHz = 0.25,
            zoneAmp = 0.18,
            fillRate = 20,
            requiredTension = 20,
            hookWindow = 0.50,
        },
        behaviourCfg = {
            count = 8, -- anchors, not fish
            perSchool = 6,
            anchorSpeed = 6,
            anchorRadius = 60,
            orbit = 6,
            pauseMin = 1,
            pauseMax = 3,
            fleeRadius = 8,
            fleeSpeed = 22,
            fleeTime = 3,
            reanchorMax = 80,
        },
    },

    SunsetGrouper = {
        id = "SunsetGrouper",
        name = "Sunset Grouper",
        rarity = "Common",
        value = 40,
        depthBand = { 15, 55 },
        zone = "Shallows",
        behaviour = "Patrol",
        liveAtStart = 10,
        parts = 1,
        size = Vector3.new(3.0, 1.6, 1.1),
        color = Color3.fromRGB(232, 140, 86),
        material = Enum.Material.SmoothPlastic,
        transparency = 0,
        visualCue = 'Chunky rounded brick, wide and slow, orange — reads as "fat and worth it".',
        visual = {
            band = "Shallows",
            trim = { -- a lateral band around the flanks: turns "orange box" into "that orange fish"
                placement = "flank band",
                size = Vector3.new(2.70, 0.16, 1.16),
                offset = Vector3.new(0, 0, 0),
                color = Color3.fromRGB(255, 190, 120),
                transparency = 0.40,
            },
            light = nil,
        },
        mini = {
            zoneHalfWidth = 0.17,
            zoneHz = 0.35,
            zoneAmp = 0.25,
            fillRate = 18,
            requiredTension = 35,
            hookWindow = 0.50,
        },
        behaviourCfg = {
            count = 10,
            waypoints = 3,
            radius = 40,
            speed = 8,
            turnEase = 0.4,
            bobAmplitude = 0.8,
            bobPeriod = 2,
            fleeRadius = 10,
            fleeSpeed = 18,
            fleeTime = 4,
            returnNodeDistance = 80,
        },
    },

    ReefBass = {
        id = "ReefBass",
        name = "Reef Bass",
        rarity = "Uncommon",
        value = 90,
        depthBand = { 30, 85 },
        zone = "Shallows",
        behaviour = "Flee",
        liveAtStart = 6,
        parts = 1,
        size = Vector3.new(3.5, 1.8, 1.2),
        color = Color3.fromRGB(86, 150, 125),
        material = Enum.Material.SmoothPlastic,
        transparency = 0,
        accent = { -- thin Neon dorsal strip (§4.2)
            color = Color3.fromRGB(150, 240, 200),
            placement = "dorsal strip",
        },
        visualCue = "Sleek olive torpedo with a glowing spine line; the one that runs — the first real chase.",
        -- §4.2's "thin Neon RGB(150,240,200) dorsal strip" — the cue the blockout never built, and
        -- the only thing that tells a Reef Bass from a dark shape at 60 studs in the Shallows.
        visual = {
            band = "Shallows",
            trim = {
                placement = "dorsal strip",
                size = Vector3.new(3.10, 0.10, 0.10),
                offset = Vector3.new(0, 0.95, 0),
                color = Color3.fromRGB(150, 240, 200),
                transparency = 0.20,
            },
            light = nil,
        },
        mini = {
            zoneHalfWidth = 0.13,
            zoneHz = 0.50,
            zoneAmp = 0.32,
            fillRate = 15,
            requiredTension = 60,
            hookWindow = 0.42,
        },
        behaviourCfg = {
            count = 6,
            radius = 45,
            speed = 4,
            startleRadius = 14,
            startleDelay = 0.35, -- the only reason it is catchable — do not remove (§4.3)
            fleeSpeed = 26,
            clearDistance = 40,
            driftTime = 5,
            diveRadius = 8,
        },
    },

    LanternEel = {
        id = "LanternEel",
        name = "Lantern Eel",
        rarity = "Rare",
        value = 260,
        depthBand = { 115, 175 },
        zone = "Shelf",
        behaviour = "Ambush",
        liveAtStart = 7, -- one eel per crevice den (§4.3, dens in SpawnConfig)
        parts = 2, -- body + lure (Appendix C)
        size = Vector3.new(6.0, 0.8, 0.8),
        color = Color3.fromRGB(40, 32, 58),
        material = Enum.Material.SmoothPlastic,
        transparency = 0,
        accent = {
            color = Color3.fromRGB(120, 255, 190),
            placement = "lure",
            lureSize = Vector3.new(0.9, 0.9, 0.9),
            dashColor = Color3.fromRGB(80, 200, 160),
            dashCount = 3,
        },
        visualCue = "A long dark ribbon with one floating green point of light — the light is the tell.",
        -- §4.2 says the body carries "3 Neon RGB(80,200,160) dashes". Three parts per eel is 21 parts
        -- for a read that one continuous back-line gives better at distance, so the dashes are a
        -- single thin back line here (stated as a deviation, not hidden). The lure is the real tell.
        visual = {
            band = "Shelf",
            trim = {
                placement = "back line",
                size = Vector3.new(5.40, 0.10, 0.12),
                offset = Vector3.new(0, 0.45, 0),
                color = Color3.fromRGB(80, 200, 160),
                transparency = 0.25,
            },
            -- §8.6: "Eel lures RGB(120,255,190) with PointLight Brightness 1.5 / Range 14". The lure
            -- itself is §4.2 geometry (the accent above); its light and the flame-like sway are here.
            light = {
                color = Color3.fromRGB(120, 255, 190),
                brightness = 1.5,
                range = 14,
                flickerAmplitude = 0.08, -- the lure breathes rather than glows steady
                flickerHz = 0.45,
            },
        },
        mini = {
            zoneHalfWidth = 0.09,
            zoneHz = 0.70,
            zoneAmp = 0.38,
            fillRate = 12,
            requiredTension = 110,
            hookWindow = 0.34,
        },
        behaviourCfg = {
            count = 7,
            lungeRadius = 9,
            lungeSpeed = 30,
            lungeTime = 1.5,
            recoverTime = 2.0,
            recoverSpeed = 2,
            maxRange = 20,
            idleProtrusion = 3,
            swayAmplitude = 1.2,
            swayPeriod = 1.8,
            lureBobAmplitude = 0.5,
            returnTime = 4,
        },
    },

    GhostRay = {
        id = "GhostRay",
        name = "Ghost Ray",
        rarity = "Epic",
        value = 600,
        depthBand = { 130, 210 },
        zone = "Shelf",
        behaviour = "Patrol",
        liveAtStart = 3,
        parts = 1,
        size = Vector3.new(8.0, 0.6, 7.0),
        color = Color3.fromRGB(212, 236, 255),
        material = Enum.Material.Neon, -- Appendix B; §4.2 describes it as glass-like at 0.55
        transparency = 0.55,
        accent = {
            color = Color3.fromRGB(160, 220, 255),
            placement = "wing-tip edge trim",
            transparency = 0.35,
        },
        visualCue = "A wide flat pale diamond that never flaps, only glides — crosses the vent glow.",
        -- §8.6: "Ghost Ray edge trim Neon RGB(160,220,255) at 0.35 transparency with a very slow
        -- PointLight flicker (10% amplitude, 0.3 Hz)". This is the fish the whole retention plan
        -- hangs on (§2), so it is the one species that is *always* slightly lit: the trim is what a
        -- player sees first, from the dock-side edge of the Shelf, before they can ever catch it.
        visual = {
            band = "Shelf",
            trim = {
                placement = "wing-tip edge trim",
                size = Vector3.new(8.20, 0.12, 0.50),
                offset = Vector3.new(0, 0, 3.50),
                color = Color3.fromRGB(160, 220, 255),
                transparency = 0.35,
            },
            light = {
                color = Color3.fromRGB(160, 220, 255),
                brightness = 0.9,
                range = 18,
                flickerAmplitude = 0.10, -- §8.6
                flickerHz = 0.30, -- §8.6
            },
        },
        mini = {
            zoneHalfWidth = 0.06,
            zoneHz = 0.90,
            zoneAmp = 0.42,
            fillRate = 9,
            requiredTension = 160,
            hookWindow = 0.26,
        },
        behaviourCfg = {
            count = 3,
            waypoints = 5,
            radius = 90, -- half of the 180-stud loop box (§4.3)
            loopBox = Vector3.new(180, 30, 120),
            legTime = 14,
            easing = "Quad",
            bobAmplitude = 2,
            bobHz = 0.15,
            speed = 12,
            fleeRadius = 18,
            fleeSpeed = 22,
            fleeTime = 5,
        },
    },
}

return FishConfig
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="11">
          <Properties>
            <string name="Name">GearConfig</string>
            <string name="Source"><![CDATA[--!strict
--[[
Deep Tide — GearConfig   (GDD Appendix B, "GearConfig (dive)")
Source: GDD §3.1 (gear rating required per zone), §5.4 (auto-surface rule thresholds),
        §6.3 (shop SKU 2), §6.5 (the 280 C gate).
PURE DATA. DepthRating is what makes gear "a key, not a stat" (§0 lever 1).
]]

local GearConfig = {}

GearConfig.Order = { "RubberLungs", "ReinforcedTank" }

-- What a player wears is server state, but the HUD has to show it (§9: `ROD: RUSTY / BRASS`)
-- without a remote of its own. GearService stamps these attributes on the Player instance; they
-- replicate to the owning client, which is all the readout needs.
GearConfig.PlayerAttributes = {
	RodId = "EquippedRodId",
	GearId = "EquippedGearId",
}

GearConfig.Gear = {
	RubberLungs = {
		id = "RubberLungs",
		name = "Rubber Lungs",
		tier = 1,
		cost = 0, -- equipped free at spawn (§6.1)
		airCapacity = 100, -- seconds
		depthRating = 90, -- studs
	},
	ReinforcedTank = {
		id = "ReinforcedTank",
		name = "Reinforced Tank",
		tier = 2,
		cost = 280, -- the first upgrade; opens The Shelf (§3.1)
		airCapacity = 300, -- seconds
		depthRating = 240, -- studs
	},
}

return GearConfig
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="12">
          <Properties>
            <string name="Name">LandmarkConfig</string>
            <string name="Source"><![CDATA[--!strict
--[[
    Deep Tide — LandmarkConfig
    Source: GDD §3.2 (The Shallows, L1-L9), §3.3 (The Rim, R1-R3), §3.4 (The Shelf, S1-S6),
            Appendix A (naming rule: every landmark part is named "<ID>_<Piece>").
    PURE DATA — anchor positions and part counts for the blockout builder and WorldService.

    Deviation note: this file is not named in Appendix A/B. It exists so landmark
    coordinates live as data instead of being re-typed from the GDD by every implementer.

    `position` is only set where the GDD prints an explicit (X, Y, Z). Where the GDD
    defines a landmark as a volume instead, `position` is nil and `regionRef` names the
    table that holds its extents (numbers are never repeated across config files).
    Eel den coordinates live in SpawnConfig (§4.6).

    Part-count note: the counts listed in §3.2/§3.3/§3.4 sum to 226 (Shallows 102, Rim 54,
    Shelf 70). Appendix A's "~280 Parts" is the *world* total, not a landmark total: 226
    landmarks + 44 seabed (§3.1: 24 sand + 20 rock) + 8 world props/anchors = 278.
    The per-landmark counts are authoritative and PartBudget below is the measured build
    target; WorldService asserts its built geometry against it and warns on any mismatch.
]]

local LandmarkConfig = {}

-- Appendix A's original estimate, kept so the GDD's own disagreement stays visible in code.
LandmarkConfig.TotalWorldPartsPerAppendixA = 280
LandmarkConfig.SumOfLandmarkPartCounts = 226

-- What the blockout actually builds (measured from WorldService:GetLayout, 2026-10-13).
-- Landmarks + Seabed + WorldProps + SpawnAnchorHosts must equal World.
LandmarkConfig.PartBudget = {
	Landmarks = 226, -- §3.2-§3.4 per-landmark counts (includes the 4 L1 props that live in Spawns)
	Seabed = 44, -- §3.1: 24 sand + 20 rock (ZoneConfig.Seabed)
	WorldProps = 3, -- SpawnLocation, DiveMarker, WaterRegionMarker
	SpawnAnchorHosts = 5, -- one invisible anchor host per species (Appendix A: spawn volumes)
	World = 278,
	FishLive = 74, -- §4.5: 48 + 10 + 6 + 7 + 3 (the GDD prints that sum as 79; the sum is 74)
	FishParts = 81, -- Appendix C: one Part per fish, two for the Lantern Eel (7 lures)
}
LandmarkConfig.PartBudget.GrandTotal = LandmarkConfig.PartBudget.World + LandmarkConfig.PartBudget.FishParts

LandmarkConfig.Landmarks = {
	-- THE SHALLOWS (§3.2) ----------------------------------------------------
	{ id = "L1", name = "Deep Tide Dock", zone = "Shallows", position = Vector3.new(0, 6, -10), parts = 12 },
	{ id = "L2", name = "Coral Spire", zone = "Shallows", position = Vector3.new(-120, -30, 70), parts = 9 },
	{ id = "L3", name = "The Trawler (wreck)", zone = "Shallows", position = Vector3.new(140, -58, -60), parts = 12 },
	{ id = "L4", name = "Kelp Field", zone = "Shallows", position = Vector3.new(-40, -35, -100), parts = 34 },
	{ id = "L5", name = "The Deep Hole", zone = "Shallows", position = Vector3.new(0, -85, 90), parts = 6 },
	{ id = "L6", name = "Sand Channels", zone = "Shallows", position = nil, parts = 12 }, -- 12 ridges at Y -44, scattered
	{ id = "L7", name = "Fish Rock Cluster", zone = "Shallows", position = Vector3.new(-160, -30, 30), parts = 8 },
	{ id = "L8", name = "Sun Shafts", zone = "Shallows", position = nil, parts = 0 }, -- Y 0 -> -60, Technical Artist
	{
		id = "L9",
		name = "Surface Buoys",
		zone = "Shallows",
		position = Vector3.new(0, 1, 120),
		parts = 9,
		positions = { Vector3.new(0, 1, 120), Vector3.new(-80, 1, 60), Vector3.new(80, 1, 60) },
	},

	-- THE RIM (§3.3) ---------------------------------------------------------
	{ id = "R1", name = "Rim Wall", zone = "Rim", position = nil, parts = 40, regionRef = "ZoneConfig.Rim.wall" },
	{
		id = "R2",
		name = "The Rim Gate (notch)",
		zone = "Rim",
		position = nil,
		parts = 8,
		regionRef = "ZoneConfig.Rim.gate",
	},
	{ id = "R3", name = "Rim Current", zone = "Rim", position = nil, parts = 6, regionRef = "ZoneConfig.Rim.current" },

	-- THE SHELF (§3.4) -------------------------------------------------------
	{ id = "S1", name = "The Lip", zone = "Shelf", position = Vector3.new(0, -108, 240), parts = 10 },
	{ id = "S2", name = "Crevice Row (Eel dens)", zone = "Shelf", position = nil, parts = 7 }, -- SpawnConfig.LanternEel.dens
	{ id = "S3", name = "Ghost Ledge", zone = "Shelf", position = Vector3.new(0, -175, 380), parts = 8 },
	{ id = "S4", name = "Thermal Vents", zone = "Shelf", position = Vector3.new(110, -205, 440), parts = 14 },
	{ id = "S5", name = "Sunken Pillars", zone = "Shelf", position = Vector3.new(-130, -165, 330), parts = 9 },
	{ id = "S6", name = "The Chasm", zone = "Shelf", position = nil, parts = 22, regionRef = "ZoneConfig.Chasm" },
}

-- Interaction props that host ProximityPrompts (§1 steps 2, 3 and 8, §3.2 L1).
-- These four L1 props live in Workspace.DeepTide.Spawns (Appendix A), not in the Shallows
-- folder, and are 4 of L1's 12 parts. `actionText` is what the prompt shows; Roblox prefixes
-- the key itself, so §1's "E — Take Rusty Rod" is actionText = "Take Rusty Rod".
LandmarkConfig.PromptHosts = {
	{
		id = "RodRack",
		zone = "Shallows",
		landmark = "L1",
		position = Vector3.new(12, 9, -10),
		objectText = "Rod Rack",
		actionText = "Take Rusty Rod",
		holdDuration = 0,
	},
	{
		id = "TideTrader",
		zone = "Shallows",
		landmark = "L1",
		position = Vector3.new(-14, 9, -10),
		objectText = "Tide Trader",
		actionText = "Trade",
		holdDuration = 0,
	},
	{
		id = "DiveMarker",
		zone = "Shallows",
		landmark = "L1",
		-- §3.2 gives the marker no coordinate; the ramp meets the water at Z 8, so the marker
		-- hangs just above that point (ZoneConfig.InteractionPoints.DiveMarker).
		position = Vector3.new(0, 2.5, 8),
		objectText = "Dive Point",
		actionText = "Dive",
		holdDuration = 0,
		-- §1 step 3: the marker's verb is the dive itself — the hint is what the prompt says
		-- when the player uses it (WorldService:WirePrompts pushes it as a §9 Notify).
		hint = "DIVE — SWIM DOWN, FISH HOLD IN THE SHALLOWS",
	},
}

-- How long a prompt's hint line stays on the HUD (§9's 2-3 s explainer band).
LandmarkConfig.PromptHintSeconds = 3

-- Prompt hosts that are not landmark parts, so the builder counts them separately
-- (LandmarkConfig.PartBudget.WorldProps). Naming rule Appendix A: "<ID>_<Piece>".
LandmarkConfig.WorldPropNames = {
	SpawnLocation = "SpawnLocation",
	DiveMarker = "DiveMarker",
	WaterRegionMarker = "WaterRegionMarker",
}

return LandmarkConfig
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="13">
          <Properties>
            <string name="Name">LightingConfig</string>
            <string name="Source"><![CDATA[--!strict
--[[
    Deep Tide — LightingConfig
    Source: GDD §3.0 (sky, atmosphere, water region, the 1.5 s blend), §3.1 (per-zone ambience
            row: "Lit, teal, coral" vs "Near-black, cold blue, bioluminescence only"),
            §8.1 (two-world lighting + the fade), §8.2 (fog is the depth gauge),
            §8.3 (sun rays die by 60 studs), §8.6 (bioluminescence is the Shelf's only light),
            §8.8 (the air alarm must be impossible to miss), §3.4/§7 (the chasm is black),
            Appendix C (fog formula, underwater fade).

    PURE DATA — every number the world's light is made of, and nothing else.

    How this file is meant to be read
      * `Bands` is an ordered list of depth anchors (studs below sea level, §3.0). A depth between
        two anchors is a straight interpolation of both (§8.1: "one interpolation ... the transition
        must be a fade, never a snap"). The sampler that does this is Modules/Atmosphere.luau; it is
        the only reader. Three bands are the three places the player must be able to name without
        being told: Surface (lit), Shallows (teal, sunlit), Rim (cold, hazy), Shelf (black, lit by
        living things), Abyss (the chasm floor, darker still — §7's next update starts here).
      * Fog distance is NOT here: §8.2's curve (FogEnd = clamp(320 - 1.35 x depth, 45, 320),
        FogStart = FogEnd x 0.25, FogColor lerp) already lives in ZoneConfig.Fog, and a number
        never lives in two config files. The sampler reads ZoneConfig for the curve and this file
        for the per-band atmosphere/ambient/grade.
      * `Water` is the Terrain water appearance (§3.0: "Water is Roblox Terrain water"). Terrain
        holds water and nothing else, so these five numbers are the whole of the world's water.
      * Every value below is a look, so every value below is the Technical Artist's to retune.
        Nothing in gameplay reads this file.

    NOT done in this pass (owner/lead should know): no Roblox stock audio is wired, so §8.7's
    sound layers and §8.8's audible beep are still missing. This file only covers what can be
    seen.
]]

local LightingConfig = {}

-- §3.0 / §8.1: the fade length (1.5 s on the camera crossing Y 0) is already recorded as
-- ZoneConfig.UnderwaterFadeSeconds ("Presentation timings owned by the world") and as
-- DiveConfig.UnderwaterFadeSeconds (the service that runs the fade). It is NOT repeated here: the
-- depth sampler (Modules/Atmosphere) is a pure function of depth and owns no clock.

-- §3.0: "Sky: Lighting.ClockTime = 17.5". Late afternoon, so the sun is low over the dock and
-- the shafts at §8.3 read as shafts rather than as a noon glare.
LightingConfig.ClockTime = 17.5
LightingConfig.GlobalShadows = true
LightingConfig.ShadowSoftness = 0.35
-- Lighting.Technology is not scriptable at runtime, so it is set in default.project.json as a
-- place property; recorded here so the intended lighting technology sits next to its numbers.
LightingConfig.Technology = "ShadowMap"

-- §8.1 (above water): "Above: Brightness 2, teal-tinted, saturation +0.05."
-- Every band carries the same field set, so a band is comparable to a band and a missing value
-- is a nil rather than a silent fallback.
LightingConfig.Bands = {
    {
        id = "Surface", -- above the waterline: the dock, §1 steps 1-3
        zone = "Shallows",
        depthStuds = 0, -- anchor depth (§3.0: sea level = Y 0)
        ambient = Color3.fromRGB(80, 96, 104),
        outdoorAmbient = Color3.fromRGB(132, 152, 160),
        brightness = 2.0, -- §8.1
        exposureCompensation = 0.0,
        environmentDiffuseScale = 1.0,
        environmentSpecularScale = 1.0,
        -- §3.0 exact: Atmosphere Density 0.38, Haze 1.8, Color RGB(72, 96, 110).
        atmosphere = {
            density = 0.38,
            haze = 1.8,
            color = Color3.fromRGB(72, 96, 110),
            decay = Color3.fromRGB(110, 116, 128),
            glare = 0.35,
            offset = 0.10,
        },
        grade = { -- ColorCorrectionEffect: teal-tinted, saturation +0.05 (§8.1)
            tint = Color3.fromRGB(198, 224, 232),
            saturation = 0.05,
            contrast = 0.0,
            brightness = 0.0,
        },
        bloom = { intensity = 0.70, size = 24, threshold = 1.10 },
    },
    {
        id = "Shallows", -- §3.1 ambience: "Lit, teal, coral, sun rays from above"
        zone = "Shallows",
        depthStuds = 40, -- mid-band (Appendix C: Shallows 0 -> -85)
        ambient = Color3.fromRGB(46, 78, 92),
        outdoorAmbient = Color3.fromRGB(74, 110, 124),
        brightness = 1.15,
        exposureCompensation = -0.08,
        environmentDiffuseScale = 0.85,
        environmentSpecularScale = 0.90,
        atmosphere = {
            density = 0.44,
            haze = 1.35,
            color = Color3.fromRGB(40, 80, 96),
            decay = Color3.fromRGB(40, 70, 86),
            glare = 0.15,
            offset = 0.15,
        },
        grade = {
            tint = Color3.fromRGB(158, 206, 222),
            saturation = -0.04,
            contrast = 0.04,
            brightness = -0.02,
        },
        bloom = { intensity = 0.90, size = 22, threshold = 1.00 },
    },
    {
        id = "Rim", -- §3.1/§3.3: the transition — colder, hazier, the visibility starts collapsing
        zone = "Rim",
        depthStuds = 110,
        ambient = Color3.fromRGB(26, 46, 60),
        outdoorAmbient = Color3.fromRGB(34, 54, 68),
        brightness = 0.80,
        exposureCompensation = -0.20,
        environmentDiffuseScale = 0.60,
        environmentSpecularScale = 0.70,
        atmosphere = {
            density = 0.52,
            haze = 0.95,
            color = Color3.fromRGB(18, 36, 50),
            decay = Color3.fromRGB(16, 32, 44),
            glare = 0.06,
            offset = 0.20,
        },
        grade = {
            tint = Color3.fromRGB(132, 176, 202),
            saturation = -0.16,
            contrast = 0.06,
            brightness = -0.03,
        },
        bloom = { intensity = 0.85, size = 20, threshold = 0.95 },
    },
    {
        -- §8.1 "at depth" verbatim: Ambient RGB(18,30,42), Brightness 0.6, saturation -0.25,
        -- Atmosphere.Density 0.55, TintColor RGB(120,170,200).
        id = "Shelf", -- §3.1 ambience: "Near-black, cold blue, bioluminescence only"
        zone = "Shelf",
        depthStuds = 175,
        ambient = Color3.fromRGB(18, 30, 42),
        outdoorAmbient = Color3.fromRGB(22, 34, 46),
        brightness = 0.60,
        exposureCompensation = -0.30,
        environmentDiffuseScale = 0.35,
        environmentSpecularScale = 0.50,
        atmosphere = {
            density = 0.55,
            haze = 0.75,
            color = Color3.fromRGB(8, 18, 28),
            decay = Color3.fromRGB(8, 16, 24),
            glare = 0.0,
            offset = 0.25,
        },
        grade = {
            tint = Color3.fromRGB(120, 170, 200),
            saturation = -0.25,
            contrast = 0.08,
            brightness = -0.04,
        },
        -- Bloom is *up* in the dark on purpose: §8.6 says the Shelf is lit by bioluminescence, so
        -- the only bright things on screen must bleed a little. It is the cheapest way to make the
        -- eel lures and the vent rims read as light sources rather than as coloured boxes.
        bloom = { intensity = 1.00, size = 18, threshold = 0.85 },
    },
    {
        id = "Abyss", -- §3.4 S6 (chasm floor, Y -215) / §7 ("the black, unlit water below")
        zone = "Shelf",
        depthStuds = 230,
        ambient = Color3.fromRGB(10, 18, 26),
        outdoorAmbient = Color3.fromRGB(12, 20, 28),
        brightness = 0.48,
        exposureCompensation = -0.42,
        environmentDiffuseScale = 0.25,
        environmentSpecularScale = 0.40,
        atmosphere = {
            density = 0.62,
            haze = 0.60,
            color = Color3.fromRGB(4, 10, 18),
            decay = Color3.fromRGB(4, 8, 14),
            glare = 0.0,
            offset = 0.30,
        },
        grade = {
            tint = Color3.fromRGB(104, 152, 190),
            saturation = -0.34,
            contrast = 0.10,
            brightness = -0.06,
        },
        bloom = { intensity = 1.05, size = 16, threshold = 0.80 },
    },
}

-- §3.0 + §3.1: the water itself. Terrain water only; these five properties are its whole look.
-- Teal and only lightly hazed, because §4.2 sells fish by *silhouette* — water the player cannot
-- see through would hide the very thing the game is about.
--
-- MIRRORED IN default.project.json (Rojo cannot read Luau, and the place file has to look like
-- water in Studio's viewport before a single script has run). Change both together — the runtime
-- value here, the place-file baseline there.
LightingConfig.Water = {
    color = Color3.fromRGB(58, 132, 148), -- surface water colour, reflected straight back at you
    transparency = 0.35, -- 0.35 = clear enough to hold a fish silhouette at 25 studs (CastRange)
    reflectance = 0.18, -- a little sky on the surface, not a mirror
    waveSize = 0.12, -- studs of swell; small, or the surface reads as a storm
    waveSpeed = 12, -- studs/s the swell travels
}

-- §8.3: "Sun rays only 0-60 studs ... fade to zero by 60 studs and are fully gone in the Shelf."
-- Five shafts (§3.2 L8 names five), built as thin translucent Neon parts — no meshes, no textures.
-- The fade is per-client: the shafts hold full strength at the surface, are invisible from 60
-- studs down (LightingConfig.SunShafts.fadeEndStuds), and are gone entirely in the Shelf, whose
-- darkness §8.3 calls "the Shelf's best asset".
LightingConfig.SunShafts = {
    count = 5,
    aboveWaterAlpha = 0.35, -- seen from the dock: present, not solid
    fadeStartStuds = 0, -- full strength at the surface
    fadeEndStuds = 60, -- §8.3: zero by here
    -- The shafts brighten over the first stretch of the descent (you are inside them) and then die.
    -- Without this the shafts would be strongest at the exact moment the camera is clamped to the
    -- surface, which reads as a wall of light rather than as a shaft: 0.35 at Y 0, 1.0 at 20 studs,
    -- 0 at 60. Modules/Atmosphere.SunShaftAlpha is that curve, and it is continuous at every point.
    peakStuds = 20,
    size = Vector3.new(9, 60, 9), -- 60 studs tall = the §8.3 0 -> -60 range
    color = Color3.fromRGB(196, 232, 240),
    material = "Neon",
    -- Above the waterline the shafts would float in the sky, so they are dropped this far below
    -- the camera's own depth before they show at all (they read as water columns, not pillars).
    startY = 0,
    -- Deterministic placement inside the Shallows (§3.0 build zone): hand-placed, never rolled, so
    -- the nth build is the 1st build.
    placements = {
        { x = -96, z = -44, yaw = 14, pitch = 9 },
        { x = -34, z = 96, yaw = -8, pitch = 7 },
        { x = 12, z = -108, yaw = 4, pitch = 11 },
        { x = 74, z = 22, yaw = -17, pitch = 8 },
        { x = 148, z = -66, yaw = 21, pitch = 6 },
    },
    -- Per-client fade rate; the shafts are dimmed through LocalTransparencyModifier (client-only),
    -- so no replication cost is paid per frame for an effect only one screen can see.
    fadeLerpPerSecond = 3.0,
}

-- §8.8: "the air alarm ... a red vignette creeping in from the screen edges ... impossible to
-- miss". The thresholds are DiveConfig's (AirAlarmSeconds / AirFastPulseSeconds) — the shapes and
-- colours are here. Applied as a post-process grade on the client, NOT as HUD chrome: the UI/UX
-- pass owns the HUD layout, this owns the screen.
LightingConfig.Oxygen = {
    -- Strength ramps 0 -> 1 between DiveConfig.AirAlarmSeconds and DiveConfig.AirFastPulseSeconds.
    tint = Color3.fromRGB(255, 108, 96), -- the blood-red wash
    maxSaturation = -0.38, -- colour drains out of the world first...
    minBrightness = -0.10, -- ...then the picture darkens
    maxBlur = 6, -- tunnel vision at the end (BlurEffect.Size, 0 = off)
    -- The pulse: slow breathing at the alarm, fast beating at fastPulse (DiveConfig's numbers).
    pulseAmplitude = 0.35, -- fraction of the strength that breathes
    pulseSlowSeconds = 1.0,
    pulseFastSeconds = 0.25, -- §8.8 "accelerating to a fast pulse"
    -- Nothing here may cover the tension track (§8.8): these are post-process values, so they
    -- tint the whole frame and never occlude the mini-game.
}

-- §8.1: the underwater grade. Owned by DiveService (it is the service that knows when the camera
-- crossed Y 0) and cross-faded over LightingConfig.FadeSeconds. The numbers are §8.1's.
LightingConfig.UnderwaterGrade = {
    name = "DeepTideUnderwater", -- the ColorCorrectionEffect DiveService parents to the Head
    tint = Color3.fromRGB(120, 170, 200), -- §8.1
    saturation = -0.25, -- §8.1
    contrast = 0.15,
    brightness = -0.05,
    above = { -- what the same effect reads above water before it fades out
        tint = Color3.fromRGB(255, 255, 255),
        saturation = 0.0,
        contrast = 0.0,
        brightness = 0.0,
    },
}

-- Names of the instances this system owns, so a restyle can find them and a rebuild can replace
-- them without hunting through the tree.
LightingConfig.InstanceNames = {
    Atmosphere = "DeepTideAtmosphere",
    Bloom = "DeepTideBloom",
    Grade = "DeepTideGrade",
    OxygenGrade = "DeepTideOxygen",
    OxygenBlur = "DeepTideOxygenBlur",
}

-- The stated budget for everything this system adds to the place. Asserted by
-- tools/worldtest/visual_harness.luau against the real build, not eyeballed.
LightingConfig.Budget = {
    Lights = 48, -- PointLights the whole world carries (WorldService 15 + VisualService + fish)
    Emitters = 24, -- ParticleEmitters the world carries, at low rates
    VisualParts = 32, -- parts that exist only to be looked at (sun shafts, bioluminescent specks)
    ClientEmittersPerPlayer = 4, -- bubbles, splash, catch flash, snap flash (client-only)
    PostEffects = 4, -- Atmosphere + Bloom + Grade + the oxygen pair (5 instances, 4 kinds)
}

-- How often the client sampler runs. 10 Hz, not per frame: fog that steps 10 times a second is
-- indistinguishable from fog that steps 60 times a second (each step moves the fog end by well
-- under a stud), and the dive camera is the only thing driving it.
LightingConfig.SampleHz = 10

return LightingConfig
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="14">
          <Properties>
            <string name="Name">RarityConfig</string>
            <string name="Source"><![CDATA[--!strict
--[[
Deep Tide — RarityConfig   (the rarity enum + its shared per-rarity numbers)
Source: GDD §4.1 (rarity ladder), §5.2 step 5 (hook-set window), §5.3 step 5 (line strain).
PURE DATA.

RarityConfig.Rarity is the enum used across the codebase. Rank is the ordering
that the rod gate (§5.4) compares: fish.rarity rank > rod.maxRarity rank => line snaps.
]]

local RarityConfig = {}

RarityConfig.Rarity = {
Common = "Common",
Uncommon = "Uncommon",
Rare = "Rare",
Epic = "Epic",
}

-- Lowest -> highest.
RarityConfig.Order = { "Common", "Uncommon", "Rare", "Epic" }

RarityConfig.Rank = {
Common = 1,
Uncommon = 2,
Rare = 3,
Epic = 4,
}

-- UI colour code (§4.1).
RarityConfig.Color = {
Common = Color3.fromRGB(180, 190, 200),
Uncommon = Color3.fromRGB(110, 200, 150),
Rare = Color3.fromRGB(140, 170, 255),
Epic = Color3.fromRGB(230, 170, 255),
}

-- Hook-set ring shrink window in seconds (§4.1 / §5.5 "Hook window" column).
RarityConfig.HookSetWindow = {
Common = 0.50,
Uncommon = 0.42,
Rare = 0.34,
Epic = 0.26,
}

-- Hold-meter drain multiplier (§4.1 "Line-strain multiplier" = §5.5 "strainMult" column).
RarityConfig.StrainMult = {
Common = 1.00,
Uncommon = 1.25,
Rare = 1.55,
Epic = 2.00,
}

-- Sell-value band in Coins, inclusive (§4.1). Actual per-species values live in FishConfig.
RarityConfig.SellValueBand = {
Common = { 15, 40 },
Uncommon = { 60, 100 },
Rare = { 200, 300 },
Epic = { 500, 700 },
}

return RarityConfig
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="15">
          <Properties>
            <string name="Name">RodConfig</string>
            <string name="Source"><![CDATA[--!strict
--[[
Deep Tide — RodConfig   (GDD Appendix B, "RodConfig")
Source: GDD §5.3 (zone width / strain / fill modifiers), §5.4 (the unbreakable rod gate),
        §6.3 (shop SKUs 1 and 3, costs).
PURE DATA.
]]

local RodConfig = {}

RodConfig.Order = { "RustyRod", "BrassRod" }

-- §1 step 2: the Rod Rack hands the starter rod over with a line saying so, in the same voice as
-- §9's explainers. Format: the rod's printed name.
RodConfig.EquippedMessageFormat = "%s EQUIPPED — DIVE WHEN READY"
RodConfig.EquippedMessageSeconds = 2

RodConfig.Rods = {
	RustyRod = {
		id = "RustyRod",
		name = "Rusty Rod",
		tier = 1,
		cost = 0, -- starting gear, taken free from the Rod Rack (§6.1)
		maxRarity = "Rare", -- §5.4: an Epic fish can NEVER be landed with this rod
		lineStrength = 130, -- pounds; sets the over-tension ceiling T_max (§5.3 step 4)
		zoneWidthMult = 1.00, -- safe-zone half-width multiplier (§5.3 step 3)
		strainMult = 1.00, -- hold-meter drain multiplier (§5.3 step 5)
		fillMult = 1.00, -- hold-meter fill multiplier (§5.3 step 5)
	},
	BrassRod = {
		id = "BrassRod",
		name = "Brass Rod",
		tier = 2,
		cost = 750,
		maxRarity = "Epic",
		lineStrength = 260,
		zoneWidthMult = 1.35,
		strainMult = 0.70,
		fillMult = 1.15,
	},
}

return RodConfig
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="16">
          <Properties>
            <string name="Name">SpawnConfig</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Deep Tide — SpawnConfig
	Source: GDD §4.6 "Fixed spawn coordinates (copy these straight into config)".
	PURE DATA. Depths/positions are exact; do not re-roll them.

	Behaviour => container:
	  "School" / "Patrol" / "Flee"  -> per-species spawn node list (FishService spawns count fish across them)
	  "Ambush"                     -> one den per coordinate, opening faces -Z
	The unit of `nodes` is a node/anchor; FishConfig.behaviourCfg.count is how many there are.
]]

local SpawnConfig = {}

SpawnConfig.SilverSardine = {
	kind = "School",
	box = Vector3.new(44, 22, 44), -- box around each anchor
	anchors = {
		Vector3.new(-140, -15, -110),
		Vector3.new(-70, -15, -110),
		Vector3.new(70, -15, -20),
		Vector3.new(140, -15, -20),
		Vector3.new(-140, -15, 70),
		Vector3.new(-40, -15, 70),
		Vector3.new(0, -20, -120),
		Vector3.new(110, -15, 60),
	},
}

SpawnConfig.SunsetGrouper = {
	kind = "Node",
	waypointRadius = 40,
	waypointsPerNode = 3,
	nodes = {
		Vector3.new(-160, -30, -40),
		Vector3.new(-60, -30, -80),
		Vector3.new(20, -30, -40),
		Vector3.new(90, -30, 10),
		Vector3.new(170, -30, -90),
		Vector3.new(-110, -30, 20),
		Vector3.new(60, -30, 110),
		Vector3.new(-30, -30, 120),
		Vector3.new(140, -30, 80),
		Vector3.new(-180, -30, -120),
	},
}

SpawnConfig.ReefBass = {
	kind = "Node",
	driftRadius = 45,
	nodes = {
		Vector3.new(-120, -60, -140),
		Vector3.new(-20, -60, -110),
		Vector3.new(80, -60, -60),
		Vector3.new(160, -60, -30),
		Vector3.new(-90, -60, 90),
		Vector3.new(40, -60, 130),
	},
}

SpawnConfig.LanternEel = {
	kind = "Den",
	openingFacing = "-Z",
	dens = {
		Vector3.new(-170, -140, 260),
		Vector3.new(-100, -150, 300),
		Vector3.new(-35, -135, 275),
		Vector3.new(25, -155, 310),
		Vector3.new(95, -140, 270),
		Vector3.new(150, -150, 320),
		Vector3.new(190, -145, 290),
	},
}

SpawnConfig.GhostRay = {
	kind = "Node",
	loopBox = Vector3.new(180, 30, 120),
	nodes = {
		Vector3.new(-80, -172, 370),
		Vector3.new(0, -170, 395),
		Vector3.new(80, -172, 360),
	},
}

return SpawnConfig
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="17">
          <Properties>
            <string name="Name">VisualConfig</string>
            <string name="Source"><![CDATA[--!strict
--[[
    Deep Tide — VisualConfig
    Source: GDD §8.4 (the underwater movement kit: bubbles, silt, hand-sweep), §8.5 (fish reads,
            the landing burst, the snap flash), §3.3 (R3 Rim Current: 6 strips + an emitter),
            §3.4 (S4 vents: "6 particle emitters (upward, slow)"), §8.6 (bioluminescence is the
            Shelf's only light source), §9 (navigation: a player must be able to read the place by
            eye), §3.2-§3.4 (the landmarks that must have a focal point), Appendix A
            (primitives + Neon + PointLight + ParticleEmitter only: no meshes, no textures).

    PURE DATA — every non-lighting effect the world and the player carry.

    Why this file exists separately from LightingConfig
      LightingConfig answers "what does the water look like". This answers "what is moving in it".
      The two are read by different things: LightingConfig by the depth sampler (Modules/Atmosphere),
      VisualConfig by VisualService (server instances) and the client EffectsController.

    The instance budget for BOTH files lives in LightingConfig.Budget and is asserted against the
    real build by tools/worldtest/visual_harness.luau.

    Honesty note: none of these are named audio. §8.7's sound layers and §8.8's audible air alarm
    are NOT implemented in this pass — they are the one §8 item the visuals do not cover.
]]

local VisualConfig = {}

-- ============================================================================
-- §8.4 — the underwater movement kit (client-side: only one screen can see it)
-- ============================================================================
-- "A constant, low-rate bubble trail from the player's head (2 particles/s idle, 14/s while
-- swimming, 30/s on a fast ascent)". Those three rates are the design's; everything else is the
-- shape of the bubbles.
VisualConfig.Player = {
    Bubbles = {
        idleRate = 2, -- §8.4
        swimRate = 14, -- §8.4
        ascendRate = 30, -- §8.4
        -- What counts as "swimming" and what counts as a "fast ascent": measured from the
        -- character's own velocity, so the numbers read the same at any frame rate.
        swimSpeedStuds = 6,
        ascendSpeedStuds = 8,
        lifetime = 1.4, -- seconds a bubble lives; short, or the screen fills with foam
        speed = 3.2, -- studs/s upward
        spreadAngle = 22, -- a narrow plume, not a cloud
        sizeMin = 0.18,
        sizeMax = 0.42,
        transparencyStart = 0.35,
        transparencyEnd = 1,
        color = Color3.fromRGB(226, 240, 250),
        lightEmission = 0.15, -- bubbles catch a little light without glowing like lamps
        lightInfluence = 0.35,
        maxParticles = 40, -- a hard ceiling so a fast ascent can never become a fog bank
    },
    -- §8.4: "a kick-up silt puff when the player touches the seabed". Shares the burst emitter
    -- (see VisualConfig.Burst) rather than owning one — the budget is 2 client emitters, and a
    -- one-off puff and a one-off splash are the same machine with different numbers.
    SiltKick = {
        burstCount = 10,
        speed = 2.4,
        lifetime = 1.6,
        sizeMin = 0.6,
        sizeMax = 1.8,
        color = Color3.fromRGB(196, 183, 148), -- the §3.1 sand colour
        transparencyStart = 0.55,
        transparencyEnd = 1,
        spreadAngle = 180,
        lightEmission = 0,
        lightInfluence = 1,
        cooldownSeconds = 1.2, -- touching the floor repeatedly must not sandblast the screen
    },
}

-- ============================================================================
-- The one burst emitter (client-side) — splash, silt, landing, snap
-- ============================================================================
-- ParticleEmitter properties are read at the moment `Emit(n)` is called, so one emitter can serve
-- every one-shot burst as long as the values are written immediately before the emission. That is
-- why the budget is 2 client emitters and not 5. The tradeoff, stated plainly: two bursts in the
-- same frame share whichever numbers were written last — at these sizes it is not visible.
VisualConfig.Burst = {
    name = "DeepTideBurst",
    rate = 0, -- never emits on its own; only `Emit(count)` ever fires it
    speed = 10,
    lifetime = 1,
    drag = 0,
    acceleration = Vector3.new(0, -6, 0), -- water drags everything down eventually
    spreadAngle = 45,
    emissionDirection = "Top",
    maxParticles = 60,
}

-- §1 step 3 ("jumps off the edge at the DIVE HERE marker"): the surface-entry splash.
VisualConfig.Splash = {
    burstCount = 16,
    speed = 12,
    lifetime = 1.1,
    sizeMin = 0.5,
    sizeMax = 1.4,
    color = Color3.fromRGB(210, 235, 245),
    transparencyStart = 0.25,
    transparencyEnd = 1,
    spreadAngle = 60,
    lightEmission = 0.2,
    lightInfluence = 0.4,
}

-- ============================================================================
-- §8.5 — "the player must be able to tell win from loss from across the room"
-- ============================================================================
-- A landing pops a Coin-yellow burst at the rod tip; a snap is a hard white flash. Both are the
-- same burst emitter plus a PointLight that lives for the flash and is destroyed with it, so the
-- world's steady light count never grows because someone lost a fish.
VisualConfig.Flash = {
    Landing = { -- §8.5 "a Coin-yellow burst at the rod tip"
        color = Color3.fromRGB(255, 214, 120),
        burstCount = 14,
        speed = 8,
        lifetime = 0.9,
        sizeMin = 0.5,
        sizeMax = 1.6,
        transparencyStart = 0.1,
        transparencyEnd = 1,
        lightColor = Color3.fromRGB(255, 214, 120),
        lightBrightness = 6,
        lightRange = 20,
        lightSeconds = 0.45,
    },
    -- §5.4: a line snap with the Rusty Rod is a *designed* wall, so its feedback is the loudest
    -- thing in the game that is not an explosion. 0.15 s, hard cut, no lingering glow.
    Snap = {
        color = Color3.fromRGB(255, 255, 255),
        burstCount = 8,
        speed = 6,
        lifetime = 0.4,
        sizeMin = 0.3,
        sizeMax = 0.9,
        transparencyStart = 0,
        transparencyEnd = 1,
        lightColor = Color3.fromRGB(255, 255, 255),
        lightBrightness = 8,
        lightRange = 14,
        lightSeconds = 0.15, -- §8.5: "a 0.15 s white flash"
    },
    -- Escape (§8.5 "a small grey ripple") — the quiet one, so a loss reads as a loss and not as a
    -- snap: no light at all, just a few grey motes.
    Escape = {
        color = Color3.fromRGB(150, 158, 168),
        burstCount = 5,
        speed = 2.5,
        lifetime = 0.7,
        sizeMin = 0.3,
        sizeMax = 0.8,
        transparencyStart = 0.5,
        transparencyEnd = 1,
    },
    -- Where "the rod tip" is: the character's Head plus this offset (the rod is a Tool the
    -- RodController holds; nothing here depends on its length, so a restyle of the rod cannot
    -- silently move the flash). Offsets are in studs, camera-space-free and constant.
    rodTipOffset = Vector3.new(1.6, -0.4, -2.2),
}

-- ============================================================================
-- §3.3 R3 — the Rim Current: the one place the water visibly moves
-- ============================================================================
-- "6 thin vertical Neon strips + particle emitter ... telegraphs downward flow". The strips are
-- WorldService's geometry; the flow is here. Attached to the middle strip so the particles start
-- inside the neon band rather than beside it.
VisualConfig.RimCurrent = {
    hostPath = "World/Rim/R3/R3_Strip_3",
    rate = 8,
    speed = 5,
    lifetime = 3.2,
    sizeMin = 0.4,
    sizeMax = 1.2,
    color = Color3.fromRGB(150, 215, 235),
    transparencyStart = 0.6,
    transparencyEnd = 1,
    spreadAngle = 12,
    emissionDirection = "Bottom", -- downward, the way the current pulls (§3.3 pushes north, flows down)
    acceleration = Vector3.new(0, -1.5, 0),
    lightEmission = 0.25,
    lightInfluence = 0.3,
    maxParticles = 30,
}

-- ============================================================================
-- §3.4 S4 — Thermal Vents: the Shelf's only warm light, and its long-range beacon
-- ============================================================================
-- "6 particle emitters (upward, slow)". One per chimney (S4_Chimney_1..6), very low rate: this is
-- water carrying heat, not smoke from a fire.
VisualConfig.VentPlumes = {
    hostFormat = "World/Shelf/S4/S4_Chimney_%d", -- six hosts, §3.4
    hostCount = 6,
    rate = 4,
    speed = 3,
    lifetime = 5,
    sizeMin = 0.8,
    sizeMax = 2.6,
    color = Color3.fromRGB(120, 92, 74), -- warm silt, lit by the vent rim it came out of
    transparencyStart = 0.55,
    transparencyEnd = 1,
    spreadAngle = 18,
    emissionDirection = "Top",
    acceleration = Vector3.new(0, 2, 0), -- it rises; slowly (§3.4 "upward, slow")
    lightEmission = 0.18,
    lightInfluence = 0.35,
    maxParticles = 24,
}

-- ============================================================================
-- Suspended matter — "the water is a place, not air"
-- ============================================================================
-- Silt drifting off the seabed (2 per band) and motes hanging in the sun shafts. Both are seed
-- effects: a few, at a rate of 2/s, so the eye reads water and the frame rate never notices.
VisualConfig.SeabedDust = {
    rate = 2,
    speed = 1.1,
    lifetime = 6,
    sizeMin = 0.4,
    sizeMax = 0.9,
    transparencyStart = 0.78,
    transparencyEnd = 1,
    spreadAngle = 180,
    emissionDirection = "Top",
    acceleration = Vector3.new(0, 0.25, 0),
    lightEmission = 0,
    lightInfluence = 1,
    maxParticles = 16,
    placements = {
        -- Attached to real seabed geometry by name, so the silt rises off the sand rather than
        -- out of an invisible marker (Appendix A: every world part is findable by name).
        { hostPath = "World/Shallows/Base/Base_Seabed_2_2", color = Color3.fromRGB(196, 183, 148) },
        { hostPath = "World/Shallows/Base/Base_Seabed_4_3", color = Color3.fromRGB(196, 183, 148) },
        { hostPath = "World/Rim/R1/R1_Step_4_Rock_W1", color = Color3.fromRGB(110, 120, 130) },
        { hostPath = "World/Rim/R1/R1_Step_4_Rock_E1", color = Color3.fromRGB(110, 120, 130) },
        { hostPath = "World/Shelf/Base/Base_Shelf_2_4", color = Color3.fromRGB(96, 106, 118) },
        { hostPath = "World/Shelf/Base/Base_Shelf_4_1", color = Color3.fromRGB(96, 106, 118) },
    },
}

VisualConfig.ShaftMotes = {
    rate = 2,
    speed = 0.6,
    lifetime = 8,
    sizeMin = 0.25,
    sizeMax = 0.6,
    color = Color3.fromRGB(224, 240, 236),
    transparencyStart = 0.7,
    transparencyEnd = 1,
    spreadAngle = 25,
    emissionDirection = "Bottom",
    acceleration = Vector3.new(0, -0.4, 0),
    lightEmission = 0.35, -- these are inside a light shaft; they should catch it
    lightInfluence = 0.2,
    maxParticles = 12,
    -- The first two sun shafts (LightingConfig.SunShafts.placements) carry the motes: shafts 1 and 3.
    hostIndices = { 1, 3 },
}

-- ============================================================================
-- §8.6 — bioluminescence: the Shelf's ONLY light source
-- ============================================================================
-- "A player should be able to hide in the dark and see lights before fish." Everything here is a
-- point of light with no geometry around it to explain it — that is the whole trick. Small parts
-- (a Neon speck) host the lights so the light has a visible source when you get close.
VisualConfig.Bioluminescence = {
    speck = {
        size = Vector3.new(0.35, 0.35, 0.35),
        material = "Neon",
        transparency = 0.15,
    },
    points = {
        -- Shallows' north edge (§3.2 L5 The Deep Hole): one cold shimmer over the hole, so the
        -- place the player cannot go yet is the place that glows.
        {
            zone = "Shallows",
            position = Vector3.new(-6, -78, 78),
            color = Color3.fromRGB(120, 200, 220),
            brightness = 1.2,
            range = 26,
        },
        -- The Rim Gate's far side — the first light a diver sees through the notch (§3.3 R2).
        {
            zone = "Rim",
            position = Vector3.new(0, -132, 208),
            color = Color3.fromRGB(130, 210, 225),
            brightness = 1.0,
            range = 30,
        },
        -- The Shelf: four points spread across the landmarks, so "deeper" reads as a scatter of
        -- living lights rather than one lamp (§8.6).
        {
            zone = "Shelf",
            position = Vector3.new(-48, -140, 268),
            color = Color3.fromRGB(120, 255, 190), -- the eel-lure green (§4.2)
            brightness = 1.3,
            range = 20,
        },
        {
            zone = "Shelf",
            position = Vector3.new(62, -168, 352),
            color = Color3.fromRGB(150, 225, 255),
            brightness = 1.1,
            range = 22,
        },
        {
            zone = "Shelf",
            position = Vector3.new(-120, -158, 312),
            color = Color3.fromRGB(110, 200, 230),
            brightness = 0.9,
            range = 18,
        },
        {
            zone = "Shelf",
            position = Vector3.new(0, -206, 400),
            color = Color3.fromRGB(255, 132, 60), -- the vent warmth, seen from the chasm lip
            brightness = 0.8,
            range = 18,
        },
    },
}

-- ============================================================================
-- §9 — landmark dressing: every place the player must recognise has a light on it
-- ============================================================================
-- The brief for the art pass, restated as data: dock, rod rack, Tide Trader, Rim Gate and each
-- Shelf landmark get a focal point, so the player navigates by eye and the place has shape. These
-- are the ONLY steady lights this system adds, and they are placed on existing landmark parts
-- (found by name, Appendix A) rather than on new geometry — dressing, not building.
--
-- `hostPath` is relative to Workspace.DeepTide. A host that cannot be found is reported as a
-- problem by VisualService:Build, and asserted to be zero problems by the visual suite, so a
-- renamed part cannot silently leave the dock unlit.
VisualConfig.LandmarkLights = {
    -- The dock, L1 (§3.2): a cold work lamp on the ramp, so the DIVE HERE water entry is legible
    -- from the water. The deck's own beacon (L1_Beacon) is already warm neon — this is the other
    -- half of the pair: warm beacon at the top, cold light at the water.
    {
        id = "DockRamp",
        hostPath = "World/Shallows/L1/L1_Ramp",
        zone = "Shallows",
        color = Color3.fromRGB(150, 200, 225),
        brightness = 1.6,
        range = 32,
    },
    -- The Rod Rack (§1 step 2): the first thing the player is told to walk to, so it gets the
    -- warmest small light on the dock.
    {
        id = "RodRack",
        hostPath = "Spawns/L1_RodRack",
        zone = "Shallows",
        color = Color3.fromRGB(255, 214, 140),
        brightness = 2.0,
        range = 24,
    },
    -- The Tide Trader (§1 step 8): a lamp over the stall's sign board.
    {
        id = "TideTraderSign",
        hostPath = "Spawns/L1_TideTrader_Sign",
        zone = "Shallows",
        color = Color3.fromRGB(255, 190, 120),
        brightness = 2.2,
        range = 28,
    },
    -- The trawler (§3.2 L3): the deep-side silhouette. A dim cold light on the broken mast is a
    -- nav mark over the sand flats — "there is something over there" — not a lamp.
    {
        id = "TrawlerMast",
        hostPath = "World/Shallows/L3/L3_Mast",
        zone = "Shallows",
        color = Color3.fromRGB(120, 170, 190),
        brightness = 0.8,
        range = 40,
    },
    -- The Deep Hole (§3.2 L5 exists "purely to make the player want a deeper rating"): its lip is
    -- lit so the mouth of it reads as a drop rather than as a dark patch of sand.
    {
        id = "DeepHoleLip",
        hostPath = "World/Shallows/L5/L5_Lip_Overhang",
        zone = "Shallows",
        color = Color3.fromRGB(70, 120, 150),
        brightness = 0.7,
        range = 30,
    },
    -- The Rim Gate (§3.3 R2): the notch is the one opening in a 400-stud wall and the single most
    -- important navigational fact in the world, so its keystone carries the coldest, furthest
    -- light in the Shallows' water.
    {
        id = "RimGateKeystone",
        hostPath = "World/Rim/R2/R2_Keystone",
        zone = "Rim",
        color = Color3.fromRGB(120, 190, 210),
        brightness = 1.6,
        range = 45,
    },
    -- The Rim Wall (§3.3 R1): a second, dimmer light further along the wall, so the wall reads as
    -- a wall (a long thing) and not as a doorway with nothing either side of it.
    {
        id = "RimWallWest",
        hostPath = "World/Rim/R1/R1_Step_3_Rock_W1",
        zone = "Rim",
        color = Color3.fromRGB(96, 156, 178),
        brightness = 0.9,
        range = 34,
    },
    -- The Lip (§3.4 S1 "Best-lit point in the Shelf; the player's arrival shot"): the brightest
    -- thing below 100 studs, and the reason the arrival into The Shelf reads as an arrival.
    {
        id = "ShelfLip",
        hostPath = "World/Shelf/S1/S1_Ledge",
        zone = "Shelf",
        color = Color3.fromRGB(150, 205, 230),
        brightness = 2.0,
        range = 55,
    },
    -- The Ghost Ledge (§3.4 S3): the mineral speckle is faint neon in the geometry; this light
    -- gives it something to be seen by, and marks where the ray crosses (§2's whole hook).
    {
        id = "GhostLedgeMineral",
        hostPath = "World/Shelf/S3/S3_MineralVein",
        zone = "Shelf",
        color = Color3.fromRGB(150, 190, 220),
        brightness = 1.4,
        range = 35,
    },
    -- The Sunken Pillars (§3.4 S5): cover the player weaves between, so it needs to be navigable
    -- in near-dark. Dim by design.
    {
        id = "SunkenPillar",
        hostPath = "World/Shelf/S5/S5_Pillar_1",
        zone = "Shelf",
        color = Color3.fromRGB(110, 160, 190),
        brightness = 1.0,
        range = 30,
    },
    -- The Chasm's edge (§3.4 S6 / §7): 25 studs below the tank's rating, the mouth of the next
    -- update. Lit just enough to be visibly a drop and visibly unfinished.
    {
        id = "ChasmLip",
        hostPath = "World/Shelf/S6/S6_LipRock_1",
        zone = "Shelf",
        color = Color3.fromRGB(96, 150, 180),
        brightness = 0.9,
        range = 24,
    },
}

-- Names VisualService gives the instances it owns, so a restyle can find them by name.
VisualConfig.InstanceNames = {
    Root = "Visual", -- Workspace.DeepTide.Visual, the folder for visual-only parts
    EmitterPrefix = "DT_", -- every emitter this system adds (idempotent rebuild looks for this)
    LightPrefix = "DT_",
}

return VisualConfig
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="18">
          <Properties>
            <string name="Name">ZoneConfig</string>
            <string name="Source"><![CDATA[--!strict
--[[
    Deep Tide — ZoneConfig
    Source: GDD §3.0 (coordinates, water region, build zone), §3.1 (volume summary),
            §3.3 (The Rim / Rim Gate), §3.4 (zone footprints), §8.2 (fog formula),
            §9 (zone entry banner), Appendix C (depth bands).
    PURE DATA — the world's rules of space, shared by WorldService, DiveService and the blockout.

    Depth is reported as -Y at the player's head (§3.0), in studs, printed as "m" (GDD header).
]]

local ZoneConfig = {}

ZoneConfig.SeaLevelY = 0

-- Water fill region for Roblox Terrain (§3.0). Terrain holds water and nothing else.
ZoneConfig.WaterRegion = {
    minX = -240,
    maxX = 240,
    minZ = -180,
    maxZ = 620,
    topY = 0,
    bottomY = -230,
}

-- Nothing is placed outside this box (§3.0).
ZoneConfig.BuildZone = {
    minX = -220,
    maxX = 220,
    minZ = -160,
    maxZ = 560,
}

-- Vertical depth bands in studs, top -> bottom (Appendix C).
ZoneConfig.DepthBand = {
    Shallows = { top = 0, bottom = -85 },
    Rim = { top = -40, bottom = -175 },
    Shelf = { top = -100, bottom = -215 },
}

-- Seabed / base geology (§3.1 "Seabed" row of the volume summary). Parts are laid on a
-- column x row grid inside the zone footprint; `topY` is the surface the player swims over,
-- so a cell's centre is topY - thickness/2. WorldService builds exactly these cells.
ZoneConfig.Seabed = {
    Shallows = {
        parts = 24, -- §3.1: "24 sand Parts (80 x 4 x 75, grid 5 x 4) ... tops at Y -45"
        grid = { columns = 5, rows = 4 },
        cellSize = Vector3.new(80, 4, 75),
        topY = -45,
        -- §3.1: "sloping to -85 in a trench at the SE corner". The SE cell is replaced by
        -- `trenchSteps` descending sand slabs, so grid + trench still totals 24 parts.
        trenchCell = { column = 5, row = 4 },
        trenchTopY = -85,
        trenchSteps = 5,
        trenchSize = Vector3.new(70, 4, 60),
        material = Enum.Material.SmoothPlastic,
        color = Color3.fromRGB(196, 183, 148),
    },
    Shelf = {
        parts = 20, -- §3.1: "20 rock Parts, sloping from Y -150 at the lip down to -215"
        grid = { columns = 5, rows = 4 },
        cellSize = Vector3.new(80, 4, 75),
        topYs = { -150, -172, -194, -215 }, -- one per row, south (lip) -> north
        -- §3.1: "split by a central chasm" (ZoneConfig.Chasm). Those cells are not built;
        -- `aprons` rock slabs close the chasm's north and south ends instead, keeping 20.
        chasmSkipColumn = 3,
        chasmSkipRows = { 2, 3 },
        aprons = 2,
        material = Enum.Material.Slate,
        color = Color3.fromRGB(58, 66, 74),
    },
}

-- The two playable areas (§3.1).
ZoneConfig.Zones = {
    Shallows = {
        id = "Shallows",
        displayName = "THE SHALLOWS",
        footprint = { minX = -200, maxX = 200, minZ = -150, maxZ = 150 },
        depthBand = ZoneConfig.DepthBand.Shallows,
        requiredDepthRating = 90, -- Rubber Lungs
        species = { "SilverSardine", "SunsetGrouper", "ReefBass" },
        playtimeShare = 0.85,
    },
    Shelf = {
        id = "Shelf",
        displayName = "THE SHELF",
        footprint = { minX = -200, maxX = 200, minZ = 200, maxZ = 500 },
        depthBand = ZoneConfig.DepthBand.Shelf,
        requiredDepthRating = 240, -- Reinforced Tank
        species = { "LanternEel", "GhostRay" },
        playtimeShare = 0.15,
    },
}

-- The Rim: the gate between the two areas (§3.3).
ZoneConfig.Rim = {
    wall = {
        minX = -200,
        maxX = 200,
        minZ = 150,
        maxZ = 200,
        steps = 8,
        topY = -40,
        bottomY = -175,
    },
    gate = {
        id = "RimGate",
        minX = -25,
        maxX = 25,
        minZ = 150,
        maxZ = 200,
        width = 50,
        rampTopY = -50,
        rampBottomY = -120,
        pillarSize = Vector3.new(26, 90, 26),
    },
    current = {
        topY = -90,
        bottomY = -140,
        pushNorthStudsPerSecond = 30,
        visualOnly = true, -- §3.3: the hard gate is the DepthRating check (§5.4), never this
    },
    -- The rule this geometry exists to express:
    crossingRule = "DepthRating >= 240 (ZoneConfig.Zones.Shelf.requiredDepthRating); "
        .. "the notch is at X in [-25, 25], Z 150 -> 200 (GDD §3.3, §5.4).",
}

-- The Chasm: the deepest playable point of the slice and where the next update's
-- content sits (§3.4 S6, §7). Referenced by LandmarkConfig.
ZoneConfig.Chasm = {
    minX = -40,
    maxX = 40,
    minZ = 300,
    maxZ = 460,
    floorY = -215,
}

-- Fog is the depth gauge (§8.2): FogEnd = clamp(320 - 1.35 x depth, 45, 320).
ZoneConfig.Fog = {
    BaseDistance = 320,
    DepthCoefficient = 1.35,
    MinDistance = 45,
    StartFraction = 0.25,
    ShallowColor = Color3.fromRGB(90, 150, 170),
    DeepColor = Color3.fromRGB(6, 12, 20),
    -- §8.2 gives the FogColor lerp's two ends but not its length. The clamp distance
    -- ((320 - 45) / 1.35 = 203.7 studs) is where the curve itself stops moving, so the colour
    -- finishes changing exactly where the distance does — rounded to the Shelf's own depth band
    -- (§3.1: Shelf 100 -> 215). Modules/Atmosphere reads this; nothing else does.
    ColorRampStuds = 204,
}

-- Presentation timings owned by the world (§3.0, §9).
ZoneConfig.ZoneEntryBannerSeconds = 3
ZoneConfig.UnderwaterFadeSeconds = 1.5

-- §3.1 / §3.3 / §9: a zone is entered through its gate, not by crossing an invisible line. A
-- player who reaches a zone's water without the gear rating that opens it (§3.1's "gear rating
-- required" row) is told what the water needs — named, rated and priced — so the wall is a
-- shopping list rather than a mystery. The physical consequence is §5.4's auto-surface rule,
-- which DiveService owns; this table only owns the words.
ZoneConfig.ZoneEntry = {
    requireRating = true, -- §1 step 12: "gate to advance: DepthRating >= 240"
    -- params: zone display name, the gear that opens it, that gear's rating, its cost
    requirementFormat = "%s NEEDS %s — RATING %dm · %d C",
    requirementSeconds = 3,
    requirementCooldownSeconds = 6, -- the same wall, said once per attempt rather than per frame
    -- The zone's water starts here (§3.1). A diver standing on the dock or swimming the surface
    -- is still "in" a zone whose water starts at the surface (the Shallows), while a swimmer on
    -- the surface 100 m above The Shelf's water simply has not reached it — so the entry check
    -- runs against the band top with this much allowance for the surface itself.
    enterBelowBandTop = true,
    surfaceSlackStuds = 20,
}

-- Where the world's interactive props stand (§3.2 L1). ProximityPrompts are wired by WorldService.
ZoneConfig.InteractionPoints = {
    PlayerSpawn = Vector3.new(0, 8, -20), -- standing on the dock, facing +Z (§1 step 1)
    RodRack = Vector3.new(12, 9, -10), -- "E — Take Rusty Rod"
    TideTrader = Vector3.new(-14, 9, -10), -- "E — Trade"
    -- DiveMarker: GDD §1 step 3 references a "DIVE HERE" marker but §3.2 gives no coordinate.
    -- The dock ramp meets the water at Z 8 (§3.2 L1), so the marker floats just above the
    -- ramp's water entry there (lead decision, 2026-10-13).
    DiveMarker = Vector3.new(0, 2.5, 8),
}

return ZoneConfig
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="Folder" referent="19">
        <Properties>
          <string name="Name">Modules</string>
        </Properties>
        <Item class="ModuleScript" referent="20">
          <Properties>
            <string name="Name">Atmosphere</string>
            <string name="Source"><![CDATA[--!strict
--[[
    Deep Tide — Atmosphere (the depth sampler)
    Source: GDD §3.0 (depth is -Y at the head; the 1.5 s blend on crossing Y 0),
            §8.1 (two-world lighting, one interpolation), §8.2 (fog is the depth gauge),
            §8.3 (sun rays die by 60 studs), §8.8 (the air alarm's screen effect),
            Appendix C (the fog formula).

    WHAT THIS IS: a pure function of one number. Give it a depth in studs and it returns every
    value the water's light should have at that depth — fog distance and colour, ambient, brightness,
    the Atmosphere instance's numbers, the colour grade and the bloom — by interpolating between the
    depth anchors in LightingConfig.Bands. Nothing here touches an Instance, so it runs (and is
    asserted) headlessly, and so the exact curve the client applies is the exact curve the test rig
    checks. The three places the player must be able to name are in that curve as anchors, not as
    branches: descending through the Shallows into the Rim into the Shelf is one continuous fade.

    TWO RULES THIS FILE EXISTS TO ENFORCE
      1. Fog is a gauge, not decoration (§8.2): the numbers come from ZoneConfig.Fog and nowhere
         else, so FogEnd = clamp(320 - 1.35 x depth, 45, 320) is literally the formula the GDD
         prints, and the colour ramp ends where the distance ramp stops moving.
      2. Nothing steps (§8.1: "never a snap"). The sampler is continuous at every band boundary;
         tools/worldtest/visual_harness.luau asserts that by walking depth 0 -> 230 in 1-stud steps
         and failing on any jump larger than the stated tolerance.

    The clock-domain pieces (the 1.5 s underwater cross-fade, the air-alarm pulse) are functions of
    time here too, but they are still pure: the caller supplies the fade factor / the clock, so the
    controller stays a writer and the maths stays testable.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local ZoneConfig = require(ReplicatedStorage.DeepTide.Config.ZoneConfig)
local LightingConfig = require(ReplicatedStorage.DeepTide.Config.LightingConfig)
local DiveConfig = require(ReplicatedStorage.DeepTide.Config.DiveConfig)

local Atmosphere = {}

-- ============================================================================
-- Small colour maths (Color3:Lerp is not stubbed in the headless rig, and this is 6 lines)
-- ============================================================================

function Atmosphere.Lerp(a: number, b: number, t: number): number
    return a + (b - a) * t
end

function Atmosphere.Clamp01(t: number): number
    if t < 0 then
        return 0
    elseif t > 1 then
        return 1
    end
    return t
end

--- Linear interpolation between two colours, on their RGB channels (Roblox has no HSV lerp and
--- the GDD only ever names RGB endpoints).
function Atmosphere.LerpColor(a: Color3, b: Color3, t: number): Color3
    local u = Atmosphere.Clamp01(t)
    return Color3.fromRGB(a.R * 255 + (b.R * 255 - a.R * 255) * u, a.G * 255 + (b.G * 255 - a.G * 255) * u, a.B * 255 + (b.B * 255 - a.B * 255) * u)
end

-- ============================================================================
-- §8.2 — the fog curve (ZoneConfig.Fog is the only place these numbers live)
-- ============================================================================

--- How far the player can see at `depthStuds`: §8.2 `FogEnd = clamp(320 - 1.35 x depth, 45, 320)`.
--- 320 studs at the surface, 50 at 200 studs, 45 from 204 studs down. The player's *sense* of
--- depth equals the number on the HUD — which is the whole point of §8.2.
function Atmosphere.FogEnd(depthStuds: number): number
    local fog = ZoneConfig.Fog
    local distance = fog.BaseDistance - fog.DepthCoefficient * math.max(depthStuds, 0)
    if distance < fog.MinDistance then
        return fog.MinDistance
    elseif distance > fog.BaseDistance then
        return fog.BaseDistance
    end
    return distance
end

--- §8.2: `FogStart = FogEnd x 0.25`. The near plane of the haze follows the far plane, so the
--- transition band stays proportional as the world closes in.
function Atmosphere.FogStart(depthStuds: number): number
    return Atmosphere.FogEnd(depthStuds) * ZoneConfig.Fog.StartFraction
end

--- §8.2: FogColor lerps `RGB(90, 150, 170)` -> `RGB(6, 12, 20)` (ZoneConfig.Fog's two ends).
--- The ramp length is ZoneConfig.Fog.ColorRampStuds — the depth at which the distance curve stops
--- moving, so colour and distance finish together.
function Atmosphere.FogColor(depthStuds: number): Color3
    local fog = ZoneConfig.Fog
    return Atmosphere.LerpColor(fog.ShallowColor, fog.DeepColor, Atmosphere.Clamp01(depthStuds / fog.ColorRampStuds))
end

-- ============================================================================
-- §8.3 — sun shafts, per-client, continuous
-- ============================================================================

--- How visibly the §3.2 L8 sun shafts are drawn from `depthStuds` of camera depth.
--- 0.35 seen from the dock (above water), up to 1.0 by LightingConfig.SunShafts.peakStuds, then
--- down to 0 at fadeEndStuds (60) and gone below it (§8.3 "further down their absence is the
--- Shelf's best asset"). Continuous at every breakpoint, including at 0.
function Atmosphere.SunShaftAlpha(depthStuds: number): number
    local cfg = LightingConfig.SunShafts
    local above = cfg.aboveWaterAlpha
    if depthStuds <= cfg.fadeStartStuds then
        return above
    end
    if depthStuds >= cfg.fadeEndStuds then
        return 0
    end
    if depthStuds <= cfg.peakStuds then
        local t = (depthStuds - cfg.fadeStartStuds) / math.max(cfg.peakStuds - cfg.fadeStartStuds, 1e-6)
        return Atmosphere.Lerp(above, 1, t)
    end
    local t = (depthStuds - cfg.peakStuds) / math.max(cfg.fadeEndStuds - cfg.peakStuds, 1e-6)
    return Atmosphere.Lerp(1, 0, t)
end

-- ============================================================================
-- The band curve (§8.1): the three places, as anchors
-- ============================================================================

--- The two anchors a depth sits between: `{ shallow, deep, t }`, where `t` is how far along the
--- pair the depth is (0 at the shallow anchor, 1 at the deep one). Above the first anchor and
--- below the last, `shallow == deep` and `t == 0`, so the ends are held rather than extrapolated.
function Atmosphere.Span(depthStuds: number): { shallow: any, deep: any, t: number }
    local bands = LightingConfig.Bands
    local depth = depthStuds
    if depth <= bands[1].depthStuds then
        return { shallow = bands[1], deep = bands[1], t = 0 }
    end
    for index = 1, #bands - 1 do
        local shallow, deep = bands[index], bands[index + 1]
        if depth < deep.depthStuds then
            local span = deep.depthStuds - shallow.depthStuds
            return { shallow = shallow, deep = deep, t = Atmosphere.Clamp01((depth - shallow.depthStuds) / span) }
        end
    end
    local last = bands[#bands]
    return { shallow = last, deep = last, t = 0 }
end

--- The band a depth *belongs* to (§3.1's three places, plus the chasm floor). A boundary depth
--- belongs to the deeper band: at 40 studs the water is already Shallows water.
--- bands[1] (Surface) is the *above-the-waterline* preset — §8.1's bright dock look — and it is
--- anchored at Y 0 only so the fade down to the first water band starts at the waterline. A depth
--- below the waterline therefore belongs to water: 10 studs down is Shallows water (§3.0: sea
--- level = Y 0, and Appendix C puts the whole 0 -> 85 stud band in the Shallows), not "Surface".
function Atmosphere.BandAt(depthStuds: number): string
    local bands = LightingConfig.Bands
    if depthStuds <= bands[1].depthStuds then
        return bands[1].id
    end
    -- Below the waterline the first water band holds until its own anchor: at 10 studs there is no
    -- deeper anchor yet, and the shallowest water band is the right answer, not Surface.
    local shallowestWater = if bands[2] ~= nil then bands[2] else bands[1]
    local name = shallowestWater.id
    for index = 2, #bands do
        if depthStuds >= bands[index].depthStuds then
            name = bands[index].id
        end
    end
    return name
end

--- Interpolate a fixed set of number fields and a fixed set of colour fields from one band to the
--- next. The two lists are given by the caller rather than sniffed, so a field that is added to a
--- band and forgotten here is a nil the test rig sees, not a silent fallback.
local function lerpFields(
    shallow: any,
    deep: any,
    t: number,
    numberKeys: { string },
    colorKeys: { string }
): { [string]: any }
    local out: { [string]: any } = {}
    for _, key in numberKeys do
        out[key] = Atmosphere.Lerp(shallow[key], deep[key], t)
    end
    for _, key in colorKeys do
        out[key] = Atmosphere.LerpColor(shallow[key], deep[key], t)
    end
    return out
end

local BAND_SCALARS = { "brightness", "exposureCompensation", "environmentDiffuseScale", "environmentSpecularScale" }
local BAND_COLORS = { "ambient", "outdoorAmbient" }
local ATMOSPHERE_SCALARS = { "density", "haze", "glare", "offset" }
local ATMOSPHERE_COLORS = { "color", "decay" }
local GRADE_SCALARS = { "saturation", "contrast", "brightness" }
local GRADE_COLORS = { "tint" }
local BLOOM_SCALARS = { "intensity", "size", "threshold" }

--- Everything the water's light is at `depthStuds` (studs below sea level, §3.0).
--- One table, no Instances: the client controller writes exactly this, and the test rig asserts
--- exactly this is sane.
function Atmosphere.Plan(depthStuds: number): { [string]: any }
    local span = Atmosphere.Span(depthStuds)
    local shallow, deep, t = span.shallow, span.deep, span.t

    local plan = lerpFields(shallow, deep, t, BAND_SCALARS, BAND_COLORS)
    plan.atmosphere = lerpFields(shallow.atmosphere, deep.atmosphere, t, ATMOSPHERE_SCALARS, ATMOSPHERE_COLORS)
    plan.grade = lerpFields(shallow.grade, deep.grade, t, GRADE_SCALARS, GRADE_COLORS)
    plan.bloom = lerpFields(shallow.bloom, deep.bloom, t, BLOOM_SCALARS, {})

    -- §8.2: fog is not a band value, it is the depth gauge. The bands say how the water *feels*;
    -- the curve says how far you can see, and it is the same curve at every depth.
    plan.fogEnd = Atmosphere.FogEnd(depthStuds)
    plan.fogStart = Atmosphere.FogStart(depthStuds)
    plan.fogColor = Atmosphere.FogColor(depthStuds)
    plan.sunShaftAlpha = Atmosphere.SunShaftAlpha(depthStuds)

    plan.depthStuds = depthStuds
    plan.band = Atmosphere.BandAt(depthStuds)
    plan.zone = deep.zone
    plan.span = { from = shallow.id, to = deep.id, t = t }
    return plan
end

--- §8.1's cross-fade, as a pure step: given the current blend (0 = above water, 1 = underwater),
--- the target and `dt` seconds, advance by the blend rate. The controller calls this once per
--- sample; the fade length itself is ZoneConfig.UnderwaterFadeSeconds, read by the controller.
function Atmosphere.AdvanceBlend(current: number, target: number, dt: number, fadeSeconds: number): number
    if fadeSeconds <= 0 then
        return target
    end
    local step = dt / fadeSeconds
    if current < target then
        return math.min(target, current + step)
    end
    return math.max(target, current - step)
end

-- ============================================================================
-- §8.8 — the air alarm, as a screen effect (never as HUD chrome)
-- ============================================================================

--- The alarm's strength: 0 at DiveConfig.AirAlarmSeconds, 1 at DiveConfig.AirFastPulseSeconds,
--- linear between, and 1 below the fast threshold. Above the alarm it is exactly 0 — no warning
--- before the warning, or the number stops meaning anything.
function Atmosphere.AirAlarmStrength(airSeconds: number): number
    local alarm = DiveConfig.AirAlarmSeconds
    local fast = DiveConfig.AirFastPulseSeconds
    if airSeconds >= alarm then
        return 0
    end
    if airSeconds <= fast then
        return 1
    end
    return Atmosphere.Clamp01((alarm - airSeconds) / (alarm - fast))
end

--- The pulse period under the alarm: §8.8 "accelerating to a fast pulse" at the fast threshold.
function Atmosphere.AirAlarmPeriod(airSeconds: number): number
    local oxygen = LightingConfig.Oxygen
    if airSeconds <= DiveConfig.AirFastPulseSeconds then
        return oxygen.pulseFastSeconds
    end
    return oxygen.pulseSlowSeconds
end

--- What the oxygen screen effect should be at this instant: a red wash, the colour draining out,
--- the picture closing in, all of it breathing. Returns a table of property values (never
--- Instances) so the curve can be asserted: this is the "impossible to miss" half of §8.8, and the
--- only part of the alarm that is not audio (the beep is not implemented — see VisualConfig).
function Atmosphere.OxygenPlan(airSeconds: number, clock: number): { [string]: any }
    local oxygen = LightingConfig.Oxygen
    local strength = Atmosphere.AirAlarmStrength(airSeconds)
    if strength <= 0 then
        return {
            enabled = false,
            strength = 0,
            tint = Color3.fromRGB(255, 255, 255),
            saturation = 0,
            brightness = 0,
            blur = 0,
        }
    end

    local period = Atmosphere.AirAlarmPeriod(airSeconds)
    local phase = if period > 0 then math.sin(2 * math.pi * clock / period) else 0
    -- The pulse rides on top of the ramp but never takes it negative: 1 -> 2 at the peak.
    local pulsed = strength * (1 + oxygen.pulseAmplitude * phase)

    return {
        enabled = true,
        strength = strength,
        tint = Atmosphere.LerpColor(Color3.fromRGB(255, 255, 255), oxygen.tint, strength),
        saturation = oxygen.maxSaturation * strength,
        brightness = oxygen.minBrightness * strength,
        blur = oxygen.maxBlur * pulsed,
        pulse = phase,
    }
end

return Atmosphere
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="21">
          <Properties>
            <string name="Name">ConfigCheck</string>
            <string name="Source"><![CDATA[--!strict
--[[
    Deep Tide — ConfigCheck
    Source: GDD §4 (fish), §5.5 (fight times), §5.4 (rod wall), §6.2/§6.4 (economy maths),
            §11 (acceptance criteria the numbers must satisfy).

    Not gameplay logic: a consistency check over the data layer. It runs once at server
    boot and reports, it never repairs. If a config edit breaks a GDD relationship, this
    is what tells you — instead of a playtest five minutes later.
]]

local Configs = require(script.Parent.Configs)

-- §5.5: real playtime runs ~1.4x the perfect-play time (100 / fillRate). Used only
-- to confirm EconomyConfig.FightTimeSeconds still matches FishConfig.
local REAL_PLAY_FACTOR = 1.4
local FIGHT_TIME_TOLERANCE = 0.2
local COINS_PER_SECOND_TOLERANCE = 0.05

export type Report = {
    ok: boolean,
    problems: { string },
}

local ConfigCheck = {}

function ConfigCheck.run(): Report
    local problems: { string } = {}

    local function check(ok: boolean, message: string)
        if not ok then
            table.insert(problems, message)
        end
    end

    local Fish, Spawn, Landmark = Configs.Fish, Configs.Spawn, Configs.Landmark
    local Rarity, Rod, Gear = Configs.Rarity, Configs.Rod, Configs.Gear
    local Economy, Zone = Configs.Economy, Configs.Zone

    local nodeCounts: { [string]: number } = {
        SilverSardine = #Spawn.SilverSardine.anchors,
        SunsetGrouper = #Spawn.SunsetGrouper.nodes,
        ReefBass = #Spawn.ReefBass.nodes,
        LanternEel = #Spawn.LanternEel.dens,
        GhostRay = #Spawn.GhostRay.nodes,
    }

    local liveTotal = 0
    local fishParts = 0
    local worldParts = 0

    for _, landmark in Landmark.Landmarks do
        worldParts += landmark.parts
    end
    check(
        worldParts == Landmark.SumOfLandmarkPartCounts,
        ("landmark part counts sum to %d, not the recorded %d"):format(worldParts, Landmark.SumOfLandmarkPartCounts)
    )

    -- §3.1 / Appendix A: the world part budget has to add up, and the seabed has to match the
    -- grids WorldService builds from it, or the built place and the design document drift apart.
    local budget = Landmark.PartBudget
    check(
        budget.Landmarks + budget.Seabed + budget.WorldProps + budget.SpawnAnchorHosts == budget.World,
        ("PartBudget does not add up: %d + %d + %d + %d ~= %d"):format(
            budget.Landmarks,
            budget.Seabed,
            budget.WorldProps,
            budget.SpawnAnchorHosts,
            budget.World
        )
    )
    check(
        budget.World + budget.FishParts == budget.GrandTotal,
        ("GrandTotal %d is not World %d + FishParts %d"):format(budget.GrandTotal, budget.World, budget.FishParts)
    )
    local shallowsSeabed = Zone.Seabed.Shallows
    local shallowsCells = shallowsSeabed.grid.columns * shallowsSeabed.grid.rows
    check(
        shallowsCells - 1 + shallowsSeabed.trenchSteps == shallowsSeabed.parts,
        ("Shallows seabed grid (%dx%d - 1 trench cell + %d steps) is not %d parts"):format(
            shallowsSeabed.grid.columns,
            shallowsSeabed.grid.rows,
            shallowsSeabed.trenchSteps,
            shallowsSeabed.parts
        )
    )
    local shelfSeabed = Zone.Seabed.Shelf
    local shelfCells = shelfSeabed.grid.columns * shelfSeabed.grid.rows
    check(
        shelfCells - #shelfSeabed.chasmSkipRows + shelfSeabed.aprons == shelfSeabed.parts,
        ("Shelf seabed grid (%dx%d - %d chasm cells + %d aprons) is not %d parts"):format(
            shelfSeabed.grid.columns,
            shelfSeabed.grid.rows,
            #shelfSeabed.chasmSkipRows,
            shelfSeabed.aprons,
            shelfSeabed.parts
        )
    )

    for _, id in Fish.Order do
        local fish = Fish.Species[id]
        check(fish ~= nil, ("FishConfig.Species.%s is missing but is listed in FishConfig.Order"):format(id))
        if fish ~= nil then
            liveTotal += fish.liveAtStart
            fishParts += fish.liveAtStart * fish.parts

            -- §4.1 / §5.5: the species' hook-set window must equal its rarity's.
            check(
                Rarity.HookSetWindow[fish.rarity] == fish.mini.hookWindow,
                ("%s: hookWindow %s does not match RarityConfig.HookSetWindow.%s (%s)"):format(
                    id, tostring(fish.mini.hookWindow), fish.rarity, tostring(Rarity.HookSetWindow[fish.rarity])
                )
            )

            -- §4.1: the value must sit inside its rarity's sell band.
            local band = Rarity.SellValueBand[fish.rarity]
            check(
                band ~= nil and fish.value >= band[1] and fish.value <= band[2],
                ("%s: value %d is outside the %s band %s-%s"):format(id, fish.value, fish.rarity, tostring(band and band[1]), tostring(band and band[2]))
            )

            -- §6.2: the economy table must quote the same price as the fish table.
            check(
                Economy.SellValues[id] == fish.value,
                ("%s: EconomyConfig.SellValues is %s but FishConfig value is %d"):format(id, tostring(Economy.SellValues[id]), fish.value)
            )

            -- §4.5: one node/den/anchor per instance of the species.
            check(
                nodeCounts[id] == fish.behaviourCfg.count,
                ("%s: %d spawn nodes in SpawnConfig but behaviourCfg.count is %s"):format(id, nodeCounts[id], tostring(fish.behaviourCfg.count))
            )
            if fish.behaviour == "School" then
                check(
                    fish.behaviourCfg.count * fish.behaviourCfg.perSchool == fish.liveAtStart,
                    ("%s: liveAtStart %d != schools x perSchool"):format(id, fish.liveAtStart)
                )
            else
                check(
                    fish.behaviourCfg.count == fish.liveAtStart,
                    ("%s: liveAtStart %d != behaviourCfg.count %s"):format(id, fish.liveAtStart, tostring(fish.behaviourCfg.count))
                )
            end

            -- §5.5 / §6.2: fight length and Coins-per-second must still agree.
            local ideal = 100 / fish.mini.fillRate
            local real = Economy.FightTimeSeconds[id]
            check(
                real ~= nil and math.abs(real - REAL_PLAY_FACTOR * ideal) <= FIGHT_TIME_TOLERANCE,
                ("%s: FightTimeSeconds %s is not ~%.1fx the %.1fs perfect-play fight"):format(id, tostring(real), REAL_PLAY_FACTOR, ideal)
            )
            if real ~= nil and real > 0 then
                local computed = math.floor((fish.value / real) * 10 + 0.5) / 10
                check(
                    math.abs(Economy.CoinsPerSecondOfFight[id] - computed) <= COINS_PER_SECOND_TOLERANCE,
                    ("%s: CoinsPerSecondOfFight %s != value/fightTime %.1f"):format(id, tostring(Economy.CoinsPerSecondOfFight[id]), computed)
                )
            end

            -- §3.1 / §4.5: the species must live inside its zone's band, and never
            -- shallower than the shelf rule allows.
            local zone = Zone.Zones[fish.zone]
            check(zone ~= nil, ("%s: zone '%s' is not in ZoneConfig.Zones"):format(id, tostring(fish.zone)))
            if zone ~= nil then
                local deepest = -zone.depthBand.bottom
                check(
                    fish.depthBand[1] >= 0 and fish.depthBand[2] <= deepest,
                    ("%s: depthBand %d-%d does not fit %s (0-%d studs)"):format(id, fish.depthBand[1], fish.depthBand[2], fish.zone, deepest)
                )
            end
            if fish.zone == "Shelf" then
                check(
                    fish.depthBand[1] >= Fish.SpawnRules.NeverShallowerThanStuds,
                    ("%s: no Shelf fish may be found shallower than %d studs"):format(id, Fish.SpawnRules.NeverShallowerThanStuds)
                )
            end
        end
    end

    -- §4.5 / Appendix C: 48 + 10 + 6 + 7 + 3 = 74 live at server start.
    check(
        liveTotal == Fish.TotalLiveAtServerStart,
        ("live fish sum to %d, FishConfig.TotalLiveAtServerStart records %d"):format(liveTotal, Fish.TotalLiveAtServerStart)
    )
    check(liveTotal == 74, ("live fish sum to %d, the GDD's 48/10/6/7/3 is 74"):format(liveTotal))

    -- §3.1: each zone's gear gate must be met by the gear that unlocks it.
    check(
        Gear.Gear.RubberLungs.depthRating >= Zone.Zones.Shallows.requiredDepthRating,
        "Rubber Lungs cannot reach the Shallows requirement"
    )
    check(
        Gear.Gear.ReinforcedTank.depthRating >= Zone.Zones.Shelf.requiredDepthRating,
        "Reinforced Tank cannot reach The Shelf requirement"
    )

    -- §6.3: shop prices must match the gear/rod tables the shop sells.
    check(
        Gear.Gear.ReinforcedTank.cost == Economy.Shop.ReinforcedTank.cost,
        "Reinforced Tank cost differs between GearConfig and EconomyConfig.Shop"
    )
    check(Rod.Rods.BrassRod.cost == Economy.Shop.BrassRod.cost, "Brass Rod cost differs between RodConfig and EconomyConfig.Shop")
    check(Economy.ShopOrder[1] == "ReinforcedTank", "§6.3: the Reinforced Tank must be listed first")

    -- §5.4: the rod wall. A Rusty Rod must never be able to land an Epic fish, and the
    -- Brass Rod must be the item that removes that wall (§6.3).
    check(
        Rarity.Rank[Rod.Rods.RustyRod.maxRarity] < Rarity.Rank[Fish.Species.GhostRay.rarity],
        "§5.4: Rusty Rod's maxRarity now allows an Epic fish — the designed wall is broken"
    )
    check(
        Rarity.Rank[Rod.Rods.BrassRod.maxRarity] >= Rarity.Rank[Fish.Species.GhostRay.rarity],
        "§6.3: Brass Rod must reach the Ghost Ray's rarity"
    )

    -- §6.4: the routes to the 280 C tank must still add up, and must still clear it.
    local tankCost = Economy.Shop.ReinforcedTank.cost
    local median = Economy.Routes.Median
    check(median.dive1 + median.dive2 == median.total, "§6.4: the median route totals do not add up")
    check(
        median.total >= tankCost,
        ("§6.4: the median 2-dive route (%d C) no longer affords the tank (%d C)"):format(median.total, tankCost)
    )
    local minimum = Economy.Routes.MinimumSkill
    check(
        minimum.sardines * Economy.SellValues.SilverSardine == minimum.total,
        "§6.4: the 19-sardine route total no longer matches its arithmetic"
    )
    check(
        minimum.total >= tankCost,
        ("§6.4: the minimum-skill balance floor (%d C) no longer affords the tank (%d C)"):format(minimum.total, tankCost)
    )
    local fast = Economy.Routes.Fast
    check(fast.reefBass * Economy.SellValues.ReefBass == fast.total, "§6.4: the fast route total no longer matches its arithmetic")

    return {
        ok = #problems == 0,
        problems = problems,
    }
end

--- Human-readable one-liner for the boot line / Studio output.
function ConfigCheck.summary(report: Report, speciesCount: number, liveFish: number): string
    if report.ok then
        -- The world part count is what the blockout actually builds (LandmarkConfig.PartBudget,
        -- asserted by WorldService at build time), not the landmark subtotal on its own.
        return ("config OK — %d species, %d fish live, %d world parts"):format(
            speciesCount,
            liveFish,
            Configs.Landmark.PartBudget.World
        )
    end
    return ("config problems: %d"):format(#report.problems)
end

return ConfigCheck
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="22">
          <Properties>
            <string name="Name">Configs</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Deep Tide — Configs (single entry point for every config table)
	Source: GDD Appendix A (Config/ layout) and Appendix B (config tables).

	Gameplay code should require this one module and never build require paths itself:

		local Config = require(game:GetService("ReplicatedStorage").DeepTide.Modules.Configs)
		local fish = Config.Fish.Species[speciesId]

	These are references, not copies — every requirer sees the same tables.
]]

local Modules = script.Parent
local DeepTide = Modules.Parent

local Configs = {
	Fish = require(DeepTide.Config.FishConfig), -- GDD §4, §5.5, §4.5
	Spawn = require(DeepTide.Config.SpawnConfig), -- GDD §4.6
	Landmark = require(DeepTide.Config.LandmarkConfig), -- GDD §3.2-§3.4
	Rarity = require(DeepTide.Config.RarityConfig), -- GDD §4.1
	Rod = require(DeepTide.Config.RodConfig), -- GDD §5.3, §5.4, §6.3
	Gear = require(DeepTide.Config.GearConfig), -- GDD §3.1, §6.3
	Dive = require(DeepTide.Config.DiveConfig), -- GDD §3, §5.4, §8.8
	Fight = require(DeepTide.Config.FightConfig), -- GDD §5.1-§5.6
	Economy = require(DeepTide.Config.EconomyConfig), -- GDD §6
	Zone = require(DeepTide.Config.ZoneConfig), -- GDD §3
}

return Configs
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="23">
          <Properties>
            <string name="Name">Remotes</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Deep Tide — Remotes (remote/event definitions)
	Source: GDD Appendix B ("Key remotes (Remotes folder, CreateRemoteEvent)").
	PURE DATA + one accessor pair. No gameplay logic.

	Every client <-> server message in the game is declared here once, created by the
	server bootstrap, and fetched by name on either realm:

		local Remotes = require(game:GetService("ReplicatedStorage").DeepTide.Modules.Remotes)
		Remotes.get("CoinsChanged"):FireClient(player, coins)

	Payloads are documented per remote so the scripter and the UI designer agree on shape.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Remotes = {}

Remotes.ParentName = "DeepTide" -- ReplicatedStorage.DeepTide
Remotes.FolderName = "Remotes" -- ReplicatedStorage.DeepTide.Remotes

Remotes.Direction = {
	ClientToServer = "ClientToServer",
	ServerToClient = "ServerToClient",
}

Remotes.Definitions = {
	-- Client -> server requests
	CastRequest = {
		direction = Remotes.Direction.ClientToServer,
		payload = "fish instance (the client's chosen target within §5.1 cast range)",
		owner = "FishingService",
	},
	HookSetRequest = {
		direction = Remotes.Direction.ClientToServer,
		payload = "none (the server owns the hook-set window, §5.2)",
		owner = "FishingService",
	},
	FightInput = {
		direction = Remotes.Direction.ClientToServer,
		payload = "\"hold\" | \"release\" | \"abort\" (§5.3 input set)",
		owner = "FishingService",
	},
	ShopBuyRequest = {
		direction = Remotes.Direction.ClientToServer,
		payload = "sku id (EconomyConfig.ShopOrder members, §6.3)",
		owner = "ShopService",
	},

	-- Server -> client state
	FightStateChanged = {
		direction = Remotes.Direction.ServerToClient,
		payload = "{ needle T, zone centre S, zone half-width W, hold meter H, tensionMax } @30 Hz (§5.3)",
		owner = "FishingService",
	},
	FightResolved = {
		direction = Remotes.Direction.ServerToClient,
		payload = "{ result = \"Landed\"|\"Escaped\"|\"Snapped\"|\"WeakLine\", speciesId, reason } (§5.3, §5.4)",
		owner = "FishingService",
	},
	CatchLogChanged = {
		direction = Remotes.Direction.ServerToClient,
		payload = "{ entries = { Types.CatchLogEntry }, totalCoins } (§9)",
		owner = "InventoryService",
	},
	CoinsChanged = {
		direction = Remotes.Direction.ServerToClient,
		payload = "{ coins, delta } (§9)",
		owner = "EconomyService",
	},
	ShopStateChanged = {
		direction = Remotes.Direction.ServerToClient,
		payload = "{ skus = { { sku, cost, affordable, owned } }, coins } (§9)",
		owner = "ShopService",
	},
	DiveStateChanged = {
		direction = Remotes.Direction.ServerToClient,
		payload = "{ air, airCapacity, depth, depthRating, exceeded } (§9)",
		owner = "DiveService",
	},
	ZoneChanged = {
		direction = Remotes.Direction.ServerToClient,
		payload = "zone id (\"Shallows\" | \"Shelf\") — drives the §9 entry banner",
		owner = "WorldService",
	},
	Notify = {
		direction = Remotes.Direction.ServerToClient,
		payload = "{ text, seconds } — the §9 2-second explainer line (FightConfig.FailMessages)",
		owner = "FishingService",
	},
}

-- Ordered list of every remote name (creation order is deterministic).
Remotes.Names = {
	"CastRequest",
	"HookSetRequest",
	"FightInput",
	"FightStateChanged",
	"FightResolved",
	"CatchLogChanged",
	"CoinsChanged",
	"ShopBuyRequest",
	"ShopStateChanged",
	"DiveStateChanged",
	"ZoneChanged",
	"Notify",
}

--- The ReplicatedStorage.DeepTide.Remotes folder.
--- Server: created on demand. Client: waited for (the server makes it at boot).
function Remotes.getFolder(): Folder
	local deepTide = ReplicatedStorage:WaitForChild(Remotes.ParentName)

	if RunService:IsServer() then
		local existing = deepTide:FindFirstChild(Remotes.FolderName)
		if existing ~= nil then
			return existing :: Folder
		end

		local created = Instance.new("Folder")
		created.Name = Remotes.FolderName
		created.Parent = deepTide
		return created
	end

	return deepTide:WaitForChild(Remotes.FolderName) :: Folder
end

--- Creates the folder and every RemoteEvent. Server only; called once by the bootstrap.
function Remotes.ensure(): Folder
	assert(RunService:IsServer(), "Remotes.ensure() must only be called on the server")

	local folder = Remotes.getFolder()
	for _, name in Remotes.Names do
		if folder:FindFirstChild(name) == nil then
			local remote = Instance.new("RemoteEvent")
			remote.Name = name
			remote.Parent = folder
		end
	end

	return folder
end

--- Fetch one remote by name. Waits on the client if the server has not created it yet.
function Remotes.get(name: string): RemoteEvent
	assert(Remotes.Definitions[name] ~= nil, ("Remotes.get: '%s' is not a declared remote"):format(name))
	return Remotes.getFolder():WaitForChild(name) :: RemoteEvent
end

return Remotes
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="24">
          <Properties>
            <string name="Name">Rng</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Deep Tide — Rng (deterministic pseudo-random numbers)

	Source: GDD §4.3 (the behaviour specs are full of "random" values: anchor random walks,
	orbit phase offsets, jitter, waypoint scatter) and §4.5 (respawn/despawn timers).

	Why this exists: fish behaviour has to be *reproducible*. A run with the same seed must
	produce the same swim, the same fights and the same outcomes twice, so the loop can be
	tested headlessly (tools/worldtest) and so a bug can be replayed instead of guessed at.
	`math.random` cannot do that — it is global and shared with every other caller.

	A small 32-bit LCG (Numerical Recipes constants). Exact in a double, no bit library needed,
	and the same sequence in Studio, in the Luau CLI and on any server.
]]

local Rng = {}
Rng.__index = Rng

local MODULUS = 4294967296 -- 2^32
local MULTIPLIER = 1664525
local INCREMENT = 1013904223

export type Rng = typeof(setmetatable({} :: { state: number }, Rng))

--- A generator from `seed`. Any integer works; 0 is folded to 1 so the sequence never sticks.
function Rng.new(seed: number?): Rng
	local state = math.floor(math.abs(seed or 1)) % MODULUS
	if state <= 0 then
		state = 1
	end
	return setmetatable({ state = state }, Rng)
end

--- Uniform in [0, 1).
function Rng:nextUnit(): number
	self.state = (self.state * MULTIPLIER + INCREMENT) % MODULUS
	return self.state / MODULUS
end

--- Uniform in [min, max).
function Rng:range(min: number, max: number): number
	return min + (max - min) * self:nextUnit()
end

--- Uniform integer in [min, max], inclusive on both ends.
function Rng:integer(min: number, max: number): number
	if max <= min then
		return min
	end
	return min + math.floor(self:nextUnit() * (max - min + 1) - 1e-9) :: number
end

--- -1 or 1.
function Rng:sign(): number
	return if self:nextUnit() < 0.5 then -1 else 1
end

--- One element of a list, or nil for an empty list.
function Rng:pick<T>(list: { T }): T?
	if #list == 0 then
		return nil
	end
	return list[self:integer(1, #list)]
end

--- A point inside a sphere of `radius` (uniform by volume), offset from `centre`.
function Rng:insideSphere(centre: Vector3, radius: number): Vector3
	local z = self:range(-1, 1)
	local theta = self:range(0, 2 * math.pi)
	local r = radius * (self:nextUnit() ^ (1 / 3))
	local planar = math.sqrt(math.max(0, 1 - z * z))
	return centre + Vector3.new(r * planar * math.cos(theta), r * z, r * planar * math.sin(theta))
end

--- A unit direction. Used for flee/lunge headings, which the GDD gives as "away from the
--- player" — a real direction only needs to be deterministic when the fish has no player.
function Rng:unitVector(): Vector3
	local z = self:range(-1, 1)
	local theta = self:range(0, 2 * math.pi)
	local planar = math.sqrt(math.max(0, 1 - z * z))
	return Vector3.new(planar * math.cos(theta), z, planar * math.sin(theta))
end

--- The next integer a fresh generator from this seed would use — for logging a run so it can
--- be replayed.
function Rng:getState(): number
	return self.state
end

return Rng
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="25">
          <Properties>
            <string name="Name">Tension</string>
            <string name="Source"><![CDATA[--!strict
--[[
    Deep Tide — Tension (the pure §5 maths, in one place)

    Source: GDD §5.1 (cast geometry), §5.2 (the hook-set ring), §5.3 (the tension mini-game,
    steps 1-7 verbatim), §5.4 (the unbreakable rod wall), §5.5 (per-species tuning),
    §4.1 (hook-set window and strain multiplier by rarity).

    Nothing here touches Instances, remotes or players: it is the arithmetic the server runs and
    the client mirrors, so a fight can be simulated headlessly (tools/worldtest/fish_harness.luau)
    and the same seed produces the same fight twice. FishingService owns the consequences
    (cooldowns, fish states, catch log); this module owns the numbers.

    Every constant comes from FightConfig / RarityConfig / the species' mini table. Tension
    takes at most a species config entry and a rod stats entry — no magic numbers.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local FightConfig = require(ReplicatedStorage.DeepTide.Config.FightConfig)
local RarityConfig = require(ReplicatedStorage.DeepTide.Config.RarityConfig)

local Tension = {}

export type SpeciesEntry = {
    id: string,
    name: string,
    rarity: string,
    value: number,
    mini: {
        zoneHalfWidth: number,
        zoneHz: number,
        zoneAmp: number,
        fillRate: number,
        requiredTension: number,
        hookWindow: number,
    },
}

export type RodStats = {
    id: string,
    name: string,
    lineStrength: number,
    zoneWidthMult: number,
    strainMult: number,
    fillMult: number,
    maxRarity: string,
}

--- One fight. Mirrored field-for-field by the client (§5.3 UI: safe zone, needle, hold meter,
--- over-tension line).
export type FightState = {
    needle: number, -- T in [0, 1], starts at FightConfig.NeedleStart
    zoneCentre: number, -- S (§5.3 step 2)
    zoneHalfWidth: number, -- W = species value x rod zoneWidthMult
    hold: number, -- H in [0, FightConfig.HoldMeterMax]
    tensionMax: number, -- T_max = min(1, rod.lineStrength / species.requiredTension)
    fillRate: number, -- %/s, species value x rod fillMult
    strainMult: number, -- RarityConfig.StrainMult[rarity] x rod strainMult
    zoneHz: number,
    zoneAmp: number,
    elapsed: number, -- fight clock, drives the sine
    jitter: number, -- the ±ZoneJitterAmp offset currently in force
    jitterTimer: number, -- seconds until the next re-roll
    overTensionSeconds: number, -- how long T has sat at the over-tension line
    inZone: boolean, -- last step's in-zone test (§5.3 step 5)
}

export type FightOutcome = "Landed" | "Escaped" | "Snapped"
export type HookSetResult = "Hit" | "Early" | "Late" | "Expired"

local function clamp(value: number, low: number, high: number): number
    if value < low then
        return low
    elseif value > high then
        return high
    end
    return value
end

-- Cast (§5.1) -----------------------------------------------------------------

--- §5.1 step 1/2: is `targetPosition` a legal cast from `origin`, given the caster's facing?
--- Returns (ok, distance, facingDot) so a refusal can name which rule failed.
function Tension.castTargetCheck(
    origin: Vector3,
    lookVector: Vector3,
    targetPosition: Vector3,
    maxRange: number?,
    minFacingDot: number?
): (boolean, number, number)
    local range = maxRange or FightConfig.CastRange
    local minDot = minFacingDot or FightConfig.CastFacingDot

    local offset = targetPosition - origin
    local distance = offset.Magnitude
    local dot = 0
    if distance > 0 then
        local unit = offset / distance
        dot = unit.X * lookVector.X + unit.Y * lookVector.Y + unit.Z * lookVector.Z
    end

    return distance <= range and dot >= minDot, distance, dot
end

-- Hook set (§5.2) -------------------------------------------------------------

--- How far through the shrink ring is, as a fraction of the species' window (§5.2 step 5).
function Tension.hookSetFraction(elapsed: number, hookWindow: number): number
    if hookWindow <= 0 then
        return 1
    end
    return elapsed / hookWindow
end

--- §5.2 step 6/7: a press lands if the ring is between HookSetZoneMin and 100%; a press inside
--- the +HookSetGraceSeconds tail is a miss ("Late"), as is an early press. `Expired` is the
--- window closing with no press at all.
function Tension.hookSetResult(elapsed: number, hookWindow: number): HookSetResult
    local fraction = Tension.hookSetFraction(elapsed, hookWindow)
    local graceFraction = if hookWindow > 0 then FightConfig.HookSetGraceSeconds / hookWindow else 0

    if fraction < FightConfig.HookSetZoneMin then
        return "Early"
    elseif fraction <= 1 then
        return "Hit"
    elseif fraction <= 1 + graceFraction then
        return "Late"
    end
    return "Expired"
end

-- Fight (§5.3) ----------------------------------------------------------------

--- §5.5: 100 / fillRate with perfect play, before the rod's fill multiplier. The GDD's
--- "bare-minimum time to land" column, computed instead of copied.
function Tension.bareMinimumSeconds(species: SpeciesEntry, rodStats: RodStats?): number
    local fillMult = if rodStats ~= nil then rodStats.fillMult else 1
    local fillRate = species.mini.fillRate * fillMult
    if fillRate <= 0 then
        return math.huge
    end
    return FightConfig.HoldMeterMax / fillRate
end

--- §5.3 step 4: the tension ceiling the rod can hold against this fish. 1.0 means the rod
--- out-strengths the fish; below 1.0 the over-tension line sits inside the track.
function Tension.tensionCeiling(species: SpeciesEntry, rodStats: RodStats): number
    if species.mini.requiredTension <= 0 then
        return 1
    end
    return math.min(1, rodStats.lineStrength / species.mini.requiredTension)
end

--- §5.4/§4.1: can this rod land this rarity at all? One rank comparison — never a roll.
function Tension.rarityAllowed(rodMaxRarity: string, rarity: string): boolean
    local rodRank = RarityConfig.Rank[rodMaxRarity]
    local fishRank = RarityConfig.Rank[rarity]
    if rodRank == nil or fishRank == nil then
        return false
    end
    return fishRank <= rodRank
end

--- A new fight, with every value derived from config (§5.3 steps 1-4 on entry).
function Tension.newFight(species: SpeciesEntry, rodStats: RodStats): FightState
    local rarityStrain = RarityConfig.StrainMult[species.rarity] or 1
    return {
        needle = FightConfig.NeedleStart,
        zoneCentre = 0.5,
        zoneHalfWidth = species.mini.zoneHalfWidth * rodStats.zoneWidthMult,
        hold = FightConfig.HoldMeterStart,
        tensionMax = Tension.tensionCeiling(species, rodStats),
        fillRate = species.mini.fillRate * rodStats.fillMult,
        strainMult = rarityStrain * rodStats.strainMult,
        -- the species' §5.5 zoneHz, held to the sweep ceiling (see zoneSweepCeiling above)
        zoneHz = Tension.effectiveZoneHz(species.mini.zoneHz, species.mini.zoneAmp),
        zoneAmp = species.mini.zoneAmp,
        elapsed = 0,
        jitter = 0,
        jitterTimer = 0, -- first step rolls the jitter
        overTensionSeconds = 0,
        inZone = false,
    }
end

--- §5.3 step 2: S = 0.5 + zoneAmp * sin(2 pi * zoneHz * t) + jitter.
function Tension.zoneCentreAt(fight: FightState, elapsed: number): number
    return 0.5 + fight.zoneAmp * math.sin(2 * math.pi * fight.zoneHz * elapsed) + fight.jitter
end

--- GAP IN §5.3, resolved here and flagged to the design owner (see the note in Config/FightConfig):
--- §5.3 step 1 gives the needle a fixed 0.55 up / 0.75 down track per second, and §5.3 step 2 /
--- §5.5 give each species a zone that sweeps at 2 pi x zoneHz x zoneAmp — up to 2.38/s for the
--- Ghost Ray, 4.3x faster than the needle can move. A zone that out-runs the needle can never be
--- held: measured against the real §5.3 maths, every input policy (including one that reads the
--- zone's next position out of the air) ends up in the band 17% of the time on the Lantern Eel and
--- 12% on the Ghost Ray, against the 71% the 1.4x real-play column of §5.5/§6.2 assumes, and the
--- hold meter drains far faster than it fills — so those two fish, and the Reef Bass at 1.01/s
--- swept/s, were unlandable by construction, and the §5.4 wall ("only the Brass Rod can land a
--- Ghost Ray") guarded a fish nobody could land with any rod.
---
--- The ceiling: the needle must out-pace the zone's sweep and still have the speed left over to
--- close the +/-ZoneJitterAmp step the zone's centre takes every ZoneJitterInterval, otherwise
--- nowhere in the band is stable. Both operands are §5.3's own numbers, so this is a derived rule
--- rather than a new tunable — and it edits no §5.5 value: FishConfig keeps the printed zoneHz.
function Tension.zoneSweepCeiling(): number
    return FightConfig.NeedleRiseRate - FightConfig.ZoneJitterAmp / FightConfig.ZoneJitterInterval
end

--- The zone frequency a fight actually runs at: the species' §5.5 `zoneHz`, held to the ceiling
--- above. Species already inside the ceiling (Silver Sardine, Sunset Grouper) are untouched.
function Tension.effectiveZoneHz(zoneHz: number, zoneAmp: number): number
    local ceiling = Tension.zoneSweepCeiling()
    if zoneAmp <= 0 or ceiling <= 0 then
        return zoneHz
    end
    return math.min(zoneHz, ceiling / (2 * math.pi * zoneAmp))
end

--- One 1/30 s step of §5.3. `held` is the player's current input (hold = pull, release = slack).
--- Mutates `fight` and returns the outcome, or nil while the fight continues.
function Tension.step(fight: FightState, dt: number, held: boolean, rng: any): FightOutcome?
    fight.elapsed += dt

    -- step 2: the drifting safe zone (jitter re-rolled every ZoneJitterInterval)
    fight.jitterTimer -= dt
    if fight.jitterTimer <= 0 then
        fight.jitter = rng:range(-FightConfig.ZoneJitterAmp, FightConfig.ZoneJitterAmp)
        fight.jitterTimer = FightConfig.ZoneJitterInterval
    end
    fight.zoneCentre = Tension.zoneCentreAt(fight, fight.elapsed)

    -- step 1: the needle follows the button, not the fish
    if held then
        fight.needle += FightConfig.NeedleRiseRate * dt
    else
        fight.needle -= FightConfig.NeedleFallRate * dt
    end

    -- step 4: the rod's LineStrength caps the needle, and sitting on the cap breaks the line
    fight.needle = clamp(fight.needle, 0, fight.tensionMax)
    if fight.needle >= fight.tensionMax - FightConfig.SnapBand then
        fight.overTensionSeconds += dt
        if fight.overTensionSeconds >= FightConfig.SnapHoldTime then
            return "Snapped"
        end
    else
        fight.overTensionSeconds = 0
    end

    -- step 5: in zone the meter fills, out of zone it drains, further out drains faster
    local excess = math.abs(fight.needle - fight.zoneCentre) - fight.zoneHalfWidth
    fight.inZone = excess <= 0
    if fight.inZone then
        fight.hold += fight.fillRate * dt
    else
        local slope = if fight.zoneHalfWidth > 0 then excess / fight.zoneHalfWidth else 0
        fight.hold -= (FightConfig.HoldDrainBase + FightConfig.HoldDrainSlope * slope) * fight.strainMult * dt
    end
    fight.hold = clamp(fight.hold, 0, FightConfig.HoldMeterMax)

    -- steps 6/7: the two endings the fight owns (the §5.4 wall is checked before the fight starts)
    if fight.hold >= FightConfig.HoldMeterMax then
        return "Landed"
    elseif fight.hold <= 0 then
        return "Escaped"
    end
    return nil
end

--- The payload the client draws (§5.3 UI, §9) — a flat copy, never the live table.
function Tension.viewOf(fight: FightState, speciesId: string): { [string]: any }
    return {
        needle = fight.needle,
        zoneCentre = fight.zoneCentre,
        zoneHalfWidth = fight.zoneHalfWidth,
        hold = fight.hold,
        tensionMax = fight.tensionMax,
        speciesId = speciesId,
        overTension = fight.needle >= fight.tensionMax - FightConfig.SnapBand,
        inZone = fight.inZone,
    }
end

return Tension
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="26">
          <Properties>
            <string name="Name">Types</string>
            <string name="Source"><![CDATA[--!strict
--[[
    Deep Tide — Types
    Source: GDD §4.2 (fish), §4.1 (rarity), §5.3 (fight outcomes), §6 (economy), §9 (catch log).
    Shared type vocabulary. Data only — every runtime lookup goes through Modules/Configs.
]]

export type RarityName = "Common" | "Uncommon" | "Rare" | "Epic"
export type SpeciesId = "SilverSardine" | "SunsetGrouper" | "ReefBass" | "LanternEel" | "GhostRay"
export type ZoneId = "Shallows" | "Shelf"
export type RodId = "RustyRod" | "BrassRod"
export type GearId = "RubberLungs" | "ReinforcedTank"
export type BehaviourType = "School" | "Patrol" | "Flee" | "Ambush"

-- Fish lifecycle. "Hooked_Pending" is the GDD's name for a fish that is hooked but
-- whose hook-set window is still open (§5.1 step 3); the rest of the state machine is
-- the gameplay scripter's to define in FishService.
export type FishState = string

-- Outcomes of the Tension mini-game (§5.3, §5.4).
export type FightResult = "Landed" | "Escaped" | "Snapped" | "WeakLine"

export type MiniGameConfig = {
	zoneHalfWidth: number,
	zoneHz: number,
	zoneAmp: number,
	fillRate: number,
	requiredTension: number,
	hookWindow: number,
}

export type SpeciesConfig = {
	id: SpeciesId,
	name: string,
	rarity: RarityName,
	value: number,
	depthBand: { number },
	zone: ZoneId,
	behaviour: BehaviourType,
	liveAtStart: number,
	parts: number,
	size: Vector3,
	color: Color3,
	material: Enum.Material,
	transparency: number,
	visualCue: string,
	mini: MiniGameConfig,
	behaviourCfg: { [string]: any },
}

export type RodConfigEntry = {
	id: RodId,
	name: string,
	tier: number,
	cost: number,
	maxRarity: RarityName,
	lineStrength: number,
	zoneWidthMult: number,
	strainMult: number,
	fillMult: number,
}

export type GearConfigEntry = {
	id: GearId,
	name: string,
	tier: number,
	cost: number,
	airCapacity: number,
	depthRating: number,
}

-- One row of the Catch Log (§9): everything caught and not yet sold.
export type CatchLogEntry = {
	speciesId: SpeciesId,
	name: string,
	rarity: RarityName,
	value: number,
	count: number,
}

-- Result of SELL ALL (§6.2).
export type SellAllResult = {
	soldCount: number,
	coinsEarned: number,
	newBalance: number,
}

-- What persists per player (Modules/PlayerStore, PlayerService).
export type PlayerData = {
	schemaVersion: number,
	coins: number,
	catchLog: { CatchLogEntry },
	equippedRodId: RodId,
	equippedGearId: GearId,
}

-- Live dive readout (§9): `AIR 100s`, `DEPTH 62m`, `RATING 90m`, `GEAR RATING EXCEEDED`.
export type DiveState = {
	air: number,
	airCapacity: number,
	depth: number,
	depthRating: number,
	exceeded: boolean,
	submerged: boolean,
}

-- One shop row as the client renders it (§9: sticky cost-vs-cash comparison).
export type ShopSkuState = {
	sku: string,
	name: string,
	category: string,
	cost: number,
	affordable: boolean,
	owned: boolean,
	recommended: boolean,
	unlockLabel: string,
	-- How far short of the price the player is (§9: "grey with C 150 / 280 shown when not").
	-- 0 when the row is affordable.
	shortfall: number,
	-- The measurable effect, built from RodConfig/GearConfig at read time (§6.3: the tank is
	-- the key to depth, and the row has to say so with real numbers).
	effectLabel: string,
}

export type ShopState = {
	coins: number,
	skus: { ShopSkuState },
}

-- The §9 explainer line: "never a loss without a reason and a next step".
export type NotifyPayload = {
	text: string,
	seconds: number,
}

return {}
]]></string>
