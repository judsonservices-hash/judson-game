      <Item class="ModuleScript" referent="110">
        <Properties>
          <string name="Name">Knit</string>
          <string name="Source"><![CDATA[local RunService = game:GetService("RunService")

if RunService:IsServer() then
	return require(script.KnitServer)
else
	local KnitServer = script:FindFirstChild("KnitServer")
	if KnitServer and RunService:IsRunning() then
		KnitServer:Destroy()
	end

	return require(script.KnitClient)
end
]]></string>
        </Properties>
        <Item class="ModuleScript" referent="111">
          <Properties>
            <string name="Name">KnitClient</string>
            <string name="Source"><![CDATA[--[=[
	@interface Middleware
	.Inbound ClientMiddleware?
	.Outbound ClientMiddleware?
	@within KnitClient
]=]
type Middleware = {
	Inbound: ClientMiddleware?,
	Outbound: ClientMiddleware?,
}

--[=[
	@type ClientMiddlewareFn (args: {any}) -> (shouldContinue: boolean, ...: any)
	@within KnitClient

	For more info, see [ClientComm](https://sleitnick.github.io/RbxUtil/api/ClientComm/) documentation.
]=]
type ClientMiddlewareFn = (args: { any }) -> (boolean, ...any)

--[=[
	@type ClientMiddleware {ClientMiddlewareFn}
	@within KnitClient
	An array of client middleware functions.
]=]
type ClientMiddleware = { ClientMiddlewareFn }

--[=[
	@type PerServiceMiddleware {[string]: Middleware}
	@within KnitClient
]=]
type PerServiceMiddleware = { [string]: Middleware }

--[=[
	@interface ControllerDef
	.Name string
	.[any] any
	@within KnitClient
	Used to define a controller when creating it in `CreateController`.
]=]
type ControllerDef = {
	Name: string,
	[any]: any,
}

--[=[
	@interface Controller
	.Name string
	.[any] any
	@within KnitClient
]=]
type Controller = {
	Name: string,
	[any]: any,
}

--[=[
	@interface Service
	.[any] any
	@within KnitClient
]=]
type Service = {
	[any]: any,
}

--[=[
	@interface KnitOptions
	.ServicePromises boolean?
	.Middleware Middleware?
	.PerServiceMiddleware PerServiceMiddleware?
	@within KnitClient

	- `ServicePromises` defaults to `true` and indicates if service methods use promises.
	- Each service will go through the defined middleware, unless the service
	has middleware defined in `PerServiceMiddleware`.
]=]
type KnitOptions = {
	ServicePromises: boolean,
	Middleware: Middleware?,
	PerServiceMiddleware: PerServiceMiddleware?,
}

local defaultOptions: KnitOptions = {
	ServicePromises = true,
	Middleware = nil,
	PerServiceMiddleware = {},
}

local selectedOptions = nil

--[=[
	@class KnitClient
	@client
]=]
local KnitClient = {}

--[=[
	@prop Player Player
	@within KnitClient
	@readonly
	Reference to the LocalPlayer.
]=]
KnitClient.Player = game:GetService("Players").LocalPlayer

--[=[
	@prop Util Folder
	@within KnitClient
	@readonly
	References the Util folder. Should only be accessed when using Knit as
	a standalone module. If using Knit from Wally, modules should just be
	pulled in via Wally instead of relying on Knit's Util folder, as this
	folder only contains what is necessary for Knit to run in Wally mode.
]=]
KnitClient.Util = (script.Parent :: Instance).Parent

local Promise = require(KnitClient.Util.Promise)
local Comm = require(KnitClient.Util.Comm)
local ClientComm = Comm.ClientComm

local controllers: { [string]: Controller } = {}
local services: { [string]: Service } = {}
local servicesFolder = nil

local started = false
local startedComplete = false
local onStartedComplete = Instance.new("BindableEvent")

local function DoesControllerExist(controllerName: string): boolean
	local controller: Controller? = controllers[controllerName]

	return controller ~= nil
end

local function GetServicesFolder()
	if not servicesFolder then
		servicesFolder = (script.Parent :: Instance):WaitForChild("Services")
	end

	return servicesFolder
end

local function GetMiddlewareForService(serviceName: string)
	local knitMiddleware = if selectedOptions.Middleware ~= nil then selectedOptions.Middleware else {}
	local serviceMiddleware = selectedOptions.PerServiceMiddleware[serviceName]

	return if serviceMiddleware ~= nil then serviceMiddleware else knitMiddleware
end

local function BuildService(serviceName: string)
	local folder = GetServicesFolder()
	local middleware = GetMiddlewareForService(serviceName)
	local clientComm = ClientComm.new(folder, selectedOptions.ServicePromises, serviceName)
	local service = clientComm:BuildObject(middleware.Inbound, middleware.Outbound)

	services[serviceName] = service

	return service
end

--[=[
	Creates a new controller.

	:::caution
	Controllers must be created _before_ calling `Knit.Start()`.
	:::
	```lua
	-- Create a controller
	local MyController = Knit.CreateController {
		Name = "MyController",
	}

	function MyController:KnitStart()
		print("MyController started")
	end

	function MyController:KnitInit()
		print("MyController initialized")
	end
	```
]=]
function KnitClient.CreateController(controllerDef: ControllerDef): Controller
	assert(type(controllerDef) == "table", `Controller must be a table; got {type(controllerDef)}`)
	assert(type(controllerDef.Name) == "string", `Controller.Name must be a string; got {type(controllerDef.Name)}`)
	assert(#controllerDef.Name > 0, "Controller.Name must be a non-empty string")
	assert(not DoesControllerExist(controllerDef.Name), `Controller {controllerDef.Name} already exists`)
	assert(not started, `Controllers cannot be created after calling "Knit.Start()"`)

	local controller = controllerDef :: Controller
	controllers[controller.Name] = controller

	return controller
end

--[=[
	Requires all the modules that are children of the given parent. This is an easy
	way to quickly load all controllers that might be in a folder.
	```lua
	Knit.AddControllers(somewhere.Controllers)
	```
]=]
function KnitClient.AddControllers(parent: Instance): { Controller }
	assert(not started, `Controllers cannot be added after calling "Knit.Start()"`)

	local addedControllers = {}
	for _, v in parent:GetChildren() do
		if not v:IsA("ModuleScript") then
			continue
		end

		table.insert(addedControllers, require(v))
	end

	return addedControllers
end

--[=[
	Requires all the modules that are descendants of the given parent.
]=]
function KnitClient.AddControllersDeep(parent: Instance): { Controller }
	assert(not started, `Controllers cannot be added after calling "Knit.Start()"`)

	local addedControllers = {}
	for _, v in parent:GetDescendants() do
		if not v:IsA("ModuleScript") then
			continue
		end

		table.insert(addedControllers, require(v))
	end

	return addedControllers
end

--[=[
	Returns a Service object which is a reflection of the remote objects
	within the Client table of the given service. Throws an error if the
	service is not found.

	If a service's Client table contains RemoteSignals and/or RemoteProperties,
	these values are reflected as
	[ClientRemoteSignals](https://sleitnick.github.io/RbxUtil/api/ClientRemoteSignal) and
	[ClientRemoteProperties](https://sleitnick.github.io/RbxUtil/api/ClientRemoteProperty).

	```lua
	-- Server-side service creation:
	local MyService = Knit.CreateService {
		Name = "MyService",
		Client = {
			MySignal = Knit.CreateSignal(),
			MyProperty = Knit.CreateProperty("Hello"),
		},
	}
	function MyService:AddOne(player, number)
		return number + 1
	end

	-------------------------------------------------

	-- Client-side service reflection:
	local MyService = Knit.GetService("MyService")

	-- Call a method:
	local num = MyService:AddOne(5) --> 6

	-- Fire a signal to the server:
	MyService.MySignal:Fire("Hello")

	-- Listen for signals from the server:
	MyService.MySignal:Connect(function(message)
		print(message)
	end)

	-- Observe the initial value and changes to properties:
	MyService.MyProperty:Observe(function(value)
		print(value)
	end)
	```

	:::caution
	Services are only exposed to the client if the service has remote-based
	content in the Client table. If not, the service will not be visible
	to the client. `KnitClient.GetService` will only work on services that
	expose remote-based content on their Client tables.
	:::
]=]
function KnitClient.GetService(serviceName: string): Service
	local service = services[serviceName]
	if service then
		return service
	end

	assert(started, "Cannot call GetService until Knit has been started")
	assert(type(serviceName) == "string", `ServiceName must be a string; got {type(serviceName)}`)

	return BuildService(serviceName)
end

--[=[
	Gets the controller by name. Throws an error if the controller
	is not found.
]=]
function KnitClient.GetController(controllerName: string): Controller
	local controller = controllers[controllerName]
	if controller then
		return controller
	end

	assert(started, "Cannot call GetController until Knit has been started")
	assert(type(controllerName) == "string", `ControllerName must be a string; got {type(controllerName)}`)
	error(`Could not find controller "{controllerName}". Check to verify a controller with this name exists.`, 2)
end

--[=[
	Gets a table of all controllers.
]=]
function KnitClient.GetControllers(): { [string]: Controller }
	assert(started, "Cannot call GetControllers until Knit has been started")

	return controllers
end

--[=[
	@return Promise
	Starts Knit. Should only be called once per client.
	```lua
	Knit.Start():andThen(function()
		print("Knit started!")
	end):catch(warn)
	```

	By default, service methods exposed to the client will return promises.
	To change this behavior, set the `ServicePromises` option to `false`:
	```lua
	Knit.Start({ServicePromises = false}):andThen(function()
		print("Knit started!")
	end):catch(warn)
	```
]=]
function KnitClient.Start(options: KnitOptions?)
	if started then
		return Promise.reject("Knit already started")
	end

	started = true

	table.freeze(controllers)

	if options == nil then
		selectedOptions = defaultOptions
	else
		assert(typeof(options) == "table", `KnitOptions should be a table or nil; got {typeof(options)}`)
		selectedOptions = options
		for k, v in defaultOptions do
			if selectedOptions[k] == nil then
				selectedOptions[k] = v
			end
		end
	end
	if type(selectedOptions.PerServiceMiddleware) ~= "table" then
		selectedOptions.PerServiceMiddleware = {}
	end

	return Promise.new(function(resolve)
		-- Init:
		local promisesStartControllers = {}

		for _, controller in controllers do
			if type(controller.KnitInit) == "function" then
				table.insert(
					promisesStartControllers,
					Promise.new(function(r)
						debug.setmemorycategory(controller.Name)
						controller:KnitInit()
						r()
					end)
				)
			end
		end

		resolve(Promise.all(promisesStartControllers))
	end):andThen(function()
		-- Start:
		for _, controller in controllers do
			if type(controller.KnitStart) == "function" then
				task.spawn(function()
					debug.setmemorycategory(controller.Name)
					controller:KnitStart()
				end)
			end
		end

		startedComplete = true
		onStartedComplete:Fire()

		task.defer(function()
			onStartedComplete:Destroy()
		end)
	end)
end

--[=[
	@return Promise
	Returns a promise that is resolved once Knit has started. This is useful
	for any code that needs to tie into Knit controllers but is not the script
	that called `Start`.
	```lua
	Knit.OnStart():andThen(function()
		local MyController = Knit.GetController("MyController")
		MyController:DoSomething()
	end):catch(warn)
	```
]=]
function KnitClient.OnStart()
	if startedComplete then
		return Promise.resolve()
	else
		return Promise.fromEvent(onStartedComplete.Event)
	end
end

return KnitClient
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="112">
          <Properties>
            <string name="Name">KnitServer</string>
            <string name="Source"><![CDATA[--[=[
	@interface Middleware
	.Inbound ServerMiddleware?
	.Outbound ServerMiddleware?
	@within KnitServer
]=]
type Middleware = {
	Inbound: ServerMiddleware?,
	Outbound: ServerMiddleware?,
}

--[=[
	@type ServerMiddlewareFn (player: Player, args: {any}) -> (shouldContinue: boolean, ...: any)
	@within KnitServer

	For more info, see [ServerComm](https://sleitnick.github.io/RbxUtil/api/ServerComm/) documentation.
]=]
type ServerMiddlewareFn = (player: Player, args: { any }) -> (boolean, ...any)

--[=[
	@type ServerMiddleware {ServerMiddlewareFn}
	@within KnitServer
	An array of server middleware functions.
]=]
type ServerMiddleware = { ServerMiddlewareFn }

--[=[
	@interface ServiceDef
	.Name string
	.Client table?
	.Middleware Middleware?
	.[any] any
	@within KnitServer
	Used to define a service when creating it in `CreateService`.

	The middleware tables provided will be used instead of the Knit-level
	middleware (if any). This allows fine-tuning each service's middleware.
	These can also be left out or `nil` to not include middleware.
]=]
type ServiceDef = {
	Name: string,
	Client: { [any]: any }?,
	Middleware: Middleware?,
	[any]: any,
}

--[=[
	@interface Service
	.Name string
	.Client ServiceClient
	.KnitComm Comm
	.[any] any
	@within KnitServer
]=]
type Service = {
	Name: string,
	Client: ServiceClient,
	KnitComm: any,
	[any]: any,
}

--[=[
	@interface ServiceClient
	.Server Service
	.[any] any
	@within KnitServer
]=]
type ServiceClient = {
	Server: Service,
	[any]: any,
}

--[=[
	@interface KnitOptions
	.Middleware Middleware?
	@within KnitServer

	- Middleware will apply to all services _except_ ones that define
	their own middleware.
]=]
type KnitOptions = {
	Middleware: Middleware?,
}

local defaultOptions: KnitOptions = {
	Middleware = nil,
}

local selectedOptions = nil

--[=[
	@class KnitServer
	@server
	Knit server-side lets developers create services and expose methods and signals
	to the clients.

	```lua
	local Knit = require(somewhere.Knit)

	-- Load service modules within some folder:
	Knit.AddServices(somewhere.Services)

	-- Start Knit:
	Knit.Start():andThen(function()
		print("Knit started")
	end):catch(warn)
	```
]=]
local KnitServer = {}

--[=[
	@prop Util Folder
	@within KnitServer
	@readonly
	References the Util folder. Should only be accessed when using Knit as
	a standalone module. If using Knit from Wally, modules should just be
	pulled in via Wally instead of relying on Knit's Util folder, as this
	folder only contains what is necessary for Knit to run in Wally mode.
]=]
KnitServer.Util = (script.Parent :: Instance).Parent

local SIGNAL_MARKER = newproxy(true)
getmetatable(SIGNAL_MARKER).__tostring = function()
	return "SIGNAL_MARKER"
end

local UNRELIABLE_SIGNAL_MARKER = newproxy(true)
getmetatable(UNRELIABLE_SIGNAL_MARKER).__tostring = function()
	return "UNRELIABLE_SIGNAL_MARKER"
end

local PROPERTY_MARKER = newproxy(true)
getmetatable(PROPERTY_MARKER).__tostring = function()
	return "PROPERTY_MARKER"
end

local knitRepServiceFolder = Instance.new("Folder")
knitRepServiceFolder.Name = "Services"

local Promise = require(KnitServer.Util.Promise)
local Comm = require(KnitServer.Util.Comm)
local ServerComm = Comm.ServerComm

local services: { [string]: Service } = {}
local started = false
local startedComplete = false
local onStartedComplete = Instance.new("BindableEvent")

local function DoesServiceExist(serviceName: string): boolean
	local service: Service? = services[serviceName]

	return service ~= nil
end

--[=[
	Constructs a new service.

	:::caution
	Services must be created _before_ calling `Knit.Start()`.
	:::
	```lua
	-- Create a service
	local MyService = Knit.CreateService {
		Name = "MyService",
		Client = {},
	}

	-- Expose a ToAllCaps remote function to the clients
	function MyService.Client:ToAllCaps(player, msg)
		return msg:upper()
	end

	-- Knit will call KnitStart after all services have been initialized
	function MyService:KnitStart()
		print("MyService started")
	end

	-- Knit will call KnitInit when Knit is first started
	function MyService:KnitInit()
		print("MyService initialize")
	end
	```
]=]
function KnitServer.CreateService(serviceDef: ServiceDef): Service
	assert(type(serviceDef) == "table", `Service must be a table; got {type(serviceDef)}`)
	assert(type(serviceDef.Name) == "string", `Service.Name must be a string; got {type(serviceDef.Name)}`)
	assert(#serviceDef.Name > 0, "Service.Name must be a non-empty string")
	assert(not DoesServiceExist(serviceDef.Name), `Service "{serviceDef.Name}" already exists`)
	assert(not started, `Services cannot be created after calling "Knit.Start()"`)

	local service = serviceDef
	service.KnitComm = ServerComm.new(knitRepServiceFolder, serviceDef.Name)

	if type(service.Client) ~= "table" then
		service.Client = { Server = service }
	else
		if service.Client.Server ~= service then
			service.Client.Server = service
		end
	end

	services[service.Name] = service

	return service
end

--[=[
	Requires all the modules that are children of the given parent. This is an easy
	way to quickly load all services that might be in a folder.
	```lua
	Knit.AddServices(somewhere.Services)
	```
]=]
function KnitServer.AddServices(parent: Instance): { Service }
	assert(not started, `Services cannot be added after calling "Knit.Start()"`)

	local addedServices = {}
	for _, v in parent:GetChildren() do
		if not v:IsA("ModuleScript") then
			continue
		end

		table.insert(addedServices, require(v))
	end

	return addedServices
end

--[=[
	Requires all the modules that are descendants of the given parent.
]=]
function KnitServer.AddServicesDeep(parent: Instance): { Service }
	assert(not started, `Services cannot be added after calling "Knit.Start()"`)

	local addedServices = {}
	for _, v in parent:GetDescendants() do
		if not v:IsA("ModuleScript") then
			continue
		end

		table.insert(addedServices, require(v))
	end

	return addedServices
end

--[=[
	Gets the service by name. Throws an error if the service is not found.
]=]
function KnitServer.GetService(serviceName: string): Service
	assert(started, "Cannot call GetService until Knit has been started")
	assert(type(serviceName) == "string", `ServiceName must be a string; got {type(serviceName)}`)

	return assert(services[serviceName], `Could not find service "{serviceName}"`) :: Service
end

--[=[
	Gets a table of all services.
]=]
function KnitServer.GetServices(): { [string]: Service }
	assert(started, "Cannot call GetServices until Knit has been started")

	return services
end

--[=[
	@return SIGNAL_MARKER
	Returns a marker that will transform the current key into
	a RemoteSignal once the service is created. Should only
	be called within the Client table of a service.

	See [RemoteSignal](https://sleitnick.github.io/RbxUtil/api/RemoteSignal)
	documentation for more info.
	```lua
	local MyService = Knit.CreateService {
		Name = "MyService",
		Client = {
			-- Create the signal marker, which will turn into a
			-- RemoteSignal when Knit.Start() is called:
			MySignal = Knit.CreateSignal(),
		},
	}

	function MyService:KnitInit()
		-- Connect to the signal:
		self.Client.MySignal:Connect(function(player, ...) end)
	end
	```
]=]
function KnitServer.CreateSignal()
	return SIGNAL_MARKER
end

--[=[
	@return UNRELIABLE_SIGNAL_MARKER

	Returns a marker that will transform the current key into
	an unreliable RemoteSignal once the service is created. Should
	only be called within the Client table of a service.

	See [RemoteSignal](https://sleitnick.github.io/RbxUtil/api/RemoteSignal)
	documentation for more info.

	:::info Unreliable Events
	Internally, this uses UnreliableRemoteEvents, which allows for
	network communication that is unreliable and unordered. This is
	useful for events that are not crucial for gameplay, since the
	delivery of the events may occur out of order or not at all.

	See  the documentation for [UnreliableRemoteEvents](https://create.roblox.com/docs/reference/engine/classes/UnreliableRemoteEvent)
	for more info.
]=]
function KnitServer.CreateUnreliableSignal()
	return UNRELIABLE_SIGNAL_MARKER
end

--[=[
	@return PROPERTY_MARKER
	Returns a marker that will transform the current key into
	a RemoteProperty once the service is created. Should only
	be called within the Client table of a service. An initial
	value can be passed along as well.

	RemoteProperties are great for replicating data to all of
	the clients. Different data can also be set per client.

	See [RemoteProperty](https://sleitnick.github.io/RbxUtil/api/RemoteProperty)
	documentation for more info.

	```lua
	local MyService = Knit.CreateService {
		Name = "MyService",
		Client = {
			-- Create the property marker, which will turn into a
			-- RemoteProperty when Knit.Start() is called:
			MyProperty = Knit.CreateProperty("HelloWorld"),
		},
	}

	function MyService:KnitInit()
		-- Change the value of the property:
		self.Client.MyProperty:Set("HelloWorldAgain")
	end
	```
]=]
function KnitServer.CreateProperty(initialValue: any)
	return { PROPERTY_MARKER, initialValue }
end

--[=[
	@return Promise
	Starts Knit. Should only be called once.

	Optionally, `KnitOptions` can be passed in order to set
	Knit's custom configurations.

	:::caution
	Be sure that all services have been created _before_
	calling `Start`. Services cannot be added later.
	:::

	```lua
	Knit.Start():andThen(function()
		print("Knit started!")
	end):catch(warn)
	```
	
	Example of Knit started with options:
	```lua
	Knit.Start({
		Middleware = {
			Inbound = {
				function(player, args)
					print("Player is giving following args to server:", args)
					return true
				end
			},
		},
	}):andThen(function()
		print("Knit started!")
	end):catch(warn)
	```
]=]
function KnitServer.Start(options: KnitOptions?)
	if started then
		return Promise.reject("Knit already started")
	end

	started = true

	table.freeze(services)

	if options == nil then
		selectedOptions = defaultOptions
	else
		assert(typeof(options) == "table", `KnitOptions should be a table or nil; got {typeof(options)}`)
		selectedOptions = options
		for k, v in defaultOptions do
			if selectedOptions[k] == nil then
				selectedOptions[k] = v
			end
		end
	end

	return Promise.new(function(resolve)
		local knitMiddleware = if selectedOptions.Middleware ~= nil then selectedOptions.Middleware else {}

		-- Bind remotes:
		for _, service in services do
			local middleware = if service.Middleware ~= nil then service.Middleware else {}
			local inbound = if middleware.Inbound ~= nil then middleware.Inbound else knitMiddleware.Inbound
			local outbound = if middleware.Outbound ~= nil then middleware.Outbound else knitMiddleware.Outbound

			service.Middleware = nil

			for k, v in service.Client do
				if type(v) == "function" then
					service.KnitComm:WrapMethod(service.Client, k, inbound, outbound)
				elseif v == SIGNAL_MARKER then
					service.Client[k] = service.KnitComm:CreateSignal(k, false, inbound, outbound)
				elseif v == UNRELIABLE_SIGNAL_MARKER then
					service.Client[k] = service.KnitComm:CreateSignal(k, true, inbound, outbound)
				elseif type(v) == "table" and v[1] == PROPERTY_MARKER then
					service.Client[k] = service.KnitComm:CreateProperty(k, v[2], inbound, outbound)
				end
			end
		end

		-- Init:
		local promisesInitServices = {}
		for _, service in services do
			if type(service.KnitInit) == "function" then
				table.insert(
					promisesInitServices,
					Promise.new(function(r)
						debug.setmemorycategory(service.Name)
						service:KnitInit()
						r()
					end)
				)
			end
		end

		resolve(Promise.all(promisesInitServices))
	end):andThen(function()
		-- Start:
		for _, service in services do
			if type(service.KnitStart) == "function" then
				task.spawn(function()
					debug.setmemorycategory(service.Name)
					service:KnitStart()
				end)
			end
		end

		startedComplete = true
		onStartedComplete:Fire()

		task.defer(function()
			onStartedComplete:Destroy()
		end)

		-- Expose service remotes to everyone:
		knitRepServiceFolder.Parent = script.Parent
	end)
end

--[=[
	@return Promise
	Returns a promise that is resolved once Knit has started. This is useful
	for any code that needs to tie into Knit services but is not the script
	that called `Start`.
	```lua
	Knit.OnStart():andThen(function()
		local MyService = Knit.Services.MyService
		MyService:DoSomething()
	end):catch(warn)
	```
]=]
function KnitServer.OnStart()
	if startedComplete then
		return Promise.resolve()
	else
		return Promise.fromEvent(onStartedComplete.Event)
	end
end

return KnitServer
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="113">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Script" referent="114">
      <Properties>
        <string name="Name">DeepTide</string>
        <token name="RunContext">0</token>
        <string name="Source"><![CDATA[--!strict
--[[
	Deep Tide — server bootstrap
	Source: GDD Appendix B ("Services (server, Knit.CreateService)" — all nine must register),
	        §11 acceptance ("Knit boots with zero errors and all services in Appendix B registered").

	The only Script on the server. Order of business:
	  1. create ReplicatedStorage.DeepTide.Remotes and its 12 RemoteEvents (Appendix B)
	  2. run the config consistency check and surface any problem as a warning
	  3. register every ModuleScript in ServerScriptService.DeepTide.Services with Knit
	  4. start Knit and print exactly one boot line
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Knit = require(ReplicatedStorage.Packages.Knit)
local Configs = require(ReplicatedStorage.DeepTide.Modules.Configs)
local ConfigCheck = require(ReplicatedStorage.DeepTide.Modules.ConfigCheck)
local Remotes = require(ReplicatedStorage.DeepTide.Modules.Remotes)

local BUILD_VERSION = "0.1.0"

local DeepTide = script.Parent -- ServerScriptService.DeepTide
local Services = DeepTide:WaitForChild("Services")
local PlayerStore = require(DeepTide.Modules.PlayerStore)

Remotes.ensure()

local report = ConfigCheck.run()
for _, problem in report.problems do
	warn("[Deep Tide] config: " .. problem)
end

local serviceCount = 0
for _, child in Services:GetChildren() do
	if child:IsA("ModuleScript") then
		serviceCount += 1
	end
end

Knit.AddServices(Services)

Knit.Start():andThen(function()
	print(
		("[Deep Tide] v%s booted — %d services · %s · %d remotes · persistence: %s"):format(
			BUILD_VERSION,
			serviceCount,
			ConfigCheck.summary(report, #Configs.Fish.Order, Configs.Fish.TotalLiveAtServerStart),
			#Remotes.Names,
			PlayerStore.mode
		)
	)
end):catch(function(err: any)
	warn("[Deep Tide] Knit failed to start: " .. tostring(err))
end)
]]></string>
      </Properties>
      <Item class="Folder" referent="115">
        <Properties>
          <string name="Name">Modules</string>
        </Properties>
        <Item class="ModuleScript" referent="116">
          <Properties>
            <string name="Name">PlayerStore</string>
            <string name="Source"><![CDATA[--!strict
--[[
    Deep Tide — PlayerStore (server-side helper module, NOT a Knit service)
    Source: GDD §10 ("save persistence ... if a DataStore is added it must be a stub that
             cannot fail the loop"), §11 ("no Engine errors or warnings during a full loop").

    The slice's only persistence: a player's Coins and Catch Log.

    Design rules
      * every DataStore call is wrapped in pcall — a persistence failure can never error the loop;
      * if Studio API access is unavailable (the default) it degrades to session-only data
        and reports the mode instead of throwing;
      * to persist in Studio: Game Settings > Security > "Enable Studio Access to API Services".

    This module is intentionally outside Services/ so Knit never treats it as a service.
]]

local DataStoreService = game:GetService("DataStoreService")

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Types = require(ReplicatedStorage.DeepTide.Modules.Types)
local EconomyConfig = require(ReplicatedStorage.DeepTide.Config.EconomyConfig)
local RodConfig = require(ReplicatedStorage.DeepTide.Config.RodConfig)
local GearConfig = require(ReplicatedStorage.DeepTide.Config.GearConfig)

local PlayerStore = {}

PlayerStore.StoreName = "DeepTide_PlayerData_v1"
PlayerStore.SchemaVersion = 1

-- "session-only" | "DataStore". Read by the boot line.
PlayerStore.mode = "session-only"

local store: DataStore? = nil

local function keyFor(player: Player): string
    return ("player_%d"):format(player.UserId)
end

--- A fresh profile (§6.1: 0 C, Rusty Rod, Rubber Lungs, empty Catch Log).
function PlayerStore.defaultData(): Types.PlayerData
    return {
        schemaVersion = PlayerStore.SchemaVersion,
        coins = EconomyConfig.StartingCoins,
        catchLog = {},
        equippedRodId = EconomyConfig.StartingRodId,
        equippedGearId = EconomyConfig.StartingGearId,
    }
end

--- Probes DataStore availability once. Never throws; sets PlayerStore.mode.
function PlayerStore.init(): string
    local gotStore, result = pcall(function()
        return DataStoreService:GetDataStore(PlayerStore.StoreName)
    end)

    if not gotStore then
        PlayerStore.mode = "session-only"
        return PlayerStore.mode
    end

    store = result

    -- Studio with "Enable Studio Access to API Services" off fails here, which is the
    -- expected case, not an error.
    local probed = pcall(function()
        return (store :: DataStore):GetAsync("__deeptide_probe__")
    end)

    PlayerStore.mode = if probed then "DataStore" else "session-only"
    return PlayerStore.mode
end

--- Loads coins + catch log for a player.
--- Returns (persisted, data): `persisted` is false when the session-only fallback is
--- serving defaults, so callers can tell the difference without handling errors.
function PlayerStore.load(player: Player): (boolean, Types.PlayerData)
    local data = PlayerStore.defaultData()

    if store == nil or PlayerStore.mode ~= "DataStore" then
        return false, data
    end

    local ok, result = pcall(function()
        return (store :: DataStore):GetAsync(keyFor(player))
    end)

    if not ok or type(result) ~= "table" then
        return false, data
    end

    for field in data do
        if result[field] ~= nil then
            data[field] = result[field]
        end
    end
    data.schemaVersion = PlayerStore.SchemaVersion
    return true, data
end

--- Saves coins + catch log. Returns false when there is nothing to save to.
function PlayerStore.save(player: Player, data: Types.PlayerData): boolean
    if store == nil or PlayerStore.mode ~= "DataStore" then
        return false
    end

    local ok = pcall(function()
        (store :: DataStore):SetAsync(keyFor(player), data)
    end)

    if not ok then
        warn(("[Deep Tide] PlayerStore: save failed for %s"):format(player.Name))
    end
    return ok
end

return PlayerStore
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="Folder" referent="117">
        <Properties>
          <string name="Name">Services</string>
        </Properties>
        <Item class="ModuleScript" referent="118">
          <Properties>
            <string name="Name">DiveService</string>
            <string name="Source"><![CDATA[--!strict
--[[
    DiveService — Appendix B: "Oxygen depletion, depth tracking, the DepthRating auto-surface
    rule, air refill, underwater light blending".
    Source: GDD §3.0 (depth is -Y at the head, studs printed as "m"), §5.3 step 9 (oxygen keeps
            draining through every fight phase), §5.4 + §11 (at rating + 20 for 1.5 s the player
            is auto-surfaced, and a forced ascent never costs a banked fish), §8.1 (underwater
            lighting blend), §8.8 (the air alarm at 20 s), §9 (air and depth readouts).

    Air is a clock on the reward, not on the player: running out must never lose a banked fish.

    Who loses what when the tank empties:
      * DiveService surfaces the player and tells them (§8.8's alarm is the client's half).
      * DiveService also tells FishingService, because §5.3 step 9 makes the fight part of the
        clock: the fish that is on the line when the air runs out is lost. Nothing else is.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Knit = require(ReplicatedStorage.Packages.Knit)

local Types = require(ReplicatedStorage.DeepTide.Modules.Types)
local Remotes = require(ReplicatedStorage.DeepTide.Modules.Remotes)
local DiveConfig = require(ReplicatedStorage.DeepTide.Config.DiveConfig)
local ZoneConfig = require(ReplicatedStorage.DeepTide.Config.ZoneConfig)
local GearConfig = require(ReplicatedStorage.DeepTide.Config.GearConfig)
local LightingConfig = require(ReplicatedStorage.DeepTide.Config.LightingConfig)

local DiveService = Knit.CreateService({
    Name = "DiveService",
    Client = {},
})

local airByPlayer: { [Player]: number } = {}
local ratingHold: { [Player]: number } = {}
local underwaterBlend: { [Player]: number } = {}
local underwaterTarget: { [Player]: number } = {}
local pushAccumulator = 0

-- The head sits this far above the character's root (the offset Roblox uses for the standard
-- rigs); a forced ascent places both, because §3.0 measures depth at the head.
local HEAD_OFFSET_STUDS = 2

local function gearService(): any
    return Knit.GetService("GearService")
end

-- Resolved lazily and tolerated when absent: the dive loop drives the world's zone rule, but
-- the dive maths must still work on its own (the harness boots WorldService with it).
local cachedWorld: any = nil
local function worldService(): any?
    if cachedWorld == nil then
        local ok, service = pcall(function()
            return Knit.GetService("WorldService")
        end)
        if ok and type(service) == "table" then
            cachedWorld = service
        end
    end
    return cachedWorld
end

local function headPosition(player: Player): Vector3?
    local character = player.Character
    if character == nil then
        return nil
    end
    local head = character:FindFirstChild("Head") or character:FindFirstChild("HumanoidRootPart")
    return if head ~= nil then (head :: BasePart).Position else nil
end

local function airOf(player: Player): number
    local air = airByPlayer[player]
    if air == nil then
        air = gearService():GetAirCapacity(player)
        airByPlayer[player] = air
    end
    return air
end

-- Public server API -----------------------------------------------------------

--- Depth in studs, always positive: -Y at the player's head (§3.0).
function DiveService:GetDepth(player: Player): number
    local position = headPosition(player)
    if position == nil then
        return 0
    end
    return math.max(0, DiveConfig.SeaLevelY - position.Y)
end

--- Seconds of air left (§9: `AIR 100s`).
function DiveService:GetAir(player: Player): number
    return airOf(player)
end

function DiveService:GetAirCapacity(player: Player): number
    return gearService():GetAirCapacity(player)
end

--- Everything the HUD needs in one payload (§9): air, capacity, depth, rating, and whether
--- the rating is currently exceeded (both turn red and print `GEAR RATING EXCEEDED`).
function DiveService:GetState(player: Player): Types.DiveState
    local depth = self:GetDepth(player)
    local rating = gearService():GetDepthRating(player)
    local air = airOf(player)
    return {
        air = air,
        airCapacity = self:GetAirCapacity(player),
        depth = depth,
        depthRating = rating,
        exceeded = depth > rating,
        submerged = depth > DiveConfig.SeaLevelY,
    }
end

function DiveService:IsSubmerged(player: Player): boolean
    return self:GetDepth(player) > DiveConfig.SeaLevelY
end

--- §5.3 step 9: called by FishingService on every fight tick — oxygen drains through all
--- three phases, which is the slice's central tension.
function DiveService:DrainAir(player: Player, seconds: number)
    local air = math.max(0, airOf(player) - seconds)
    airByPlayer[player] = air
    if air <= 0 then
        self:ForceSurface(player, "outOfAir")
    end
end

--- §1 step 7: air refills over SurfaceRefillSeconds at the surface, with a visible refill.
function DiveService:RefillAir(player: Player)
    airByPlayer[player] = self:GetAirCapacity(player)
end

--- §6.3: the Reinforced Tank immediately becomes AIR 300s — a bigger tank arrives full.
function DiveService:ApplyGearCapacity(player: Player)
    airByPlayer[player] = self:GetAirCapacity(player)
    self:_Push(player)
end

--- Losing the tank's air: the player is put back at the surface, the reason is named (§9: never a
--- loss without a reason), and the fish on the line is lost — nothing banked is ever lost (§11).
---
--- The rating wall is a *different* loss from a broken line and has to read like one: it prints
--- `GEAR RATING EXCEEDED — RATING 90m — SURFACED` (the number the HUD is already showing) plus
--- the tier that opens the deeper water, so the player leaves knowing what to buy. Nothing in
--- this path may ever say "CAST BROKE" or "LINE TOO WEAK" (§5.4 is the rod's failure, not this).
function DiveService:ForceSurface(player: Player, kind: string)
    local position = headPosition(player)
    if position ~= nil then
        local character = player.Character
        local root = if character ~= nil then character:FindFirstChild("HumanoidRootPart") else nil
        local target = Vector3.new(position.X, DiveConfig.SeaLevelY + DiveConfig.ForceSurfaceHeightStuds, position.Z)
        -- The ascent moves the player; it must not turn them. `CFrame.new(target)` carries the
        -- identity rotation, so writing it straight to the root snapped the avatar's facing to
        -- world -Z — a 180 deg flip for a diver swimming +Z, which is the direction the whole loop
        -- faces — and the swim/run controller then visibly swung the rig back. Keep the yaw the
        -- character already has (the root's LookVector is what a rig reports, in game and in rigs).
        local yaw = 0
        if root ~= nil then
            local facing = (root :: BasePart).CFrame.LookVector
            yaw = math.atan2(-facing.X, -facing.Z)
        end
        if root ~= nil then
            (root :: BasePart).CFrame = CFrame.new(target) * CFrame.Angles(0, yaw, 0)
        end
        -- §3.0 reads depth at the head, so the head lands on the surface with the root. Roblox
        -- welds the head to the root and does this by itself; saying it explicitly keeps the
        -- readout and the character in agreement everywhere, including in the headless rig, which
        -- moves the two parts independently.
        local head = if character ~= nil then character:FindFirstChild("Head") else nil
        if head ~= nil then
            (head :: BasePart).CFrame = CFrame.new(target + Vector3.new(0, HEAD_OFFSET_STUDS, 0))
                * CFrame.Angles(0, yaw, 0)
        end
    end

    ratingHold[player] = 0
    airByPlayer[player] = self:GetAirCapacity(player)
    self:_Push(player)

    local message = self:ForceSurfaceMessage(player, kind)
    if message ~= nil then
        Remotes.get("Notify"):FireClient(player, { text = message, seconds = DiveConfig.RatingWarningHoldTime })
    end

    if kind == "outOfAir" then
        -- §5.3 step 9: the tank is a clock on the reward, so the fight it interrupted is lost.
        Knit.GetService("FishingService"):LoseToOutOfAir(player)
    end
end

--- The cheapest gear tier deeper than what this player is wearing (§6.3/§6.5: the tank comes
--- first, and it is the answer to this wall). nil when the player already holds the deepest.
local function nextGearTier(player: Player): Types.GearConfigEntry?
    local current = gearService():GetGearStats(player)
    local best: Types.GearConfigEntry? = nil
    for _, gearId in GearConfig.Order do
        local gear = GearConfig.Gear[gearId]
        if gear ~= nil and gear.depthRating > current.depthRating then
            if best == nil or gear.cost < best.cost then
                best = gear
            end
        end
    end
    return best
end

--- The line a forced ascent prints (§9), built from DiveConfig's formats and — for the rating
--- case — the player's own gear rating plus the deeper tier's name, rating and cost out of
--- GearConfig. Every number is read, never typed.
function DiveService:ForceSurfaceMessage(player: Player, kind: string): string?
    if kind ~= "rating" then
        return DiveConfig.ForceSurfaceMessages[kind]
    end

    local rating = gearService():GetDepthRating(player)
    local deeper = nextGearTier(player)
    if deeper == nil then
        return DiveConfig.ForceSurfaceMessages.rating:format(rating)
    end
    return DiveConfig.ForceSurfaceMessages.ratingWithUpgradeFormat:format(
        rating,
        string.upper(deeper.name),
        deeper.depthRating,
        deeper.cost
    )
end

--- §5.4 + §11: at DepthRating + RatingWarningMargin for RatingWarningHoldTime the player is
--- auto-surfaced with the rating warning. Returns true when the ascent was forced.
--- The ascent itself must never cost a banked catch (§11).
--- `dt` is the seconds this call stands for; it defaults to one step of the §9 push rate, so the
--- 1.5 s window is measured in real seconds even if a frame is long.
function DiveService:EnforceDepthRating(player: Player, dt: number?): boolean
    local step = dt or (1 / DiveConfig.StatePushHz)
    local depth = self:GetDepth(player)
    local limit = gearService():GetDepthRating(player) + DiveConfig.RatingWarningMargin

    if depth <= limit then
        ratingHold[player] = 0
        return false
    end

    local held = (ratingHold[player] or 0) + step
    ratingHold[player] = held
    if held >= DiveConfig.RatingWarningHoldTime then
        ratingHold[player] = 0
        self:ForceSurface(player, "rating")
        return true
    end
    return false
end

--- §8.1/§3.0: blend the underwater preset in over UnderwaterFadeSeconds when the camera crosses sea
--- level. The values are LightingConfig.UnderwaterGrade (§8.1's numbers, moved out of this file);
--- the fade is the design's, and it is a fade rather than a switch (§8.1: "The transition must be a
--- fade, never a snap").
---
--- The effect is created on the first call and then *driven* by StepUnderwaterVisuals once per step,
--- not destroyed and recreated — a destroy/create pair is exactly the snap §8.1 forbids.
function DiveService:SetUnderwaterVisuals(player: Player, underwater: boolean)
    underwaterTarget[player] = if underwater then 1 else 0

    local character = player.Character
    local head = if character ~= nil then character:FindFirstChild("Head") else nil
    if head == nil then
        return
    end
    local effect = (head :: Instance):FindFirstChild(LightingConfig.UnderwaterGrade.name)
    if effect == nil then
        local created: any = Instance.new("ColorCorrectionEffect")
        created.Name = LightingConfig.UnderwaterGrade.name
        local above = LightingConfig.UnderwaterGrade.above
        created.TintColor = above.tint
        created.Contrast = above.contrast
        created.Saturation = above.saturation
        created.Brightness = above.brightness
        created.Parent = head
    end
end

--- The fade itself: one step of the §8.1 cross-fade, driven from the existing dive loop (which
--- already runs at DiveConfig.StatePushHz and already knows whether the player is submerged), so the
--- fade costs one instance-property write per step and no extra loop, no `task.wait`, no timer.
function DiveService:StepUnderwaterVisuals(player: Player, dt: number)
    local target = underwaterTarget[player]
    if target == nil then
        return
    end
    local grade = LightingConfig.UnderwaterGrade
    local under = grade.under or grade
    local current = underwaterBlend[player]

    if current == nil then
        -- First sight of this player: start where they are (no fade on join — a join is not a dive).
        underwaterBlend[player] = target
        current = target
    end

    if current ~= target then
        local step = dt / math.max(DiveConfig.UnderwaterFadeSeconds, 0.01)
        current = if current < target then math.min(target, current + step) else math.max(target, current - step)
        underwaterBlend[player] = current
    end

    local character = player.Character
    local head = if character ~= nil then character:FindFirstChild("Head") else nil
    local effect = if head ~= nil then (head :: Instance):FindFirstChild(grade.name) else nil
    if effect == nil then
        return
    end

    local above = grade.above
    local function mix(a: number, b: number): number
        return a + (b - a) * current
    end
    local function mixColor(a: Color3, b: Color3): Color3
        return Color3.fromRGB(mix(a.R * 255, b.R * 255), mix(a.G * 255, b.G * 255), mix(a.B * 255, b.B * 255))
    end

    local target_grade: any = effect
    target_grade.TintColor = mixColor(above.tint, under.tint)
    target_grade.Saturation = mix(above.saturation, under.saturation)
    target_grade.Contrast = mix(above.contrast, under.contrast)
    target_grade.Brightness = mix(above.brightness, under.brightness)
    return current
end

function DiveService:_Push(player: Player)
    Remotes.get("DiveStateChanged"):FireClient(player, self:GetState(player))
end

--- One step of the air clock. Called from Heartbeat at DiveConfig.StatePushHz; the harness calls
--- it with a fixed dt. `dt` seconds of air per second submerged (§11: exactly 1 s per second).
--- It also drives §3.1/§3.3's zone-entry rule, so the world needs no second per-player loop.
function DiveService:_Step(dt: number)
    for _, player in game:GetService("Players"):GetPlayers() do
        local submerged = self:IsSubmerged(player)
        local capacity = self:GetAirCapacity(player)

        if submerged then
            airByPlayer[player] = math.max(0, airOf(player) - dt)
            if airOf(player) <= 0 then
                self:ForceSurface(player, "outOfAir")
            end
            self:SetUnderwaterVisuals(player, true)
        else
            local refillRate = capacity / math.max(DiveConfig.SurfaceRefillSeconds, 0.01)
            airByPlayer[player] = math.min(capacity, airOf(player) + refillRate * dt)
            -- §1 step 7: nothing is lost by surfacing, and the tank comes back in ≤3 s.
            self:SetUnderwaterVisuals(player, false)
        end

        -- §8.1: one step of the 1.5 s cross-fade, on the same loop that already knows whether this
        -- player is submerged. The two calls above only set the target; this moves toward it.
        self:StepUnderwaterVisuals(player, dt)

        self:EnforceDepthRating(player, dt)

        -- §3.1/§3.3/§9: which zone is this player in, and does their gear open it? The world
        -- owns the rule; the dive loop is merely the clock that asks.
        local world = worldService()
        if world ~= nil then
            world:UpdateZone(player)
        end
    end

    pushAccumulator += dt
    if pushAccumulator >= 1 / DiveConfig.StatePushHz then
        pushAccumulator = 0
        for _, player in game:GetService("Players"):GetPlayers() do
            self:_Push(player)
        end
    end
end

function DiveService:ReleasePlayer(player: Player)
    airByPlayer[player] = nil
    ratingHold[player] = nil
    underwaterBlend[player] = nil
    underwaterTarget[player] = nil
end

-- Client surface -------------------------------------------------------------

function DiveService.Client:GetState(player: Player): Types.DiveState
    return self.Server:GetState(player)
end

-- Knit lifecycle --------------------------------------------------------------

function DiveService:KnitInit()
    game:GetService("Players").PlayerAdded:Connect(function(player)
        airByPlayer[player] = nil -- filled to capacity on first read
    end)

    game:GetService("Players").PlayerRemoving:Connect(function(player)
        self:ReleasePlayer(player)
    end)
end

function DiveService:KnitStart()
    local accumulator = 0
    local stepSeconds = 1 / DiveConfig.StatePushHz

    RunService.Heartbeat:Connect(function(dt: number)
        accumulator += dt
        if accumulator < stepSeconds then
            return
        end
        local step = accumulator
        accumulator = 0
        local ok, err = pcall(function()
            DiveService:_Step(step)
        end)
        if not ok then
            warn("[Deep Tide] DiveService step failed: " .. tostring(err))
        end
    end)

    -- Boot line: the two readouts §9 pairs, straight from GearConfig (§6.3).
    local GearConfig = require(ReplicatedStorage.DeepTide.Config.GearConfig)
    local lungs = GearConfig.Gear[GearConfig.Order[1]]
    local tank = GearConfig.Gear[GearConfig.Order[#GearConfig.Order]]
    print(
        ("[Deep Tide] dive: air %ds -> %ds, rating %dm -> %dm, %.0f Hz"):format(
            lungs.airCapacity,
            tank.airCapacity,
            lungs.depthRating,
            tank.depthRating,
            DiveConfig.StatePushHz
        )
    )
end

return DiveService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="119">
          <Properties>
            <string name="Name">EconomyService</string>
            <string name="Source"><![CDATA[--!strict
--[[
    EconomyService — Appendix B: "Coins, sell-all, purchase validation, the single source of
    truth for player balance".
    Source: GDD §6.1 (starting cash 0 C), §6.2 (sell values, SELL ALL), §6.3 (the 280 C and
            750 C purchases), §9 (cash readout, income animates), §11 (SELL ALL pays exactly
            the §6.2 table, a forced ascent never costs a banked fish).

    Every Coin in the game moves through this service. Coins are integers only (§6).

    The rule this file exists to keep: a transaction either happens completely or not at all.
    Selling pays the exact FishConfig sum for every logged fish and only then clears the log;
    spending is checked before it is applied. Nothing here may credit a wrong sum, silently
    drop a fish, or leave a half-finished purchase behind.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Knit = require(ReplicatedStorage.Packages.Knit)

local Types = require(ReplicatedStorage.DeepTide.Modules.Types)
local Remotes = require(ReplicatedStorage.DeepTide.Modules.Remotes)
local EconomyConfig = require(ReplicatedStorage.DeepTide.Config.EconomyConfig)

local EconomyService = Knit.CreateService({
	Name = "EconomyService",
	Client = {},
})

local function playerService(): any
	return Knit.GetService("PlayerService")
end

local function inventoryService(): any
	return Knit.GetService("InventoryService")
end

--- Coins are integers (§6) and never negative: this is the only place a balance is read from
--- the profile, so nothing downstream has to defend against a nil or a fractional balance.
local function balanceOf(player: Player): number
	local data = playerService():GetData(player)
	if data == nil or type(data.coins) ~= "number" then
		return EconomyConfig.StartingCoins
	end
	return math.max(0, math.floor(data.coins))
end

local function fire(remoteName: string, player: Player, ...)
	Remotes.get(remoteName):FireClient(player, ...)
end

-- Public server API -----------------------------------------------------------

--- Current balance (§9: `C 295`, top-right, always).
function EconomyService:GetCoins(player: Player): number
	return balanceOf(player)
end

--- Adds (or subtracts, with a negative amount) and fires CoinsChanged (§9: the delta
--- animates into the counter). Returns the new balance. Clamped at 0 — a balance can never
--- go negative, so an unaffordable spend can never be expressed as a debt.
function EconomyService:AddCoins(player: Player, amount: number, reason: string?): number
	local data = playerService():GetData(player)
	local before = balanceOf(player)
	local delta = math.floor(amount or 0)
	if data == nil or delta == 0 then
		return before
	end

	local after = math.max(0, before + delta)
	data.coins = after

	-- The HUD animates the true delta, not the requested one, so a clamped spend still reads
	-- honestly on screen.
	fire("CoinsChanged", player, after, after - before)
	if reason ~= nil then
		print(("[Deep Tide] economy: %s %+d C (%s)"):format(player.Name, after - before, reason))
	end
	return after
end

function EconomyService:CanAfford(player: Player, cost: number): boolean
	return balanceOf(player) >= math.max(0, math.floor(cost))
end

--- Spend cost Coins atomically. false (with nothing changed) when unaffordable — the
--- shop must never silently fail a purchase (§9).
function EconomyService:TrySpend(player: Player, cost: number): boolean
	local price = math.max(0, math.floor(cost))
	if not self:CanAfford(player, price) then
		return false
	end
	if price == 0 then
		return true
	end
	self:AddCoins(player, -price, "spend")
	return true
end

--- SELL ALL at the Tide Trader (§6.2): pays exactly the FishConfig values for every
--- logged catch, then clears the log. No haggling, no fluctuation, no cooldown.
---
--- Both the count and the sum are taken from InventoryService, which derives them from the
--- fish table the Catch Log's running `TOTAL` is drawn from — so the number the player read
--- and the coins they receive cannot disagree. The log is cleared only after the payment has
--- landed, so no fish is ever dropped without payment.
function EconomyService:SellAll(player: Player): Types.SellAllResult
	local inventory = inventoryService()

	local soldCount = inventory:GetFishCount(player)
	local coinsEarned = inventory:GetTotalCoins(player)

	if soldCount > 0 then
		self:AddCoins(player, coinsEarned, "sellAll")
		inventory:Clear(player)
		fire("Notify", player, {
			text = EconomyConfig.SellAllMessage.soldFormat:format(soldCount, coinsEarned),
			seconds = EconomyConfig.SellAllMessage.seconds,
		})
	else
		fire("Notify", player, {
			text = EconomyConfig.SellAllMessage.emptyFormat,
			seconds = EconomyConfig.SellAllMessage.seconds,
		})
	end

	return {
		soldCount = soldCount,
		coinsEarned = coinsEarned,
		newBalance = self:GetCoins(player),
	}
end

-- Client surface -------------------------------------------------------------

--- Initial balance so the HUD can draw before the first CoinsChanged arrives (§9).
function EconomyService.Client:GetCoins(player: Player): number
	return self.Server:GetCoins(player)
end

-- Knit lifecycle --------------------------------------------------------------

function EconomyService:KnitInit()
	-- CoinsChanged is fired by AddCoins: the push stays on the server, so the client can never
	-- disagree with the true balance. The only thing left to do at join is tell the player what
	-- they are holding (a rejoining player's last balance is already in the profile by then).
	game:GetService("Players").PlayerAdded:Connect(function(player)
		task.defer(function()
			if playerService():IsLoaded(player) then
				fire("CoinsChanged", player, self:GetCoins(player), 0)
			end
		end)
	end)
end

function EconomyService:KnitStart() end

return EconomyService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="120">
          <Properties>
            <string name="Name">FishService</string>
            <string name="Source"><![CDATA[--!strict
--[[
    FishService — Appendix B: "Owns fish spawning, the 20 Hz movement loop, behaviour state
    machines (§4.3), despawn/respawn timers".
    Source: GDD §4 (fish are single primitives with Attributes), §4.3 (the five behaviour
            rules), §4.5 (spawn/despawn/respawn rules), §4.6 (fixed coordinates),
            §11 (48/10/6/7/3 = 74 live at server start; no Shelf fish visible from the dock).

    Every fish is a non-collidable Part parented to Workspace.DeepTide.Fish, moved by the server
    at FishConfig.SpawnRules.MovementHz; clients interpolate. Coordinates come from SpawnConfig
    (through the §4.6 spawn anchors WorldService builds); timings from FishConfig — never from
    this file.

    Where the fish live (the one contract with the world):
        Workspace.DeepTide.Spawns.<Species>/<Species>_AnchorHost
            Attachment <Node|Den>_<n>   -- one per §4.6 coordinate
    If those anchors do not exist (a server booted without the world) the service falls back to
    SpawnConfig's coordinates rather than spawning nothing.

    Determinism: every "random" value §4.3 asks for comes from one seeded Rng
    (FishConfig.SpawnRules.RandomSeed), consumed in a fixed order, so a run is reproducible and
    the loop can be tested headlessly — see tools/worldtest/fish_harness.luau.

    Divergence from §4 (flagged, deliberate): §4 says fish are `Anchored = false`. They are
    anchored here. An unanchored part in Roblox Terrain water is buoyant — it rises to the
    surface — so an unanchored Ghost Ray at 210 studs cannot stay there. Fish are
    server-authoritative parts, exactly as §4 asks, and the anchor is only how that is enforced.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Knit = require(ReplicatedStorage.Packages.Knit)

local FishConfig = require(ReplicatedStorage.DeepTide.Config.FishConfig)
local SpawnConfig = require(ReplicatedStorage.DeepTide.Config.SpawnConfig)
local ZoneConfig = require(ReplicatedStorage.DeepTide.Config.ZoneConfig)
local FightConfig = require(ReplicatedStorage.DeepTide.Config.FightConfig)
local Rng = require(ReplicatedStorage.DeepTide.Modules.Rng)

local FishService = Knit.CreateService({
    Name = "FishService",
})

local ROOT_NAME = "DeepTide"
local FISH_FOLDER = "Fish"
local SPAWNS_FOLDER = "Spawns"

-- §5.1 step 1 / §5.2 step 3: states a fish cannot be cast at. "Fleeing" covers the §4.3 flight
-- of every species, "Lunging" is the eel mid-attack, and the hooked states belong to FishingService.
local UNCASTABLE_STATES: { [string]: boolean } = {
    Fleeing = true,
    Lunging = true,
    Hooked_Pending = true,
    Fighting = true,
    Landed = true,
    Despawning = true,
}

-- §4: "Each fish carries Attributes: Species, Rarity, Value, State, HomeNode."
local ATTRIBUTE_KEYS = { "Species", "Rarity", "Value", "State", "HomeNode" }

export type FishRecord = {
    index: number, -- stable spawn order, 1..FishConfig.TotalLiveAtServerStart
    speciesId: string,
    species: any, -- FishConfig.Species entry
    nodeIndex: number, -- 1-based anchor ordinal
    homeNode: string, -- "<Species>/<NodeName>" (§4 attribute value)
    home: Vector3, -- the §4.6 coordinate the fish belongs to
    part: BasePart?,
    lure: BasePart?,
    trim: BasePart?, -- §4.2's visual cue, a child of the body part (see applyVisualCue)
    cueLight: PointLight?, -- the cue's own light (§8.6), for the species whose cue carries one
    alive: boolean,
    state: string,
    position: Vector3,
    velocity: Vector3,
    -- shared school anchor
    anchorKey: string?,
    orbitOffset: Vector3,
    swimSpeed: number,
    -- patrol
    waypoints: { Vector3 },
    waypointIndex: number,
    legElapsed: number,
    legDuration: number,
    legFrom: Vector3,
    -- ambush
    denPosition: Vector3,
    denFacing: Vector3,
    -- flee / lunge
    fleeSpeed: number,
    fleeTimer: number,
    fleeDirection: Vector3,
    fleeRespawnDelay: number?,
    fleeRespawnWander: boolean,
    fleeIsFight: boolean, -- true = a lost-fight flight (FishingService), false = the §4.3 pattern
    settleTimer: number, -- §4.3 Reef Bass: drift before it is approachable again
    -- bookkeeping
    eligibilityTimer: number,
    respawnTimer: number,
    awaySeconds: number,
    spawnCooldown: number,
    clock: number, -- per-fish phase clock, drives sway/bob
}

type SchoolAnchor = {
    position: Vector3,
    target: Vector3,
    pause: number,
    fleeTimer: number,
    fleeDirection: Vector3,
}

local records: { FishRecord } = {}
local byPart: { [BasePart]: FishRecord } = {}
local schoolAnchors: { [string]: SchoolAnchor } = {}
local loopConnection: RBXScriptConnection? = nil
local rng = Rng.new(FishConfig.SpawnRules.RandomSeed)
local spawnSequence = 0

-- ============================================================================
-- Small helpers
-- ============================================================================

local function fishFolder(): Instance
    local root = Workspace:FindFirstChild(ROOT_NAME)
    if root == nil then
        local created = Instance.new("Folder")
        created.Name = ROOT_NAME
        created.Parent = Workspace
        root = created
    end
    local folder = (root :: Instance):FindFirstChild(FISH_FOLDER)
    if folder == nil then
        local created = Instance.new("Folder")
        created.Name = FISH_FOLDER
        created.Parent = root
        folder = created
    end
    return folder :: Instance
end

--- Depth in studs below sea level (§3.0), positive.
local function depthOf(position: Vector3): number
    return math.max(0, ZoneConfig.SeaLevelY - position.Y)
end

--- §4.2/§4.5: a fish's depth must stay inside its species band, and inside its zone's footprint.
--- This is what makes "no Shelf fish can be found at less than 110 studs" (§4.5) a property of
--- the system rather than of the spawn coordinates happening to be deep enough.
local function clampToBand(species: any, position: Vector3): Vector3
    local band = species.depthBand
    local topY = -band[1]
    local bottomY = -band[2]

    local y = math.clamp(position.Y, bottomY, topY)

    local zone = ZoneConfig.Zones[species.zone]
    local x, z = position.X, position.Z
    if zone ~= nil then
        local footprint = zone.footprint
        x = math.clamp(x, footprint.minX, footprint.maxX)
        z = math.clamp(z, footprint.minZ, footprint.maxZ)
    end

    return Vector3.new(x, y, z)
end

--- The seabed surface a species should be floated above when the GDD says "snapped to seabed
--- + 4 studs" (§4.3, Sunset Grouper). Read from ZoneConfig — the same table WorldService builds
--- the seabed from — so it can never drift from the geometry.
local function seabedTopY(species: any, position: Vector3): number
    local spec = ZoneConfig.Seabed[species.zone]
    if spec == nil then
        return position.Y
    end
    if type(spec.topY) == "number" then
        return spec.topY :: number
    end
    local tops = spec.topYs
    if tops == nil then
        return position.Y
    end
    local footprint = ZoneConfig.Zones[species.zone].footprint
    local cellZ = spec.cellSize.Z
    local originZ = (footprint.minZ + footprint.maxZ) / 2 - (#tops * cellZ) / 2
    local row = math.clamp(math.floor((position.Z - originZ) / cellZ) + 1, 1, #tops)
    return tops[row]
end

local function playerPositions(): { Vector3 }
    local out: { Vector3 } = {}
    local players = game:GetService("Players"):GetPlayers()
    for _, player in players do
        local character = player.Character
        local root = if character ~= nil then character:FindFirstChild("HumanoidRootPart") else nil
        if root ~= nil then
            table.insert(out, (root :: BasePart).Position)
        end
    end
    return out
end

--- (distance, player position) of the closest player to `position`; nil when nobody is in.
local function nearestPlayer(position: Vector3, positions: { Vector3 }): (number?, Vector3?)
    local bestDistance: number? = nil
    local bestPosition: Vector3? = nil
    for _, other in positions do
        local distance = (other - position).Magnitude
        if bestDistance == nil or distance < bestDistance then
            bestDistance = distance
            bestPosition = other
        end
    end
    return bestDistance, bestPosition
end

local function unitOr(offset: Vector3, fallback: Vector3): Vector3
    local magnitude = offset.Magnitude
    if magnitude < 1e-4 then
        return fallback
    end
    return offset / magnitude
end

local function nodeRadius(species: any): number
    local cfg = species.behaviourCfg
    return cfg.radius or cfg.driftRadius or cfg.anchorRadius or 0
end

-- ============================================================================
-- Spawn anchors (§4.6, built by WorldService)
-- ============================================================================

--- The §4.6 coordinates for a species, in anchor order: the Attachments WorldService built when
--- they are there, SpawnConfig when they are not. Returns positions and their node names.
local function anchorPositions(speciesId: string): ({ Vector3 }, { string })
    local positions: { Vector3 } = {}
    local names: { string } = {}

    local root = Workspace:FindFirstChild(ROOT_NAME)
    local spawns = if root ~= nil then (root :: Instance):FindFirstChild(SPAWNS_FOLDER) else nil
    local speciesFolder = if spawns ~= nil then (spawns :: Instance):FindFirstChild(speciesId) else nil
    local host = if speciesFolder ~= nil then speciesFolder:FindFirstChild(("%s_AnchorHost"):format(speciesId)) else nil

    if host ~= nil then
        for _, child in (host :: Instance):GetChildren() do
            if child:IsA("Attachment") then
                table.insert(positions, (child :: Attachment).WorldPosition)
                table.insert(names, tostring((child :: Attachment):GetAttribute("NodeName") or child.Name))
            end
        end
    end

    if #positions == 0 then
        local config = (SpawnConfig :: any)[speciesId]
        local list = if config ~= nil then (config.anchors or config.nodes or config.dens) else nil
        for index, position in (list or {}) do
            table.insert(positions, position)
            local prefix = if speciesId == "LanternEel" then "Den" else "Node"
            table.insert(names, ("%s_%d"):format(prefix, index))
        end
    end

    return positions, names
end

-- ============================================================================
-- Fish instances
-- ============================================================================

local function stampAttributes(rec: FishRecord)
    local part = rec.part
    if part == nil then
        return
    end
    part:SetAttribute("Species", rec.speciesId)
    part:SetAttribute("Rarity", rec.species.rarity)
    part:SetAttribute("Value", rec.species.value)
    part:SetAttribute("State", rec.state)
    part:SetAttribute("HomeNode", rec.homeNode)
end

--- §4.2's per-species visual cue, built from `species.visual` (FishConfig) — the silhouette/colour
--- read that lets a player name a fish at distance against its own depth band, and the §8.6 light
--- that is the tell for the two Shelf species.
---
--- Shape of the hook, deliberately: ONE extra part per fish, as a child of the body part. A child
--- is destroyed with its parent, so the despawn path needs no new code and can never leak parts;
--- a sibling in the Fish folder would have to be tracked, moved and cleaned up separately.
--- Nothing about behaviour, spawn, movement or the catch rules is touched by this function.
local function applyVisualCue(rec: FishRecord, species: any)
    local visual = species.visual
    local part = rec.part
    if visual == nil or part == nil then
        return
    end

    local trimSpec = visual.trim
    if trimSpec ~= nil then
        local trim = Instance.new("Part")
        trim.Name = part.Name .. "_Cue"
        trim.Shape = Enum.PartType.Block
        trim.Size = trimSpec.size
        trim.Color = trimSpec.color
        trim.Material = Enum.Material.Neon
        trim.Transparency = trimSpec.transparency
        trim.Anchored = true
        trim.CanCollide = false
        trim.CanQuery = false -- a cast must never land on the cue instead of the fish
        trim.CanTouch = false
        trim.CastShadow = false
        trim.TopSurface = Enum.SurfaceType.Smooth
        trim.BottomSurface = Enum.SurfaceType.Smooth
        trim.CFrame = part.CFrame * CFrame.new(trimSpec.offset)
        -- Parented to the body: it follows the body through writeTransform and dies with it.
        trim.Parent = part
        trim:SetAttribute("Species", species.id)
        trim:SetAttribute("VisualCue", trimSpec.placement)
        rec.trim = trim
    end

    local lightSpec = visual.light
    if lightSpec ~= nil and lightSpec.color ~= nil and rec.trim ~= nil then
        -- The Ghost Ray's own edge light (§8.6). The eel's light rides its lure, built above.
        if species.accent == nil or species.accent.placement ~= "lure" then
            local light = Instance.new("PointLight")
            light.Name = "CueLight"
            light.Color = lightSpec.color
            light.Brightness = lightSpec.brightness
            light.Range = lightSpec.range
            light.Shadows = false
            light.Parent = rec.trim
            rec.cueLight = light
        end
    end
end

--- Builds (or rebuilds) one fish's Part at its home node. §4.2: one primitive, config's size,
--- colour, material and transparency; the Lantern Eel gets its §4.2 lure as a second neon Part.
local function spawnRecord(rec: FishRecord)
    local species = rec.species
    local start = if rec.state == "Fleeing" then rec.position else rec.home
    local position = clampToBand(species, start)

    local part = Instance.new("Part")
    part.Name = ("%s_%d"):format(rec.speciesId, rec.index)
    part.Shape = Enum.PartType.Block
    part.Size = species.size
    part.Color = species.color
    part.Material = species.material
    part.Transparency = species.transparency
    part.Anchored = true -- see the file header: Terrain water floats unanchored parts
    part.CanCollide = false
    part.CanQuery = false
    part.CanTouch = false
    part.CastShadow = false
    part.TopSurface = Enum.SurfaceType.Smooth
    part.BottomSurface = Enum.SurfaceType.Smooth
    part.CFrame = CFrame.new(position)
    part.Parent = fishFolder()

    rec.part = part
    rec.position = position
    rec.velocity = Vector3.zero
    rec.alive = true
    rec.state = "Idle"
    rec.clock = rng:range(0, 10)
    rec.eligibilityTimer = 0
    rec.awaySeconds = 0
    rec.settleTimer = 0
    rec.fleeTimer = 0
    rec.spawnCooldown = FishConfig.SpawnRules.SpawnBurstIntervalSeconds
    rec.waypointIndex = 1
    rec.legElapsed = 0
    if rec.waypoints[1] ~= nil then
        rec.legFrom = rec.position
    end

    if species.accent ~= nil and species.accent.placement == "lure" then
        local lure = Instance.new("Part")
        lure.Name = part.Name .. "_Lure"
        lure.Shape = Enum.PartType.Ball
        lure.Size = species.accent.lureSize or Vector3.new(0.9, 0.9, 0.9)
        lure.Color = species.accent.color
        lure.Material = Enum.Material.Neon
        lure.Anchored = true
        lure.CanCollide = false
        lure.CanQuery = false
        lure.CanTouch = false
        lure.CastShadow = false
        lure.CFrame = CFrame.new(position + rec.denFacing * (species.size.X / 2 + 1))
        lure.Parent = fishFolder()
        -- §8.6: the lure is the eel's tell in the dark. Its colour and its intensity come from the
        -- species' `visual.light` (FishConfig), so the one thing a player navigates by in the Shelf
        -- is not a literal buried in this file.
        local lightSpec = if species.visual ~= nil then species.visual.light else nil
        local light = Instance.new("PointLight")
        light.Color = if lightSpec ~= nil then lightSpec.color else species.accent.color
        light.Brightness = if lightSpec ~= nil then lightSpec.brightness else 1
        light.Range = if lightSpec ~= nil then lightSpec.range else 12
        light.Shadows = false
        light.Parent = lure
        rec.lure = lure
    end

    applyVisualCue(rec, species)
    byPart[part] = rec
    stampAttributes(rec)
end

local function despawnRecord(rec: FishRecord)
    if rec.part ~= nil then
        byPart[rec.part] = nil
        rec.part:Destroy() -- the §4.2 cue is a child of this part, so it goes with it
        rec.part = nil
    end
    rec.trim = nil
    rec.cueLight = nil
    if rec.lure ~= nil then
        rec.lure:Destroy()
        rec.lure = nil
    end
    rec.alive = false
    rec.state = "Despawning"
    rec.spawnCooldown = FishConfig.SpawnRules.SpawnBurstIntervalSeconds
end

--- A brand new fish record for one §4.6 anchor slot. `member` distinguishes the 6 sardines that
--- share one school anchor.
local function makeRecord(
    index: number,
    speciesId: string,
    nodeIndex: number,
    nodeName: string,
    home: Vector3,
    member: number
): FishRecord
    local species = FishConfig.Species[speciesId]
    local cfg = species.behaviourCfg

    local rec: FishRecord = {
        index = index,
        speciesId = speciesId,
        species = species,
        nodeIndex = nodeIndex,
        homeNode = ("%s/%s"):format(speciesId, nodeName),
        home = home,
        part = nil,
        lure = nil,
        trim = nil,
        cueLight = nil,
        alive = false,
        state = "Idle",
        position = home,
        velocity = Vector3.zero,
        anchorKey = nil,
        orbitOffset = Vector3.zero,
        swimSpeed = 0,
        waypoints = {},
        waypointIndex = 1,
        legElapsed = 0,
        legDuration = 0,
        legFrom = home,
        denPosition = home,
        denFacing = Vector3.new(0, 0, 1),
        fleeSpeed = 0,
        fleeTimer = 0,
        fleeDirection = Vector3.new(0, 0, 1),
        fleeRespawnDelay = nil,
        fleeRespawnWander = false,
        fleeIsFight = false,
        settleTimer = 0,
        eligibilityTimer = 0,
        respawnTimer = 0,
        awaySeconds = 0,
        spawnCooldown = 0,
        clock = 0,
    }

    if species.behaviour == "School" then
        local radius = cfg.orbit or 0
        rec.orbitOffset = rng:insideSphere(Vector3.zero, radius)
        rec.swimSpeed = cfg.anchorSpeed * rng:range(0.9, 1.1) -- "anchor velocity +/-10% jitter"
        rec.anchorKey = ("%s_%d"):format(speciesId, nodeIndex)
        if member == 1 or schoolAnchors[rec.anchorKey] == nil then
            schoolAnchors[rec.anchorKey] = {
                position = home,
                target = home,
                pause = rng:range(cfg.pauseMin, cfg.pauseMax),
                fleeTimer = 0,
                fleeDirection = Vector3.new(0, 0, 1),
            }
        end
    elseif species.behaviour == "Patrol" then
        rec.legDuration = cfg.legTime or 0
        for waypoint = 1, (cfg.waypoints or 0) do
            local offset = if cfg.loopBox ~= nil
                then Vector3.new(
                    rng:range(-cfg.loopBox.X / 2, cfg.loopBox.X / 2),
                    rng:range(-cfg.loopBox.Y / 2, cfg.loopBox.Y / 2),
                    rng:range(-cfg.loopBox.Z / 2, cfg.loopBox.Z / 2)
                )
                else Vector3.new(
                    rng:range(-cfg.radius, cfg.radius),
                    rng:range(-8, 8),
                    rng:range(-cfg.radius, cfg.radius)
                )
            table.insert(rec.waypoints, clampToBand(species, home + offset))
        end
        if #rec.waypoints == 0 then
            table.insert(rec.waypoints, home)
        end
        rec.legFrom = home
        rec.swimSpeed = cfg.speed
        if rec.legDuration > 0 and #rec.waypoints > 1 then
            -- An eased glide goes leg to leg: the fish starts ON waypoint 1 and its first leg
            -- targets waypoint 2. (Starting a leg from home toward the point the fish is already
            -- sitting on would make the first 14 s a crawl across a few studs.)
            rec.legFrom = rec.waypoints[1]
            rec.position = rec.waypoints[1]
            rec.waypointIndex = 2
        end
    elseif species.behaviour == "Flee" then
        rec.swimSpeed = cfg.speed
        local target = rng:insideSphere(home, cfg.radius * 0.6)
        table.insert(rec.waypoints, clampToBand(species, target))
    elseif species.behaviour == "Ambush" then
        -- §4.6: the den's opening faces -Z, so the eel protrudes that way.
        rec.denPosition = home
        rec.denFacing = Vector3.new(0, 0, -1)
        rec.waypoints = { clampToBand(species, home + rec.denFacing * cfg.idleProtrusion) }
    end

    rec.position = if #rec.waypoints > 0 then rec.waypoints[1] else home
    return rec
end

-- ============================================================================
-- Behaviour (§4.3) — one function per pattern
-- ============================================================================

--- Moves `rec` toward `target` by at most `speed * dt`, writing the velocity for the turn easing.
local function steer(rec: FishRecord, target: Vector3, speed: number, dt: number, ease: number?)
    local offset = target - rec.position
    local distance = offset.Magnitude
    local desired = if distance > 1e-4 then (offset / distance) * speed else Vector3.zero
    local blend = if ease ~= nil and ease > 0 then math.min(1, dt / ease) else 1
    rec.velocity = rec.velocity + (desired - rec.velocity) * blend
    rec.position += rec.velocity * dt
end

--- Shared flight (§4.3): away from the player, optionally with a extra dive component.
local function beginFlee(rec: FishRecord, playerPosition: Vector3, speed: number, seconds: number, dive: boolean)
    rec.state = "Fleeing"
    rec.fleeSpeed = speed
    rec.fleeTimer = seconds
    rec.fleeIsFight = false
    local away = rec.position - playerPosition
    if dive then
        away = away + Vector3.new(0, -math.abs(away.Y) - 6, 0)
    end
    rec.fleeDirection = unitOr(away, Vector3.new(0, 0, 1))
    rec.velocity = rec.fleeDirection * speed
end

--- §4.3 School: 8 anchors random-walking on a 60-stud radius, 6 members orbiting each.
local function stepSchool(rec: FishRecord, dt: number, positions: { Vector3 })
    local cfg = rec.species.behaviourCfg
    local anchor = schoolAnchors[rec.anchorKey :: string]
    if anchor == nil then
        return
    end

    local distance, playerPosition = nearestPlayer(rec.position, positions)

    -- The whole school bursts together (§4.3): the trigger is any member's player distance, but
    -- the anchor is what moves, so every member reacts on the same frame.
    if distance ~= nil and distance <= cfg.fleeRadius and anchor.fleeTimer <= 0 and rec.fleeTimer <= 0 then
        anchor.fleeTimer = cfg.fleeTime
        anchor.fleeDirection = unitOr(anchor.position - (playerPosition :: Vector3), Vector3.new(0, 0, 1))
    end

    if anchor.fleeTimer > 0 then
        anchor.fleeTimer -= dt
        anchor.position += anchor.fleeDirection * cfg.fleeSpeed * dt
        if anchor.fleeTimer <= 0 then
            -- "then re-anchors up to 80 studs away"
            anchor.target = anchor.position + rng:unitVector() * cfg.reanchorMax * rng:range(0.3, 1)
            anchor.pause = 0
        end
    elseif anchor.pause > 0 then
        anchor.pause -= dt
    else
        local offset = anchor.target - anchor.position
        if offset.Magnitude <= 1 then
            anchor.target = anchor.position + rng:unitVector() * cfg.anchorRadius * rng:range(0.3, 1)
            anchor.pause = rng:range(cfg.pauseMin, cfg.pauseMax)
        else
            anchor.position += (offset / offset.Magnitude) * cfg.anchorSpeed * dt
        end
    end

    local desired = clampToBand(rec.species, anchor.position + rec.orbitOffset)
    steer(rec, desired, rec.swimSpeed, dt)
    if anchor.fleeTimer > 0 then
        rec.state = "Fleeing"
        rec.fleeTimer = anchor.fleeTimer
    elseif rec.state == "Fleeing" then
        rec.state = "Idle"
        rec.fleeTimer = 0
    end
end

--- §4.3 Patrol (Sunset Grouper, Ghost Ray): waypoint to waypoint, with the ray's eased glide.
local function stepPatrol(rec: FishRecord, dt: number, positions: { Vector3 })
    local cfg = rec.species.behaviourCfg
    local distance, playerPosition = nearestPlayer(rec.position, positions)

    if rec.settleTimer > 0 then
        rec.settleTimer -= dt
    end

    if rec.fleeTimer > 0 then
        rec.fleeTimer -= dt
        rec.position += rec.fleeDirection * rec.fleeSpeed * dt
        if rec.fleeTimer <= 0 then
            rec.state = "Idle"
            -- "then rejoins its loop at the nearest waypoint"
            local bestIndex, bestDistance = 1, math.huge
            for index, waypoint in rec.waypoints do
                local d = (waypoint - rec.position).Magnitude
                if d < bestDistance then
                    bestIndex, bestDistance = index, d
                end
            end
            rec.waypointIndex = bestIndex
            rec.legFrom = rec.position
            rec.legElapsed = 0
        end
        return
    end

    if cfg.fleeRadius ~= nil and rec.settleTimer <= 0 and distance ~= nil and distance <= cfg.fleeRadius then
        rec.fleeSpeed = cfg.fleeSpeed
        rec.fleeTimer = cfg.fleeTime
        rec.fleeDirection = unitOr(rec.position - (playerPosition :: Vector3), Vector3.new(0, 0, 1))
        rec.state = "Fleeing"
        return
    end

    -- A displaced grouper walks home (§4.3: "Returns to its original node if displaced > 80 studs").
    local returnDistance = cfg.returnNodeDistance
    if returnDistance ~= nil and (rec.home - rec.position).Magnitude > returnDistance then
        rec.waypoints[rec.waypointIndex] = clampToBand(rec.species, rec.home)
    end

    local target = rec.waypoints[rec.waypointIndex]
    if rec.legDuration > 0 then
        -- Ghost Ray: 5 waypoints, ~14 s a leg, eased so it never turns sharply. The GDD asks for
        -- TweenService + Quad; the same Quad curve is interpolated here instead, which keeps the
        -- loop deterministic, testable and free of one Tween per fish per leg.
        rec.legElapsed += dt
        local t = math.clamp(rec.legElapsed / rec.legDuration, 0, 1)
        local eased = 1 - (1 - t) * (1 - t) -- Quad, Out
        rec.position = rec.legFrom + (target - rec.legFrom) * eased
        rec.velocity = unitOr(target - rec.legFrom, rec.velocity) * cfg.speed
        if t >= 1 then
            rec.legFrom = target
            rec.legElapsed = 0
            rec.waypointIndex = (rec.waypointIndex % #rec.waypoints) + 1
            rec.waypoints[rec.waypointIndex] = clampToBand(
                rec.species,
                rec.home
                    + Vector3.new(
                        rng:range(-cfg.radius, cfg.radius),
                        rng:range(-6, 6),
                        rng:range(-cfg.radius, cfg.radius) * 0.6
                    )
            )
        end
    else
        steer(rec, target, cfg.speed, dt, cfg.turnEase)
        if (target - rec.position).Magnitude <= 1 then
            rec.waypointIndex = (rec.waypointIndex % #rec.waypoints) + 1
            -- §4.3: waypoints are procedural, inside the node's radius, snapped above the seabed.
            local offset =
                Vector3.new(rng:range(-cfg.radius, cfg.radius), rng:range(-10, 10), rng:range(-cfg.radius, cfg.radius))
            local nextPoint = clampToBand(rec.species, rec.home + offset)
            local floor = seabedTopY(rec.species, nextPoint) + 4
            if nextPoint.Y < floor then
                nextPoint = Vector3.new(nextPoint.X, floor, nextPoint.Z)
            end
            rec.waypoints[rec.waypointIndex] = nextPoint
        end
    end
end

--- §4.3 Flee (Reef Bass): drift, the 0.35 s startle pause, then run until it is 40 studs clear.
local function stepFleeFish(rec: FishRecord, dt: number, positions: { Vector3 })
    local cfg = rec.species.behaviourCfg
    local distance, playerPosition = nearestPlayer(rec.position, positions)

    if rec.settleTimer > 0 then
        rec.settleTimer -= dt
    end

    if rec.state == "Fleeing" then
        if rec.fleeSpeed <= 0 then
            -- §4.3: "the frame the player is within 14 studs, pause 0.35 s — that delay is the only
            -- reason it is catchable, do not remove it". The pause is a Fleeing state at zero speed.
            rec.fleeTimer -= dt
            if rec.fleeTimer <= 0 then
                rec.fleeSpeed = cfg.fleeSpeed
                -- ReefBass has no fleeTime: §4.3 runs it until it is clearDistance from its home.
                rec.fleeTimer = cfg.fleeTime or math.huge
            end
        else
            rec.fleeTimer -= dt
            rec.position += rec.fleeDirection * rec.fleeSpeed * dt
            local clear = (rec.position - rec.home).Magnitude
            if rec.fleeTimer <= 0 or clear >= (cfg.clearDistance or math.huge) then
                -- "decelerates and drifts for 5 s before being approachable again"
                rec.state = "Idle"
                rec.settleTimer = cfg.driftTime
                rec.waypoints[1] = clampToBand(rec.species, rec.home + rng:insideSphere(Vector3.zero, cfg.radius * 0.6))
            end
        end
        return
    end

    if rec.settleTimer <= 0 and distance ~= nil and distance <= cfg.startleRadius then
        beginFlee(rec, playerPosition :: Vector3, 0, cfg.startleDelay, distance <= cfg.diveRadius)
        return
    end

    local target = rec.waypoints[rec.waypointIndex]
    if target == nil or (target - rec.position).Magnitude <= 2 then
        rec.waypoints[1] = clampToBand(rec.species, rec.home + rng:insideSphere(Vector3.zero, cfg.radius * 0.6))
        rec.waypointIndex = 1
    end
    steer(rec, rec.waypoints[rec.waypointIndex], cfg.speed, dt, 0.5)
end

--- §4.3 Ambush (Lantern Eel): idle in the den, lunge, 2 s recovery (the catch window), return.
local function stepAmbush(rec: FishRecord, dt: number, positions: { Vector3 })
    local cfg = rec.species.behaviourCfg
    local distance, playerPosition = nearestPlayer(rec.position, positions)

    if rec.fleeTimer > 0 then
        rec.fleeTimer -= dt
        if rec.state == "Lunging" then
            rec.position += rec.fleeDirection * rec.fleeSpeed * dt
            if (rec.position - rec.denPosition).Magnitude > cfg.maxRange then
                rec.position = rec.denPosition + unitOr(rec.position - rec.denPosition, rec.denFacing) * cfg.maxRange
            end
            if rec.fleeTimer <= 0 then
                rec.state = "Recovering"
                rec.fleeTimer = cfg.recoverTime
            end
        elseif rec.state == "Recovering" then
            rec.position += rec.fleeDirection * cfg.recoverSpeed * dt
            if rec.fleeTimer <= 0 then
                rec.state = "Returning"
                rec.fleeTimer = cfg.returnTime
            end
        else
            rec.position += rec.fleeDirection * rec.fleeSpeed * dt
            if rec.fleeTimer <= 0 then
                rec.state = "Idle"
            end
        end
        -- §4.3: the whole encounter stays inside maxRange of the crevice (§4.3 "never chases
        -- more than maxRange studs from its crevice").
        if (rec.position - rec.denPosition).Magnitude > cfg.maxRange then
            rec.position = rec.denPosition + unitOr(rec.position - rec.denPosition, rec.denFacing) * cfg.maxRange
        end
        return
    end

    -- §4.3: "never chases more than maxRange studs from its crevice" — true of the whole
    -- encounter, not just the lunge, so recovery cannot carry it away either.
    if (rec.position - rec.denPosition).Magnitude > cfg.maxRange then
        rec.position = rec.denPosition + unitOr(rec.position - rec.denPosition, rec.denFacing) * cfg.maxRange
    end

    if rec.state == "Returning" then
        local target = rec.denPosition + rec.denFacing * cfg.idleProtrusion
        steer(rec, target, (rec.position - target).Magnitude / math.max(cfg.returnTime, 0.01), dt)
        if (target - rec.position).Magnitude <= 0.5 then
            rec.state = "Idle"
            rec.waypoints = { target }
        end
        return
    end

    -- Idle: it ProtRUDES from the crevice (§4.3). The sway is applied at CFrame-write time.
    if rec.state == "Idle" then
        local target = rec.denPosition + rec.denFacing * cfg.idleProtrusion
        rec.position = rec.position + (target - rec.position) * math.min(1, dt * 2)
    end

    if distance ~= nil and distance <= cfg.lungeRadius then
        rec.state = "Lunging"
        rec.fleeSpeed = cfg.lungeSpeed
        rec.fleeTimer = cfg.lungeTime
        rec.fleeDirection = unitOr((playerPosition :: Vector3) - rec.position, rec.denFacing)
    end
end

--- Where a fish is drawn this frame: behaviour owns `position`, presentation adds the sway/bob
--- the GDD describes, so the two never feed back into each other.
local function renderPosition(rec: FishRecord): Vector3
    local cfg = rec.species.behaviourCfg
    local offset = Vector3.zero
    if rec.species.behaviour == "School" then
        offset = Vector3.new(0, math.sin(rec.clock * 2) * 0.1, 0)
    elseif cfg.bobAmplitude ~= nil then
        local period = cfg.bobPeriod or (1 / (cfg.bobHz or 1))
        offset = Vector3.new(0, cfg.bobAmplitude * math.sin(2 * math.pi * rec.clock / period), 0)
    elseif rec.species.behaviour == "Ambush" then
        offset = Vector3.new(math.sin(2 * math.pi * rec.clock / cfg.swayPeriod) * cfg.swayAmplitude, 0, 0)
    end
    return rec.position + offset
end

local function writeTransform(rec: FishRecord)
    local part = rec.part
    if part == nil then
        return
    end
    local position = clampToBand(rec.species, renderPosition(rec))
    local heading = rec.velocity.Magnitude > 1e-3 and rec.velocity or rec.denFacing
    local flat = Vector3.new(heading.X, 0, heading.Z)
    if flat.Magnitude < 1e-3 then
        flat = Vector3.new(0, 0, 1)
    end
    part.CFrame = CFrame.new(position) * CFrame.Angles(0, math.atan2(-flat.X, flat.Z), 0)

    -- §4.2's cue rides the body: it is a child part, so it has to be placed too (an anchored child
    -- does not follow its parent on its own). Its light's §8.6 flicker is driven from the same
    -- per-fish clock the sway/bob already uses — no new loop, no new timer, no extra instance.
    if rec.trim ~= nil then
        rec.trim.CFrame = part.CFrame * CFrame.new(rec.species.visual.trim.offset)
        local lightSpec = rec.species.visual.light
        if rec.cueLight ~= nil and lightSpec ~= nil and lightSpec.flickerHz ~= nil then
            local flicker = 1 + lightSpec.flickerAmplitude * math.sin(2 * math.pi * lightSpec.flickerHz * rec.clock)
            rec.cueLight.Brightness = lightSpec.brightness * flicker
        end
    end

    if rec.lure ~= nil then
        local cfg = rec.species.behaviourCfg
        local bob = cfg.lureBobAmplitude or 0
        local forward = if rec.denFacing.Magnitude > 0 then rec.denFacing else Vector3.new(0, 0, 1)
        rec.lure.CFrame = CFrame.new(
            position + forward * (rec.species.size.X / 2 + 1) + Vector3.new(0, math.sin(rec.clock * 1.6) * bob, 0)
        )
    end
end

-- ============================================================================
-- Public server API
-- ============================================================================

--- Spawns every species at its §4.6 coordinates: 74 fish at server start (§11).
function FishService:StartSpawning()
    self:StopSpawning()
    records = {}
    byPart = {}
    schoolAnchors = {}
    rng = Rng.new(FishConfig.SpawnRules.RandomSeed)
    spawnSequence = 0

    for _, speciesId in FishConfig.Order do
        local species = FishConfig.Species[speciesId]
        local positions, names = anchorPositions(speciesId)
        local cfg = species.behaviourCfg

        if #positions > 0 then
            local perNode = if species.behaviour == "School" then cfg.perSchool else 1
            local target = species.liveAtStart
            local spawned = 0

            -- §4.5: the fish live permanently at their node. The population target from config
            -- decides how many fish each anchor actually holds, so the two can never disagree:
            -- `liveAtStart` fish are spread across the anchors in order.
            local member = 0
            while spawned < target do
                local nodeIndex = (math.floor(spawned / perNode) % #positions) + 1
                member += 1
                local record =
                    makeRecord(spawnSequence + 1, speciesId, nodeIndex, names[nodeIndex], positions[nodeIndex], member)
                spawnSequence += 1
                spawned += 1
                table.insert(records, record)
                spawnRecord(record)
            end
        end
    end

    return #records
end

function FishService:StopSpawning()
    if loopConnection ~= nil then
        loopConnection:Disconnect()
        loopConnection = nil
    end
    local root = Workspace:FindFirstChild(ROOT_NAME)
    local folder = if root ~= nil then (root :: Instance):FindFirstChild(FISH_FOLDER) else nil
    if folder ~= nil then
        for _, child in (folder :: Instance):GetChildren() do
            child:Destroy()
        end
    end
    records = {}
    byPart = {}
    schoolAnchors = {}
end

--- Every live fish Part.
function FishService:GetAllFish(): { BasePart }
    local out: { BasePart } = {}
    for _, rec in records do
        if rec.alive and rec.part ~= nil then
            table.insert(out, rec.part)
        end
    end
    return out
end

--- Live count, optionally for one species (§11 verifies 48/10/6/7/3).
function FishService:GetLiveFishCount(speciesId: string?): number
    local count = 0
    for _, rec in records do
        if rec.alive and (speciesId == nil or rec.speciesId == speciesId) then
            count += 1
        end
    end
    return count
end

--- What the population should be at rest (FishConfig), vs what is alive right now, per species.
--- One call, so a boot line or a test can state the whole §4.5 target in a sentence.
function FishService:GetPopulationReport(): { [string]: any }
    local live: { [string]: number } = {}
    local target: { [string]: number } = {}
    for _, speciesId in FishConfig.Order do
        live[speciesId] = self:GetLiveFishCount(speciesId)
        target[speciesId] = FishConfig.Species[speciesId].liveAtStart
    end
    return {
        live = live,
        target = target,
        totalLive = self:GetLiveFishCount(),
        totalTarget = FishConfig.TotalLiveAtServerStart,
        tracked = #records,
    }
end

--- The §5.1 rule: nearest eligible fish to the player, within `maxRange` and (optionally) in
--- front of them. "In front" is the character's facing — the camera is the client's business and
--- the client is what draws the [E] CAST prompt; the server refuses a target it cannot see.
function FishService:GetNearestEligibleFish(player: Player, maxRange: number, requireFacing: boolean): BasePart?
    local character = player.Character
    local root = if character ~= nil then character:FindFirstChild("HumanoidRootPart") else nil
    if root == nil then
        return nil
    end
    local origin = (root :: BasePart).Position
    local look = (root :: BasePart).CFrame.LookVector

    local best: BasePart? = nil
    local bestDistance = math.huge
    for _, rec in records do
        if rec.alive and rec.part ~= nil and self:IsCastable(rec.part) then
            local offset = rec.position - origin
            local distance = offset.Magnitude
            if distance <= maxRange and distance < bestDistance then
                if not requireFacing then
                    best, bestDistance = rec.part, distance
                elseif distance > 0 then
                    local unit = offset / distance
                    local dot = unit.X * look.X + unit.Y * look.Y + unit.Z * look.Z
                    if dot >= FightConfig.CastFacingDot then
                        best, bestDistance = rec.part, distance
                    end
                end
            end
        end
    end
    return best
end

--- §5.2 step 7, §5.6: a fish that was missed, escaped or snapped is ineligible for a while, and a
--- fish that is fleeing or mid-lunge cannot be cast at (§5.1 step 1: "fish not fleeing").
function FishService:IsEligible(fish: BasePart): boolean
    local rec = byPart[fish]
    if rec == nil or not rec.alive then
        return false
    end
    if rec.eligibilityTimer > 0 then
        return false
    end
    return UNCASTABLE_STATES[rec.state] ~= true
end

--- The same test, named for what the caller means: "can the player cast at this fish right now".
function FishService:IsCastable(fish: BasePart): boolean
    return self:IsEligible(fish)
end

--- Everything about one fish that FishingService needs, in one snapshot (§4 attributes + state).
function FishService:Describe(fish: BasePart): { [string]: any }?
    local rec = byPart[fish]
    if rec == nil then
        return nil
    end
    return {
        speciesId = rec.speciesId,
        species = rec.species,
        node = rec.homeNode,
        home = rec.home,
        position = rec.position,
        state = rec.state,
        eligible = self:IsEligible(fish),
        part = rec.part,
    }
end

--- Drives the behaviour state machine for one fish (§4.3). Called from the 20 Hz loop and by
--- FishingService when a fish enters or leaves a fight.
function FishService:SetState(fish: BasePart, state: string)
    local rec = byPart[fish]
    if rec == nil then
        return
    end
    rec.state = state
    rec.velocity = Vector3.zero
    if state == "Fleeing" or state == "Lunging" then
        rec.fleeTimer = 0
    end
    if rec.part ~= nil then
        rec.part:SetAttribute("State", state)
    end
end

function FishService:GetState(fish: BasePart): string?
    local rec = byPart[fish]
    return if rec ~= nil then rec.state else nil
end

--- §5.1 step 3: the targeted fish is frozen in place for the hook-set window — it may not escape
--- before the player has had a chance to react.
function FishService:LockForFight(fish: BasePart, state: string)
    self:SetState(fish, state)
end

--- §5.6: hold the fish out of eligibility without moving it (used after a missed hook set).
function FishService:SetIneligible(fish: BasePart, seconds: number)
    local rec = byPart[fish]
    if rec ~= nil then
        rec.eligibilityTimer = math.max(rec.eligibilityTimer, seconds)
    end
end

--- A landed fish: remove it and respawn its home node after FishConfig.SpawnRules.RespawnSeconds.
function FishService:MarkCaught(fish: BasePart)
    local rec = byPart[fish]
    if rec == nil then
        return
    end
    despawnRecord(rec)
    rec.respawnTimer = FishConfig.SpawnRules.RespawnSeconds
    rec.state = "Despawning"
end

--- §4.3: the shared flight helper — `speed` and `seconds` come from the species'
--- behaviourCfg (fleeSpeed / fleeTime, or lungeSpeed / lungeTime for the eel).
--- `respawnDelay` is the §5.6 addition: the fish flees, then leaves the world and comes back.
function FishService:StartFlee(fish: BasePart, speed: number, seconds: number, respawnDelay: number?, wander: boolean?)
    local rec = byPart[fish]
    if rec == nil then
        return
    end
    local _, playerPosition = nearestPlayer(rec.position, playerPositions())
    local away = if playerPosition ~= nil then rec.position - playerPosition else rng:unitVector()
    rec.state = "Fleeing"
    rec.fleeSpeed = speed
    rec.fleeTimer = seconds
    rec.fleeDirection = unitOr(away, Vector3.new(0, 0, 1))
    rec.velocity = rec.fleeDirection * speed
    rec.settleTimer = 0
    rec.fleeIsFight = true
    rec.fleeRespawnDelay = respawnDelay
    rec.fleeRespawnWander = wander == true
    if rec.part ~= nil then
        rec.part:SetAttribute("State", "Fleeing")
    end
end

--- §5.6 respawn timers: 15 s after a catch or despawn (`MarkCaught`), and the per-outcome waits in
--- FightConfig.Cooldowns (respawnMiss / respawnSnap / respawnEscape) after a lost fight.
--- `wander` respawns the fish elsewhere in its band (§5.3 step 8) instead of on its node.
function FishService:RespawnAfter(fish: BasePart, delaySeconds: number, wander: boolean?)
    local rec = byPart[fish]
    if rec == nil then
        return
    end
    local species = rec.species
    local home = rec.home
    if wander == true then
        local radius = nodeRadius(species)
        home = clampToBand(species, home + rng:insideSphere(Vector3.zero, radius))
    end
    despawnRecord(rec)
    rec.home = home
    rec.respawnTimer = delaySeconds
end

--- §4.5: a spawner will not spawn more than one fish per SpawnBurstIntervalSeconds. The opening
--- population ignores it (the world must start full); everything after it respects it.
function FishService:CanSpawnNow(speciesId: string?): boolean
    for _, rec in records do
        if rec.alive and (speciesId == nil or rec.speciesId == speciesId) then
            if rec.spawnCooldown > 0 then
                return false
            end
        end
    end
    return true
end

-- ============================================================================
-- The movement loop (§4.3, §4.5)
-- ============================================================================

--- One movement step. Called from Heartbeat with the real frame delta; the harness calls it with
--- a fixed delta so a run is reproducible. `dt` is clamped to FishConfig.SpawnRules.MaxStepSeconds.
function FishService:_Step(dt: number)
    local step = math.min(dt, FishConfig.SpawnRules.MaxStepSeconds)
    if step <= 0 then
        return
    end
    local positions = playerPositions()

    for _, rec in records do
        if rec.spawnCooldown > 0 then
            rec.spawnCooldown -= step
        end

        if not rec.alive then
            rec.respawnTimer -= step
            if rec.respawnTimer <= 0 then
                spawnRecord(rec)
            end
        else
            rec.clock += step
            if rec.eligibilityTimer > 0 then
                rec.eligibilityTimer -= step
            end

            -- §5.1-§5.3: a hooked fish is FishingService's until the fight resolves.
            local locked = rec.state == "Hooked_Pending" or rec.state == "Fighting"
            if not locked then
                if rec.state == "Fleeing" and rec.fleeIsFight then
                    -- a flight imposed by a lost fight (§5.6): it runs, then leaves and respawns
                    rec.fleeTimer -= step
                    rec.position += rec.fleeDirection * rec.fleeSpeed * step
                    if rec.fleeTimer <= 0 then
                        local delay = rec.fleeRespawnDelay
                        local wander = rec.fleeRespawnWander
                        rec.fleeIsFight = false
                        rec.fleeRespawnDelay = nil
                        rec.fleeRespawnWander = false
                        self:RespawnAfter(rec.part :: BasePart, delay or FishConfig.SpawnRules.RespawnSeconds, wander)
                    end
                elseif rec.species.behaviour == "School" then
                    stepSchool(rec, step, positions)
                elseif rec.species.behaviour == "Patrol" then
                    stepPatrol(rec, step, positions)
                elseif rec.species.behaviour == "Flee" then
                    stepFleeFish(rec, step, positions)
                elseif rec.species.behaviour == "Ambush" then
                    stepAmbush(rec, step, positions)
                end

                if rec.alive then
                    rec.position = clampToBand(rec.species, rec.position)
                    -- §4: the State attribute is what a client reads (the cast prompt only appears
                    -- over a fish that is not fleeing or hooked), so it is kept in step with the
                    -- behaviour machine, one write per actual change.
                    if rec.part ~= nil and rec.part:GetAttribute("State") ~= rec.state then
                        rec.part:SetAttribute("State", rec.state)
                    end
                    writeTransform(rec)

                    -- §4.5: the 400-stud perf guard. Only measured while somebody is in the server —
                    -- an empty server has nobody to be far from, and must not wipe the ocean.
                    if #positions > 0 then
                        local distance = nearestPlayer(rec.position, positions)
                        if distance ~= nil and distance > FishConfig.SpawnRules.DespawnPlayerDistance then
                            rec.awaySeconds += step
                            if rec.awaySeconds >= FishConfig.SpawnRules.DespawnAfterSeconds then
                                despawnRecord(rec)
                                rec.respawnTimer = FishConfig.SpawnRules.RespawnSeconds
                            end
                        else
                            rec.awaySeconds = 0
                        end
                    else
                        rec.awaySeconds = 0
                    end
                end
            else
                writeTransform(rec)
            end
        end
    end
end

--- The §4.5 population target, per species, as the loop itself sees it.
function FishService:TargetCount(speciesId: string): number
    local species = FishConfig.Species[speciesId]
    return if species ~= nil then species.liveAtStart else 0
end

-- Knit lifecycle --------------------------------------------------------------

function FishService:KnitInit() end

function FishService:KnitStart()
    local spawned = self:StartSpawning()

    -- §4.3: reposition at MovementHz, server-authoritative.
    loopConnection = RunService.Heartbeat:Connect(function(dt)
        local ok, err = pcall(function()
            FishService:_Step(dt)
        end)
        if not ok then
            warn("[Deep Tide] FishService step failed: " .. tostring(err))
        end
    end)

    local report = self:GetPopulationReport()
    print(
        ("[Deep Tide] fish: %d live (target %d) — %d/%d %d/%d %d/%d %d/%d %d/%d · %d Hz"):format(
            report.totalLive,
            report.totalTarget,
            report.live.SilverSardine,
            report.target.SilverSardine,
            report.live.SunsetGrouper,
            report.target.SunsetGrouper,
            report.live.ReefBass,
            report.target.ReefBass,
            report.live.LanternEel,
            report.target.LanternEel,
            report.live.GhostRay,
            report.target.GhostRay,
            FishConfig.SpawnRules.MovementHz
        )
    )
    print(("[Deep Tide] fish spawned: %d records"):format(spawned))
end

return FishService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="121">
          <Properties>
            <string name="Name">FishingService</string>
            <string name="Source"><![CDATA[--!strict
--[[
    FishingService — Appendix B: "Cast -> hook set -> tension fight state machine (§5), rod
    gating (§5.4), cooldowns (§5.6)".
    Source: GDD §5.1 (cast), §5.2 (hook set), §5.3 (the Tension mini-game, server-authoritative
            at 30 Hz), §5.4 (the unbreakable rod wall), §5.5 (per-species tuning), §5.6 (cooldowns),
            §9 (failure explainer is never optional), §1 step 6 (a landed fish is banked instantly).

    Every tunable comes from FishConfig.mini (per species) and FightConfig (frame rules); the
    arithmetic itself is Modules/Tension, which is pure and therefore testable headlessly.

    The three phases, and who owns what:
        Casting   the line goes out for CastTweenTime; the fish is Hooked_Pending and does not flee
                  (§5.1 step 3); walking more than CastAbortDistance away cancels it (§5.1 step 4).
        HookSet   the ring shrinks over the species' hook window; the §5.4 rod gate fires here,
                  before the fight, exactly once and instantly.
        Fighting  Tension.step at FightTickHz. The player holds (E / mouse / R2) or releases; the
                  input is a *state*, so a late or dropped packet costs the player nothing but the
                  time until the next change — the latency tolerance §5.3 asks for. Q aborts.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Knit = require(ReplicatedStorage.Packages.Knit)

local Types = require(ReplicatedStorage.DeepTide.Modules.Types)
local Remotes = require(ReplicatedStorage.DeepTide.Modules.Remotes)
local FightConfig = require(ReplicatedStorage.DeepTide.Config.FightConfig)
local FishConfig = require(ReplicatedStorage.DeepTide.Config.FishConfig)
local Rng = require(ReplicatedStorage.DeepTide.Modules.Rng)
local Tension = require(ReplicatedStorage.DeepTide.Modules.Tension)

local FishingService = Knit.CreateService({
	Name = "FishingService",
})

-- One in-flight cast or fight per player (§5).
export type FightSession = {
	player: Player,
	fish: BasePart,
	phase: string, -- "Casting" | "HookSet" | "Fighting" (§5.1-§5.3)
	speciesId: string,
	species: any,
	rodId: string,
	fight: Tension.FightState?,
	phaseElapsed: number,
	castOrigin: Vector3,
	hookWindow: number,
	held: boolean,
}

-- §5.6: cooldown kinds, in the order they are reported.
local COOLDOWN_KINDS = { "cast", "missHook", "escape", "snap" }

-- A cast is refused while the rod is still recovering from any of these (§5.6: the snap
-- cooldown greys the rod and shows a countdown, so it must block a new cast).
local ROD_BLOCKING = { "cast", "missHook", "escape", "snap" }

local sessions: { [Player]: FightSession } = {}
local cooldowns: { [Player]: { [string]: number } } = {}
local rng = Rng.new(FightConfig.RandomSeed)

local services: { [string]: any } = {}

local function svc(name: string): any
	local found = services[name]
	if found == nil then
		found = Knit.GetService(name)
		services[name] = found
	end
	return found
end

local function fire(remoteName: string, player: Player, ...)
	local remote = Remotes.get(remoteName)
	remote:FireClient(player, ...)
end

--- §4.3's flight speeds, reused so a lost fight makes the fish run at its own species' speed.
local function speciesFleeSpeed(species: any): number
	local cfg = species.behaviourCfg
	return cfg.fleeSpeed or cfg.lungeSpeed or cfg.speed or 10
end

-- Public server API -----------------------------------------------------------

--- §5.1 step 2: the client's chosen target, or nil to let the server pick the nearest eligible
--- fish in front of the player. Returns false when the request is illegal (out of range,
--- ineligible, on cooldown, already fighting, no rod) — never a silent no-op.
function FishingService:RequestCast(player: Player, fish: BasePart?): boolean
	if sessions[player] ~= nil then
		return false
	end
	if not self:IsRodReady(player) then
		return false
	end

	local gear = svc("GearService")
	local fishService = svc("FishService")
	local target = fish
	if target == nil then
		target = fishService:GetNearestEligibleFish(player, FightConfig.CastRange, true)
	end
	if target == nil then
		return false
	end
	if not fishService:IsEligible(target) then
		return false
	end

	local character = player.Character
	local root = if character ~= nil then character:FindFirstChild("HumanoidRootPart") else nil
	if root == nil then
		return false
	end
	local origin = (root :: BasePart).Position

	local info = fishService:Describe(target)
	if info == nil then
		return false
	end

	-- §5.1 steps 1-2: within CastRange and roughly in front of the player.
	local ok = Tension.castTargetCheck(origin, (root :: BasePart).CFrame.LookVector, info.position)
	if not ok then
		return false
	end

	local rod = gear:GetRodStats(player)
	local species = FishConfig.Species[info.speciesId]

	sessions[player] = {
		player = player,
		fish = target,
		phase = "Casting",
		speciesId = info.speciesId,
		species = species,
		rodId = rod.id,
		fight = nil,
		phaseElapsed = 0,
		castOrigin = origin,
		hookWindow = species.mini.hookWindow,
		held = false,
	}

	-- §5.1 step 3: hooked but not yet fought — it may not flee before the player has reacted.
	fishService:LockForFight(target, "Hooked_Pending")
	self:_PushState(player)
	return true
end

--- §5.2 step 6/7: the second E press. A press inside the window wins; an early press and a press
--- inside the +HookSetGraceSeconds tail are both misses (§5.2 step 7: fish flees 3 s and is
--- ineligible for 8 s — no other penalty).
function FishingService:RequestHookSet(player: Player): boolean
	local session = sessions[player]
	if session == nil or session.phase ~= "HookSet" then
		return false
	end

	local result = Tension.hookSetResult(session.phaseElapsed, session.hookWindow)
	if result == "Expired" then
		-- the window is already over; the tick will retire it
		return false
	end

	if result ~= "Hit" then
		self:_MissHookSet(player, session)
		return false
	end

	-- §5.4: the rod gate fires here, before the fight, and it is absolute.
	local gate = self:GetRodGateFailure(player, session.speciesId)
	if gate ~= nil then
		self:ResolveFight(player, "WeakLine", gate)
		return false
	end

	session.phase = "Fighting"
	session.phaseElapsed = 0
	local rod = svc("GearService"):GetRodStats(player)
	session.fight = Tension.newFight(session.species, rod)
	svc("FishService"):SetState(session.fish, "Fighting")
	self:_PushState(player)
	return true
end

--- §5.4: rarity above the rod's MaxRarity snaps the line instantly with
--- FightConfig.FailMessages.weakLine. Returns nil when the rod is fine.
function FishingService:GetRodGateFailure(player: Player, speciesId: string): string?
	local species = FishConfig.Species[speciesId]
	if species == nil then
		return nil
	end
	local rod = svc("GearService"):GetRodStats(player)
	if not Tension.rarityAllowed(rod.maxRarity, species.rarity) then
		return FightConfig.FailMessages.weakLine
	end
	return nil
end

--- §5.3: hold/release input during the fight; the input is a state, not an event.
function FishingService:SetFightInput(player: Player, held: boolean)
	local session = sessions[player]
	if session ~= nil and session.phase == "Fighting" then
		session.held = held
	end
end

--- §5.3 step 9 / §0 lever 2: the tank ran out mid-fight. The fish is lost, the player is put back
--- at the surface by DiveService, and nothing that was already banked is touched (§11).
function FishingService:LoseToOutOfAir(player: Player)
	if sessions[player] ~= nil then
		self:ResolveFight(player, "Escaped", FightConfig.FailMessages.outOfAir)
	end
end

--- §5.3 step 10: aborting always works and carries no extra penalty.
function FishingService:AbortFight(player: Player)
	if sessions[player] ~= nil then
		self:ResolveFight(player, "Escaped")
	end
end

function FishingService:GetSession(player: Player): FightSession?
	return sessions[player]
end

--- §5.6: is this cooldown still running? Kinds are FightConfig.Cooldowns keys.
function FishingService:GetCooldown(player: Player, kind: string): number
	local table_ = cooldowns[player]
	if table_ == nil then
		return 0
	end
	return table_[kind] or 0
end

function FishingService:IsOnCooldown(player: Player, kind: string): boolean
	return self:GetCooldown(player, kind) > 0
end

--- Can a new cast start at all? (§5.6: the rod is unusable for Cooldowns.snap after a snap.)
function FishingService:IsRodReady(player: Player): boolean
	for _, kind in ROD_BLOCKING do
		if self:IsOnCooldown(player, kind) then
			return false
		end
	end
	return true
end

function FishingService:SetCooldown(player: Player, kind: string)
	local total = FightConfig.Cooldowns[kind]
	if total == nil then
		return
	end
	local table_ = cooldowns[player]
	if table_ == nil then
		table_ = {}
		cooldowns[player] = table_
	end
	table_[kind] = total
end

--- Ends the fight and applies the §5.6 consequences. `result` uses Types.FightResult:
--- Landed / Escaped / Snapped / WeakLine.
function FishingService:ResolveFight(player: Player, result: Types.FightResult, reason: string?): Types.FightResult
	local session = sessions[player]
	if session == nil then
		return result
	end
	sessions[player] = nil

	local fishService = svc("FishService")
	local species = session.species
	local note = reason

	if result == "Landed" then
		-- §1 step 6: the fish enters the Catch Log instantly; no Coins are added yet (§6.2).
		svc("InventoryService"):AddCatch(player, session.speciesId)
		fishService:MarkCaught(session.fish)
		self:SetCooldown(player, "cast")
		note = FightConfig.CatchMessageFormat:format(species.name, species.value)
	elseif result == "Escaped" then
		fishService:StartFlee(
			session.fish,
			speciesFleeSpeed(species),
			FightConfig.EscapeFleeSeconds,
			FightConfig.Cooldowns.respawnEscape
		)
		self:SetCooldown(player, "escape")
		note = note or FightConfig.FailMessages.escape
	else
		-- "Snapped" (over-tension) and "WeakLine" (§5.4) are the same physical event: the line
		-- broke, the fish runs, and it comes back somewhere else in its band (§5.3 step 8, §5.6).
		fishService:StartFlee(
			session.fish,
			speciesFleeSpeed(species),
			FightConfig.SnapFleeSeconds,
			FightConfig.Cooldowns.respawnSnap,
			true
		)
		self:SetCooldown(player, "snap")
		note = note or FightConfig.FailMessages.snap
	end

	fire("FightResolved", player, { result = result, speciesId = session.speciesId, reason = note })
	if result ~= "Landed" and note ~= nil then
		-- §9: never a loss without a reason and a next step.
		fire("Notify", player, { text = note, seconds = FightConfig.FailureMessageSeconds })
	end
	return result
end

--- §5.2 step 7: a missed hook set. The fish flees as if startled for 3 s and is out of
--- eligibility for Cooldowns.respawnMiss, but keeps its value and does not respawn.
function FishingService:_MissHookSet(player: Player, session: FightSession)
	sessions[player] = nil
	local fishService = svc("FishService")
	fishService:SetState(session.fish, "Idle")
	fishService:StartFlee(session.fish, speciesFleeSpeed(session.species), FightConfig.MissFleeSeconds)
	fishService:SetIneligible(session.fish, FightConfig.Cooldowns.respawnMiss)
	self:SetCooldown(player, "missHook")
	fire("FightResolved", player, {
		result = "Escaped",
		speciesId = session.speciesId,
		reason = FightConfig.MissMessages.missedHookSet,
	})
	fire(
		"Notify",
		player,
		{ text = FightConfig.MissMessages.missedHookSet, seconds = FightConfig.FailureMessageSeconds }
	)
end

--- The `FightStateChanged` payload (§5.3, §9): everything the track needs, including the
--- species name and value so the fight has a known stake.
function FishingService:_PushState(player: Player)
	local session = sessions[player]
	if session == nil then
		return
	end
	local payload: { [string]: any } = {
		phase = session.phase,
		speciesId = session.speciesId,
		name = session.species.name,
		value = session.species.value,
		rarity = session.species.rarity,
		rodId = session.rodId,
		ring = Tension.hookSetFraction(session.phaseElapsed, session.hookWindow),
	}
	if session.fight ~= nil then
		local view = Tension.viewOf(session.fight, session.speciesId)
		for key, value in view do
			payload[key] = value
		end
		payload.ring = nil
	end
	fire("FightStateChanged", player, payload)
end

--- §5.3: one tick of the tension maths, at FightTickHz, replicated to the fighting client.
--- Also the per-tick oxygen check (§5.3 step 9): the tank drains through all three phases, and
--- running dry loses the fish — the tank is a clock on the reward, never a punishment timer.
function FishingService:_TickFight(session: FightSession, dt: number)
	local player = session.player
	session.phaseElapsed += dt

	if session.phase == "Casting" then
		-- §5.1 step 4: moving more than CastAbortDistance from where the cast started aborts it.
		local character = player.Character
		local root = if character ~= nil then character:FindFirstChild("HumanoidRootPart") else nil
		if
			root == nil
			or ((root :: BasePart).Position - session.castOrigin).Magnitude > FightConfig.CastAbortDistance
		then
			sessions[player] = nil
			local fishService = svc("FishService")
			fishService:SetState(session.fish, "Idle")
			fishService:StartFlee(session.fish, speciesFleeSpeed(session.species), FightConfig.MissFleeSeconds)
			self:SetCooldown(player, "missHook")
			fire("FightResolved", player, {
				result = "Escaped",
				speciesId = session.speciesId,
				reason = FightConfig.MissMessages.castAborted,
			})
			return
		end
		if session.phaseElapsed >= FightConfig.CastTweenTime then
			session.phase = "HookSet"
			session.phaseElapsed = 0
		end
		self:_PushState(player)
		return
	end

	if session.phase == "HookSet" then
		if Tension.hookSetResult(session.phaseElapsed, session.hookWindow) == "Expired" then
			self:_MissHookSet(player, session)
			return
		end
		self:_PushState(player)
		return
	end

	-- Fighting
	local dive = svc("DiveService")
	if dive:GetAir(player) <= 0 then
		self:ResolveFight(player, "Escaped", FightConfig.FailMessages.outOfAir)
		return
	end

	local fight = session.fight
	if fight == nil then
		return
	end
	local outcome = Tension.step(fight, dt, session.held, rng)
	if outcome ~= nil then
		self:ResolveFight(player, outcome)
		return
	end
	self:_PushState(player)
end

--- One service step: cooldowns down, then every live session (cast, hook set or fight) forward.
--- Called from Heartbeat at FightTickHz; the harness calls it with a fixed dt.
function FishingService:_Step(dt: number)
	for player, table_ in cooldowns do
		for _, kind in COOLDOWN_KINDS do
			local remaining = table_[kind]
			if remaining ~= nil and remaining > 0 then
				table_[kind] = math.max(0, remaining - dt)
			end
		end
		if sessions[player] == nil then
			-- keep the tables small: a player with nothing running and nothing on cooldown
			-- drops their entry entirely
			local any = false
			for _, kind in COOLDOWN_KINDS do
				if (table_[kind] or 0) > 0 then
					any = true
					break
				end
			end
			if not any then
				cooldowns[player] = nil
			end
		end
	end

	for player, session in sessions do
		local ok, err = pcall(function()
			FishingService:_TickFight(session, dt)
		end)
		if not ok then
			warn(("[Deep Tide] FishingService: fight tick failed for %s: %s"):format(player.Name, tostring(err)))
			sessions[player] = nil
		end
	end
end

--- Per-player teardown (§PlayerService's release sweep): a player who leaves mid-fight releases
--- their fish instead of leaving it Hooked forever.
function FishingService:ReleasePlayer(player: Player)
	local session = sessions[player]
	if session ~= nil then
		sessions[player] = nil
		local fishService = svc("FishService")
		if fishService:Describe(session.fish) ~= nil then
			fishService:SetState(session.fish, "Idle")
		end
	end
	cooldowns[player] = nil
end

-- Knit lifecycle --------------------------------------------------------------

function FishingService:KnitInit()
	Remotes.get("CastRequest").OnServerEvent:Connect(function(player: Player, target: BasePart?)
		self:RequestCast(player, target)
	end)

	Remotes.get("HookSetRequest").OnServerEvent:Connect(function(player: Player)
		self:RequestHookSet(player)
	end)

	Remotes.get("FightInput").OnServerEvent:Connect(function(player: Player, action: string)
		if action == "hold" then
			self:SetFightInput(player, true)
		elseif action == "release" then
			self:SetFightInput(player, false)
		elseif action == "abort" then
			self:AbortFight(player)
		end
	end)
end

function FishingService:KnitStart()
	local accumulator = 0
	local tickSeconds = 1 / FightConfig.FightTickHz

	RunService.Heartbeat:Connect(function(dt: number)
		accumulator += dt
		local steps = 0
		while accumulator >= tickSeconds and steps < 5 do
			accumulator -= tickSeconds
			steps += 1
			local ok, err = pcall(function()
				FishingService:_Step(tickSeconds)
			end)
			if not ok then
				warn("[Deep Tide] FishingService step failed: " .. tostring(err))
			end
		end
	end)
end

return FishingService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="122">
          <Properties>
            <string name="Name">GearService</string>
            <string name="Source"><![CDATA[--!strict
--[[
    GearService — Appendix B: "Equipped rod + dive gear, DepthRating, LineStrength modifiers,
    applies effects to combat/dive maths".
    Source: GDD §0 lever 1 (gear is a key, not a stat), §5.3 steps 3-5 (zone width, strain,
    fill modifiers), §5.4 (MaxRarity wall), §6.1 (the starting kit), §6.3 (the two upgrades),
    §9 (`ROD: RUSTY / BRASS` — the player must be able to blame the rod correctly).

    The only service that answers "what is this player holding, and what does that allow?".
    FishingService asks it for rod stats; DiveService asks it for rating and air.

    Ownership vs equipping: in the slice a rod a player owns is the rod they hold (§6.1: the Rusty
    Rod is free and taken from the rack; §6.3: the Brass Rod is bought), and the dive gear works
    the same way. ShopService (the next delegation) buys the item and hands it over with
    SetEquippedRod / SetEquippedGear — the purchase rules are the shop's, not this file's.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Knit = require(ReplicatedStorage.Packages.Knit)

local Types = require(ReplicatedStorage.DeepTide.Modules.Types)
local Remotes = require(ReplicatedStorage.DeepTide.Modules.Remotes)
local RodConfig = require(ReplicatedStorage.DeepTide.Config.RodConfig)
local GearConfig = require(ReplicatedStorage.DeepTide.Config.GearConfig)
local EconomyConfig = require(ReplicatedStorage.DeepTide.Config.EconomyConfig)
local Tension = require(ReplicatedStorage.DeepTide.Modules.Tension)

local GearService = Knit.CreateService({
	Name = "GearService",
	Client = {},
})

local function playerService(): any
	return Knit.GetService("PlayerService")
end

local function isGearOwned(data: Types.PlayerData, gearId: string): boolean
	return data.equippedGearId == gearId
end

-- Rod -------------------------------------------------------------------------

--- "RustyRod" until the Brass Rod is bought.
function GearService:GetEquippedRodId(player: Player): string
	local data = playerService():GetData(player)
	local rodId = if data ~= nil and data.equippedRodId ~= nil then data.equippedRodId else EconomyConfig.StartingRodId
	if RodConfig.Rods[rodId] == nil then
		rodId = EconomyConfig.StartingRodId
	end
	return rodId
end

function GearService:GetRodStats(player: Player): Types.RodConfigEntry
	return RodConfig.Rods[self:GetEquippedRodId(player)]
end

--- §5.4: can this rod land that rarity at all? One comparison of RarityConfig.Rank —
--- Rusty Rod (Rare) can never land the Ghost Ray (Epic), by design, at any skill level.
function GearService:CanLandRarity(player: Player, rarity: string): boolean
	return Tension.rarityAllowed(self:GetRodStats(player).maxRarity, rarity)
end

--- Equip a rod the player owns (Rod Rack handout or a shop purchase).
function GearService:SetEquippedRod(player: Player, rodId: string): boolean
	local rod = RodConfig.Rods[rodId]
	if rod == nil then
		return false
	end
	local data = playerService():GetData(player)
	if data == nil then
		return false
	end
	data.equippedRodId = rodId
	player:SetAttribute(GearConfig.PlayerAttributes.RodId, rodId)
	return true
end

-- Dive gear -------------------------------------------------------------------

--- "RubberLungs" until the Reinforced Tank is bought.
function GearService:GetEquippedGearId(player: Player): string
	local data = playerService():GetData(player)
	local gearId = if data ~= nil and data.equippedGearId ~= nil
		then data.equippedGearId
		else EconomyConfig.StartingGearId
	if GearConfig.Gear[gearId] == nil then
		gearId = EconomyConfig.StartingGearId
	end
	return gearId
end

function GearService:GetGearStats(player: Player): Types.GearConfigEntry
	return GearConfig.Gear[self:GetEquippedGearId(player)]
end

--- §3.1/§6.3: 90 studs, or 240 with the Reinforced Tank.
function GearService:GetDepthRating(player: Player): number
	return self:GetGearStats(player).depthRating
end

--- §6.3: 100 s, or 300 with the Reinforced Tank.
function GearService:GetAirCapacity(player: Player): number
	return self:GetGearStats(player).airCapacity
end

function GearService:SetEquippedGear(player: Player, gearId: string): boolean
	local gear = GearConfig.Gear[gearId]
	if gear == nil then
		return false
	end
	local data = playerService():GetData(player)
	if data == nil then
		return false
	end
	data.equippedGearId = gearId
	player:SetAttribute(GearConfig.PlayerAttributes.GearId, gearId)
	-- §6.3: the purchase immediately sets AIR 300s / RATING 240m — DiveService tops the tank up
	-- to the new capacity rather than leaving the player on a half-full 100 s tank.
	Knit.GetService("DiveService"):ApplyGearCapacity(player)
	return true
end

--- What the HUD shows as the rod (§9: `ROD: RUSTY / BRASS` — the player must be able to
--- blame the rod correctly when a line snaps).
function GearService:GetRodReadout(player: Player): { id: string, name: string, tier: number, maxRarity: string }
	local rod = self:GetRodStats(player)
	return { id = rod.id, name = rod.name, tier = rod.tier, maxRarity = rod.maxRarity }
end

--- §6.1/§6.3: what the player is wearing, in one payload (used by the boot line and the HUD).
function GearService:GetReadout(player: Player): { [string]: any }
	local rod = self:GetRodStats(player)
	local gear = self:GetGearStats(player)
	return {
		rodId = rod.id,
		rodName = rod.name,
		rodTier = rod.tier,
		maxRarity = rod.maxRarity,
		lineStrength = rod.lineStrength,
		gearId = gear.id,
		gearName = gear.name,
		airCapacity = gear.airCapacity,
		depthRating = gear.depthRating,
	}
end

--- Stamps the two attributes the client reads (§9 readouts) and is called on load and on change.
function GearService:SyncAttributes(player: Player)
	player:SetAttribute(GearConfig.PlayerAttributes.RodId, self:GetEquippedRodId(player))
	player:SetAttribute(GearConfig.PlayerAttributes.GearId, self:GetEquippedGearId(player))
end

--- §1 step 2: the Rod Rack hands out the Rusty Rod. Idempotent — the rack is not a consumable,
--- and a player who already has a better rod keeps it.
function GearService:TakeStarterRod(player: Player): boolean
	local current = self:GetEquippedRodId(player)
	if
		RodConfig.Rods[current] ~= nil
		and RodConfig.Rods[current].tier > RodConfig.Rods[EconomyConfig.StartingRodId].tier
	then
		self:SyncAttributes(player)
		return false
	end
	return self:SetEquippedRod(player, EconomyConfig.StartingRodId)
end

--- §3.1: is this gear the one that opens The Shelf? (Used by the boot line and the shop.)
function GearService:OpensZone(player: Player, zoneId: string): boolean
	local ZoneConfig = require(ReplicatedStorage.DeepTide.Config.ZoneConfig)
	local zone = ZoneConfig.Zones[zoneId]
	if zone == nil then
		return false
	end
	return self:GetDepthRating(player) >= zone.requiredDepthRating
end

--- §3.1 / §3.3 / §6.3: the zone-entry rule's other half. Answers "does the player's gear open
--- this zone, and if not, what does?" — the cheapest gear tier whose DepthRating reaches the
--- zone's requirement, named and priced from GearConfig (never from the world or the UI), so
--- the refusal the player reads is a shopping list (§9).
function GearService:GetZoneAccess(player: Player, zoneId: string): { [string]: any }
	local ZoneConfig = require(ReplicatedStorage.DeepTide.Config.ZoneConfig)
	local zone = ZoneConfig.Zones[zoneId]
	local rating = self:GetDepthRating(player)
	if zone == nil then
		return { opens = true, rating = rating, required = 0 }
	end

	local required = zone.requiredDepthRating
	local key: Types.GearConfigEntry? = nil
	for _, gearId in GearConfig.Order do
		local gear = GearConfig.Gear[gearId]
		if gear ~= nil and gear.depthRating >= required and (key == nil or gear.cost < key.cost) then
			key = gear
		end
	end

	return {
		opens = rating >= required,
		rating = rating,
		required = required,
		gearId = if key ~= nil then key.id else nil,
		gearName = if key ~= nil then key.name else nil,
		gearCost = if key ~= nil then key.cost else nil,
		gearRating = if key ~= nil then key.depthRating else nil,
	}
end

function GearService:Owns(player: Player, itemId: string): boolean
	local data = playerService():GetData(player)
	if data == nil then
		return false
	end
	return data.equippedRodId == itemId or data.equippedGearId == itemId or isGearOwned(data, itemId)
end

--- §1 step 2: the Rod Rack's verb — take the starter rod and say so in the §9 voice. Kept as a
--- method (rather than wired here) so WorldService:WirePrompts owns every prompt's connection
--- and no prompt can end up with two handlers, or none.
function GearService:OnRodRackTriggered(player: Player)
	local took = self:TakeStarterRod(player)
	self:SyncAttributes(player)
	if took then
		local rod = self:GetRodStats(player)
		Remotes.get("Notify"):FireClient(player, {
			text = RodConfig.EquippedMessageFormat:format(string.upper(rod.name)),
			seconds = RodConfig.EquippedMessageSeconds,
		})
	end
end

-- Client surface -------------------------------------------------------------

function GearService.Client:GetRodReadout(player: Player): { id: string, name: string, tier: number, maxRarity: string }
	return self.Server:GetRodReadout(player)
end

function GearService.Client:GetReadout(player: Player): { [string]: any }
	return self.Server:GetReadout(player)
end

-- Knit lifecycle --------------------------------------------------------------

function GearService:KnitInit()
	game:GetService("Players").PlayerAdded:Connect(function(player)
		-- The profile may not be loaded yet (PlayerService loads it on its own PlayerAdded), so
		-- the attribute is re-stamped whenever the client asks for the readout as well.
		task.defer(function()
			if playerService():IsLoaded(player) then
				self:SyncAttributes(player)
			end
		end)
	end)
end

function GearService:KnitStart()
	-- §1 step 2: the Rod Rack's ProximityPrompt is connected by WorldService:WirePrompts (which
	-- owns every prompt host). The verb itself is OnRodRackTriggered, above.
end

return GearService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="123">
          <Properties>
            <string name="Name">InventoryService</string>
            <string name="Source"><![CDATA[--!strict
--[[
	InventoryService — Appendix B: "The Catch Log (unsold catches), add/clear/aggregate".
	Source: GDD §1 step 6 (a landed fish enters the Catch Log instantly, no Coins yet),
	        §6.2 (SELL ALL is the only conversion), §9 (Catch Log panel: species, rarity
	        colour, count, running TOTAL, clear on SELL ALL), §11 (the log survives a rejoin —
	        it lives inside the per-player profile that PlayerStore already persists).

	Nothing here knows what a fish is worth at sale time — values come from the fish table so the
	log can show a running total before any Coins exist (§9).
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Knit = require(ReplicatedStorage.Packages.Knit)

local Types = require(ReplicatedStorage.DeepTide.Modules.Types)
local Remotes = require(ReplicatedStorage.DeepTide.Modules.Remotes)
local FishConfig = require(ReplicatedStorage.DeepTide.Config.FishConfig)

local InventoryService = Knit.CreateService({
	Name = "InventoryService",
	Client = {},
})

local function playerService(): any
	return Knit.GetService("PlayerService")
end

local function logOf(player: Player): { Types.CatchLogEntry }?
	local data = playerService():GetData(player)
	if data == nil then
		return nil
	end
	if data.catchLog == nil then
		data.catchLog = {}
	end
	return data.catchLog
end

--- §9: push the whole log plus its running total — the panel redraws from one payload, and the
--- client never computes a value the economy has not agreed to.
function InventoryService:_Push(player: Player)
	local entries = self:GetEntries(player)
	Remotes.get("CatchLogChanged"):FireClient(player, entries, self:GetTotalCoins(player))
end

-- Public server API -----------------------------------------------------------

--- Adds one landed fish as a Catch Log row (§1 step 6). Rows are keyed by species and
--- carry the count, so a dive of 4 sardines is one row reading "x4".
--- Returns the updated log.
function InventoryService:AddCatch(player: Player, speciesId: string): { Types.CatchLogEntry }
	local log = logOf(player)
	local species = FishConfig.Species[speciesId]
	if log == nil or species == nil then
		return {}
	end

	for _, entry in log do
		if entry.speciesId == speciesId then
			entry.count += 1
			entry.value = species.value
			entry.name = species.name
			entry.rarity = species.rarity
			self:_Push(player)
			return log
		end
	end

	table.insert(log, {
		speciesId = speciesId,
		name = species.name,
		rarity = species.rarity,
		value = species.value,
		count = 1,
	})
	self:_Push(player)
	return log
end

function InventoryService:GetEntries(player: Player): { Types.CatchLogEntry }
	local log = logOf(player)
	if log == nil then
		return {}
	end
	return log
end

--- Running total in Coins for the unsold log (§9: `TOTAL 295 C`). Derived from
--- FishConfig's fish table, not from anything the client sends.
function InventoryService:GetTotalCoins(player: Player): number
	local total = 0
	for _, entry in self:GetEntries(player) do
		local species = FishConfig.Species[entry.speciesId]
		local value = if species ~= nil then species.value else entry.value
		if value ~= nil then
			total += value * entry.count
		end
	end
	return total
end

--- How many fish are in the log (the shop's SELL ALL reports this; §6.2).
function InventoryService:GetFishCount(player: Player): number
	local total = 0
	for _, entry in self:GetEntries(player) do
		total += entry.count
	end
	return total
end

--- Clears the log. Only EconomyService:SellAll should call this (§6.2).
function InventoryService:Clear(player: Player)
	local log = logOf(player)
	if log == nil then
		return
	end
	for index = #log, 1, -1 do
		table.remove(log, index)
	end
	self:_Push(player)
end

function InventoryService:ReleasePlayer(player: Player)
	-- nothing cached outside the profile; the profile itself is PlayerService's to save
end

-- Client surface -------------------------------------------------------------

--- Initial log so the panel can draw before the first CatchLogChanged arrives (§9).
function InventoryService.Client:GetCatchLog(player: Player): { Types.CatchLogEntry }
	return self.Server:GetEntries(player)
end

-- Knit lifecycle --------------------------------------------------------------

function InventoryService:KnitInit() end

function InventoryService:KnitStart() end

return InventoryService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="124">
          <Properties>
            <string name="Name">PlayerService</string>
            <string name="Source"><![CDATA[--!strict
--[[
    PlayerService — Appendix B: "Join/leave, PlayerData bootstrap, placeholder persistence".
    Source: GDD §6.1 (starting state: 0 C, Rusty Rod, Rubber Lungs, empty Catch Log),
            §10 (persistence is a stub that cannot fail the loop).

    Owns the per-player profile and its lifecycle. Coins and the Catch Log live inside
    the profile; the services that change them (EconomyService, InventoryService) ask
    this service for it.

    Persistence is wired and cannot fail the loop: every DataStore call inside PlayerStore
    is pcall'd, and a Studio session without API access degrades to session-only data
    (PlayerStore.mode) instead of erroring. A profile is loaded on join, saved on leave,
    and saved once more on shutdown (BindToClose).

    Per-player teardown rule: PlayerService:ReleasePlayer saves the profile, drops it, then
    calls `ReleasePlayer(player)` on every sibling service that defines it — so any service
    holding per-player state (a cooldown table, a live fight) drops it by implementing that
    one method. Nothing else has to know who holds what.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Knit = require(ReplicatedStorage.Packages.Knit)

local Types = require(ReplicatedStorage.DeepTide.Modules.Types)
local PlayerStore = require(script.Parent.Parent.Modules.PlayerStore)

local PlayerService = Knit.CreateService {
    Name = "PlayerService",
}

local dataByPlayer: { [Player]: Types.PlayerData } = {}

-- Public server API -----------------------------------------------------------

--- The player's profile, or nil before it is loaded.
function PlayerService:GetData(player: Player): Types.PlayerData?
    return dataByPlayer[player]
end

function PlayerService:IsLoaded(player: Player): boolean
    return dataByPlayer[player] ~= nil
end

--- "DataStore" or "session-only" (§10). Surfaced on the boot line.
function PlayerService:GetPersistenceMode(): string
    return PlayerStore.mode
end

--- §6.1, §10: load the profile (coins + catch log) and publish it. Returns whether real
--- persistence answered: false means the session-only defaults are in use, which is the
--- correct starting state anyway (EconomyConfig.StartingCoins / StartingRodId / StartingGearId).
function PlayerService:LoadPlayer(player: Player): boolean
    local persisted, data = PlayerStore.load(player)
    dataByPlayer[player] = data
    return persisted
end

--- §10: write the profile back. Returns false when nothing was loaded or when there is
--- no DataStore to write to (session-only), never an error.
function PlayerService:SavePlayer(player: Player): boolean
    local data = dataByPlayer[player]
    if data == nil then
        return false
    end
    local ok, saved = pcall(function()
        return PlayerStore.save(player, data)
    end)
    return ok and saved == true
end

--- Save, drop the profile, and let every sibling service drop its own per-player state.
--- Called on PlayerRemoving and on shutdown.
function PlayerService:ReleasePlayer(player: Player)
    if dataByPlayer[player] ~= nil then
        self:SavePlayer(player)
    end
    dataByPlayer[player] = nil

    for _, module in script.Parent:GetChildren() do
        if module:IsA("ModuleScript") and module.Name ~= self.Name then
            local resolved, service = pcall(function()
                return Knit.GetService(module.Name)
            end)
            local release = if resolved and type(service) == "table" then (service :: any).ReleasePlayer else nil
            if type(release) == "function" then
                local ok, err = pcall(function()
                    release(service, player)
                end)
                if not ok then
                    warn(("[Deep Tide] PlayerService: %s.ReleasePlayer failed: %s"):format(module.Name, tostring(err)))
                end
            end
        end
    end
end

-- Knit lifecycle --------------------------------------------------------------

function PlayerService:KnitInit()
    -- Probe persistence once so PlayerStore.mode is known before the boot line prints.
    PlayerStore.init()

    Players.PlayerAdded:Connect(function(player)
        self:LoadPlayer(player)
    end)

    Players.PlayerRemoving:Connect(function(player)
        self:ReleasePlayer(player)
    end)

    -- §10: a shutdown save cannot surface as an error. Each save is pcall'd inside
    -- SavePlayer, and the whole sweep is wrapped too.
    game:BindToClose(function()
        pcall(function()
            for player in dataByPlayer do
                self:SavePlayer(player)
            end
        end)
    end)

    -- A player can already be in the game when this runs (Studio's local player, or someone
    -- who joined during the boot): PlayerAdded will not fire for them.
    for _, player in Players:GetPlayers() do
        if not self:IsLoaded(player) then
            self:LoadPlayer(player)
        end
    end
end

function PlayerService:KnitStart() end

return PlayerService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="125">
          <Properties>
            <string name="Name">ShopService</string>
            <string name="Source"><![CDATA[--!strict
--[[
    ShopService — Appendix B: "The three SKUs, affordability, purchase transactions".
    Source: GDD §6.2 (SELL ALL is offered at the same stall), §6.3 (the whole shop:
            Reinforced Tank 280 C then Brass Rod 750 C, and the presentation order),
            §6.5 (the ordering is the design: the tank is the key), §6.6 (one disabled tab,
            no Robux anywhere), §9 (sticky cost-vs-cash comparison on every row, and never a
            purchase button that silently does nothing).

    Costs come from RodConfig/GearConfig; this service never hard-codes a price. Every
    transaction is: validate -> charge -> apply -> publish. A refusal always carries a reason
    the player can act on (§9).

    Why the tank is first: §6.5. The shop is the moment the player understands that the tank
    is the key to depth, so EconomyConfig.ShopOrder puts the Reinforced Tank on top and each
    row states its own measurable effect, read from the gear table.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Knit = require(ReplicatedStorage.Packages.Knit)

local Types = require(ReplicatedStorage.DeepTide.Modules.Types)
local Remotes = require(ReplicatedStorage.DeepTide.Modules.Remotes)
local EconomyConfig = require(ReplicatedStorage.DeepTide.Config.EconomyConfig)
local RodConfig = require(ReplicatedStorage.DeepTide.Config.RodConfig)
local GearConfig = require(ReplicatedStorage.DeepTide.Config.GearConfig)

local ShopService = Knit.CreateService({
	Name = "ShopService",
	Client = {},
})

local function economyService(): any
	return Knit.GetService("EconomyService")
end

local function gearService(): any
	return Knit.GetService("GearService")
end

local function fire(remoteName: string, player: Player, ...)
	Remotes.get(remoteName):FireClient(player, ...)
end

--- The config entry behind a SKU, whichever table owns it (§6.3).
local function skuEntry(sku: string): { [string]: any }?
	if RodConfig.Rods[sku] ~= nil then
		return RodConfig.Rods[sku]
	end
	return GearConfig.Gear[sku]
end

--- §6.3's measurable effect, built from the two gear tables so the row cannot drift from
--- what the purchase actually does: a tank reports the rating and air it grants, a rod
--- reports the rarity ceiling it raises.
local function effectLabelFor(player: Player, sku: string): string
	local gear = GearConfig.Gear[sku]
	if gear ~= nil then
		return EconomyConfig.ShopRowLabel.gearEffectFormat:format(
			gearService():GetDepthRating(player),
			gear.depthRating,
			gear.airCapacity
		)
	end
	local rod = RodConfig.Rods[sku]
	if rod ~= nil then
		return EconomyConfig.ShopRowLabel.rodEffectFormat:format(
			gearService():GetRodStats(player).maxRarity,
			rod.maxRarity
		)
	end
	return ""
end

-- Public server API -----------------------------------------------------------

--- The shop rows in presentation order (§6.3): Reinforced Tank first and flagged as the
--- recommended buy, Brass Rod below it labelled "UNLOCKS: GHOST RAY (600 C)".
function ShopService:GetSkuStates(player: Player): { Types.ShopSkuState }
	local states: { Types.ShopSkuState } = {}
	local coins = economyService():GetCoins(player)

	for _, sku in EconomyConfig.ShopOrder do
		local entry = EconomyConfig.Shop[sku]
		local gearOrRod = skuEntry(sku)

		if entry ~= nil and gearOrRod ~= nil then
			local price = gearOrRod.cost
			local owned = gearService():Owns(player, sku)
			local affordable = economyService():CanAfford(player, price)
			table.insert(states, {
				sku = sku,
				name = gearOrRod.name,
				category = entry.category,
				cost = price,
				affordable = affordable,
				owned = owned,
				recommended = entry.recommended,
				unlockLabel = entry.unlockLabel,
				shortfall = if affordable then 0 else math.max(0, price - coins),
				effectLabel = effectLabelFor(player, sku),
			})
		end
	end

	return states
end

--- Coins plus every row's affordability, for the shop UI (§9). Never a purchase button
--- that silently does nothing.
function ShopService:GetState(player: Player): Types.ShopState
	return {
		coins = economyService():GetCoins(player),
		skus = self:GetSkuStates(player),
	}
end

function ShopService:CanPurchase(player: Player, sku: string): boolean
	if table.find(EconomyConfig.ShopOrder, sku) == nil then
		return false
	end
	if skuEntry(sku) == nil then
		return false
	end
	if gearService():Owns(player, sku) then
		return false
	end
	return economyService():CanAfford(player, skuEntry(sku).cost)
end

--- The purchase transaction. Applies the effect via GearService and deducts via
--- EconomyService — 280 C is exactly 280 C (§11), and the tank immediately sets
--- AIR 300s / RATING 240m (§6.3).
--- Returns (success, reasonForFailure?) so the UI can explain a refusal (§9).
---
--- Order matters: the charge is attempted first (so an unaffordable buy changes nothing at
--- all), and the equip is applied only after the coins have moved — a failure to equip
--- refunds, so the shop can never take 280 C and hand back nothing.
function ShopService:Purchase(player: Player, sku: string): (boolean, string?)
	local entry = EconomyConfig.Shop[sku]
	local gearOrRod = skuEntry(sku)

	if table.find(EconomyConfig.ShopOrder, sku) == nil or entry == nil or gearOrRod == nil then
		local reason = EconomyConfig.PurchaseMessage.unknownFormat:format(tostring(sku))
		fire("Notify", player, { text = reason, seconds = EconomyConfig.PurchaseMessage.seconds })
		return false, reason
	end

	if gearService():Owns(player, sku) then
		local reason = EconomyConfig.PurchaseMessage.ownedFormat:format(gearOrRod.name)
		fire("Notify", player, { text = reason, seconds = EconomyConfig.PurchaseMessage.seconds })
		self:_Push(player)
		return false, reason
	end

	if not economyService():CanAfford(player, gearOrRod.cost) then
		local coins = economyService():GetCoins(player)
		local reason = EconomyConfig.PurchaseMessage.shortfallFormat:format(math.max(0, gearOrRod.cost - coins))
		-- §9: the refusal is spoken, and the row the player is looking at is re-pushed so the
		-- comparison stays true to their balance.
		fire("Notify", player, { text = reason, seconds = EconomyConfig.PurchaseMessage.seconds })
		self:_Push(player)
		return false, reason
	end

	if not economyService():TrySpend(player, gearOrRod.cost) then
		local reason = EconomyConfig.PurchaseMessage.shortfallFormat:format(gearOrRod.cost)
		fire("Notify", player, { text = reason, seconds = EconomyConfig.PurchaseMessage.seconds })
		self:_Push(player)
		return false, reason
	end

	local equipped = if GearConfig.Gear[sku] ~= nil
		then gearService():SetEquippedGear(player, sku)
		else gearService():SetEquippedRod(player, sku)

	if not equipped then
		-- Nothing to hand over: give the Coins back rather than charging for air.
		economyService():AddCoins(player, gearOrRod.cost, "purchaseRefund")
		local reason = EconomyConfig.PurchaseMessage.unknownFormat:format(gearOrRod.name)
		fire("Notify", player, { text = reason, seconds = EconomyConfig.PurchaseMessage.seconds })
		self:_Push(player)
		return false, reason
	end

	-- §6.3: the row says what the purchase does, and the line the player reads says the same
	-- numbers — both read from the gear table after the equip, so they cannot disagree.
	local message = if GearConfig.Gear[sku] ~= nil
		then EconomyConfig.PurchaseMessage.gearFormat:format(
			GearConfig.Gear[sku].name,
			GearConfig.Gear[sku].depthRating,
			GearConfig.Gear[sku].airCapacity
		)
		else EconomyConfig.PurchaseMessage.rodFormat:format(RodConfig.Rods[sku].name, entry.unlockLabel)

	fire("Notify", player, { text = message, seconds = EconomyConfig.PurchaseMessage.seconds })
	self:_Push(player)
	return true
end

--- §1 step 8 / §6.2: the Tide Trader's own verb. SELL ALL is offered at the same stall as
--- the shop, so the controller asks the shop for it and the shop asks the economy.
function ShopService:SellAll(player: Player): Types.SellAllResult
	local result = economyService():SellAll(player)
	self:_Push(player)
	return result
end

--- §9: push the whole shop state — coins plus every row — so the client redraws from one
--- payload. Firing this is also how the Tide Trader prompt "opens" the shop (§1 step 8):
--- the panel appears when the state arrives, so there is no second open/close protocol.
function ShopService:_Push(player: Player)
	fire("ShopStateChanged", player, self:GetState(player))
end

--- The Tide Trader prompt's verb (§1 step 8).
function ShopService:OpenFor(player: Player)
	self:_Push(player)
end

-- Client surface -------------------------------------------------------------

function ShopService.Client:GetState(player: Player): Types.ShopState
	return self.Server:GetState(player)
end

--- §6.2: SELL ALL from the shop panel. Selling is authoritative — the client asks, the
--- server pays.
function ShopService.Client:SellAll(player: Player): Types.SellAllResult
	return self.Server:SellAll(player)
end

-- Knit lifecycle --------------------------------------------------------------

function ShopService:KnitInit()
	-- §6.3, §9: the purchase request is bound to the buy path; the reply reaches the client
	-- through ShopStateChanged / CoinsChanged / Notify rather than a return value, so a
	-- refusal cannot be lost in transit.
	Remotes.get("ShopBuyRequest").OnServerEvent:Connect(function(player: Player, sku: string)
		if type(sku) == "string" then
			self:Purchase(player, sku)
		end
	end)
end

function ShopService:KnitStart() end

return ShopService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="126">
          <Properties>
            <string name="Name">VisualService</string>
            <string name="Source"><![CDATA[--!strict
--[[
    VisualService — builds every light, emitter and look-only part the world carries, from config.
    Source: GDD §3.0 (water is Terrain, sky at 17.5), §3.2 L8 (sun shafts — 0 geometry, the
            Technical Artist's), §3.1 (per-zone ambience), §3.3 R3 (the rim current's emitter),
            §3.4 S4 (six upward, slow emitters), §8.1-§8.3 (the two-world lighting, fog as the
            depth gauge, sun rays dying by 60 studs), §8.6 (bioluminescence is the Shelf's only
            light), §9 (a player must be able to read the place by eye), Appendix A (primitives,
            Neon, PointLight, ParticleEmitter only).

    WHERE THIS SITS
      WorldService builds the geometry (278 parts, measured and asserted separately). This service
      adds the things that are not geometry: the water's appearance, the static lighting baseline,
      the sun shafts, the bioluminescent specks, the landmark lamps and the particle emitters. It
      adds no part to the world's geometry budget and never renames anything WorldService built —
      so the world suite keeps asserting 278 parts and this suite asserts its own, smaller budget.

    LAYERING (why the lighting is set twice on purpose)
      The server sets the *baseline* here (the Surface preset at boot, so the place reads correctly
      before any client does anything, and for anyone watching a replay). The client's
      AtmosphereController then drives the real thing: Lighting's fog, ambient and brightness are
      per-frame functions of the local camera's depth (§8.2 "the player's sense of depth must equal
      the number on the HUD"), which only a client can know. Both read the same config through the
      same sampler (Modules/Atmosphere), so the two cannot disagree about what 40 studs looks like.

    Idempotency: Build() clears Workspace.DeepTide.Visual and every child this service added is
    named with VisualConfig.InstanceNames' prefixes, so a second Build() replaces rather than
    duplicates. Every host it dresses is found by name (Appendix A) and a host that is missing is
    reported as a problem, never silently skipped.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Knit = require(ReplicatedStorage.Packages.Knit)

local LightingConfig = require(ReplicatedStorage.DeepTide.Config.LightingConfig)
local VisualConfig = require(ReplicatedStorage.DeepTide.Config.VisualConfig)
local Atmosphere = require(ReplicatedStorage.DeepTide.Modules.Atmosphere)

local VisualService = Knit.CreateService({
	Name = "VisualService",
	Client = {},
})

local ROOT_NAME = "DeepTide"
local VISUAL_FOLDER = VisualConfig.InstanceNames.Root

-- Per-build state (module locals, so nothing is bolted onto the Knit service table).
local lastReport: { [string]: any }? = nil

-- ============================================================================
-- Tree helpers
-- ============================================================================

local function rootFolder(): Instance
	local existing = Workspace:FindFirstChild(ROOT_NAME)
	if existing ~= nil then
		return existing
	end
	local created: any = Instance.new("Folder")
	created.Name = ROOT_NAME
	created.Parent = Workspace
	return created
end

--- Create (or return) a folder by path under a root, e.g. "Visual/Shallows/Shafts".
local function folderAt(root: Instance, path: string): Instance
	local current = root
	for segment in string.gmatch(path, "[^/]+") do
		local next = current:FindFirstChild(segment)
		if next == nil then
			local created: any = Instance.new("Folder")
			created.Name = segment
			created.Parent = current
			next = created
		end
		current = next :: Instance
	end
	return current
end

--- Find a world instance by the config's path, e.g. "World/Shallows/L1/L1_Ramp".
--- Returns nil (and the caller records a problem) rather than creating anything: dressing a part
--- that does not exist would hide a rename instead of surfacing it.
local function findPath(path: string): Instance?
	local current: Instance? = rootFolder()
	for segment in string.gmatch(path, "[^/]+") do
		if current == nil then
			return nil
		end
		current = (current :: Instance):FindFirstChild(segment)
	end
	return current
end

local function clearChildren(folder: Instance)
	for _, child in folder:GetChildren() do
		child:Destroy()
	end
end

--- Remove every child this service previously added, wherever it was parented (Visual/ for parts,
--- a landmark part for a lamp, a seabed part for a dust emitter). Identifying them by name prefix
--- rather than by remembering addresses is what makes Build() safe to run twice.
local function clearOwnedChildren(root: Instance, prefix: string)
	for _, descendant in root:GetDescendants() do
		if string.sub(descendant.Name, 1, #prefix) == prefix then
			descendant:Destroy()
		end
	end
end

local function replaceChild(parent: Instance, className: string, name: string): any
	local existing = parent:FindFirstChild(name)
	if existing ~= nil then
		existing:Destroy()
	end
	local created: any = Instance.new(className)
	created.Name = name
	created.Parent = parent
	return created
end

-- ============================================================================
-- Instance builders (all numbers arrive from config; nothing here is a look)
-- ============================================================================

local function applyLight(host: Instance, name: string, spec: { [string]: any }): any
	local light = replaceChild(host, "PointLight", name)
	light.Color = spec.color
	light.Brightness = spec.brightness
	light.Range = spec.range
	-- Nothing in this world casts a shadow from a point light: 30-odd shadows at 60 Hz is the
	-- fastest way to spend a mid-range laptop's frame budget on the one thing nobody looks at.
	light.Shadows = false
	return light
end

local function applyEmitter(host: Instance, name: string, spec: { [string]: any }): any
	local emitter = replaceChild(host, "ParticleEmitter", name)
	emitter.Rate = spec.rate
	emitter.Speed = spec.speed
	emitter.Lifetime = spec.lifetime
	emitter.Size = NumberSequence.new(spec.sizeMin, spec.sizeMax)
	emitter.Transparency = NumberSequence.new(spec.transparencyStart, spec.transparencyEnd)
	emitter.Color = ColorSequence.new(spec.color, spec.color)
	emitter.LightEmission = spec.lightEmission or 0
	emitter.LightInfluence = if spec.lightInfluence ~= nil then spec.lightInfluence else 1
	emitter.SpreadAngle = Vector2.new(spec.spreadAngle, spec.spreadAngle)
	emitter.Acceleration = spec.acceleration or Vector3.zero
	emitter.Drag = spec.drag or 0
	emitter.EmissionDirection = Enum.NormalId[spec.emissionDirection or "Top"]
	emitter.MaxParticles = spec.maxParticles or 20
	-- Never a texture: Appendix A forbids imported assets. A large particle with no texture is a
	-- soft water-fog mote, which is exactly what silt and bubbles should look like.
	emitter.Enabled = true
	return emitter
end

--- A part that exists only to be looked at: anchored, non-collidable, non-queryable, no shadow.
local function addLookPart(
	parent: Instance,
	name: string,
	position: Vector3,
	size: Vector3,
	color: Color3,
	material: any,
	transparency: number
): any
	local part: any = Instance.new("Part")
	part.Name = name
	part.Shape = Enum.PartType.Block
	part.Size = size
	part.CFrame = CFrame.new(position)
	part.Color = color
	part.Material = material
	part.Transparency = transparency
	part.Anchored = true
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.CastShadow = false
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	part.Parent = parent
	return part
end

-- ============================================================================
-- The water and the static lighting baseline (§3.0, §3.1, §8.1)
-- ============================================================================

--- §3.0: "Water is Roblox Terrain water, one fill region ... Nothing else is Terrain."
--- Terrain's water properties are global, so this is the whole of the world's water look.
function VisualService:ApplyWater(): { [string]: any }
	local water = LightingConfig.Water
	local terrain: any = Workspace.Terrain
	terrain.WaterColor = water.color
	terrain.WaterTransparency = water.transparency
	terrain.WaterReflectance = water.reflectance
	terrain.WaterWaveSize = water.waveSize
	terrain.WaterWaveSpeed = water.waveSpeed
	return water
end

--- The boot-time baseline: the Surface preset, applied to Lighting and the three post-process
--- instances. The client takes it from here (see the file header) — this is what the place looks
--- like with no client script running at all.
function VisualService:ApplyLightingBaseline(): { [string]: any }
	local lighting: any = game:GetService("Lighting")
	local plan = Atmosphere.Plan(0)
	local names = LightingConfig.InstanceNames

	lighting.ClockTime = LightingConfig.ClockTime
	lighting.GlobalShadows = LightingConfig.GlobalShadows
	lighting.ShadowSoftness = LightingConfig.ShadowSoftness
	lighting.Ambient = plan.ambient
	lighting.OutdoorAmbient = plan.outdoorAmbient
	lighting.Brightness = plan.brightness
	lighting.ExposureCompensation = plan.exposureCompensation
	lighting.EnvironmentDiffuseScale = plan.environmentDiffuseScale
	lighting.EnvironmentSpecularScale = plan.environmentSpecularScale
	lighting.FogEnd = plan.fogEnd
	lighting.FogStart = plan.fogStart
	lighting.FogColor = plan.fogColor

	local atmosphere = replaceChild(lighting, "Atmosphere", names.Atmosphere)
	atmosphere.Density = plan.atmosphere.density
	atmosphere.Haze = plan.atmosphere.haze
	atmosphere.Color = plan.atmosphere.color
	atmosphere.Decay = plan.atmosphere.decay
	atmosphere.Glare = plan.atmosphere.glare
	atmosphere.Offset = plan.atmosphere.offset

	local bloom = replaceChild(lighting, "BloomEffect", names.Bloom)
	bloom.Intensity = plan.bloom.intensity
	bloom.Size = plan.bloom.size
	bloom.Threshold = plan.bloom.threshold
	bloom.Enabled = true

	local grade = replaceChild(lighting, "ColorCorrectionEffect", names.Grade)
	grade.TintColor = plan.grade.tint
	grade.Saturation = plan.grade.saturation
	grade.Contrast = plan.grade.contrast
	grade.Brightness = plan.grade.brightness
	grade.Enabled = true

	return plan
end

-- ============================================================================
-- Build
-- ============================================================================

--- Everything this service puts in the place, counted.
--- Returns { lights, emitters, parts, missing, problems, budget, seconds }.
function VisualService:Build(): { [string]: any }
	local startedAt = os.clock()
	local report: { [string]: any } = {
		lights = 0,
		emitters = 0,
		parts = 0,
		hosts = 0,
		missing = {},
		problems = {},
		seconds = 0,
	}

	local root = rootFolder()
	local names = VisualConfig.InstanceNames

	-- Water + the lighting baseline are not instances this service owns (Terrain and Lighting are
	-- services), so they are applied rather than counted.
	self:ApplyWater()
	self:ApplyLightingBaseline()

	-- Idempotency: drop everything this service previously added anywhere in the tree.
	clearOwnedChildren(root, names.EmitterPrefix)
	clearOwnedChildren(root, names.LightPrefix)
	local visual = folderAt(root, VISUAL_FOLDER)
	clearChildren(visual)

	-- ------------------------------------------------------------------
	-- §3.2 L8 / §8.3 — sun shafts (5 parts, 0 in the world's geometry budget by design)
	-- ------------------------------------------------------------------
	local shaftFolder = folderAt(root, VISUAL_FOLDER .. "/Shallows/Shafts")
	local shaftParts: { any } = {}
	local shaftCfg = LightingConfig.SunShafts
	for index, placement in shaftCfg.placements do
		local position = Vector3.new(
			placement.x,
			shaftCfg.startY - shaftCfg.size.Y / 2,
			placement.z
		)
		local part = addLookPart(
			shaftFolder,
			("SunShaft_%d"):format(index),
			position,
			shaftCfg.size,
			shaftCfg.color,
			Enum.Material[shaftCfg.material],
			-- 1 - alpha: the parts are drawn at `aboveWaterAlpha` transparency (0.65 = faint) and the
			-- client's AtmosphereController moves them from there to fully invisible with depth.
			1 - shaftCfg.aboveWaterAlpha
		)
		part.CFrame = CFrame.new(position) * CFrame.Angles(math.rad(placement.pitch), math.rad(placement.yaw), 0)
		part:SetAttribute("SunShaftIndex", index)
		part:SetAttribute("Zone", "Shallows")
		table.insert(shaftParts, part)
		report.parts += 1
	end

	-- Suspended motes inside two of the shafts (§8.4's "hand-sweep"/water density read, cheapest
	-- possible form: something already in the light path that drifts very slowly).
	for _, index in VisualConfig.ShaftMotes.hostIndices do
		local host = shaftParts[index]
		if host ~= nil then
			applyEmitter(host, names.EmitterPrefix .. "ShaftMotes_" .. tostring(index), VisualConfig.ShaftMotes)
			report.emitters += 1
		end
	end

	-- ------------------------------------------------------------------
	-- §8.6 — bioluminescent points: the Shelf's only light source
	-- ------------------------------------------------------------------
	local biolum = VisualConfig.Bioluminescence
	for index, point in biolum.points do
		local zone = point.zone
		local folder = folderAt(root, ("%s/%s/Biolum"):format(VISUAL_FOLDER, zone))
		local speck = addLookPart(
			folder,
			("BioluminescentPoint_%d"):format(index),
			point.position,
			biolum.speck.size,
			point.color,
			Enum.Material[biolum.speck.material],
			biolum.speck.transparency
		)
		speck:SetAttribute("Zone", zone)
		applyLight(speck, names.LightPrefix .. "Biolum_" .. tostring(index), point)
		report.parts += 1
		report.lights += 1
	end

	-- ------------------------------------------------------------------
	-- §9 — landmark dressing: every place the player must recognise, lit
	-- ------------------------------------------------------------------
	for _, dressing in VisualConfig.LandmarkLights do
		local host = findPath(dressing.hostPath)
		if host == nil then
			table.insert(report.missing, dressing.hostPath)
			table.insert(
				report.problems,
				("%s: no such part (%s) — that landmark would be left unlit"):format(dressing.id, dressing.hostPath)
			)
		else
			applyLight(host, names.LightPrefix .. dressing.id, dressing)
			report.lights += 1
			report.hosts += 1
		end
	end

	-- ------------------------------------------------------------------
	-- §3.3 R3 — the Rim Current's particle emitter (its 6 neon strips are WorldService's)
	-- ------------------------------------------------------------------
	local currentHost = findPath(VisualConfig.RimCurrent.hostPath)
	if currentHost == nil then
		table.insert(report.missing, VisualConfig.RimCurrent.hostPath)
		table.insert(
			report.problems,
			("RimCurrent: no such part (%s) — the only moving water in the world would be still"):format(
				VisualConfig.RimCurrent.hostPath
			)
		)
	else
		applyEmitter(currentHost, names.EmitterPrefix .. "RimCurrent", VisualConfig.RimCurrent)
		report.emitters += 1
		report.hosts += 1
	end

	-- ------------------------------------------------------------------
	-- §3.4 S4 — six upward, slow vent plumes
	-- ------------------------------------------------------------------
	local plumeCfg = VisualConfig.VentPlumes
	for index = 1, plumeCfg.hostCount do
		local path = plumeCfg.hostFormat:format(index)
		local host = findPath(path)
		if host == nil then
			table.insert(report.missing, path)
			table.insert(report.problems, ("VentPlume %d: no such part (%s)"):format(index, path))
		else
			applyEmitter(host, ("%sVentPlume_%d"):format(names.EmitterPrefix, index), plumeCfg)
			report.emitters += 1
			report.hosts += 1
		end
	end

	-- ------------------------------------------------------------------
	-- Silt: the water is a place, not air (2 emitters per band, on real seabed geometry)
	-- ------------------------------------------------------------------
	for index, placement in VisualConfig.SeabedDust.placements do
		local host = findPath(placement.hostPath)
		if host == nil then
			table.insert(report.missing, placement.hostPath)
			table.insert(report.problems, ("SeabedDust %d: no such part (%s)"):format(index, placement.hostPath))
		else
			local spec = table.clone(VisualConfig.SeabedDust)
			spec.color = placement.color
			applyEmitter(host, ("%sSeabedDust_%d"):format(names.EmitterPrefix, index), spec)
			report.emitters += 1
			report.hosts += 1
		end
	end

	report.seconds = os.clock() - startedAt
	report.problems = self:_BudgetProblems(report, report.problems)
	lastReport = report
	return report
end

--- The stated budget, checked rather than trusted (LightingConfig.Budget).
function VisualService:_BudgetProblems(report: { [string]: any }, problems: { string }): { string }
	local budget = LightingConfig.Budget
	if report.lights > budget.Lights then
		table.insert(problems, ("%d lights, budget is %d"):format(report.lights, budget.Lights))
	end
	if report.emitters > budget.Emitters then
		table.insert(problems, ("%d emitters, budget is %d"):format(report.emitters, budget.Emitters))
	end
	if report.parts > budget.VisualParts then
		table.insert(problems, ("%d look-only parts, budget is %d"):format(report.parts, budget.VisualParts))
	end
	return problems
end

-- ============================================================================
-- Reporting
-- ============================================================================

function VisualService:GetReport(): { [string]: any }?
	return lastReport
end

function VisualService:GetLightCount(): number
	return if lastReport ~= nil then (lastReport :: any).lights else 0
end

function VisualService:GetEmitterCount(): number
	return if lastReport ~= nil then (lastReport :: any).emitters else 0
end

function VisualService:GetVisualPartCount(): number
	return if lastReport ~= nil then (lastReport :: any).parts else 0
end

--- How many lights WorldService itself built, read off the live tree rather than remembered, so
--- this file never carries a second copy of the world's own numbers.
function VisualService:EngineLightCount(): number
	local total = 0
	for _, descendant in rootFolder():GetDescendants() do
		if descendant:IsA("PointLight") and string.sub(descendant.Name, 1, 2) ~= VisualConfig.InstanceNames.LightPrefix then
			total += 1
		end
	end
	return total
end

function VisualService:SummaryLine(): string
	local report = lastReport
	if report == nil then
		return "visuals: not built"
	end
	local budget = LightingConfig.Budget
	return ("visuals: %d lights (world %d, budget %d) · %d emitters (budget %d) · %d look-only parts (budget %d) · %d/5 bands"):format(
		report.lights,
		self:EngineLightCount(),
		budget.Lights,
		report.emitters,
		budget.Emitters,
		report.parts,
		budget.VisualParts,
		#LightingConfig.Bands
	)
end

-- Client surface -------------------------------------------------------------

--- The client's AtmosphereController reads config directly (it is in ReplicatedStorage), so
--- nothing needs to be shipped here.
function VisualService.Client:GetLightCount(player: Player): number
	return self.Server:GetLightCount()
end

-- Knit lifecycle --------------------------------------------------------------

function VisualService:KnitStart()
	-- KnitStart, not KnitInit: the world is built in WorldService's init and every host this
	-- service dresses is found by name in the tree WorldService produced.
	local report = self:Build()
	for _, problem in report.problems do
		warn("[Deep Tide] visual: " .. problem)
	end
	print("[Deep Tide] " .. self:SummaryLine())
end

return VisualService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="127">
          <Properties>
            <string name="Name">WorldService</string>
            <string name="Source"><![CDATA[--!strict
--[[
    WorldService — builds the playable world at server start, from config data only.
    Source: GDD §3.0 (coordinates, water, build zone), §3.1 (volumes + seabed),
            §3.2 (THE SHALLOWS L1-L9), §3.3 (THE RIM R1-R3), §3.4 (THE SHELF S1-S6),
            §3.4/§7 (the abyss drop and the threshold read), §4.6 (spawn coordinates),
            §1 steps 1-3 and 8 (spawn, rod rack, dive marker, Tide Trader), §9 (zone banners),
            Appendix A (naming rule, folder tree, primitives only).

    Rules this file obeys
      * Config is the source of truth. Landmark anchors and part counts come from
        LandmarkConfig, the seabed grids from ZoneConfig.Seabed, the spawn coordinates from
        SpawnConfig. This file holds only the per-piece *build recipe* (sizes, colours, tilts)
        that the GDD prints in prose — no gameplay number lives here.
      * Deterministic. No math.random: every "random" value in the GDD (yaw, tilt, scatter)
        is a pure hash of the part index, so every server and every re-run builds the same world.
      * Idempotent. Build() clears Workspace.DeepTide.World, .Water and .Spawns first, so a
        server restart or a second call rebuilds instead of duplicating. It never touches
        Workspace.DeepTide.Fish — that folder belongs to FishService.
      * Anchored. Every part is anchored; nothing here can fall or be pushed.
      * No fish, no animation. This service creates the spawn *anchors* and the ProximityPrompt
        *instances*, wires each prompt to the service that owns its verb (WirePrompts), and owns
        the zone-entry rule + the §9 banner (UpdateZone / AnnounceZone). What a prompt *does*
        belongs to the owning service; what a zone *needs* belongs here, because Zones are here.
      * Nothing is placed outside ZoneConfig.BuildZone (§3.0) except the water volume itself.

	Known GDD deviations, all commented at the point they happen:
	  * §3.2 L1's "-12 deg ramp" (see RAMP_DEGREES) — the angle and the Z 8 water entry cannot
		both hold; the water entry wins (the DIVE HERE marker sits there).
	  * §3.2 L2's "Cone primitives" and §3.4 S4's cones — Roblox has no cone Part and
		Appendix A forbids SpecialMesh, so tapered cylinder stacks stand in.
	  * §3.4 S2's "3-stud Neon speck" — S2's budget is 7 (the dens), so the speck is a
		PointLight on each den instead of an eighth part.
      * §3.2 L1's light tower "at (0, 20, -22)" — see buildL1Dock: §3.2 also prints the player
        spawn at (0, 8, -20), and the tower's base plane and footprint both land exactly there,
        so the printed pair creates the avatar inside the tower. The tower moves to (20, 20, -22).
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Knit = require(ReplicatedStorage.Packages.Knit)

local ZoneConfig = require(ReplicatedStorage.DeepTide.Config.ZoneConfig)
local LandmarkConfig = require(ReplicatedStorage.DeepTide.Config.LandmarkConfig)
local SpawnConfig = require(ReplicatedStorage.DeepTide.Config.SpawnConfig)
local Remotes = require(ReplicatedStorage.DeepTide.Modules.Remotes)

local WorldService = Knit.CreateService({
	Name = "WorldService",
	Client = {},
})

-- ============================================================================
-- Layout types (see Build() for how a spec becomes an Instance)
-- ============================================================================

type PartSpec = {
	name: string,
	parent: string, -- folder path under Workspace.DeepTide, e.g. "World/Shallows/L1"
	size: Vector3,
	cf: CFrame,
	class: string?,
	shape: Enum.PartType?,
	axis: string?, -- "Y" for a standing cylinder, "X" for one lying on its side
	material: Enum.Material?,
	color: Color3?,
	transparency: number?,
	decor: boolean?, -- decorative: no collide, no query, no shadow
	collide: boolean?,
	query: boolean?,
	outsideBuildZone: boolean?, -- volumes that define space rather than occupy it
	props: { [string]: any }?, -- extra instance properties (Duration, Neutral, ...)
	attributes: { [string]: any }?,
	light: { [string]: any }?, -- PointLight on this part
	prompt: { [string]: any }?, -- ProximityPrompt on this part (Appendix A prompt host)
	billboard: { [string]: any }?, -- text sign, e.g. "DIVE HERE" (§1 step 3)
}

type AnchorSpec = {
	name: string,
	host: string, -- name of the invisible host BasePart the Attachment hangs off
	hostParent: string, -- folder holding that host part
	position: Vector3, -- relative to the host
	attributes: { [string]: any },
}

type Layout = {
	folders: { string },
	parts: { PartSpec },
	anchors: { AnchorSpec },
	water: { size: Vector3 },
}

-- ============================================================================
-- Names and constants (geometry only; every gameplay number lives in Config/)
-- ============================================================================

local ROOT_NAME = "DeepTide"
local WORLD_FOLDER = "World"
local WATER_FOLDER = "Water"
local SPAWNS_FOLDER = "Spawns"

local GOLDEN_ANGLE = 137.508

-- Palette (§3.2-§3.4 name most of these inline; the rest read off the zone descriptions).
local DOCK_WOOD = Color3.fromRGB(122, 88, 62)
local DOCK_WOOD_DARK = Color3.fromRGB(96, 68, 48)
local SAND = Color3.fromRGB(196, 183, 148)
local REEF_ROCK = Color3.fromRGB(96, 104, 116)
local RIM_ROCK = Color3.fromRGB(58, 66, 74) -- §3.3: deliberately desaturated, "not-reef"
local SHELF_ROCK = Color3.fromRGB(70, 76, 84)
local SHELF_ROCK_DARK = Color3.fromRGB(44, 52, 62)
local DEEP_VOID = Color3.fromRGB(8, 10, 14)
local CORAL_PINK = Color3.fromRGB(214, 96, 120)
local CORAL_TEAL = Color3.fromRGB(96, 186, 168)
local KELP_GREEN = Color3.fromRGB(38, 96, 70)
local WARM_NEON = Color3.fromRGB(255, 214, 140)
local GATE_NEON = Color3.fromRGB(120, 190, 210)
local EEL_NEON = Color3.fromRGB(120, 255, 190)
local VENT_NEON = Color3.fromRGB(255, 132, 60)
local MINERAL_NEON = Color3.fromRGB(150, 190, 220)

-- The dock ramp. §3.2 L1 prints "ramp 16 x 1 x 30 rotated -12 deg down to water at Z 8",
-- but the deck's north lip is at Z 5 (deck 30 deep, centred Z -10) and the water is at Y 0,
-- so a -12 deg ramp cannot reach the water at Z 8 — it would need ~33 studs of Z to fall 7.
-- The builder keeps the GDD's Z 8 water entry (the lead's DIVE HERE decision) and takes the
-- only geometry that satisfies it: a steeper dive ramp hanging off the deck lip.
local RAMP_DEGREES = 62
local RAMP_LENGTH = 18
local RAMP_WIDTH = 16
local DECK_TOP_Y = 7
local DECK_LIP_Z = 5

-- §11 step 1: the player is *created* standing on the SpawnLocation, so the volume above that pad
-- has to be empty of solid geometry. A rig is ~5 studs of body; 6 studs of clearance above the
-- pad's top surface is the character's own column, with the pad's whole 12 x 12 footprint kept
-- clear as well — a spawn pad is a landing area, not a shelf. See ValidateSpawnVolume.
local SPAWN_CLEARANCE_STUDS = 6

-- §1 steps 2, 3 and 8: which service owns each prompt host's verb. Every host in
-- LandmarkConfig.PromptHosts must appear here or carry a `hint`; UnwiredPromptIds() reports
-- anything that would be left dangling, because a prompt that does nothing is worse than no
-- prompt at all.
local PROMPT_VERB_SERVICE = {
	RodRack = "GearService",
	TideTrader = "ShopService",
}
local PROMPT_VERB_METHOD = {
	RodRack = "OnRodRackTriggered",
	TideTrader = "OpenFor",
}

-- Per-build state (module locals, so nothing is bolted onto the Knit service table).
local lastReport: { [string]: any }? = nil
local promptById: { [string]: ProximityPrompt } = {}

-- Per-player zone state (§3.0, §9): which zones this player has already been announced into,
-- and when the last "this water needs better gear" line was spoken.
local zonesEntered: { [Player]: { [string]: boolean } } = {}
local requirementSaidAt: { [Player]: number } = {}

-- ============================================================================
-- Small pure helpers
-- ============================================================================

-- Deterministic "random" in [0,1): a build must be reproducible, so the GDD's random yaw /
-- tilt / scatter values are hashed from the part index instead of rolled.
local function noise(index: number, salt: number): number
	local x = math.sin(index * 12.9898 + salt * 78.233) * 43758.5453
	return x - math.floor(x)
end

local function lerp(a: number, b: number, t: number): number
	return a + (b - a) * t
end

-- A part resting on a surface at `topY`, with `embed` of its height sunk into it.
local function restingY(topY: number, height: number, embed: number?): number
	return topY + height / 2 - height * (embed or 0.35)
end

-- The axis-aligned box a rotated box occupies: half the part's Size projected onto each world axis
-- through the CFrame's own axes, which is the exact OBB -> AABB bound. Used only by the layout
-- validation below, where two boxes overlapping is the question.
local function boxBounds(cf: CFrame, size: Vector3): (Vector3, Vector3)
	local x = cf.RightVector * (size.X / 2)
	local y = cf.UpVector * (size.Y / 2)
	local z = cf.LookVector * (size.Z / 2)
	local half = Vector3.new(
		math.abs(x.X) + math.abs(y.X) + math.abs(z.X),
		math.abs(x.Y) + math.abs(y.Y) + math.abs(z.Y),
		math.abs(x.Z) + math.abs(y.Z) + math.abs(z.Z)
	)
	local centre = cf.Position
	return centre - half, centre + half
end

local function boxesOverlap(aMin: Vector3, aMax: Vector3, bMin: Vector3, bMax: Vector3): boolean
	return aMin.X < bMax.X
		and aMax.X > bMin.X
		and aMin.Y < bMax.Y
		and aMax.Y > bMin.Y
		and aMin.Z < bMax.Z
		and aMax.Z > bMin.Z
end

--- The part as the engine will build it: `collide` defaults to the inverse of `decor`.
local function isCollidable(spec: PartSpec): boolean
	return if spec.collide ~= nil then spec.collide :: boolean else not spec.decor
end

-- Everything solid standing in the column the player is created in. This is the one build mistake
-- that shows up as the avatar itself misbehaving: Roblox does not refuse a character that exists
-- inside an anchored part — it depenetrates the rig, and a rig being depenetrated reads in game as
-- the avatar tumbling (or being flung) the instant the place is played. Every world part is
-- anchored, so dressing reaching into the spawn column is the only way the world can do this.
-- Returns the offending part names, and the volume it checked, for the report line.
local function spawnVolumeIntruders(resolved: Layout): ({ string }, Vector3, Vector3)
	local pad: PartSpec? = nil
	for _, spec in resolved.parts do
		if spec.name == LandmarkConfig.WorldPropNames.SpawnLocation then
			pad = spec
		end
	end
	if pad == nil then
		return {}, Vector3.new(0, 0, 0), Vector3.new(0, 0, 0)
	end

	local padMin, padMax = boxBounds(pad.cf, pad.size)
	local min = Vector3.new(padMin.X, padMax.Y, padMin.Z)
	local max = Vector3.new(padMax.X, padMax.Y + SPAWN_CLEARANCE_STUDS, padMax.Z)

	local names: { string } = {}
	for _, spec in resolved.parts do
		if spec ~= pad and isCollidable(spec) then
			local partMin, partMax = boxBounds(spec.cf, spec.size)
			if boxesOverlap(partMin, partMax, min, max) then
				table.insert(names, spec.name)
			end
		end
	end
	return names, min, max
end

local function zonePath(zoneId: string, landmarkId: string): string
	return ("%s/%s/%s"):format(WORLD_FOLDER, zoneId, landmarkId)
end

local function basePath(zoneId: string): string
	return ("%s/%s/Base"):format(WORLD_FOLDER, zoneId)
end

local function landmarkById(id: string): { [string]: any }
	for _, landmark in LandmarkConfig.Landmarks do
		if landmark.id == id then
			return landmark
		end
	end
	return { id = id, name = id, zone = "Shallows", parts = 0 }
end

local function promptHostById(id: string): { [string]: any }?
	for _, host in LandmarkConfig.PromptHosts do
		if host.id == id then
			return host
		end
	end
	return nil
end

-- One part. `opts.cf` wins over position/yaw/pitch/roll.
local function add(
	parts: { PartSpec },
	parent: string,
	name: string,
	position: Vector3,
	size: Vector3,
	opts: { [string]: any }?
)
	opts = opts or {}
	local cf = opts.cf :: CFrame?
	if cf == nil then
		cf = CFrame.new(position)
			* CFrame.Angles(
				math.rad((opts.pitch :: number?) or 0),
				math.rad((opts.yaw :: number?) or 0),
				math.rad((opts.roll :: number?) or 0)
			)
	end

	table.insert(parts, {
		name = name,
		parent = parent,
		size = size,
		cf = cf :: CFrame,
		class = (opts.class :: string?) or "Part",
		shape = opts.shape :: Enum.PartType?,
		axis = opts.axis :: string?,
		material = (opts.material :: Enum.Material?) or Enum.Material.Concrete,
		color = (opts.color :: Color3?) or REEF_ROCK,
		transparency = (opts.transparency :: number?) or 0,
		decor = (opts.decor :: boolean?) or false,
		collide = opts.collide :: boolean?,
		query = opts.query :: boolean?,
		outsideBuildZone = (opts.outsideBuildZone :: boolean?) or false,
		props = opts.props :: { [string]: any }?,
		attributes = opts.attributes :: { [string]: any }?,
		light = opts.light :: { [string]: any }?,
		prompt = opts.prompt :: { [string]: any }?,
		billboard = opts.billboard :: { [string]: any }?,
	})
end

-- A cylinder. Roblox has no cone Part and Appendix A forbids SpecialMesh, so every cone the
-- GDD asks for is built as a tapered stack of cylinders (see L2 and S4).
local function cyl(
	parts: { PartSpec },
	parent: string,
	name: string,
	position: Vector3,
	height: number,
	diameter: number,
	opts: { [string]: any }?
)
	opts = opts or {}
	opts.size = Vector3.new(height, diameter, diameter)
	opts.shape = Enum.PartType.Cylinder
	if ((opts.axis :: string?) or "Y") == "Y" then
		opts.cf = ((opts.cf :: CFrame?) or CFrame.new(position)) * CFrame.Angles(0, 0, math.rad(90))
	end
	add(parts, parent, name, position, opts.size :: Vector3, opts)
end

-- ============================================================================
-- Base geology (§3.1) — the seabeds the zones stand on
-- ============================================================================

local function buildShallowsSeabed(parts: { PartSpec })
	local spec = ZoneConfig.Seabed.Shallows
	local footprint = ZoneConfig.Zones.Shallows.footprint
	local parent = basePath("Shallows")

	local cell = spec.cellSize
	local originX = (footprint.minX + footprint.maxX) / 2 - (spec.grid.columns * cell.X) / 2
	local originZ = (footprint.minZ + footprint.maxZ) / 2 - (spec.grid.rows * cell.Z) / 2
	local topY = spec.topY

	for column = 1, spec.grid.columns do
		for row = 1, spec.grid.rows do
			local x = originX + (column - 0.5) * cell.X
			local z = originZ + (row - 0.5) * cell.Z

			if column == spec.trenchCell.column and row == spec.trenchCell.row then
				-- The SE corner cell is the trench: descending sand steps whose deepest slab
				-- sits at trenchTopY (-85), so the flats visibly fall away (§3.1).
				local steps = spec.trenchSteps
				local stepDepth = cell.Z / steps
				for step = 1, steps do
					local stepTop = lerp(topY, spec.trenchTopY, step / steps)
					local stepZ = z - cell.Z / 2 + (step - 0.5) * stepDepth
					add(
						parts,
						parent,
						("Base_Trench_Step_%d"):format(step),
						Vector3.new(x, stepTop - cell.Y / 2, stepZ),
						Vector3.new(spec.trenchSize.X, cell.Y, stepDepth),
						{ material = spec.material, color = spec.color }
					)
				end
			else
				add(
					parts,
					parent,
					("Base_Seabed_%d_%d"):format(column, row),
					Vector3.new(x, topY - cell.Y / 2, z),
					cell,
					{ material = spec.material, color = spec.color }
				)
			end
		end
	end
end

local function buildShelfSeabed(parts: { PartSpec })
	local spec = ZoneConfig.Seabed.Shelf
	local footprint = ZoneConfig.Zones.Shelf.footprint
	local chasm = ZoneConfig.Chasm
	local parent = basePath("Shelf")

	local cell = spec.cellSize
	local originX = (footprint.minX + footprint.maxX) / 2 - (spec.grid.columns * cell.X) / 2
	local originZ = (footprint.minZ + footprint.maxZ) / 2 - (spec.grid.rows * cell.Z) / 2

	for column = 1, spec.grid.columns do
		for row = 1, spec.grid.rows do
			local isChasm = column == spec.chasmSkipColumn
			if isChasm then
				local inSkippedRow = false
				for _, skipRow in spec.chasmSkipRows do
					if row == skipRow then
						inSkippedRow = true
					end
				end
				isChasm = inSkippedRow
			end

			if not isChasm then
				local topY = spec.topYs[row]
				local x = originX + (column - 0.5) * cell.X
				local z = originZ + (row - 0.5) * cell.Z
				add(
					parts,
					parent,
					("Base_Shelf_%d_%d"):format(column, row),
					Vector3.new(x, topY - cell.Y / 2, z),
					cell,
					{
						material = spec.material,
						color = SHELF_ROCK,
					}
				)
			end
		end
	end

	-- The two carved cells leave a gap either side of the chasm (S6 owns the rift itself).
	-- `aprons` slabs close them, so the shelf still reads as 20 rock parts with no hole into
	-- the void: one at the chasm's south mouth, one across its northern end.
	local centreX = (footprint.minX + footprint.maxX) / 2
	add(
		parts,
		parent,
		"Base_Shelf_Apron_South",
		Vector3.new(centreX, spec.topYs[2] - cell.Y / 2 - 1, chasm.minZ - 12),
		Vector3.new(cell.X, cell.Y, 24),
		{ material = spec.material, color = SHELF_ROCK }
	)
	add(
		parts,
		parent,
		"Base_Shelf_Apron_North",
		Vector3.new(centreX, spec.topYs[4] - cell.Y / 2 + 9, chasm.maxZ + 40),
		Vector3.new(cell.X, cell.Y, 80),
		{ material = spec.material, color = SHELF_ROCK }
	)
end

-- ============================================================================
-- THE SHALLOWS (§3.2)
-- ============================================================================

local function buildL1Dock(parts: { PartSpec })
	local parent = zonePath("Shallows", "L1")

	add(parts, parent, "L1_Deck", Vector3.new(0, 6, -10), Vector3.new(60, 2, 30), {
		material = Enum.Material.Wood,
		color = DOCK_WOOD,
	})

	local pylons = {
		{ "L1_Pylon_NE", Vector3.new(28.5, -3, 3.5) },
		{ "L1_Pylon_NW", Vector3.new(-28.5, -3, 3.5) },
		{ "L1_Pylon_SE", Vector3.new(28.5, -3, -23.5) },
		{ "L1_Pylon_SW", Vector3.new(-28.5, -3, -23.5) },
	}
	for _, pylon in pylons do
		add(parts, parent, pylon[1], pylon[2], Vector3.new(3, 20, 3), {
			material = Enum.Material.Wood,
			color = DOCK_WOOD_DARK,
		})
	end

	-- Dive ramp: its top surface starts at the deck's north lip (0, 7, 5) and crosses the
	-- water surface at Z ~= 8.7, continuing ~9 studs below it — a slipway, not a walkway.
	local pitch = math.rad(RAMP_DEGREES)
	local slope = Vector3.new(0, -math.sin(pitch), math.cos(pitch))
	local normal = Vector3.new(0, math.cos(pitch), math.sin(pitch))
	local lip = Vector3.new(0, DECK_TOP_Y, DECK_LIP_Z)
	local rampCentre = lip + slope * (RAMP_LENGTH / 2) - normal * 0.5
	add(parts, parent, "L1_Ramp", rampCentre, Vector3.new(RAMP_WIDTH, 1, RAMP_LENGTH), {
		pitch = RAMP_DEGREES,
		material = Enum.Material.Wood,
		color = DOCK_WOOD,
	})

	-- §3.2 L1 prints this tower at (0, 20, -22) *and* prints the player spawn at (0, 8, -20), and the
	-- two cannot both hold: the tower is 4 x 4, so at (0, -22) its footprint runs X -2..2, Z -24..-20
	-- — its north face is exactly the spawn point's Z, and its base (Y 8) is exactly the pad's top
	-- surface (Y 8). Built as printed, the avatar is created with half of its body inside a 24-stud
	-- anchored wooden pillar and its feet on the pillar's base plane. Roblox depenetrates a character
	-- that exists inside geometry, which is what "the avatar flips when the place is played" is.
	-- The spawn coordinate is the ratified one (§11 step 1, ZoneConfig.InteractionPoints.PlayerSpawn,
	-- asserted in Tools/worldtest), so the dressing moves instead: same dock, same height, same
	-- corner of the deck — 20 studs east of the spawn pad, clear of its 12 x 12 footprint.
	add(parts, parent, "L1_LightTower", Vector3.new(20, 20, -22), Vector3.new(4, 24, 4), {
		material = Enum.Material.Wood,
		color = DOCK_WOOD_DARK,
	})
	add(parts, parent, "L1_Beacon", Vector3.new(20, 32, -22), Vector3.new(2, 2, 2), {
		material = Enum.Material.Neon,
		color = WARM_NEON,
		decor = true,
		light = { color = WARM_NEON, brightness = 2, range = 60 },
	})
end

local function buildL2CoralSpire(parts: { PartSpec })
	local parent = zonePath("Shallows", "L2")
	local foot = Vector3.new(-120, -45, 70) -- seabed top under the spire (§3.2 position)
	local seabedTop = foot.Y

	add(
		parts,
		parent,
		"L2_BaseRock",
		Vector3.new(foot.X, restingY(seabedTop, 12, 0.55), foot.Z),
		Vector3.new(40, 12, 40),
		{
			material = Enum.Material.Slate,
			color = REEF_ROCK,
		}
	)

	-- §3.2: "a stack of 7 Cone primitives, heights 24-60, base diameter 40 -> 12". At the
	-- printed heights the stack would stand above the waterline, so the builder keeps the
	-- printed taper (40 -> 10, alternating colours) and spans the seabed to the surface.
	local segments = {
		{ diameter = 40, height = 12 },
		{ diameter = 34, height = 9 },
		{ diameter = 28, height = 7 },
		{ diameter = 23, height = 6 },
		{ diameter = 18, height = 5 },
		{ diameter = 14, height = 3.5 },
		{ diameter = 10, height = 2.5 },
	}
	local y = seabedTop
	for index, segment in segments do
		local color = if index % 2 == 1 then CORAL_PINK else CORAL_TEAL
		cyl(
			parts,
			parent,
			("L2_Spire_%d"):format(index),
			Vector3.new(foot.X, y + segment.height / 2, foot.Z),
			segment.height,
			segment.diameter,
			{ material = Enum.Material.SmoothPlastic, color = color }
		)
		y += segment.height
	end

	-- A torus is not a primitive, so the Neon ring at Y -8 is a thin translucent disc.
	add(parts, parent, "L2_Ring", Vector3.new(foot.X, -8, foot.Z), Vector3.new(1, 24, 24), {
		shape = Enum.PartType.Cylinder,
		axis = "Y",
		material = Enum.Material.Neon,
		color = GATE_NEON,
		transparency = 0.35,
		decor = true,
	})
end

local function buildL3Trawler(parts: { PartSpec })
	local parent = zonePath("Shallows", "L3")
	local hull = Vector3.new(140, -58, -60)

	add(parts, parent, "L3_Hull", hull, Vector3.new(46, 10, 14), {
		roll = 12, -- §3.2: hull rotated 12 deg on Z
		material = Enum.Material.Metal,
		color = Color3.fromRGB(84, 74, 62),
	})
	add(parts, parent, "L3_Bow", Vector3.new(112, -58, -60), Vector3.new(12, 10, 14), {
		class = "WedgePart",
		yaw = 180,
		material = Enum.Material.Metal,
		color = Color3.fromRGB(74, 66, 56),
	})
	add(parts, parent, "L3_Superstructure", Vector3.new(146, -49, -60), Vector3.new(12, 8, 10), {
		material = Enum.Material.Metal,
		color = Color3.fromRGB(70, 62, 52),
	})
	cyl(parts, parent, "L3_Funnel", Vector3.new(152, -42, -60), 12, 6, {
		pitch = 8,
		material = Enum.Material.Metal,
		color = Color3.fromRGB(60, 52, 46),
	})
	cyl(parts, parent, "L3_Mast", Vector3.new(140, -36, -60), 34, 1, {
		pitch = 38, -- §3.2: broken mast tilted 38 deg
		material = Enum.Material.Metal,
		color = Color3.fromRGB(66, 60, 52),
	})

	for index = 1, 7 do
		local size = 2 + 3 * noise(index, 3)
		local angle = index * GOLDEN_ANGLE
		local radius = 12 + 18 * noise(index, 4)
		add(
			parts,
			parent,
			("L3_Debris_%d"):format(index),
			Vector3.new(
				hull.X + math.cos(math.rad(angle)) * radius,
				hull.Y + 6 * noise(index, 5),
				hull.Z + math.sin(math.rad(angle)) * radius
			),
			Vector3.new(size, size, size),
			{ material = Enum.Material.Metal, color = Color3.fromRGB(78, 70, 60), yaw = angle }
		)
	end
end

local function buildL4Kelp(parts: { PartSpec })
	local parent = zonePath("Shallows", "L4")
	local centre = Vector3.new(-40, -45, -100)
	local seabedTop = centre.Y

	for index = 1, 30 do
		local angle = index * GOLDEN_ANGLE
		local radius = 10 + 45 * math.sqrt(index / 30)
		local height = 20 + 35 * noise(index, 7)
		cyl(
			parts,
			parent,
			("L4_Frond_%d"):format(index),
			Vector3.new(
				centre.X + math.cos(math.rad(angle)) * radius,
				seabedTop + height / 2,
				centre.Z + math.sin(math.rad(angle)) * radius
			),
			height,
			1.2,
			{
				pitch = -14 + 28 * noise(index, 8), -- §3.2: tilted randomly +/- 14 deg
				yaw = 360 * noise(index, 9),
				material = Enum.Material.Neon,
				color = KELP_GREEN,
				transparency = 0.35,
				decor = true,
			}
		)
	end

	for index = 1, 4 do
		local angle = index * GOLDEN_ANGLE + 40
		local size = 8 + 8 * noise(index, 11)
		add(
			parts,
			parent,
			("L4_Rock_%d"):format(index),
			Vector3.new(
				centre.X + math.cos(math.rad(angle)) * 30,
				restingY(seabedTop, size),
				centre.Z + math.sin(math.rad(angle)) * 30
			),
			Vector3.new(size, size, size),
			{ material = Enum.Material.Slate, color = REEF_ROCK, yaw = angle }
		)
	end
end

local function buildL5DeepHole(parts: { PartSpec })
	local parent = zonePath("Shallows", "L5")
	local hole = Vector3.new(0, -85, 90)
	local mouthTop = -45 -- the sand surface the mouth is cut into
	local mouth = Vector3.new(60, 22, 40)

	-- The mouth is the dark volume the sand opens into (§3.2: "view straight down into
	-- unlit water"). It does not collide or answer queries; the sand around it does.
	add(parts, parent, "L5_Mouth", Vector3.new(hole.X, mouthTop - mouth.Y / 2 + 0.02, hole.Z), mouth, {
		material = Enum.Material.SmoothPlastic,
		color = DEEP_VOID,
		transparency = 0.15,
		collide = false,
		query = false,
	})

	local lips = {
		{ "L5_Lip_W", Vector3.new(-32, -42, 90), Vector3.new(14, 6, 44) },
		{ "L5_Lip_E", Vector3.new(32, -42, 90), Vector3.new(14, 6, 44) },
		{ "L5_Lip_N", Vector3.new(0, -42, 66), Vector3.new(44, 6, 14) },
		{ "L5_Lip_S", Vector3.new(0, -42, 114), Vector3.new(44, 6, 14) },
		{ "L5_Lip_Overhang", Vector3.new(-20, -40, 76), Vector3.new(20, 8, 20) },
	}
	for index, lip in lips do
		add(parts, parent, lip[1], lip[2], lip[3], {
			material = Enum.Material.Slate,
			color = REEF_ROCK,
			yaw = 12 * noise(index, 13),
		})
	end
end

local function buildL6SandChannels(parts: { PartSpec })
	local parent = zonePath("Shallows", "L6")
	local seabedTop = ZoneConfig.Seabed.Shallows.topY

	for index = 1, 12 do
		local x = -172 + (index - 1) * 31 -- 90 wide: keeps every ridge inside §3.0's X +/220
		local z = -140 + 18 * ((index * 7) % 11)
		add(parts, parent, ("L6_Ridge_%d"):format(index), Vector3.new(x, seabedTop + 1.5, z), Vector3.new(90, 3, 16), {
			-- §3.2: "at random yaw" — hashed, so every build is still identical.
			yaw = 180 * noise(index, 17),
			material = Enum.Material.Sand,
			color = SAND,
		})
	end
end

local function buildL7FishRocks(parts: { PartSpec })
	local parent = zonePath("Shallows", "L7")
	local centre = Vector3.new(-160, -45, 30)
	local seabedTop = centre.Y

	for index = 1, 8 do
		local angle = index * GOLDEN_ANGLE
		local radius = 8 + 22 * math.sqrt(index / 8)
		local size = 14 + 16 * noise(index, 19)
		add(
			parts,
			parent,
			("L7_Rock_%d"):format(index),
			Vector3.new(
				centre.X + math.cos(math.rad(angle)) * radius,
				restingY(seabedTop, size),
				centre.Z + math.sin(math.rad(angle)) * radius
			),
			Vector3.new(size, size * 0.8, size),
			{ material = Enum.Material.Slate, color = REEF_ROCK, yaw = angle, roll = -10 + 20 * noise(index, 21) }
		)
	end
end

local function buildL9Buoys(parts: { PartSpec })
	local parent = zonePath("Shallows", "L9")
	local buoys = landmarkById("L9").positions -- (0, 1, 120), (-80, 1, 60), (80, 1, 60)

	for index, position in buoys do
		local y = position.Y
		add(
			parts,
			parent,
			("L9_Float_%d"):format(index),
			Vector3.new(position.X, y - 0.5, position.Z),
			Vector3.new(4, 4, 4),
			{
				shape = Enum.PartType.Ball,
				material = Enum.Material.SmoothPlastic,
				color = Color3.fromRGB(220, 120, 90),
			}
		)
		cyl(parts, parent, ("L9_Mast_%d"):format(index), Vector3.new(position.X, y + 4.5, position.Z), 10, 0.6, {
			material = Enum.Material.Metal,
			color = Color3.fromRGB(200, 200, 205),
			roll = 3 * noise(index, 23),
		})
		add(
			parts,
			parent,
			("L9_Light_%d"):format(index),
			Vector3.new(position.X, y + 10, position.Z),
			Vector3.new(1.6, 1.6, 1.6),
			{
				shape = Enum.PartType.Ball,
				material = Enum.Material.Neon,
				color = WARM_NEON,
				decor = true,
				light = { color = WARM_NEON, brightness = 2, range = 45 },
			}
		)
	end
end

-- ============================================================================
-- THE RIM (§3.3) — the threshold between the two zones
-- ============================================================================

local function buildRimWall(parts: { PartSpec })
	local parent = zonePath("Rim", "R1")
	local wall = ZoneConfig.Rim.wall
	local gate = ZoneConfig.Rim.gate

	local steps = wall.steps
	local stepHeight = (wall.topY - wall.bottomY) / steps
	local stepDepth = (wall.maxZ - wall.minZ) / steps
	local partHeight = 18 -- §3.3: each step is 5 rock Parts ~90 x 18 x 14
	local partWidth = 100
	local partDepth = 14

	-- Four columns per step cover |X| 30..210, leaving the 50-stud gate notch (X -25..25)
	-- and its frame clear. The centre column exists only below the notch floor, so the notch
	-- stays open for R2's ramp. Names carry the column ordinal: §Appendix A's naming rule
	-- means a scripter must be able to find any part by name, so they have to be unique.
	local columns = { { -160, "W1" }, { -80, "W2" }, { 80, "E1" }, { 160, "E2" } }
	local notchFloorY = gate.rampBottomY

	for step = 1, steps do
		local top = wall.topY - (step - 1) * stepHeight
		local centreY = top - partHeight / 2
		local z = wall.minZ + (step - 0.5) * stepDepth

		for _, column in columns do
			local columnX = column[1]
			add(
				parts,
				parent,
				("R1_Step_%d_Rock_%s"):format(step, column[2]),
				Vector3.new(columnX, centreY, z),
				Vector3.new(partWidth, partHeight, partDepth),
				{
					yaw = 3 + 6 * noise(step * 10 + columnX, 29), -- §3.3: yaw-rotated 3-9 deg
					material = Enum.Material.Slate,
					color = RIM_ROCK,
				}
			)
		end

		if centreY < notchFloorY then
			add(
				parts,
				parent,
				("R1_Step_%d_Rock_C"):format(step),
				Vector3.new(0, centreY, z),
				Vector3.new(partWidth, partHeight, partDepth),
				{
					yaw = 3 + 6 * noise(step, 31),
					material = Enum.Material.Slate,
					color = RIM_ROCK,
				}
			)
		end
	end

	-- The rest of R1's 40: shoulders at the notch lip and three outcrops so the face reads
	-- as rock rather than as a grid.
	add(parts, parent, "R1_GateShelf_W", Vector3.new(-33, -46, 175), Vector3.new(16, 8, 50), {
		material = Enum.Material.Slate,
		color = RIM_ROCK,
		yaw = 5,
	})
	add(parts, parent, "R1_GateShelf_E", Vector3.new(33, -46, 175), Vector3.new(16, 8, 50), {
		material = Enum.Material.Slate,
		color = RIM_ROCK,
		yaw = -5,
	})
	for index, columnX in { -140, 0, 140 } do
		add(
			parts,
			parent,
			("R1_Outcrop_%d"):format(index),
			Vector3.new(columnX, wall.topY - 20 - 40 * index, 168 + 6 * index),
			Vector3.new(46, 30, 22),
			{ material = Enum.Material.Slate, color = RIM_ROCK, yaw = 8 * noise(index, 37) }
		)
	end
end

local function buildRimGate(parts: { PartSpec })
	local parent = zonePath("Rim", "R2")
	local gate = ZoneConfig.Rim.gate

	local rise = gate.rampTopY - gate.rampBottomY -- 70 studs of Y
	local run = gate.maxZ - gate.minZ -- 50 studs of Z
	local length = math.sqrt(rise * rise + run * run)
	local degrees = math.deg(math.atan(rise / run))
	local centreZ = (gate.minZ + gate.maxZ) / 2

	add(
		parts,
		parent,
		"R2_GateRamp",
		Vector3.new(0, (gate.rampTopY + gate.rampBottomY) / 2, centreZ),
		Vector3.new(gate.width, 4, length),
		{ pitch = degrees, material = Enum.Material.Slate, color = SHELF_ROCK }
	)

	add(parts, parent, "R2_Pillar_W", Vector3.new(-38, -75, centreZ), gate.pillarSize, {
		material = Enum.Material.Slate,
		color = RIM_ROCK,
		yaw = 6,
	})
	add(parts, parent, "R2_Pillar_E", Vector3.new(38, -75, centreZ), gate.pillarSize, {
		material = Enum.Material.Slate,
		color = RIM_ROCK,
		yaw = -6,
	})
	add(parts, parent, "R2_Lintel", Vector3.new(0, -32, centreZ), Vector3.new(102, 8, 30), {
		material = Enum.Material.Slate,
		color = RIM_ROCK,
	})
	-- The threshold read: a cold Neon keystone over the opening (R3's palette), so crossing
	-- into The Shelf is legible from both sides.
	add(parts, parent, "R2_Keystone", Vector3.new(0, -24, centreZ), Vector3.new(14, 10, 10), {
		material = Enum.Material.Neon,
		color = GATE_NEON,
		transparency = 0.25,
		decor = true,
		light = { color = GATE_NEON, brightness = 1.2, range = 40 },
	})
	add(
		parts,
		parent,
		"R2_Threshold",
		Vector3.new(0, gate.rampBottomY - 2, gate.maxZ - 6),
		Vector3.new(gate.width, 4, 16),
		{
			material = Enum.Material.Slate,
			color = SHELF_ROCK,
		}
	)
	add(parts, parent, "R2_Buttress_W", Vector3.new(-60, -100, centreZ), Vector3.new(30, 40, 30), {
		material = Enum.Material.Slate,
		color = RIM_ROCK,
		yaw = 10,
	})
	add(parts, parent, "R2_Buttress_E", Vector3.new(60, -100, centreZ), Vector3.new(30, 40, 30), {
		material = Enum.Material.Slate,
		color = RIM_ROCK,
		yaw = -10,
	})
end

local function buildRimCurrent(parts: { PartSpec })
	local parent = zonePath("Rim", "R3")
	local current = ZoneConfig.Rim.current
	local midY = (current.topY + current.bottomY) / 2
	local height = current.topY - current.bottomY

	local index = 0
	for _, z in { 162, 175, 188 } do
		for _, x in { -10, 10 } do
			index += 1
			add(parts, parent, ("R3_Strip_%d"):format(index), Vector3.new(x, midY, z), Vector3.new(1.5, height, 1.5), {
				material = Enum.Material.Neon,
				color = GATE_NEON,
				transparency = 0.75, -- §3.3: 0.75 transparency, visual only
				decor = true,
			})
		end
	end
end

-- ============================================================================
-- THE SHELF (§3.4)
-- ============================================================================

local function buildS1Lip(parts: { PartSpec })
	local parent = zonePath("Shelf", "S1")
	local lip = Vector3.new(0, -108, 240)
	local gate = ZoneConfig.Rim.gate
	local lipTop = lip.Y + 3

	add(parts, parent, "S1_Ledge", lip, Vector3.new(130, 6, 70), {
		material = Enum.Material.Slate,
		color = SHELF_ROCK,
	})

	-- Two ramps bridge the Rim Gate's foot (Z 200, Y -120) up to the Lip's surface so the
	-- arrival is a slope, not a cliff.
	local rise = 15
	local run = 40
	local rampLength = math.sqrt(rise * rise + run * run)
	local degrees = -math.deg(math.atan(rise / run))
	for _, side in { { -35, "W" }, { 35, "E" } } do
		add(
			parts,
			parent,
			("S1_Ramp_%s"):format(side[2]),
			Vector3.new(side[1], gate.rampBottomY + rise / 2, gate.maxZ + run / 2),
			Vector3.new(40, 6, rampLength),
			{ pitch = degrees, material = Enum.Material.Slate, color = SHELF_ROCK }
		)
	end

	for index = 1, 3 do
		local angle = index * GOLDEN_ANGLE
		local size = 20 + 10 * noise(index, 41)
		add(
			parts,
			parent,
			("S1_Boulder_%d"):format(index),
			Vector3.new(
				lip.X + math.cos(math.rad(angle)) * 55,
				restingY(lipTop, size),
				lip.Z + math.sin(math.rad(angle)) * 28
			),
			Vector3.new(size, size * 0.8, size),
			{ material = Enum.Material.Slate, color = SHELF_ROCK_DARK, yaw = angle }
		)
	end

	for index = 1, 3 do
		add(
			parts,
			parent,
			("S1_Fin_%d"):format(index),
			Vector3.new(-45 + 45 * (index - 1), lipTop + 2, 272),
			Vector3.new(30, 5, 12),
			{
				material = Enum.Material.Slate,
				color = SHELF_ROCK_DARK,
				yaw = 10 * noise(index, 43),
			}
		)
	end

	add(parts, parent, "S1_BackStep", Vector3.new(0, -101, 292), Vector3.new(120, 8, 40), {
		material = Enum.Material.Slate,
		color = Color3.fromRGB(60, 66, 74),
	})
end

local function buildS2CreviceRow(parts: { PartSpec })
	local parent = zonePath("Shelf", "S2")
	local dens = SpawnConfig.LanternEel.dens -- §4.6: 7 dens, opening faces -Z

	local index = 0
	for _, position in dens do
		index += 1
		add(parts, parent, ("S2_Den_%d"):format(index), position, Vector3.new(10, 6, 14), {
			material = Enum.Material.Slate,
			color = Color3.fromRGB(30, 34, 40),
			attributes = {
				-- The matching spawn anchor lives in Spawns/LanternEel; this links the two.
				SpawnNode = ("LanternEel/Den_%d"):format(index),
				OpeningFacing = SpawnConfig.LanternEel.openingFacing,
			},
			-- §3.4: "a 3-stud Neon speck to be found in the dark". S2's budget is the 7 dens,
			-- so the speck is a light rather than an eighth part.
			light = { color = EEL_NEON, brightness = 1, range = 12 },
		})
	end
end

local function buildS3GhostLedge(parts: { PartSpec })
	local parent = zonePath("Shelf", "S3")
	local ledge = Vector3.new(0, -175, 380)
	local top = ledge.Y + 3

	add(parts, parent, "S3_Ledge", ledge, Vector3.new(200, 6, 80), {
		material = Enum.Material.Slate,
		color = SHELF_ROCK_DARK,
	})

	for index = 1, 6 do
		add(
			parts,
			parent,
			("S3_Fin_%d"):format(index),
			Vector3.new(-75 + 30 * (index - 1), top + 2.5, 345),
			Vector3.new(30, 5, 12),
			{
				material = Enum.Material.Slate,
				color = Color3.fromRGB(50, 58, 68),
				yaw = -8 + 16 * noise(index, 47),
			}
		)
	end

	add(parts, parent, "S3_MineralVein", Vector3.new(0, top + 1, 405), Vector3.new(60, 3, 8), {
		material = Enum.Material.Neon,
		color = MINERAL_NEON,
		transparency = 0.45,
		decor = true,
	})
end

local function buildS4ThermalVents(parts: { PartSpec })
	local parent = zonePath("Shelf", "S4")
	local field = Vector3.new(110, -205, 440)
	local floorTop = ZoneConfig.Seabed.Shelf.topYs[4] + 4

	for index = 1, 6 do
		local angle = index * GOLDEN_ANGLE
		local radius = 6 + 22 * noise(index, 53)
		local x = field.X + math.cos(math.rad(angle)) * radius
		local z = field.Z + math.sin(math.rad(angle)) * radius
		local height = 10 + 8 * noise(index, 59)
		local diameter = 8 - 2 * noise(index, 61)

		cyl(
			parts,
			parent,
			("S4_Chimney_%d"):format(index),
			Vector3.new(x, floorTop + height / 2, z),
			height,
			diameter,
			{
				material = Enum.Material.Slate,
				color = Color3.fromRGB(48, 40, 36),
				yaw = 6 * noise(index, 63),
			}
		)
		cyl(parts, parent, ("S4_Rim_%d"):format(index), Vector3.new(x, floorTop + height + 0.6, z), 1.2, diameter + 2, {
			material = Enum.Material.Neon,
			color = VENT_NEON,
			transparency = 0.15,
			decor = true,
			-- §3.4: 3 PointLights across the field — the Shelf's only warm light.
			light = if index <= 3 then { color = Color3.fromRGB(255, 140, 70), brightness = 2, range = 40 } else nil,
		})
	end

	add(parts, parent, "S4_Mound_1", Vector3.new(field.X - 34, floorTop + 3, field.Z + 18), Vector3.new(24, 8, 24), {
		material = Enum.Material.Slate,
		color = Color3.fromRGB(52, 44, 40),
		yaw = 14,
	})
	add(parts, parent, "S4_Mound_2", Vector3.new(field.X + 30, floorTop + 2.4, field.Z - 16), Vector3.new(20, 7, 20), {
		material = Enum.Material.Slate,
		color = Color3.fromRGB(52, 44, 40),
		yaw = -22,
	})
end

local function buildS5SunkenPillars(parts: { PartSpec })
	local parent = zonePath("Shelf", "S5")
	local field = Vector3.new(-130, -165, 330)
	local floorTop = ZoneConfig.Seabed.Shelf.topYs[2]

	for index = 1, 5 do
		local length = 60 + 30 * noise(index, 67)
		local angle = index * GOLDEN_ANGLE
		add(
			parts,
			parent,
			("S5_Pillar_%d"):format(index),
			Vector3.new(
				field.X + math.cos(math.rad(angle)) * 40,
				floorTop + 10,
				field.Z + math.sin(math.rad(angle)) * 40
			),
			Vector3.new(length, 16, 16),
			{
				shape = Enum.PartType.Cylinder, -- axis X: lying on its side
				yaw = 20 + 50 * noise(index, 71), -- §3.4: yaw 20-70 deg
				roll = -12 + 24 * noise(index, 73), -- tilt +/- 12 deg
				material = Enum.Material.Slate,
				color = Color3.fromRGB(70, 76, 84),
			}
		)
	end

	for index = 1, 4 do
		local angle = index * GOLDEN_ANGLE + 25
		local size = 18 + 8 * noise(index, 79)
		add(
			parts,
			parent,
			("S5_Rubble_%d"):format(index),
			Vector3.new(
				field.X + math.cos(math.rad(angle)) * 60,
				floorTop + size * 0.3,
				field.Z + math.sin(math.rad(angle)) * 55
			),
			Vector3.new(size, size * 0.6, size * 0.8),
			{ material = Enum.Material.Slate, color = Color3.fromRGB(64, 70, 78), yaw = angle }
		)
	end
end

local function buildS6Chasm(parts: { PartSpec })
	local parent = zonePath("Shelf", "S6")
	local chasm = ZoneConfig.Chasm
	local spanX = chasm.maxX - chasm.minX
	local spanZ = chasm.maxZ - chasm.minZ
	local centreZ = (chasm.minZ + chasm.maxZ) / 2

	-- §3.4/§7: the deepest playable point, built dark and unfinished on purpose — this is
	-- where the next update's content goes.
	add(parts, parent, "S6_Floor", Vector3.new(0, chasm.floorY - 2, centreZ), Vector3.new(spanX, 4, spanZ), {
		material = Enum.Material.Slate,
		color = DEEP_VOID,
	})

	-- §3.4: "walls from 12 large Parts 80 x 30 x 20 stepped down on both sides".
	for _, side in { { -1, "W" }, { 1, "E" } } do
		for tier = 1, 2 do
			for step = 1, 3 do
				add(
					parts,
					parent,
					("S6_Wall_%s_%d_%d"):format(side[2], tier, step),
					Vector3.new(side[1] * 60, chasm.floorY + 15 + (tier - 1) * 14, chasm.minZ + 30 + (step - 1) * 50),
					Vector3.new(80, 30, 20),
					{
						material = Enum.Material.Slate,
						color = if tier == 1 then SHELF_ROCK_DARK else Color3.fromRGB(36, 42, 50),
						yaw = side[1] * (4 + 6 * noise(tier * 10 + step, 83)),
					}
				)
			end
		end
	end

	for index = 1, 6 do
		local side = if index <= 3 then -1 else 1
		local slot = ((index - 1) % 3) + 1
		add(
			parts,
			parent,
			("S6_LipRock_%d"):format(index),
			Vector3.new(side * 14 * slot, -192, chasm.minZ + 12 + (slot - 1) * 26),
			Vector3.new(30, 12, 40),
			{ material = Enum.Material.Slate, color = Color3.fromRGB(40, 46, 54), yaw = 6 * noise(index, 89) }
		)
	end

	for index = 1, 3 do
		add(
			parts,
			parent,
			("S6_Rubble_%d"):format(index),
			Vector3.new(-20 + 20 * index, chasm.floorY + 8, centreZ - 60 + 30 * index),
			Vector3.new(20, 14, 20),
			{ material = Enum.Material.Slate, color = Color3.fromRGB(34, 40, 48), yaw = 25 * noise(index, 97) }
		)
	end
end

-- ============================================================================
-- World props, water and spawn anchors (§1, §3.0, §4.6, Appendix A)
-- ============================================================================

local function buildSpawns(parts: { PartSpec }, layout: Layout)
	-- §11: the player spawns at (0, 8, -20) on the dock, standing, facing the water (+Z).
	-- This SpawnLocation replaces the stand-in pad the scaffold shipped: it sits on L1_Deck's
	-- top (Y 7) and its LookVector points +Z, which is the way a spawned character faces.
	local spawnPoint = ZoneConfig.InteractionPoints.PlayerSpawn
	add(parts, SPAWNS_FOLDER, "SpawnLocation", spawnPoint - Vector3.new(0, 0.5, 0), Vector3.new(12, 1, 12), {
		class = "SpawnLocation",
		material = Enum.Material.Wood,
		color = DOCK_WOOD,
		cf = CFrame.new(spawnPoint - Vector3.new(0, 0.5, 0)) * CFrame.Angles(0, math.pi, 0),
		props = { Duration = 0, Neutral = true, Enabled = true },
	})

	-- L1's four prompt-host props live here (Appendix A), not in the Shallows folder, but by
	-- the naming rule they are L1 parts and are counted as such. Their ProximityPrompts are
	-- created now; their verbs are the owning service's TODO.
	local rack = promptHostById("RodRack")
	local rackAt = if rack ~= nil then rack.position else Vector3.new(12, 9, -10)
	add(parts, SPAWNS_FOLDER, "L1_RodRack", rackAt, Vector3.new(7, 3, 2), {
		material = Enum.Material.Wood,
		color = DOCK_WOOD_DARK,
		attributes = { PromptId = "RodRack" },
		prompt = rack,
	})
	add(parts, SPAWNS_FOLDER, "L1_RodRack_Top", rackAt + Vector3.new(0, 1.75, 0), Vector3.new(7.4, 0.6, 2.4), {
		material = Enum.Material.Metal,
		color = Color3.fromRGB(180, 180, 190),
	})

	local trader = promptHostById("TideTrader")
	local traderAt = if trader ~= nil then trader.position else Vector3.new(-14, 9, -10)
	add(parts, SPAWNS_FOLDER, "L1_TideTrader", traderAt, Vector3.new(8, 6, 8), {
		material = Enum.Material.Wood,
		color = Color3.fromRGB(92, 70, 54),
		attributes = { PromptId = "TideTrader" },
		prompt = trader,
	})
	add(parts, SPAWNS_FOLDER, "L1_TideTrader_Sign", traderAt + Vector3.new(0, 4.5, 4.2), Vector3.new(7, 2, 0.6), {
		material = Enum.Material.Neon,
		color = WARM_NEON,
		transparency = 0.1,
		decor = true,
	})

	add(parts, SPAWNS_FOLDER, "DiveMarker", ZoneConfig.InteractionPoints.DiveMarker, Vector3.new(12, 0.6, 2.2), {
		material = Enum.Material.Neon,
		color = GATE_NEON,
		transparency = 0.2,
		decor = true,
		attributes = { PromptId = "DiveMarker" },
		prompt = promptHostById("DiveMarker"),
		billboard = { text = "DIVE HERE", color = GATE_NEON },
	})

	-- §4.6 spawn anchors: one invisible host part per species (Appendix A: "spawn volumes
	-- are Attachments rather than Parts, so they cannot be rendered by accident") with an
	-- Attachment per coordinate. FishService spawns into these; WorldService never does.
	local groups = {
		{
			species = "SilverSardine",
			config = SpawnConfig.SilverSardine,
			list = SpawnConfig.SilverSardine.anchors,
			prefix = "Node",
		},
		{
			species = "SunsetGrouper",
			config = SpawnConfig.SunsetGrouper,
			list = SpawnConfig.SunsetGrouper.nodes,
			prefix = "Node",
		},
		{ species = "ReefBass", config = SpawnConfig.ReefBass, list = SpawnConfig.ReefBass.nodes, prefix = "Node" },
		{ species = "LanternEel", config = SpawnConfig.LanternEel, list = SpawnConfig.LanternEel.dens, prefix = "Den" },
		{ species = "GhostRay", config = SpawnConfig.GhostRay, list = SpawnConfig.GhostRay.nodes, prefix = "Node" },
	}

	for _, group in groups do
		local folder = ("%s/%s"):format(SPAWNS_FOLDER, group.species)
		table.insert(layout.folders, folder)

		local centre = Vector3.new(0, 0, 0)
		for _, position in group.list do
			centre += position
		end
		centre = centre / #group.list

		local hostName = ("%s_AnchorHost"):format(group.species)
		add(parts, folder, hostName, centre, Vector3.new(1, 1, 1), {
			transparency = 1,
			decor = true,
			collide = false,
			query = false,
			outsideBuildZone = true, -- it is a volume anchor, not scenery
			attributes = { Species = group.species, Kind = group.config.kind, AnchorCount = #group.list },
		})

		local index = 0
		for _, position in group.list do
			index += 1
			local attributes: { [string]: any } = {
				Species = group.species,
				Kind = group.config.kind,
				Index = index,
				NodeName = ("%s_%d"):format(group.prefix, index),
			}
			-- Every other scalar field of the species' SpawnConfig entry is a behaviour
			-- parameter (box, waypointRadius, driftRadius, loopBox, openingFacing): copy them
			-- onto the anchor so FishService reads its rules from one place.
			for key, value in group.config do
				if key ~= "kind" and type(value) ~= "table" then
					attributes[key] = value
				end
			end
			table.insert(layout.anchors, {
				name = ("%s_%d"):format(group.prefix, index),
				host = hostName,
				hostParent = folder,
				position = position - centre,
				attributes = attributes,
			})
		end
	end
end

local function buildWater(parts: { PartSpec }, layout: Layout)
	local region = ZoneConfig.WaterRegion
	local size = Vector3.new(region.maxX - region.minX, region.topY - region.bottomY, region.maxZ - region.minZ)
	local centre = Vector3.new(
		(region.minX + region.maxX) / 2,
		(region.topY + region.bottomY) / 2,
		(region.minZ + region.maxZ) / 2
	)
	layout.water = { size = size }

	-- One invisible marker lets a scripter or the artist see the water volume; the water
	-- itself is Terrain (§3.0: "Terrain holds water and nothing else").
	add(parts, WATER_FOLDER, LandmarkConfig.WorldPropNames.WaterRegionMarker, centre, size, {
		transparency = 1,
		decor = true,
		collide = false,
		query = false,
		outsideBuildZone = true, -- it *is* the water volume (§3.0), which is wider than the build zone
		attributes = { TopY = region.topY, BottomY = region.bottomY },
	})
end

-- ============================================================================
-- Layout
-- ============================================================================

--- The whole world as data: folders, part specs, spawn anchors and the water volume.
--- Pure — no Instances are touched, so it can be asserted before anything is built.
function WorldService:GetLayout(): Layout
	local layout: Layout = { folders = {}, parts = {}, anchors = {}, water = { size = Vector3.new(0, 0, 0) } }

	table.insert(layout.folders, WORLD_FOLDER)
	table.insert(layout.folders, WATER_FOLDER)
	table.insert(layout.folders, SPAWNS_FOLDER)
	for zoneId in ZoneConfig.Zones do
		table.insert(layout.folders, ("%s/%s"):format(WORLD_FOLDER, zoneId))
	end
	for _, landmark in LandmarkConfig.Landmarks do
		table.insert(layout.folders, zonePath(landmark.zone, landmark.id))
	end
	table.insert(layout.folders, basePath("Shallows"))
	table.insert(layout.folders, basePath("Shelf"))

	buildShallowsSeabed(layout.parts)
	buildShelfSeabed(layout.parts)

	buildL1Dock(layout.parts)
	buildL2CoralSpire(layout.parts)
	buildL3Trawler(layout.parts)
	buildL4Kelp(layout.parts)
	buildL5DeepHole(layout.parts)
	buildL6SandChannels(layout.parts)
	buildL7FishRocks(layout.parts)
	-- L8 Sun Shafts is deliberately 0 parts (§3.2): the Technical Artist owns it.
	buildL9Buoys(layout.parts)

	buildRimWall(layout.parts)
	buildRimGate(layout.parts)
	buildRimCurrent(layout.parts)

	buildS1Lip(layout.parts)
	buildS2CreviceRow(layout.parts)
	buildS3GhostLedge(layout.parts)
	buildS4ThermalVents(layout.parts)
	buildS5SunkenPillars(layout.parts)
	buildS6Chasm(layout.parts)

	buildSpawns(layout.parts, layout)
	buildWater(layout.parts, layout)

	return layout
end

--- Everything the built layout must satisfy: each landmark's part count from §3.2-§3.4,
--- the Appendix A world total, the §3.0 build zone, and the §4.6 anchor counts.
--- Returns a list of human-readable problems (empty = clean). Pure, so it can be run before
--- or after Build().
function WorldService:ValidateLayout(layout: Layout?): { string }
	local resolved = if layout ~= nil then layout else self:GetLayout()
	local problems: { string } = {}

	local byLandmark: { [string]: number } = {}
	for _, spec in resolved.parts do
		local id = spec.name:match("^([LRS]%d)_")
		if id ~= nil then
			byLandmark[id] = (byLandmark[id] or 0) + 1
		end
	end
	for _, landmark in LandmarkConfig.Landmarks do
		local actual = byLandmark[landmark.id] or 0
		if actual ~= landmark.parts then
			table.insert(
				problems,
				("%s %s: built %d parts, LandmarkConfig says %d"):format(
					landmark.id,
					landmark.name,
					actual,
					landmark.parts
				)
			)
		end
	end

	if #resolved.parts ~= LandmarkConfig.PartBudget.World then
		table.insert(
			problems,
			("world total: built %d parts, LandmarkConfig.PartBudget.World says %d"):format(
				#resolved.parts,
				LandmarkConfig.PartBudget.World
			)
		)
	end

	-- §3.0: nothing outside the build zone (the water volume and its marker are the space
	-- itself, so they are exempt by flag rather than by exception).
	for _, spec in resolved.parts do
		if not spec.outsideBuildZone then
			local p = spec.cf.Position
			local size = spec.size
			local box = ZoneConfig.BuildZone
			if
				p.X - size.X / 2 < box.minX
				or p.X + size.X / 2 > box.maxX
				or p.Z - size.Z / 2 < box.minZ
				or p.Z + size.Z / 2 > box.maxZ
			then
				table.insert(problems, ("%s is placed outside ZoneConfig.BuildZone"):format(spec.name))
			end
		end
	end
	-- §11 step 1: the player is created standing on the pad, so nothing solid may stand in that
	-- column. This is a *spawn* rule, not a scenery rule: a character that exists inside an
	-- anchored part is not refused by Roblox, it is depenetrated — which is what an avatar that
	-- tumbles or flips the moment the place is played actually is. The pad's own footprint is
	-- the volume, and the pad is the only part exempt from it.
	local intruders, spawnMin, spawnMax = spawnVolumeIntruders(resolved)
	if #intruders > 0 then
		table.insert(
			problems,
			("%s: %d part(s) stand in the player's spawn volume X %.1f..%.1f, Y %.1f..%.1f, Z %.1f..%.1f"):format(
				table.concat(intruders, ", "),
				#intruders,
				spawnMin.X,
				spawnMax.X,
				spawnMin.Y,
				spawnMax.Y,
				spawnMin.Z,
				spawnMax.Z
			)
		)
	end

	-- §Appendix A: a scripter must be able to find any world part by name, so names have to
	-- be unique inside their folder.
	local seen: { [string]: boolean } = {}
	for _, spec in resolved.parts do
		local key = ("%s/%s"):format(spec.parent, spec.name)
		if seen[key] then
			table.insert(problems, ("duplicate part name %s in %s"):format(spec.name, spec.parent))
		end
		seen[key] = true
	end
	for _, anchor in resolved.anchors do
		local key = ("%s/%s"):format(anchor.hostParent, anchor.name)
		if seen[key] then
			table.insert(problems, ("duplicate anchor name %s in %s"):format(anchor.name, anchor.hostParent))
		end
		seen[key] = true
	end

	-- §4.6: one anchor per coordinate, per species.
	local counts: { [string]: number } = {}
	for _, anchor in resolved.anchors do
		counts[anchor.attributes.Species] = (counts[anchor.attributes.Species] or 0) + 1
	end
	local groups = {
		{ "SilverSardine", #SpawnConfig.SilverSardine.anchors },
		{ "SunsetGrouper", #SpawnConfig.SunsetGrouper.nodes },
		{ "ReefBass", #SpawnConfig.ReefBass.nodes },
		{ "LanternEel", #SpawnConfig.LanternEel.dens },
		{ "GhostRay", #SpawnConfig.GhostRay.nodes },
	}
	for _, group in groups do
		if (counts[group[1]] or 0) ~= group[2] then
			table.insert(
				problems,
				("%s: %d spawn anchors, SpawnConfig has %d"):format(group[1], counts[group[1]] or 0, group[2])
			)
		end
	end

	return problems
end

-- ============================================================================
-- Build (idempotent)
-- ============================================================================

local function folderAt(root: Instance, path: string): Instance
	local current = root
	for segment in path:gmatch("[^/]+") do
		local nextFolder = current:FindFirstChild(segment)
		if nextFolder == nil then
			local created: any = Instance.new("Folder")
			created.Name = segment
			created.Parent = current
			nextFolder = created
		end
		current = nextFolder
	end
	return current
end

local function clearChildren(folder: Instance)
	for _, child in folder:GetChildren() do
		child:Destroy()
	end
end

local function applyPrompt(part: any, spec: PartSpec)
	if spec.prompt == nil then
		return
	end
	local proximity: any = Instance.new("ProximityPrompt")
	proximity.Name = "Prompt"
	proximity.ActionText = spec.prompt.actionText or "Use"
	proximity.ObjectText = spec.prompt.objectText or ""
	proximity.HoldDuration = spec.prompt.holdDuration or 0
	proximity.MaxActivationDistance = 12
	proximity.RequiresLineOfSight = false
	proximity.KeyboardKeyCode = Enum.KeyCode.E -- §1: "E — Take Rusty Rod"
	proximity.Parent = part
	proximity:SetAttribute("HostId", spec.attributes and spec.attributes.PromptId or spec.name)
	local hostId = spec.attributes and spec.attributes.PromptId
	if hostId ~= nil then
		promptById[hostId] = proximity
	end
end

local function applyBillboard(part: any, spec: PartSpec)
	if spec.billboard == nil then
		return
	end
	local gui: any = Instance.new("BillboardGui")
	gui.Name = "Sign"
	gui.Size = UDim2.fromScale(14, 3.5)
	gui.StudsOffsetWorldSpace = Vector3.new(0, 2.5, 0)
	local label: any = Instance.new("TextLabel")
	label.Name = "Text"
	label.BackgroundTransparency = 1
	label.Size = UDim2.fromScale(1, 1)
	label.Font = Enum.Font.GothamBold
	label.TextScaled = true
	label.TextColor3 = spec.billboard.color or Color3.fromRGB(255, 255, 255)
	label.Text = spec.billboard.text or ""
	label.Parent = gui
	gui.Parent = part
end

--- Creates the world. Safe to call repeatedly: every folder it owns is cleared first, so a
--- server restart or a second call rebuilds rather than duplicating (and the part count is
--- identical every time).
function WorldService:Build(): { [string]: any }
	local startedAt = os.clock()
	local layout = self:GetLayout()

	local rootInstance = Workspace:FindFirstChild(ROOT_NAME)
	if rootInstance == nil then
		local created: any = Instance.new("Folder")
		created.Name = ROOT_NAME
		created.Parent = Workspace
		rootInstance = created
	end
	local root: any = rootInstance

	local world = folderAt(root, WORLD_FOLDER)
	local water = folderAt(root, WATER_FOLDER)
	local spawns = folderAt(root, SPAWNS_FOLDER)

	-- Idempotency: drop everything this service owns, then rebuild it. Fish/ is untouched.
	clearChildren(world)
	clearChildren(water)
	clearChildren(spawns)
	promptById = {}

	for _, path in layout.folders do
		folderAt(root, path)
	end

	local byKey: { [string]: any } = {}
	local counts: { [string]: number } = {}
	for _, spec in layout.parts do
		local part: any = Instance.new(spec.class or "Part")
		part.Name = spec.name

		if spec.shape ~= nil and part:IsA("Part") then
			part.Shape = spec.shape
		end

		local collide = spec.collide
		if collide == nil then
			collide = not spec.decor
		end
		local query = spec.query
		if query == nil then
			query = not spec.decor
		end

		part.Anchored = true
		part.CanCollide = collide
		part.CanQuery = query
		part.CanTouch = false -- nothing in the game watches Touched on world geometry
		part.CastShadow = not spec.decor
		part.Material = spec.material
		part.Color = spec.color
		part.Transparency = spec.transparency
		part.TopSurface = Enum.SurfaceType.Smooth
		part.BottomSurface = Enum.SurfaceType.Smooth
		part.Size = spec.size
		part.CFrame = spec.cf

		for key, value in spec.props or {} do
			part[key] = value
		end
		for key, value in spec.attributes or {} do
			part:SetAttribute(key, value)
		end
		if spec.light ~= nil then
			local light: any = Instance.new("PointLight")
			light.Name = "Glow"
			light.Color = spec.light.color
			light.Brightness = spec.light.brightness
			light.Range = spec.light.range
			light.Shadows = false
			light.Parent = part
		end
		applyPrompt(part, spec)
		applyBillboard(part, spec)

		part.Parent = folderAt(root, spec.parent)
		byKey[("%s/%s"):format(spec.parent, spec.name)] = part

		local group = spec.parent:match("^World/([^/]+)") or spec.parent:match("^([^/]+)")
		if group ~= nil then
			counts[group] = (counts[group] or 0) + 1
		end
	end

	-- Spawn anchors: Attachments on their species' host part (§4.6). Attachments cannot be
	-- rendered, which is exactly why Appendix A asks for them instead of Parts.
	local anchorCounts: { [string]: number } = {}
	for _, anchor in layout.anchors do
		local host = byKey[("%s/%s"):format(anchor.hostParent, anchor.host)]
		if host ~= nil then
			local attachment: any = Instance.new("Attachment")
			attachment.Name = anchor.name
			attachment.Position = anchor.position
			for key, value in anchor.attributes do
				attachment:SetAttribute(key, value)
			end
			attachment.Parent = host
			local species = anchor.attributes.Species
			anchorCounts[species] = (anchorCounts[species] or 0) + 1
		end
	end

	-- Water: §3.0 — one Terrain fill and nothing else. Cleared first so re-running cannot
	-- stack two volumes.
	local terrain: any = Workspace.Terrain
	local centre = self:WaterCentre()
	terrain:FillBlock(CFrame.new(centre), layout.water.size, Enum.Material.Air)
	terrain:FillBlock(CFrame.new(centre), layout.water.size, Enum.Material.Water)

	local total = 0
	for _, count in counts do
		total += count
	end

	local report = {
		parts = total,
		counts = counts,
		anchors = anchorCounts,
		seconds = os.clock() - startedAt,
		problems = self:ValidateLayout(layout),
	}
	lastReport = report
	return report
end

--- The centre of the §3.0 water volume.
function WorldService:WaterCentre(): Vector3
	local region = ZoneConfig.WaterRegion
	return Vector3.new(
		(region.minX + region.maxX) / 2,
		(region.topY + region.bottomY) / 2,
		(region.minZ + region.maxZ) / 2
	)
end

-- ============================================================================
-- Public server API
-- ============================================================================

--- Which zone a world position sits in ("Shallows" | "Shelf" | nil between them, §3.1).
function WorldService:GetZoneAt(position: Vector3): string?
	for id, zone in ZoneConfig.Zones do
		local footprint = zone.footprint
		if
			position.X >= footprint.minX
			and position.X <= footprint.maxX
			and position.Z >= footprint.minZ
			and position.Z <= footprint.maxZ
		then
			return id
		end
	end
	return nil
end

--- Which zone a depth belongs to, using ZoneConfig.DepthBand (§3, Appendix C).
--- Depth is positive studs below sea level. The two playable zones have disjoint bands
--- (Shallows 0-85, Shelf 100-215), so they are tested first and the Rim — the transition
--- band that deliberately overlaps both — is only reported when neither zone band matches.
function WorldService:GetZoneForDepth(depthStuds: number): string?
	for id, zone in ZoneConfig.Zones do
		local band = zone.depthBand
		if depthStuds >= -band.top and depthStuds <= -band.bottom then
			return id
		end
	end
	local rim = ZoneConfig.DepthBand.Rim
	if depthStuds >= -rim.top and depthStuds <= -rim.bottom then
		return "Rim"
	end
	return nil
end

--- A named interaction point from ZoneConfig.InteractionPoints ("RodRack", "TideTrader",
--- "DiveMarker", "PlayerSpawn").
function WorldService:GetInteractionPoint(name: string): Vector3?
	return ZoneConfig.InteractionPoints[name]
end

--- §1 step 1: where the player appears, standing on the dock facing the water.
function WorldService:GetSpawnPosition(): Vector3
	return ZoneConfig.InteractionPoints.PlayerSpawn
end

--- Total parts in the built world (World + Water + Spawns; fish excluded).
function WorldService:GetPartCount(): number
	local report = lastReport
	return if report ~= nil then report.parts else 0
end

--- The species' spawn-anchor folder (Workspace.DeepTide.Spawns.<species>, §4.6). FishService
--- reads the Attachments inside; nothing here spawns fish.
function WorldService:GetAnchorFolder(species: string): Instance?
	local root = Workspace:FindFirstChild(ROOT_NAME)
	if root == nil then
		return nil
	end
	local spawns = root:FindFirstChild(SPAWNS_FOLDER)
	if spawns == nil then
		return nil
	end
	return spawns:FindFirstChild(species)
end

--- The ProximityPrompt a service wires its verb to (§1 steps 2, 3, 8). The prompt instance
--- exists from Build() on; connecting `.Triggered` is the owning service's job.
function WorldService:GetPrompt(id: string): ProximityPrompt?
	return promptById[id]
end

--- §9: announce a zone entry — fires ZoneChanged and the 3 s top-centre banner
--- (ZoneConfig.ZoneEntryBannerSeconds), first entry only per player.
function WorldService:AnnounceZone(player: Player, zoneId: string)
	local seen = zonesEntered[player]
	if seen == nil then
		seen = {}
		zonesEntered[player] = seen
	end
	if seen[zoneId] then
		return
	end
	seen[zoneId] = true
	Remotes.get("ZoneChanged"):FireClient(player, zoneId)
end

--- Has this player already been announced into a zone? (Crossing back and forth must not
--- re-banner: §9 says first entry.)
function WorldService:HasEnteredZone(player: Player, zoneId: string): boolean
	local seen = zonesEntered[player]
	return seen ~= nil and seen[zoneId] == true
end

--- §3.1/§3.3/§9: the zone-entry rule, in one place.
---
--- A zone is *entered* when the player is inside its footprint **and** inside its water band —
--- swimming the surface over the Rim is not reaching The Shelf. An entry with the gear rating
--- that opens the zone (§3.1's "gear rating required" row) announces it; an entry without that
--- gear says what the water needs, named, rated and priced, so the wall reads as a threshold
--- and a shopping list rather than a texture change. The physical consequence for a diver who
--- keeps going is §5.4's auto-surface rule, which DiveService owns.
---
--- Returns the zone id the player is in, or nil. Called from DiveService's existing 10 Hz
--- player loop so the world does not need a second heartbeat.
function WorldService:UpdateZone(player: Player): string?
	local character = player.Character
	if character == nil then
		return nil
	end
	local root = character:FindFirstChild("HumanoidRootPart")
	if root == nil then
		return nil
	end
	local position = (root :: BasePart).Position
	local zoneId = self:GetZoneAt(position)
	if zoneId == nil then
		return nil
	end

	local zone = ZoneConfig.Zones[zoneId]
	if zone == nil then
		return zoneId
	end

	local depth = ZoneConfig.SeaLevelY - position.Y
	if
		ZoneConfig.ZoneEntry.enterBelowBandTop
		and depth < -zone.depthBand.top - ZoneConfig.ZoneEntry.surfaceSlackStuds
	then
		-- Above the zone's water: not an entry, so nothing is announced and nothing is refused.
		-- (The dock and the surface count for the Shallows, whose water starts at sea level, but
		-- not for The Shelf, whose water starts 100 m down.)
		return zoneId
	end

	local access = self:GetZoneAccess(player, zoneId)
	if access == nil or access.opens then
		self:AnnounceZone(player, zoneId)
		return zoneId
	end

	self:_SayZoneRequirement(player, zone, access)
	return zoneId
end

--- Ask GearService what this player is wearing and what the zone needs. Isolated (and pcall'd)
--- so the world can be built and queried on its own, without the gear service registered.
function WorldService:GetZoneAccess(player: Player, zoneId: string): { [string]: any }?
	if not ZoneConfig.ZoneEntry.requireRating then
		return { opens = true }
	end
	local ok, gearService = pcall(function()
		return Knit.GetService("GearService")
	end)
	if not ok or type(gearService) ~= "table" then
		return nil
	end
	local answered, access = pcall(function()
		return (gearService :: any):GetZoneAccess(player, zoneId)
	end)
	if not answered or type(access) ~= "table" then
		return nil
	end
	return access
end

--- The refusal line (§9): the zone, the gear that opens it, its rating and its price.
function WorldService:_SayZoneRequirement(player: Player, zone: { [string]: any }, access: { [string]: any })
	if access.gearName == nil then
		return
	end
	local now = os.clock()
	local last = requirementSaidAt[player]
	if last ~= nil and now - last < ZoneConfig.ZoneEntry.requirementCooldownSeconds then
		return
	end
	requirementSaidAt[player] = now

	Remotes.get("Notify"):FireClient(player, {
		text = ZoneConfig.ZoneEntry.requirementFormat:format(
			zone.displayName,
			string.upper(access.gearName),
			access.gearRating,
			access.gearCost
		),
		seconds = ZoneConfig.ZoneEntry.requirementSeconds,
	})
end

--- §1 steps 2, 3 and 8: the ProximityPrompts on the Rod Rack, the dive marker and the Tide
--- Trader already exist from Build(); this connects each one to the service that owns its verb.
--- No prompt is left without a handler — a prompt that does nothing is worse than no prompt.
--- Returns the prompts it wired.
function WorldService:WirePrompts(): { [string]: ProximityPrompt? }
	local found: { [string]: ProximityPrompt? } = {}
	for _, host in LandmarkConfig.PromptHosts do
		local prompt = promptById[host.id]
		found[host.id] = prompt
		if prompt ~= nil then
			prompt.Triggered:Connect(function(player: Player)
				WorldService:_RunPromptVerb(host, player)
			end)
		end
	end
	return found
end

--- One prompt's verb. Each host names a service method; the service owns the rule (the rod
--- handout, the shop panel, the dive hint), the world only owns the trigger.
function WorldService:_RunPromptVerb(host: { [string]: any }, player: Player)
	local owner = PROMPT_VERB_SERVICE[host.id]
	local verb = PROMPT_VERB_METHOD[host.id]
	if owner ~= nil and verb ~= nil then
		local ok, service = pcall(function()
			return Knit.GetService(owner)
		end)
		if ok and type(service) == "table" then
			pcall(function()
				(service :: any)[verb](service, player)
			end)
		end
		return
	end

	-- §1 step 3: the DIVE HERE marker's verb is the dive hint itself (LandmarkConfig).
	if host.hint ~= nil then
		pcall(function()
			Remotes.get("Notify"):FireClient(player, {
				text = host.hint,
				seconds = LandmarkConfig.PromptHintSeconds,
			})
		end)
	end
end

--- Prompt hosts that would do nothing when used: no service verb and no hint. Empty is the
--- only acceptable answer (§1 steps 2, 3, 8).
function WorldService:UnwiredPromptIds(): { string }
	local loose: { string } = {}
	for _, host in LandmarkConfig.PromptHosts do
		local hasVerb = PROMPT_VERB_SERVICE[host.id] ~= nil and PROMPT_VERB_METHOD[host.id] ~= nil
		if not hasVerb and host.hint == nil then
			table.insert(loose, host.id)
		end
	end
	return loose
end

--- Per-player teardown (§PlayerService's release sweep): a rejoining player hears their zone
--- banners again, and the requirement line is not throttled by a previous session's clock.
function WorldService:ReleasePlayer(player: Player)
	zonesEntered[player] = nil
	requirementSaidAt[player] = nil
end

--- Human-readable one-liner for the boot output / the lead's status checks.
function WorldService:SummaryLine(): string
	local report = lastReport
	if report == nil then
		return "world: not built"
	end
	local counts = report.counts
	local anchorTotal = 0
	for _, count in report.anchors do
		anchorTotal += count
	end
	return ("world built in %d ms — %d parts (Shallows %d, Rim %d, Shelf %d) + Spawns %d, Water %d · %d spawn anchors · %d layout problems"):format(
		math.floor(report.seconds * 1000 + 0.5),
		report.parts,
		counts.Shallows or 0,
		counts.Rim or 0,
		counts.Shelf or 0,
		counts.Spawns or 0,
		counts.Water or 0,
		anchorTotal,
		#report.problems
	)
end

-- ============================================================================
-- Client surface
-- ============================================================================

function WorldService.Client:GetInteractionPoint(name: string): Vector3?
	return self.Server:GetInteractionPoint(name)
end

-- ============================================================================
-- Knit lifecycle
-- ============================================================================

function WorldService:KnitInit()
	local report = self:Build()
	for _, problem in report.problems do
		warn("[Deep Tide] world: " .. problem)
	end
end

function WorldService:KnitStart()
	self:WirePrompts()
	for _, id in self:UnwiredPromptIds() do
		warn(("[Deep Tide] world: prompt '%s' has no verb — a prompt must never do nothing"):format(id))
	end
	print("[Deep Tide] " .. self:SummaryLine())
end

return WorldService
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
  <Item class="ServerStorage" referent="128">
    <Properties>
      <string name="Name">ServerStorage</string>
    </Properties>
    <Item class="Folder" referent="129">
      <Properties>
        <string name="Name">DeepTide</string>
      </Properties>
      <Item class="Folder" referent="130">
        <Properties>
          <string name="Name">Dens</string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="StarterPlayer" referent="131">
    <Properties>
      <string name="Name">StarterPlayer</string>
    </Properties>
    <Item class="StarterPlayerScripts" referent="132">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="LocalScript" referent="133">
        <Properties>
          <string name="Name">DeepTide</string>
          <string name="Source"><![CDATA[--!strict
--[[
	Deep Tide — client bootstrap
	Source: GDD Appendix B (the client mirrors the server: controllers registered with Knit).

	The only LocalScript on the client. It waits for the server-created Remotes folder,
	registers every ModuleScript in StarterPlayerScripts.DeepTide.Controllers and starts Knit.
	It prints nothing: the contract is one startup line, and the server owns it.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Knit = require(ReplicatedStorage.Packages.Knit)
local Remotes = require(ReplicatedStorage.DeepTide.Modules.Remotes)

local DeepTide = script.Parent -- StarterPlayerScripts.DeepTide
local Controllers = DeepTide:WaitForChild("Controllers")

-- Blocks until the server has created ReplicatedStorage.DeepTide.Remotes (Appendix B),
-- so no controller can fire into a missing remote during a slow join.
Remotes.getFolder()

Knit.AddControllers(Controllers)

Knit.Start():catch(function(err: any)
	warn("[Deep Tide] Knit client failed to start: " .. tostring(err))
end)
]]></string>
        </Properties>
        <Item class="Folder" referent="134">
          <Properties>
            <string name="Name">Controllers</string>
          </Properties>
          <Item class="ModuleScript" referent="135">
            <Properties>
              <string name="Name">AtmosphereController</string>
              <string name="Source"><![CDATA[--!strict
--[[
    AtmosphereController — the client half of §8.1/§8.2/the §8.8 screen effect.
    Source: GDD §3.0 (depth is -Y at the head; Sky at 17.5), §8.1 (two-world lighting, one
            interpolation, cross-fade never a snap), §8.2 (fog IS the depth gauge: the player's
            sense of depth must equal the number on the HUD), §8.3 (sun rays die by 60 studs),
            §8.8 (the air alarm must be impossible to miss and must never be muted by the mini-game).

    WHY THIS RUNS ON THE CLIENT
      Fog distance, ambient and the shafts' strength are functions of *this* camera's depth, and
      the server cannot know ten players' camera depths without ten times the traffic. So the
      server sets the baseline once (VisualService.ApplyLightingBaseline) and this controller owns
      the truth from then on, at LightingConfig.SampleHz (10 Hz — fog that steps 10 times a second
      is indistinguishable from fog that steps 60 times, and it is not a per-frame cost).

    WHAT IT WRITES (one plan, five instances)
      Lighting.FogEnd / FogStart / FogColor / Ambient / OutdoorAmbient / Brightness /
      ExposureCompensation / EnvironmentDiffuseScale / EnvironmentSpecularScale
      Lighting.DeepTideAtmosphere, Lighting.DeepTideBloom, Lighting.DeepTideGrade
      Lighting.DeepTideOxygen + Lighting.DeepTideOxygenBlur (the §8.8 alarm — post-process, so it
      tints the whole frame and can never occlude the tension track)
      LocalTransparencyModifier on the sun-shaft parts (client-only: dimming them costs no
      replication and no other screen can see it)

    IT DOES NOT TOUCH THE HUD. The depth/air labels and the red vignette belong to DepthController
    and the UI/UX pass. This is the water and the screen, not the chrome.
]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Knit = require(ReplicatedStorage.Packages.Knit)

local Atmosphere = require(ReplicatedStorage.DeepTide.Modules.Atmosphere)
local Remotes = require(ReplicatedStorage.DeepTide.Modules.Remotes)
local Types = require(ReplicatedStorage.DeepTide.Modules.Types)
local LightingConfig = require(ReplicatedStorage.DeepTide.Config.LightingConfig)
local VisualConfig = require(ReplicatedStorage.DeepTide.Config.VisualConfig)
local ZoneConfig = require(ReplicatedStorage.DeepTide.Config.ZoneConfig)

local AtmosphereController = Knit.CreateController({
	Name = "AtmosphereController",
})

local player = Players.LocalPlayer

-- The last dive state the server sent (nothing here is inferred when the server has said it).
local state: Types.DiveState = {
	air = 0,
	airCapacity = 0,
	depth = 0,
	depthRating = 0,
	exceeded = false,
	submerged = false,
}

local effects: { [string]: any } = {}
local shaftParts: { any } = {}
local shaftAlpha = LightingConfig.SunShafts.aboveWaterAlpha
local clock = 0

-- ============================================================================
-- Instance plumbing
-- ============================================================================

local function lighting(): any
	return game:GetService("Lighting")
end

--- Find (or create) one of the instances this controller drives. VisualService creates them
--- server-side at boot, so on a normal join this is a lookup; `create` only matters if the client
--- ran before the server's visuals replicated, where a missing Atmosphere would otherwise mean an
--- unlit world rather than a slightly later-lit one.
local function effect(name: string, className: string): any
	local existing = effects[name]
	if existing ~= nil then
		return existing
	end
	local lightingService = lighting()
	local found = lightingService:FindFirstChild(name)
	if found == nil then
		found = Instance.new(className)
		found.Name = name
		found.Parent = lightingService
	end
	effects[name] = found
	return found
end

local function collectShafts()
	shaftParts = {}
	local root = game:GetService("Workspace"):FindFirstChild("DeepTide")
	local visual = if root ~= nil then root:FindFirstChild(VisualConfig.InstanceNames.Root) else nil
	local shallows = if visual ~= nil then visual:FindFirstChild("Shallows") else nil
	local folder = if shallows ~= nil then shallows:FindFirstChild("Shafts") else nil
	if folder == nil then
		return
	end
	for _, child in folder:GetChildren() do
		if child:IsA("BasePart") then
			table.insert(shaftParts, child)
		end
	end
end

-- ============================================================================
-- One sample: the whole water, from one number
-- ============================================================================

--- Applies Atmosphere.Plan(depth) to the place. Called at LightingConfig.SampleHz.
function AtmosphereController:Apply(depthStuds: number, dt: number)
	local plan = Atmosphere.Plan(depthStuds)
	local names = LightingConfig.InstanceNames
	local lightingService = lighting()

	-- §8.2: the depth gauge. This is the number the player's eye reads against the HUD's DEPTH.
	lightingService.FogEnd = plan.fogEnd
	lightingService.FogStart = plan.fogStart
	lightingService.FogColor = plan.fogColor
	lightingService.Ambient = plan.ambient
	lightingService.OutdoorAmbient = plan.outdoorAmbient
	lightingService.Brightness = plan.brightness
	lightingService.ExposureCompensation = plan.exposureCompensation
	lightingService.EnvironmentDiffuseScale = plan.environmentDiffuseScale
	lightingService.EnvironmentSpecularScale = plan.environmentSpecularScale

	local atmosphere = effect(names.Atmosphere, "Atmosphere")
	atmosphere.Density = plan.atmosphere.density
	atmosphere.Haze = plan.atmosphere.haze
	atmosphere.Color = plan.atmosphere.color
	atmosphere.Decay = plan.atmosphere.decay
	atmosphere.Glare = plan.atmosphere.glare
	atmosphere.Offset = plan.atmosphere.offset

	local bloom = effect(names.Bloom, "BloomEffect")
	bloom.Intensity = plan.bloom.intensity
	bloom.Size = plan.bloom.size
	bloom.Threshold = plan.bloom.threshold
	bloom.Enabled = true

	local grade = effect(names.Grade, "ColorCorrectionEffect")
	grade.TintColor = plan.grade.tint
	grade.Saturation = plan.grade.saturation
	grade.Contrast = plan.grade.contrast
	grade.Brightness = plan.grade.brightness
	grade.Enabled = true

	-- §8.3: the shafts fade with depth, and the fade is smoothed rather than switched, so a camera
	-- that pops across Y 0 (a forced ascent, §5.4) cannot make them strobe.
	local target = Atmosphere.SunShaftAlpha(depthStuds)
	shaftAlpha = Atmosphere.AdvanceBlend(
		shaftAlpha,
		target,
		dt,
		1 / math.max(LightingConfig.SunShafts.fadeLerpPerSecond, 1e-3)
	)
	for _, part in shaftParts do
		-- LocalTransparencyModifier is the client-only transparency channel: dimming a shaft costs
		-- no replication and changes nothing for any other player's screen.
		part.LocalTransparencyModifier = 1 - shaftAlpha
	end

	return plan
end

--- §8.8: the air alarm as a screen effect. Zero until the alarm threshold, then a red wash, the
--- colour draining, the picture closing in, all of it breathing — and disabled the moment the
--- player is at the surface or has air, so the warning never cries wolf.
function AtmosphereController:ApplyOxygen()
	local names = LightingConfig.InstanceNames
	local plan = Atmosphere.OxygenPlan(state.air, clock)
	local active = plan.enabled and state.submerged

	local grade = effect(names.OxygenGrade, "ColorCorrectionEffect")
	grade.Enabled = active
	if active then
		grade.TintColor = plan.tint
		grade.Saturation = plan.saturation
		grade.Brightness = plan.brightness
	end

	local blur = effect(names.OxygenBlur, "BlurEffect")
	blur.Enabled = active and plan.blur > 0.05
	blur.Size = if active then plan.blur else 0

	return plan
end

--- The depth this client draws from: the server's own number for the local player's head (§3.0),
--- because that is the number the HUD prints (§8.2: the sense of depth must equal the readout).
--- The camera is only a fallback for the first frames of a join, before the first state push.
function AtmosphereController:SampleDepth(): number
	if state.depth > 0 then
		return state.depth
	end
	local camera = game:GetService("Workspace").CurrentCamera
	if camera ~= nil then
		return math.max(-camera.CFrame.Position.Y, 0)
	end
	return 0
end

-- Knit lifecycle --------------------------------------------------------------

function AtmosphereController:KnitStart()
	collectShafts()
	self:Apply(self:SampleDepth(), 0)

	Remotes.get("DiveStateChanged").OnClientEvent:Connect(function(next: Types.DiveState)
		state = next
		self:ApplyOxygen()
	end)

	local accumulated = 0
	local interval = 1 / math.max(LightingConfig.SampleHz, 1)
	RunService.RenderStepped:Connect(function(dt: number)
		accumulated += dt
		if accumulated < interval then
			return
		end
		clock += accumulated
		local step = accumulated
		accumulated = 0
		if #shaftParts == 0 then
			collectShafts() -- the server's visuals may land a frame or two after this controller starts
		end
		self:Apply(self:SampleDepth(), step)
		self:ApplyOxygen()
	end)
end

return AtmosphereController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="136">
            <Properties>
              <string name="Name">DepthController</string>
              <string name="Source"><![CDATA[--!strict
--[[
    DepthController — GDD §8.8 (the air alarm: a beep from 20 s, faster from 5 s, red vignette),
    §9 (air bar + `AIR 100s`, `DEPTH 62m` beside `RATING 90m`, both red with
    `GEAR RATING EXCEEDED` when depth exceeds rating).

    Air and depth are the game's most important readout pair, so they own their own controller:
    the alarm, the amber/red thresholds and the vignette all hang off one state payload.

    Plain, unstyled TextLabels — the UI/UX pass restyles them. The alarm *sound* (§8.8: a Roblox
    stock audio asset) belongs to the Technical Artist's audio layer; what is here is the part the
    player cannot miss: the number, its colour, the vignette and the ceiling line.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Knit = require(ReplicatedStorage.Packages.Knit)

local Types = require(ReplicatedStorage.DeepTide.Modules.Types)
local Remotes = require(ReplicatedStorage.DeepTide.Modules.Remotes)
local DiveConfig = require(ReplicatedStorage.DeepTide.Config.DiveConfig)

local DepthController = Knit.CreateController({
	Name = "DepthController",
})

local player = Players.LocalPlayer

local state: Types.DiveState = {
	air = 0,
	airCapacity = 0,
	depth = 0,
	depthRating = 0,
	exceeded = false,
	submerged = false,
}

local airLabel: TextLabel? = nil
local depthLabel: TextLabel? = nil
local ceilingLabel: TextLabel? = nil
local vignette: Frame? = nil

local function ensureGui()
	if airLabel ~= nil or player == nil then
		return
	end
	local playerGui = player:FindFirstChild("PlayerGui")
	if playerGui == nil then
		return
	end
	local screen = playerGui:FindFirstChild("DeepTideDepth")
	if screen == nil then
		local created = Instance.new("ScreenGui")
		created.Name = "DeepTideDepth"
		created.ResetOnSpawn = false
		created.Parent = playerGui
		screen = created
	end
	local parent = screen :: Instance

	local function label(name: string, position: UDim2, text: string): TextLabel
		local found = parent:FindFirstChild(name)
		if found ~= nil then
			return found :: TextLabel
		end
		local created = Instance.new("TextLabel")
		created.Name = name
		created.Size = UDim2.fromOffset(260, 24)
		created.Position = position
		created.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
		created.BackgroundTransparency = 0.35
		created.BorderSizePixel = 0
		created.Font = Enum.Font.Code
		created.TextSize = 20
		created.TextXAlignment = Enum.TextXAlignment.Left
		created.TextColor3 = Color3.fromRGB(240, 240, 245)
		created.Text = text
		created.Parent = parent
		return created
	end

	airLabel = label("Air", UDim2.fromOffset(16, 16), "AIR 100s")
	depthLabel = label("Depth", UDim2.fromOffset(16, 44), "DEPTH 0m")
	ceilingLabel = label("Ceiling", UDim2.fromOffset(16, 72), "RATING 90m")
	ceilingLabel.Visible = false

	local edges = parent:FindFirstChild("AirVignette")
	if edges == nil then
		local created = Instance.new("Frame")
		created.Name = "AirVignette"
		created.Size = UDim2.fromScale(1, 2)
		created.Position = UDim2.fromScale(0, -0.5)
		created.BackgroundColor3 = Color3.fromRGB(160, 20, 20)
		created.BackgroundTransparency = 1
		created.BorderSizePixel = 0
		created.ZIndex = 0
		created.Parent = parent
		edges = created
	end
	vignette = edges :: Frame
end

--- §9: amber at DiveConfig.AirAmberSeconds, red with the vignette at AirAlarmSeconds.
function DepthController:GetAirSeverity(air: number): string
	if air <= DiveConfig.AirAlarmSeconds then
		return "Critical"
	elseif air <= DiveConfig.AirAmberSeconds then
		return "Warning"
	end
	return "Nominal"
end

--- §8.8: the alarm must be impossible to miss and must never be muted by the mini-game UI.
function DepthController:IsAirAlarmActive(): boolean
	return state.air <= DiveConfig.AirAlarmSeconds
end

--- §9: the depth readout, printed with DiveConfig.HudDepthSuffix (`m`, 1 stud = 1 m).
function DepthController:FormatDepth(depthStuds: number): string
	return ("DEPTH %d%s"):format(math.floor(depthStuds + 0.5), DiveConfig.HudDepthSuffix)
end

function DepthController:FormatRating(depthRating: number): string
	return ("RATING %d%s"):format(math.floor(depthRating + 0.5), DiveConfig.HudDepthSuffix)
end

--- §9: redraws the air bar + `AIR 100s`, `DEPTH 62m` / `RATING 90m`, and the
--- GEAR RATING EXCEEDED line when next.exceeded.
function DepthController:SetDiveState(next: Types.DiveState)
	state = next
	ensureGui()

	if airLabel ~= nil then
		local seconds = math.max(0, math.floor(next.air + 0.5))
		airLabel.Text = ("AIR %ds / %ds"):format(seconds, math.floor(next.airCapacity + 0.5))
		local severity = self:GetAirSeverity(next.air)
		airLabel.TextColor3 = if severity == "Critical"
			then Color3.fromRGB(255, 90, 90)
			elseif severity == "Warning" then Color3.fromRGB(255, 190, 90)
			else Color3.fromRGB(240, 240, 245)
	end

	if depthLabel ~= nil then
		depthLabel.Text = self:FormatDepth(next.depth)
		depthLabel.TextColor3 = if next.exceeded then Color3.fromRGB(255, 90, 90) else Color3.fromRGB(240, 240, 245)
	end

	if ceilingLabel ~= nil then
		-- §9: the pairing is the game's most important readout, so the ceiling is always shown
		-- once the player has been underwater at all, and turns red the moment it is passed.
		ceilingLabel.Visible = next.depth > 0 or next.submerged
		ceilingLabel.Text = if next.exceeded then "GEAR RATING EXCEEDED" else self:FormatRating(next.depthRating)
		ceilingLabel.TextColor3 = if next.exceeded then Color3.fromRGB(255, 90, 90) else Color3.fromRGB(200, 220, 235)
	end

	if vignette ~= nil then
		-- §8.8: the red creeps in from the screen edges under AirAlarmSeconds.
		local severity = self:GetAirSeverity(next.air)
		vignette.BackgroundTransparency = if next.submerged and severity == "Critical"
			then 0.55
			elseif next.submerged and severity == "Warning" then 0.85
			else 1
	end
end

function DepthController:GetState(): Types.DiveState
	return state
end

-- Knit lifecycle --------------------------------------------------------------

function DepthController:KnitStart()
	Remotes.get("DiveStateChanged").OnClientEvent:Connect(function(next: Types.DiveState)
		self:SetDiveState(next)
	end)

	-- §8.8: the alarm pulse — a red vignette that breathes at 20 s and beats fast at 5 s,
	-- never muted by, and never covering, the tension track (§5.3).
	task.spawn(function()
		while true do
			local interval = if state.air <= DiveConfig.AirFastPulseSeconds then 0.25 else 1
			task.wait(interval)
			if vignette ~= nil and self:IsAirAlarmActive() then
				local on = vignette.BackgroundTransparency < 0.9
				vignette.BackgroundTransparency = if on then 1 else 0.55
			end
		end
	end)
end

return DepthController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="137">
            <Properties>
              <string name="Name">EffectsController</string>
              <string name="Source"><![CDATA[--!strict
--[[
    EffectsController — the player's own effects: §8.4's movement kit and §8.5's win/lose reads.
    Source: GDD §8.4 ("a constant, low-rate bubble trail from the player's head — 2 particles/s
            idle, 14/s while swimming, 30/s on a fast ascent; a kick-up silt puff when the player
            touches the seabed"), §8.5 ("a landing pops a Coin-yellow burst at the rod tip ... a
            0.15 s white flash [on a snap] ... an escape is a small grey ripple. The player must be
            able to tell win from loss from across the room"), §1 step 3 (the surface entry splash).

    WHAT IS CLIENT-SIDE AND WHY
      Bubbles follow one head and flashes happen at one player's rod tip, so they are built and
      driven locally: two ParticleEmitters and one invisible anchor part per player, no replication
      per particle. The tradeoff, stated plainly: *other* players do not see your bubble trail.
      That is the right trade for the slice (the loop is single-player in practice) and it is the
      cheapest possible version of §8.4 — but it is a trade, not a free lunch, so it is written down
      here rather than discovered later.

    NOT MUTED BY THE MINI-GAME (§8.5, §8.8): every effect here is 3D and lives in the world. Nothing
    it draws can cover the tension track, and nothing the HUD draws can suppress it.
]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Knit = require(ReplicatedStorage.Packages.Knit)

local Remotes = require(ReplicatedStorage.DeepTide.Modules.Remotes)
local Types = require(ReplicatedStorage.DeepTide.Modules.Types)
local VisualConfig = require(ReplicatedStorage.DeepTide.Config.VisualConfig)

local EffectsController = Knit.CreateController({
	Name = "EffectsController",
})

local player = Players.LocalPlayer

local state: Types.DiveState = {
	air = 0,
	airCapacity = 0,
	depth = 0,
	depthRating = 0,
	exceeded = false,
	submerged = false,
}

local bubbleEmitter: any = nil
local burstAnchor: any = nil
local burstEmitter: any = nil
local flashLight: any = nil
local lastBubbleRate: number? = nil
local flashEndsAt = 0
local flashPeak = 0
local lastSiltAt = -math.huge
local clock = 0

-- ============================================================================
-- Instances (one invisible anchor carries the burst emitter and the flash light)
-- ============================================================================

local function configure(emitter: any, spec: { [string]: any })
	emitter.Rate = spec.rate or 0
	emitter.Speed = spec.speed
	emitter.Lifetime = spec.lifetime
	emitter.Size = NumberSequence.new(spec.sizeMin, spec.sizeMax)
	emitter.Transparency = NumberSequence.new(spec.transparencyStart, spec.transparencyEnd)
	emitter.Color = ColorSequence.new(spec.color, spec.color)
	emitter.LightEmission = spec.lightEmission or 0
	emitter.LightInfluence = if spec.lightInfluence ~= nil then spec.lightInfluence else 1
	emitter.SpreadAngle = Vector2.new(spec.spreadAngle, spec.spreadAngle)
	emitter.Acceleration = spec.acceleration or Vector3.new(0, 0, 0)
	emitter.MaxParticles = spec.maxParticles or 40
	emitter.EmissionDirection = Enum.NormalId[spec.emissionDirection or "Top"]
	emitter.Enabled = true
end

--- The one anchor every world-space burst is fired from: moved to the point, fired, left alone.
--- Client-only (never replicated), invisible, and non-queryable so it cannot be caught by a
--- raycast or a cast range check.
local function ensureAnchor(): any
	if burstAnchor ~= nil and burstAnchor.Parent ~= nil then
		return burstAnchor
	end
	local anchor: any = Instance.new("Part")
	anchor.Name = "DeepTideFX"
	anchor.Size = Vector3.new(1, 1, 1)
	anchor.Transparency = 1
	anchor.Anchored = true
	anchor.CanCollide = false
	anchor.CanQuery = false
	anchor.CanTouch = false
	anchor.CastShadow = false
	anchor.Parent = game:GetService("Workspace")

	burstEmitter = Instance.new("ParticleEmitter")
	burstEmitter.Name = VisualConfig.Burst.name
	configure(burstEmitter, VisualConfig.Burst)
	burstEmitter.Parent = anchor

	flashLight = Instance.new("PointLight")
	flashLight.Name = "DeepTideFlash"
	flashLight.Shadows = false
	flashLight.Enabled = false
	flashLight.Parent = anchor

	burstAnchor = anchor
	return anchor
end

local function ensureBubbles()
	local character = player.Character
	if character == nil then
		return
	end
	local head = character:FindFirstChild("Head")
	if head == nil or head:IsA("BasePart") == false then
		return
	end
	local existing = head:FindFirstChild("DeepTideBubbles")
	if existing ~= nil then
		bubbleEmitter = existing
		return
	end
	local emitter: any = Instance.new("ParticleEmitter")
	emitter.Name = "DeepTideBubbles"
	configure(emitter, VisualConfig.Player.Bubbles)
	emitter.Shape = Enum.ParticleEmitterShape.Sphere -- a plume around the head, not a slab
	emitter.Rate = 0 -- nothing until the first update says the player is underwater
	emitter.Parent = head
	bubbleEmitter = emitter
end

-- ============================================================================
-- Firing bursts
-- ============================================================================

--- One world-space burst. `spec` is one of VisualConfig.Splash / .Flash.* / .Player.SiltKick.
function EffectsController:Burst(position: Vector3, spec: { [string]: any })
	local anchor = ensureAnchor()
	anchor.CFrame = CFrame.new(position)
	configure(burstEmitter, spec)
	burstEmitter:Emit(spec.burstCount or 8)

	if spec.lightRange ~= nil then
		-- §8.5: the loss and the win both carry light, because "tell win from loss from across the
		-- room" is a lighting problem before it is a particle problem.
		flashLight.Enabled = true
		flashLight.Color = spec.lightColor
		flashLight.Range = spec.lightRange
		flashPeak = spec.lightBrightness
		flashLight.Brightness = flashPeak
		flashEndsAt = clock + (spec.lightSeconds or 0.2)
	end
end

--- Where the rod tip is: the player's head plus the config offset. Deliberately independent of the
--- rod's own geometry (RodController's model may be restyled) so the flash cannot drift away from
--- the tip without a config change.
function EffectsController:RodTip(): Vector3
	local character = player.Character
	local head = if character ~= nil then character:FindFirstChild("Head") else nil
	if head == nil then
		return Vector3.zero
	end
	return (head :: BasePart).Position + VisualConfig.Flash.rodTipOffset
end

--- §8.5, one entry point per outcome. The result strings are FishingService's.
function EffectsController:OnFightResolved(payload: any)
	local result = if payload ~= nil then payload.result else nil
	local at = self:RodTip()
	if result == "Landed" then
		self:Burst(at, VisualConfig.Flash.Landing)
	elseif result == "Snapped" or result == "WeakLine" then
		self:Burst(at, VisualConfig.Flash.Snap)
	elseif result == "Escaped" then
		self:Burst(at, VisualConfig.Flash.Escape)
	end
end

-- ============================================================================
-- The per-frame drive (§8.4)
-- ============================================================================

function EffectsController:UpdateBubbles()
	if bubbleEmitter == nil then
		return
	end
	local character = player.Character
	local root = if character ~= nil then character:FindFirstChild("HumanoidRootPart") else nil
	local bubbles = VisualConfig.Player.Bubbles
	local rate = 0
	if state.submerged and root ~= nil then
		local velocity = (root :: BasePart).AssemblyLinearVelocity
		local vertical = velocity.Y
		local speed = velocity.Magnitude
		if vertical >= bubbles.ascendSpeedStuds then
			rate = bubbles.ascendRate -- §8.4: 30/s on a fast ascent
		elseif speed >= bubbles.swimSpeedStuds then
			rate = bubbles.swimRate -- §8.4: 14/s while swimming
		else
			rate = bubbles.idleRate -- §8.4: 2/s idle
		end
	end
	if rate ~= lastBubbleRate then
		bubbleEmitter.Rate = rate
		lastBubbleRate = rate
	end
end

--- §8.4: "a kick-up silt puff when the player touches the seabed". FloorMaterial is the engine's own
--- answer to "am I standing on something", so this costs no raycast and no per-frame work.
function EffectsController:UpdateSilt()
	if not state.submerged then
		return
	end
	local character = player.Character
	local humanoid = if character ~= nil then character:FindFirstChildOfClass("Humanoid") else nil
	local root = if character ~= nil then character:FindFirstChild("HumanoidRootPart") else nil
	if humanoid == nil or root == nil then
		return
	end
	if humanoid.FloorMaterial == Enum.Material.Air then
		return
	end
	local spec = VisualConfig.Player.SiltKick
	if clock - lastSiltAt < spec.cooldownSeconds then
		return
	end
	lastSiltAt = clock
	self:Burst((root :: BasePart).Position - Vector3.new(0, 2, 0), spec)
end

--- §1 step 3: the entry splash. Fires on the false -> true edge of `submerged`, which is the
--- server's own reading of the crossing (§3.0: the camera crossing Y 0).
function EffectsController:OnSubmergedChanged(submerged: boolean, previous: boolean)
	if not submerged or previous then
		return
	end
	local character = player.Character
	local head = if character ~= nil then character:FindFirstChild("Head") else nil
	local at = if head ~= nil then (head :: BasePart).Position + Vector3.new(0, 0.5, 0) else Vector3.zero
	self:Burst(at, VisualConfig.Splash)
end

-- Knit lifecycle --------------------------------------------------------------

function EffectsController:KnitStart()
	ensureAnchor()
	ensureBubbles()
	player.CharacterAdded:Connect(function()
		bubbleEmitter = nil
		lastBubbleRate = nil
		ensureBubbles()
	end)

	Remotes.get("DiveStateChanged").OnClientEvent:Connect(function(next: Types.DiveState)
		local wasSubmerged = state.submerged
		state = next
		self:OnSubmergedChanged(next.submerged, wasSubmerged)
	end)

	Remotes.get("FightResolved").OnClientEvent:Connect(function(payload: any)
		self:OnFightResolved(payload)
	end)

	RunService.RenderStepped:Connect(function(dt: number)
		clock += dt
		if flashLight ~= nil and flashLight.Enabled then
			-- The flash decays over its config lifetime rather than switching off: a hard cut reads
			-- as a bug, a fade reads as an event.
			local remaining = flashEndsAt - clock
			if remaining <= 0 then
				flashLight.Enabled = false
			else
				flashLight.Brightness = flashPeak * math.clamp(remaining / 0.3, 0, 1)
			end
		end
		self:UpdateBubbles()
		self:UpdateSilt()
	end)
end

return EffectsController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="138">
            <Properties>
              <string name="Name">FishingController</string>
              <string name="Source"><![CDATA[--!strict
--[[
	FishingController — GDD §5.1 (cast and its [E] CAST prompt), §5.2 (hook set), §5.3 (hold /
	release / abort input), §5.6 (cooldowns shown to the player), §9 (the in-fight prompt shows
	the same key as the cast prompt, plus the species name and rarity colour).

	Owns: local input and the client half of the Tension mini-game. The maths is
	server-authoritative at 30 Hz — this controller sends input and mirrors the state the
	server pushes. HudController draws the track from GetFightView().

	The feel hooks §5.3 asks for, and why they are here:
	  * the input is a *state*, sent on change only ("hold"/"release"), so a dropped or late
	    packet costs the player at most the time until their next input event, never the fight;
	  * the needle is dead-reckoned between server packets from the same FightConfig rates the
	    server uses, so input does not visibly lag the bar the player is watching;
	  * the strain is on screen the instant it happens: the hold meter changes colour out of zone,
	    and the needle turns red at the over-tension line.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Knit = require(ReplicatedStorage.Packages.Knit)

local Types = require(ReplicatedStorage.DeepTide.Modules.Types)
local Remotes = require(ReplicatedStorage.DeepTide.Modules.Remotes)
local FightConfig = require(ReplicatedStorage.DeepTide.Config.FightConfig)
local RarityConfig = require(ReplicatedStorage.DeepTide.Config.RarityConfig)
local FishConfig = require(ReplicatedStorage.DeepTide.Config.FishConfig)
local RodConfig = require(ReplicatedStorage.DeepTide.Config.RodConfig)

local FishingController = Knit.CreateController({
	Name = "FishingController",
})

-- Mirrors the server's FightStateChanged payload (§5.3): needle T, zone centre S, zone
-- half-width W, hold meter H, over-tension ceiling.
export type FightView = {
	needle: number,
	zoneCentre: number,
	zoneHalfWidth: number,
	hold: number,
	tensionMax: number,
	speciesId: string,
	name: string?,
	value: number?,
	rarity: string?,
	phase: string?,
	ring: number?,
	inZone: boolean?,
	overTension: boolean?,
}

local remotes: { [string]: RemoteEvent } = {}

local player = Players.LocalPlayer
local fightView: FightView? = nil
local serverView: FightView? = nil
local predictedZone = 0.5
local phase: string? = nil
local held = false
local currentTarget: BasePart? = nil
local promptTarget: BasePart? = nil
local lastScan = 0
local castLine: BasePart? = nil
local worldPrompt: BillboardGui? = nil
local cooldownUntil: { [string]: number } = {}

local CASTABLE_EXCLUDED: { [string]: boolean } = {
	Fleeing = true,
	Lunging = true,
	Hooked_Pending = true,
	Fighting = true,
}

local function hud(): any
	return Knit.GetController("HudController")
end

local function rod(): any
	return Knit.GetController("RodController")
end

local function character(): Model?
	return player.Character
end

local function rootPosition(): Vector3?
	local model = character()
	local root = if model ~= nil then model:FindFirstChild("HumanoidRootPart") else nil
	return if root ~= nil then (root :: BasePart).Position else nil
end

local function rodTipPosition(): Vector3?
	local model = character()
	if model == nil then
		return nil
	end
	local tool = model:FindFirstChild("DeepTideRod")
	local handle = if tool ~= nil then tool:FindFirstChild("Handle") else nil
	if handle ~= nil then
		return (handle :: BasePart).Position
	end
	local hand = model:FindFirstChild("RightHand") or model:FindFirstChild("Right Arm")
	return if hand ~= nil then (hand :: BasePart).Position else rootPosition()
end

--- §5.1 step 1: the fish the player may cast at — nearest eligible fish within CastRange that is
--- in front of the camera. Uses the replicated `State` attribute (§4), so the prompt disappears
--- the moment the server says a fish is fleeing or already hooked.
local function scanForTarget(now: number): BasePart?
	if now - lastScan < 0.1 then
		return promptTarget
	end
	lastScan = now

	local origin = rootPosition()
	if origin == nil then
		return nil
	end
	local camera = workspace.CurrentCamera
	local look = if camera ~= nil then camera.CFrame.LookVector else nil

	local root = workspace:FindFirstChild("DeepTide")
	local folder = if root ~= nil then root:FindFirstChild("Fish") else nil
	if folder == nil or look == nil then
		promptTarget = nil
		return nil
	end

	local best: BasePart? = nil
	local bestDistance = math.huge
	for _, child in folder:GetChildren() do
		if child:IsA("BasePart") and not child.Name:match("_Lure$") then
			local part = child :: BasePart
			local state = part:GetAttribute("State")
			if CASTABLE_EXCLUDED[tostring(state)] ~= true then
				local offset = part.Position - origin
				local distance = offset.Magnitude
				if distance <= FightConfig.CastRange and distance < bestDistance and distance > 0 then
					local unit = offset / distance
					local dot = unit.X * look.X + unit.Y * look.Y + unit.Z * look.Z
					if dot >= FightConfig.CastFacingDot then
						best, bestDistance = part, distance
					end
				end
			end
		end
	end

	promptTarget = best
	return best
end

--- The `[E] CAST` prompt over the fish, with the species name and rarity colour (§9).
local function refreshPrompt(target: BasePart?)
	if hud() == nil then
		return
	end
	if target == nil then
		hud():HideCastPrompt()
		if worldPrompt ~= nil then
			worldPrompt.Enabled = false
		end
		return
	end

	local speciesId = tostring(target:GetAttribute("Species"))
	local species = FishConfig.Species[speciesId]
	local label = ("[%s] CAST — %s"):format(FightConfig.Keys.Cast, if species ~= nil then species.name else speciesId)
	local color = if species ~= nil then RarityConfig.Color[species.rarity] else nil

	hud():ShowCastPrompt(label, color)

	-- The world-anchored half: a plain, unstyled BillboardGui riding the fish (§9: a world
	-- prompt above the eligible fish).
	if worldPrompt == nil then
		local billboard = Instance.new("BillboardGui")
		billboard.Name = "DeepTideCastPrompt"
		billboard.Size = UDim2.fromScale(12, 3)
		billboard.StudsOffsetWorldSpace = Vector3.new(0, 2, 0)
		billboard.AlwaysOnTop = true
		local text = Instance.new("TextLabel")
		text.Name = "Text"
		text.Size = UDim2.fromScale(1, 1)
		text.BackgroundTransparency = 1
		text.Font = Enum.Font.Code
		text.TextScaled = true
		text.TextColor3 = color or Color3.fromRGB(240, 240, 245)
		text.Text = label
		text.Parent = billboard
		worldPrompt = billboard
	end
	if worldPrompt ~= nil then
		worldPrompt.Adornee = target
		worldPrompt.Enabled = true
		local text = worldPrompt:FindFirstChild("Text")
		if text ~= nil then
			local textLabel = text :: TextLabel
			textLabel.Text = label
			textLabel.TextColor3 = color or Color3.fromRGB(240, 240, 245)
		end
	end
end

--- §5.1 step 2: the line from the rod tip to the fish. Plain Part, client-side, no replication.
local function updateCastLine(target: BasePart?)
	local tip = rodTipPosition()
	if target == nil or tip == nil then
		if castLine ~= nil then
			castLine.Transparency = 1
		end
		return
	end
	if castLine == nil or castLine.Parent == nil then
		local part = Instance.new("Part")
		part.Name = "DeepTideCastLine"
		part.Anchored = true
		part.CanCollide = false
		part.CanQuery = false
		part.CanTouch = false
		part.CastShadow = false
		part.Material = Enum.Material.SmoothPlastic
		part.Color = Color3.fromRGB(220, 225, 235)
		part.Size = Vector3.new(0.12, 0.12, 1)
		part.Parent = workspace
		castLine = part
	end
	local line = castLine :: BasePart
	local targetPosition = target.Position
	local delta = targetPosition - tip
	local length = math.max(delta.Magnitude, 0.1)
	line.Size = Vector3.new(0.12, 0.12, length)
	line.CFrame = CFrame.lookAt(tip + delta / 2, targetPosition) * CFrame.Angles(math.rad(90), 0, 0)
	line.Transparency = 0
end

-- Public API ------------------------------------------------------------------

--- §5.1 step 2: ask the server to cast at the fish the player is aiming at.
--- The server validates range, facing and eligibility — this is a request, not a command.
function FishingController:RequestCast(target: BasePart?): boolean
	local remote = remotes.CastRequest
	if remote == nil then
		return false
	end
	remote:FireServer(target or promptTarget)
	return true
end

--- §5.2 step 6: the second press, inside the species' hook-set window.
function FishingController:RequestHookSet(): boolean
	local remote = remotes.HookSetRequest
	if remote == nil then
		return false
	end
	remote:FireServer()
	return true
end

--- §5.3: hold (E, left mouse or R2) to pull, release to slack. One button, nothing else.
--- The input is sent only when it changes, which is what makes a late packet harmless.
function FishingController:SetFightInput(next: boolean)
	if next == held then
		return
	end
	held = next
	local remote = remotes.FightInput
	if remote == nil then
		return
	end
	remote:FireServer(if next then "hold" else "release")
end

--- §5.3 step 10: abort at any time — a player must never feel trapped in the UI minigame.
function FishingController:AbortFight()
	held = false
	local remote = remotes.FightInput
	if remote == nil then
		return
	end
	remote:FireServer("abort")
end

--- Is a cast or fight in flight? (§5.6: drives the greyed rod and the countdown.)
function FishingController:IsBusy(): boolean
	return fightView ~= nil
end

--- The live fight view for the HUD track (§5.3), or nil when not fighting.
function FishingController:GetFightView(): FightView?
	return fightView
end

function FishingController:GetPhase(): string?
	return phase
end

--- §5.6: how long the current cooldown still has to run, for the HUD countdown.
function FishingController:GetCooldownRemaining(kind: string): number
	local until_ = cooldownUntil[kind]
	if until_ == nil then
		return 0
	end
	return math.max(0, until_ - os.clock())
end

--- §9: name + rarity colour for the prompt, so the player knows what they are casting at
--- BEFORE committing air.
function FishingController:GetSpeciesLabel(speciesId: string): { name: string, color: Color3 }
	local species = FishConfig.Species[speciesId]
	if species == nil then
		return { name = speciesId, color = Color3.fromRGB(240, 240, 245) }
	end
	return {
		name = species.name,
		color = RarityConfig.Color[species.rarity],
	}
end

--- §5.4 / §9: show the exact failure line — never a loss without a reason and a next step.
function FishingController:ShowFailure(result: Types.FightResult, reason: string?)
	local text = reason
	if text == nil then
		if result == "WeakLine" then
			text = FightConfig.FailMessages.weakLine
		elseif result == "Snapped" then
			text = FightConfig.FailMessages.snap
		elseif result == "Escaped" then
			text = FightConfig.FailMessages.escape
		end
	end
	if hud() ~= nil and text ~= nil then
		hud():ShowFailureMessage(text)
	end
end

-- Input -----------------------------------------------------------------------

--- One key does every verb (§1 step 5, §9): what it means depends on the phase the server has
--- told us we are in.
local function onPress()
	if phase == "Fighting" then
		FishingController:SetFightInput(true)
	elseif phase == "HookSet" then
		FishingController:RequestHookSet()
	elseif phase == "Casting" then
		-- the line is still going out; nothing to do
	else
		FishingController:RequestCast(promptTarget)
	end
end

local function onRelease()
	if phase == "Fighting" then
		FishingController:SetFightInput(false)
	end
end

-- Knit lifecycle --------------------------------------------------------------

function FishingController:KnitStart()
	for _, name in { "CastRequest", "HookSetRequest", "FightInput", "FightStateChanged", "FightResolved" } do
		remotes[name] = Remotes.get(name)
	end

	remotes.FightStateChanged.OnClientEvent:Connect(function(view: FightView)
		serverView = view
		phase = view.phase
		currentTarget = if view.phase == "Casting"
				or view.phase == "HookSet"
				or view.phase == "Fighting"
			then (promptTarget or currentTarget)
			else nil
		-- resync the dead-reckoned needle to the authority every packet (§5.3)
		if view.phase == "Fighting" then
			local predicted = {
				needle = view.needle,
				zoneCentre = view.zoneCentre,
				zoneHalfWidth = view.zoneHalfWidth,
				hold = view.hold,
				tensionMax = view.tensionMax,
				speciesId = view.speciesId,
				name = view.name,
				value = view.value,
				rarity = view.rarity,
				phase = view.phase,
				inZone = view.inZone,
				overTension = view.overTension,
			}
			predictedZone = view.zoneCentre
			fightView = predicted
			if hud() ~= nil then
				hud():ShowFight(predicted)
			end
		else
			fightView = nil
			if hud() ~= nil then
				hud():HideFight()
			end
		end
	end)

	remotes.FightResolved.OnClientEvent:Connect(function(payload: { result: Types.FightResult, reason: string? })
		fightView = nil
		serverView = nil
		phase = nil
		held = false
		currentTarget = nil
		if hud() ~= nil then
			hud():HideFight()
		end

		if payload.result == "Landed" then
			if hud() ~= nil and payload.reason ~= nil then
				hud():ShowCatchMessage(payload.reason)
			end
		else
			self:ShowFailure(payload.result, payload.reason)
			-- §5.6: the cooldown that follows each loss, for the countdown the HUD shows.
			local kind = if payload.result == "Snapped" or payload.result == "WeakLine" then "snap" else "escape"
			local total = FightConfig.Cooldowns[kind] or 0
			cooldownUntil[kind] = os.clock() + total
		end
	end)

	-- §5.1-§5.3: one key for cast, hook set and pull; mouse button 1 and gamepad R2 are the same
	-- pull. Q aborts.
	local ContextActionService = game:GetService("ContextActionService")
	ContextActionService:BindAction("DeepTideFish", function(_, inputState: Enum.UserInputState, _)
		if inputState == Enum.UserInputState.Begin then
			onPress()
		elseif inputState == Enum.UserInputState.End then
			onRelease()
		elseif inputState == Enum.UserInputState.Cancel then
			onRelease()
		end
		return Enum.ContextActionResult.Pass
	end, false, Enum.KeyCode.E, Enum.UserInputType.MouseButton1, Enum.KeyCode.ButtonR2)

	ContextActionService:BindAction("DeepTideAbort", function(_, inputState: Enum.UserInputState, _)
		if inputState == Enum.UserInputState.Begin then
			self:AbortFight()
		end
		return Enum.ContextActionResult.Pass
	end, false, Enum.KeyCode.Q)

	-- §5.1: the prompt, the line and the dead-reckoned needle, once a frame.
	RunService.RenderStepped:Connect(function(dt: number)
		if phase == nil then
			local target = scanForTarget(os.clock())
			refreshPrompt(target)
			currentTarget = nil
		else
			refreshPrompt(nil)
		end

		local tracked = currentTarget or promptTarget
		if phase == "Casting" or phase == "Fighting" then
			updateCastLine(if phase == "Casting" then tracked else nil)
		elseif castLine ~= nil then
			castLine.Transparency = 1
		end

		-- Dead-reckon the needle and ease the safe zone toward the server's value, so the bar the
		-- player is watching responds to their input this frame rather than 33 ms ago.
		if fightView ~= nil and phase == "Fighting" then
			local view = fightView :: FightView
			local rate = if held then FightConfig.NeedleRiseRate else -FightConfig.NeedleFallRate
			view.needle = math.clamp(view.needle + rate * dt, 0, view.tensionMax)
			if serverView ~= nil then
				predictedZone = predictedZone
					+ ((serverView :: FightView).zoneCentre - predictedZone) * math.min(1, dt * 10)
			end
			view.zoneCentre = predictedZone
			view.inZone = math.abs(view.needle - view.zoneCentre) <= view.zoneHalfWidth
			view.overTension = view.needle >= view.tensionMax - FightConfig.SnapBand
			if hud() ~= nil then
				hud():ShowFight(view)
			end
		end
	end)

	-- The rod the player is holding drives the HUD's `ROD:` line (§9) — RodController owns it.
	if rod() ~= nil then
		rod():AttachToCharacter()
	end
end

return FishingController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="139">
            <Properties>
              <string name="Name">HudController</string>
              <string name="Source"><![CDATA[--!strict
--[[
    HudController — GDD §9 (HUD requirements), §1 step 6 (Catch Log row appears the instant a
    fish lands), §9 (cash, rod, catch log, failure explainer, zone banner), §5.3 (the tension
    track: safe zone, needle, red over-tension line, hold meter).

    Owns the always-visible readouts EXCEPT air/depth/rating (DepthController owns those, so
    the alarm and the vignette live in exactly one place):
      * cash `C 295` top-right
      * Catch Log panel, collapsible with Tab, running TOTAL
      * `ROD: RUSTY` readout
      * the 2 s explainer line (failure and catch)
      * the zone entry banner
      * the §5.3 tension track, cast prompt and catch prompt

    Explicitly NOT here (§9): minimap, quest log, XP bar, leaderboard, friend list,
    Robux button, settings cog, any social feature.

    STYLING IS NOT DONE HERE. Every element is a plain, unstyled Frame/TextLabel with a visible
    background, sized from FightConfig (§5.3's 360 px track at 45% screen height) so the loop is
    playable and the UI/UX designer can restyle it without moving a single number.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Knit = require(ReplicatedStorage.Packages.Knit)

local Types = require(ReplicatedStorage.DeepTide.Modules.Types)
local Remotes = require(ReplicatedStorage.DeepTide.Modules.Remotes)
local EconomyConfig = require(ReplicatedStorage.DeepTide.Config.EconomyConfig)
local ZoneConfig = require(ReplicatedStorage.DeepTide.Config.ZoneConfig)
local FightConfig = require(ReplicatedStorage.DeepTide.Config.FightConfig)
local RarityConfig = require(ReplicatedStorage.DeepTide.Config.RarityConfig)

local HudController = Knit.CreateController({
	Name = "HudController",
})

local player = Players.LocalPlayer

local gui: ScreenGui? = nil
local coinsLabel: TextLabel? = nil
local rodLabel: TextLabel? = nil
local logPanel: Frame? = nil
local logList: Frame? = nil
local logTotal: TextLabel? = nil
local messageLabel: TextLabel? = nil
local bannerLabel: TextLabel? = nil
local castLabel: TextLabel? = nil
local track: Frame? = nil
local zoneBand: Frame? = nil
local needle: Frame? = nil
local limitLine: Frame? = nil
local holdFill: Frame? = nil
local fightLabel: TextLabel? = nil
local messageToken = 0
local bannerToken = 0

local function newFrame(parent: Instance, name: string, size: UDim2, position: UDim2, color: Color3): Frame
	local frame = Instance.new("Frame")
	frame.Name = name
	frame.Size = size
	frame.Position = position
	frame.BackgroundColor3 = color
	frame.BackgroundTransparency = 0
	frame.BorderSizePixel = 0
	frame.Parent = parent
	return frame
end

local function newLabel(parent: Instance, name: string, size: UDim2, position: UDim2, text: string): TextLabel
	local label = Instance.new("TextLabel")
	label.Name = name
	label.Size = size
	label.Position = position
	label.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
	label.BackgroundTransparency = 0.35
	label.BorderSizePixel = 0
	label.Font = Enum.Font.Code
	label.TextScaled = false
	label.TextSize = 18
	label.TextColor3 = Color3.fromRGB(240, 240, 245)
	label.TextXAlignment = Enum.TextXAlignment.Left
	label.Text = text
	label.Parent = parent
	return label
end

--- §9/§5.3: the whole HUD tree. Plain Frames, no styling: the UI/UX pass restyles this.
local function buildGui(): ScreenGui
	local screen = Instance.new("ScreenGui")
	screen.Name = "DeepTideHud"
	screen.ResetOnSpawn = false
	screen.IgnoreGuiInset = false
	screen.Parent = player:WaitForChild("PlayerGui")

	coinsLabel = newLabel(screen, "Coins", UDim2.fromOffset(180, 28), UDim2.new(1, -190, 0, 12), "C 0")

	rodLabel = newLabel(screen, "Rod", UDim2.fromOffset(240, 24), UDim2.new(1, -250, 0, 44), "ROD: RUSTY")

	-- §9: the cast prompt sits above the track and names the fish and its rarity colour, so the
	-- player knows what they are casting at before committing air.
	castLabel = newLabel(screen, "CastPrompt", UDim2.fromOffset(420, 26), UDim2.new(0.5, -210, 0.72, 0), "[E] CAST")
	castLabel.TextXAlignment = Enum.TextXAlignment.Center
	castLabel.Visible = false

	-- §5.3: track 360 px wide at 45% screen height.
	local trackWidth = FightConfig.TrackWidthPixels
	track = newFrame(
		screen,
		"TensionTrack",
		UDim2.fromOffset(trackWidth, 20),
		UDim2.new(0.5, -trackWidth / 2, FightConfig.TrackScreenHeightFraction, 0),
		Color3.fromRGB(20, 22, 28)
	)
	zoneBand =
		newFrame(track, "SafeZone", UDim2.fromOffset(10, 20), UDim2.fromOffset(0, 0), Color3.fromRGB(40, 200, 90))
	needle = newFrame(track, "Needle", UDim2.fromOffset(3, 24), UDim2.fromOffset(0, -2), Color3.fromRGB(245, 245, 250))
	limitLine = newFrame(
		track,
		"OverTensionLine",
		UDim2.fromOffset(2, 24),
		UDim2.fromOffset(trackWidth - 2, -2),
		Color3.fromRGB(230, 60, 60)
	)
	holdFill = newFrame(
		screen,
		"HoldMeter",
		UDim2.fromOffset(0, 8),
		UDim2.new(0.5, -trackWidth / 2, FightConfig.TrackScreenHeightFraction, 26),
		Color3.fromRGB(90, 200, 255)
	)
	fightLabel = newLabel(
		screen,
		"FightStake",
		UDim2.fromOffset(300, 22),
		UDim2.new(0.5, -150, FightConfig.TrackScreenHeightFraction, 40),
		""
	)
	fightLabel.TextXAlignment = Enum.TextXAlignment.Center

	-- §9: the explainer line. Wide enough for the longest line the server can push — the §5.4
	-- rating wall prints the player's own rating *and* the tier that opens the deeper water
	-- ("GEAR RATING EXCEEDED — RATING 90m — SURFACED · REINFORCED TANK 240m (280 C)").
	messageLabel = newLabel(screen, "Message", UDim2.fromOffset(1040, 30), UDim2.new(0.5, -520, 0.38, 0), "")
	messageLabel.TextSize = 16
	messageLabel.TextXAlignment = Enum.TextXAlignment.Center
	messageLabel.Visible = false

	bannerLabel = newLabel(screen, "ZoneBanner", UDim2.fromOffset(420, 34), UDim2.new(0.5, -210, 0.06, 0), "")
	bannerLabel.TextXAlignment = Enum.TextXAlignment.Center
	bannerLabel.Visible = false

	-- §9: the Catch Log panel — species, rarity colour, count, running TOTAL.
	logPanel =
		newFrame(screen, "CatchLog", UDim2.fromOffset(250, 200), UDim2.new(1, -260, 0, 80), Color3.fromRGB(16, 18, 24))
	logList = newFrame(logPanel, "Rows", UDim2.new(1, -10, 1, -40), UDim2.fromOffset(5, 5), Color3.fromRGB(16, 18, 24))
	logTotal = newLabel(logPanel, "Total", UDim2.fromOffset(240, 24), UDim2.new(0, 5, 1, -30), "TOTAL 0 C")

	track.Visible = false
	holdFill.Visible = false
	fightLabel.Visible = false

	return screen
end

local function showMessage(text: string, color: Color3, seconds: number)
	if messageLabel == nil then
		return
	end
	messageToken += 1
	local token = messageToken
	messageLabel.Text = text
	messageLabel.TextColor3 = color
	messageLabel.Visible = true
	task.delay(seconds, function()
		if messageToken == token and messageLabel ~= nil then
			messageLabel.Visible = false
		end
	end)
end

-- Public API ------------------------------------------------------------------

--- §9: top-right cash. (The fly-in animation is the UI pass; the value is never silent.)
function HudController:SetCoins(coins: number, delta: number?)
	if coinsLabel == nil then
		return
	end
	if delta ~= nil and delta ~= 0 then
		coinsLabel.Text = ("C %d  (%+d)"):format(coins, delta)
	else
		coinsLabel.Text = ("C %d"):format(coins)
	end
end

--- §9: the Catch Log panel — species, rarity colour, count, running TOTAL.
function HudController:SetCatchLog(entries: { Types.CatchLogEntry }, totalCoins: number?)
	if logList == nil or logTotal == nil then
		return
	end
	for _, child in logList:GetChildren() do
		child:Destroy()
	end

	local index = 0
	for _, entry in entries do
		local row = newLabel(
			logList,
			"Row_" .. entry.speciesId,
			UDim2.new(1, 0, 0, 20),
			UDim2.fromOffset(0, index * 22),
			("%s  x%d"):format(entry.name, entry.count)
		)
		row.TextColor3 = RarityConfig.Color[entry.rarity] or Color3.fromRGB(240, 240, 245)
		row.BackgroundTransparency = 1
		index += 1
	end

	local total = if totalCoins ~= nil then totalCoins else self:ComputeTotalCoins(entries)
	logTotal.Text = ("TOTAL %d C"):format(total)
end

--- §9: `ROD: RUSTY / BRASS`.
function HudController:SetRodLabel(label: string)
	if rodLabel ~= nil then
		rodLabel.Text = label
	end
end

--- §9: the centred explainer line, verbatim from FightConfig.FailMessages, shown for
--- FightConfig.FailureMessageSeconds. Never a loss without a reason and a next step.
function HudController:ShowFailureMessage(text: string)
	showMessage(text, Color3.fromRGB(255, 120, 120), FightConfig.FailureMessageSeconds)
end

--- §1 step 6: the landed-fish line (the server formats it from FightConfig.CatchMessageFormat).
function HudController:ShowCatchMessage(text: string)
	showMessage(text, Color3.fromRGB(255, 214, 120), FightConfig.CatchMessageSeconds)
end

--- §9: `THE SHALLOWS` / `THE SHELF`, top-centre, ZoneConfig.ZoneEntryBannerSeconds, fading.
function HudController:ShowZoneBanner(zoneId: string)
	local zone = ZoneConfig.Zones[zoneId]
	if zone == nil or bannerLabel == nil then
		return
	end
	bannerToken += 1
	local token = bannerToken
	bannerLabel.Text = zone.displayName
	bannerLabel.Visible = true
	task.delay(ZoneConfig.ZoneEntryBannerSeconds, function()
		if bannerToken == token and bannerLabel ~= nil then
			bannerLabel.Visible = false
		end
	end)
end

--- §5.1 step 1 / §9: the `[E] CAST` prompt naming the fish and its rarity colour.
function HudController:ShowCastPrompt(text: string, color: Color3?)
	if castLabel == nil then
		return
	end
	castLabel.Text = text
	castLabel.TextColor3 = color or Color3.fromRGB(240, 240, 245)
	castLabel.Visible = true
end

function HudController:HideCastPrompt()
	if castLabel ~= nil then
		castLabel.Visible = false
	end
end

--- §5.3: draw the track from the fight view, in track fractions (the maths is the server's).
function HudController:ShowFight(view: { [string]: any })
	if track == nil or zoneBand == nil or needle == nil or holdFill == nil or limitLine == nil then
		return
	end
	local trackWidth = FightConfig.TrackWidthPixels
	local width = math.clamp((view.zoneHalfWidth or 0) * 2, 0, 1)
	local centre = math.clamp(view.zoneCentre or 0.5, 0, 1)

	track.Visible = true
	holdFill.Visible = true
	zoneBand.Size = UDim2.fromOffset(math.max(4, width * trackWidth), 20)
	zoneBand.Position = UDim2.fromOffset((centre - width / 2) * trackWidth, 0)
	needle.Position = UDim2.fromOffset(math.clamp(view.needle or 0, 0, 1) * trackWidth - 1.5, -2)

	local overTension = view.overTension == true or (view.needle or 0) >= (view.tensionMax or 1) - FightConfig.SnapBand
	needle.BackgroundColor3 = if overTension then Color3.fromRGB(255, 90, 90) else Color3.fromRGB(245, 245, 250)
	limitLine.Position = UDim2.fromOffset(math.clamp(view.tensionMax or 1, 0, 1) * trackWidth - 1, -2)

	local hold = math.clamp((view.hold or 0) / FightConfig.HoldMeterMax, 0, 1)
	holdFill.Size = UDim2.fromOffset(math.max(1, hold * trackWidth), 8)
	-- Clear feedback on strain (§5.3 step 5): the meter changes colour the moment the needle
	-- leaves the green, and deepens the further out it is.
	holdFill.BackgroundColor3 = if view.inZone == false
		then (if (view.hold or 0) < FightConfig.HoldMeterMax / 3
			then Color3.fromRGB(255, 90, 90)
			else Color3.fromRGB(255, 170, 60))
		else Color3.fromRGB(90, 200, 255)

	if view.name ~= nil then
		fightLabel.Visible = true
		fightLabel.Text = ("%s — %d C"):format(view.name, view.value or 0)
		fightLabel.TextColor3 = RarityConfig.Color[view.rarity] or Color3.fromRGB(240, 240, 245)
	end
end

function HudController:HideFight()
	if track ~= nil then
		track.Visible = false
	end
	if holdFill ~= nil then
		holdFill.Visible = false
	end
	if fightLabel ~= nil then
		fightLabel.Visible = false
	end
end

--- §9: the first-session tutorial prompts (5, one at a time, dismissible, never repeating).
function HudController:ShowTutorialPrompt(index: number)
	showMessage(("TIP %d/%d"):format(index, 5), Color3.fromRGB(200, 220, 255), FightConfig.FailureMessageSeconds)
end

--- §9: collapse/expand the Catch Log with Tab.
function HudController:ToggleCatchLog()
	if logPanel ~= nil then
		logPanel.Visible = not logPanel.Visible
	end
end

--- The `TOTAL 295 C` under the log. Display only — EconomyService owns the real payment.
function HudController:ComputeTotalCoins(entries: { Types.CatchLogEntry }): number
	local total = 0
	for _, entry in entries do
		local value = EconomyConfig.SellValues[entry.speciesId]
		if value ~= nil then
			total += value * entry.count
		end
	end
	return total
end

-- Knit lifecycle --------------------------------------------------------------

function HudController:KnitStart()
	-- §9: first build the ScreenGui under PlayerGui (above the world, below the tension track),
	-- then the following wiring is what keeps it true.
	if player ~= nil then
		gui = buildGui()
	end

	Remotes.get("CoinsChanged").OnClientEvent:Connect(function(coins: number, delta: number?)
		self:SetCoins(coins, delta)
	end)

	Remotes.get("CatchLogChanged").OnClientEvent:Connect(function(entries: { Types.CatchLogEntry }, totalCoins: number?)
		self:SetCatchLog(entries, totalCoins)
	end)

	Remotes.get("Notify").OnClientEvent:Connect(function(payload: Types.NotifyPayload)
		self:ShowFailureMessage(payload.text)
	end)

	Remotes.get("ZoneChanged").OnClientEvent:Connect(function(zoneId: string)
		self:ShowZoneBanner(zoneId)
	end)

	-- EconomyConfig.StartingCoins seeds the very first draw so the HUD is never blank.
	self:SetCoins(EconomyConfig.StartingCoins)

	-- §9: Tab collapses the Catch Log.
	local UserInputService = game:GetService("UserInputService")
	UserInputService.InputBegan:Connect(function(input: InputObject, processed: boolean)
		if processed then
			return
		end
		if input.KeyCode == Enum.KeyCode.Tab then
			self:ToggleCatchLog()
		end
	end)
end

return HudController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="140">
            <Properties>
              <string name="Name">RodController</string>
              <string name="Source"><![CDATA[--!strict
--[[
	RodController — GDD §1 step 2 (take the Rusty Rod from the Rod Rack), §5.4 + §9
	(`ROD: RUSTY / BRASS` — the rod is why a line snaps, so the player must be able to
	blame it correctly), §6.3 (the Brass Rod purchase changes this readout).

	Owns: the rod the local player is holding, and the character-side rod model. The rod *verb*
	(taking it from the rack, buying the Brass Rod) is server work: GearService owns the equipped
	rod and stamps it on the Player as an attribute, which replicates here with no extra remote.

	The rod is a Tool with a single Handle Part (§Appendix A: primitives only) — enough for the
	cast line to start at a believable tip, and enough for the UI/art pass to replace later.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Knit = require(ReplicatedStorage.Packages.Knit)

local RodConfig = require(ReplicatedStorage.DeepTide.Config.RodConfig)
local GearConfig = require(ReplicatedStorage.DeepTide.Config.GearConfig)
local EconomyConfig = require(ReplicatedStorage.DeepTide.Config.EconomyConfig)

local RodController = Knit.CreateController({
	Name = "RodController",
})

local TOOL_NAME = "DeepTideRod"

local player = Players.LocalPlayer

-- §Appendix A: the two rod tiers, in primitives. Rusty is a plain driftwood shaft; Brass is a
-- longer, brighter one (§6.3 is a visible upgrade as well as a statistical one).
local ROD_LOOK = {
	RustyRod = { length = 6, color = Color3.fromRGB(122, 88, 62), material = Enum.Material.Wood },
	BrassRod = { length = 7.5, color = Color3.fromRGB(198, 160, 74), material = Enum.Material.Metal },
}

local function hud(): any
	local ok, controller = pcall(function()
		return Knit.GetController("HudController")
	end)
	return if ok then controller else nil
end

-- Public API ------------------------------------------------------------------

--- The rod id the HUD is showing. Read from the Player attribute GearService stamps.
function RodController:GetEquippedRodId(): string
	local rodId = if player ~= nil then player:GetAttribute(GearConfig.PlayerAttributes.RodId) else nil
	if type(rodId) ~= "string" or RodConfig.Rods[rodId] == nil then
		return EconomyConfig.StartingRodId
	end
	return rodId
end

--- "RUSTY" / "BRASS" for the HUD line (§9).
function RodController:GetRodTierLabel(): string
	local rod = RodConfig.Rods[self:GetEquippedRodId()]
	return string.upper(rod.name:gsub(" Rod$", ""))
end

--- §5.4: the reason a cast is about to snap, ready for the HUD to print verbatim.
function RodController:GetMaxRarity(): string
	return RodConfig.Rods[self:GetEquippedRodId()].maxRarity
end

function RodController:GetRodConstants(): { [string]: any }
	return RodConfig.Rods[self:GetEquippedRodId()]
end

--- Swap the visible rod (§1 step 2 for the free Rusty Rod, §6.3 for the Brass Rod) and
--- hand the model to the character.
function RodController:SetEquippedRod(rodId: string)
	if RodConfig.Rods[rodId] == nil then
		return
	end
	self:UnequipRod()
	self:AttachToCharacter(rodId)
	local label = hud()
	if label ~= nil then
		label:SetRodLabel(("ROD: %s"):format(self:GetRodTierLabel()))
	end
end

--- Takes the rod out of the character's hands (the model only — the server still knows what the
--- player owns, so nothing about their stats changes).
function RodController:UnequipRod()
	local character = player.Character
	if character == nil then
		return
	end
	local existing = character:FindFirstChild(TOOL_NAME)
	if existing ~= nil then
		existing:Destroy()
	end
	local backpack = player:FindFirstChild("Backpack")
	local stashed = if backpack ~= nil then backpack:FindFirstChild(TOOL_NAME) else nil
	if stashed ~= nil then
		stashed:Destroy()
	end
end

--- Builds the rod Tool for the equipped rod and equips it on the character. Safe to call on every
--- spawn — it destroys whatever it made last time.
function RodController:AttachToCharacter(rodId: string?)
	local character = player.Character
	if character == nil then
		return
	end
	local id = rodId or self:GetEquippedRodId()
	local look = ROD_LOOK[id] or ROD_LOOK[EconomyConfig.StartingRodId]

	self:UnequipRod()

	local tool = Instance.new("Tool")
	tool.Name = TOOL_NAME
	tool.RequiresHandle = true
	tool.CanBeDropped = false

	local handle = Instance.new("Part")
	handle.Name = "Handle"
	handle.Size = Vector3.new(0.4, look.length, 0.4)
	handle.Color = look.color
	handle.Material = look.material
	handle.CanCollide = false
	handle.CanQuery = false
	handle.CanTouch = false
	handle.CastShadow = false
	handle.Parent = tool

	local backpack = player:FindFirstChild("Backpack")
	if backpack ~= nil then
		tool.Parent = backpack
		local humanoid = character:FindFirstChildOfClass("Humanoid")
		if humanoid ~= nil then
			pcall(function()
				local grabbed = humanoid :: Humanoid
				grabbed:EquipTool(tool)
			end)
		end
	else
		tool.Parent = character
	end

	local label = hud()
	if label ~= nil then
		label:SetRodLabel(("ROD: %s"):format(self:GetRodTierLabel()))
	end
end

-- Knit lifecycle --------------------------------------------------------------

function RodController:KnitStart()
	if player ~= nil then
		player:GetAttributeChangedSignal(GearConfig.PlayerAttributes.RodId):Connect(function()
			self:SetEquippedRod(self:GetEquippedRodId())
		end)
	end

	Players.LocalPlayer.CharacterAdded:Connect(function()
		task.wait(1)
		self:AttachToCharacter()
	end)

	if player.Character ~= nil then
		self:AttachToCharacter()
	end

	local label = hud()
	if label ~= nil then
		label:SetRodLabel(("ROD: %s"):format(self:GetRodTierLabel()))
	end
end

return RodController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="141">
            <Properties>
              <string name="Name">ShopController</string>
              <string name="Source"><![CDATA[--!strict
--[[
	ShopController — GDD §1 step 8 (`E — Trade` at the Tide Trader stall opens the shop),
	§6.2 (SELL ALL converts the Catch Log to Coins at the table prices), §6.3 (the three SKUs
	and the presentation order), §6.6 (one disabled second tab, no Robux anywhere),
	§9 (sticky cost-vs-cash comparison on every row, shortfall shown on a disabled row,
	`[E] TRADE` world prompt).

	Presentation only: every price, permission and payload comes from the server. The panel is
	plain unstyled Frames and TextButtons so the loop is playable now and the UI/UX pass can
	restyle it without re-deriving a single number.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")

local Knit = require(ReplicatedStorage.Packages.Knit)

local Types = require(ReplicatedStorage.DeepTide.Modules.Types)
local Remotes = require(ReplicatedStorage.DeepTide.Modules.Remotes)
local EconomyConfig = require(ReplicatedStorage.DeepTide.Config.EconomyConfig)

local ShopController = Knit.CreateController({
	Name = "ShopController",
})

local remotes: { [string]: RemoteEvent } = {}
local shopState: Types.ShopState = {
	coins = EconomyConfig.StartingCoins,
	skus = {},
}
local isOpen = false
local panel: Frame? = nil
local coinsLabel: TextLabel? = nil
local rowsFrame: Frame? = nil

-- Plain UI helpers -------------------------------------------------------------

local function newFrame(parent: Instance, name: string, size: UDim2, position: UDim2, color: Color3): Frame
	local frame = Instance.new("Frame")
	frame.Name = name
	frame.Size = size
	frame.Position = position
	frame.BackgroundColor3 = color
	frame.BackgroundTransparency = 0
	frame.BorderSizePixel = 0
	frame.Parent = parent
	return frame
end

local function newLabel(parent: Instance, name: string, size: UDim2, position: UDim2, text: string): TextLabel
	local label = Instance.new("TextLabel")
	label.Name = name
	label.Size = size
	label.Position = position
	label.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
	label.BackgroundTransparency = 0.4
	label.BorderSizePixel = 0
	label.Font = Enum.Font.Code
	label.TextSize = 16
	label.TextColor3 = Color3.fromRGB(240, 240, 245)
	label.TextXAlignment = Enum.TextXAlignment.Left
	label.Text = text
	label.Parent = parent
	return label
end

local function newButton(parent: Instance, name: string, size: UDim2, position: UDim2, text: string): TextButton
	local button = Instance.new("TextButton")
	button.Name = name
	button.Size = size
	button.Position = position
	button.BackgroundColor3 = Color3.fromRGB(40, 44, 52)
	button.BorderSizePixel = 0
	button.Font = Enum.Font.Code
	button.TextSize = 16
	button.TextColor3 = Color3.fromRGB(240, 240, 245)
	button.Text = text
	button.Parent = parent
	return button
end

--- §9: is a row's price affordable, greyed with its shortfall, or already held?
function ShopController:FormatPrice(sku: Types.ShopSkuState): string
	if sku.owned then
		return EconomyConfig.ShopRowLabel.ownedFormat
	end
	if sku.affordable then
		return EconomyConfig.ShopRowLabel.affordableFormat:format(sku.cost)
	end
	return EconomyConfig.ShopRowLabel.shortfallFormat:format(sku.cost, sku.shortfall)
end

--- §6.3/§6.6: the header — cash, plus the layout slot the eventual second tab keeps open.
function ShopController:GetTabsLabel(): string
	local disabled = EconomyConfig.DisabledShopTab
	return ("%s   %s"):format("TIDE TRADER", if disabled ~= nil then disabled.label else "—")
end

-- Rendering --------------------------------------------------------------------

local function buildPanel(): Frame
	local player = game:GetService("Players").LocalPlayer
	local playerGui = player:WaitForChild("PlayerGui")
	local screen = Instance.new("ScreenGui")
	screen.Name = "DeepTideShop"
	screen.ResetOnSpawn = false
	screen.Enabled = false
	screen.Parent = playerGui

	local built =
		newFrame(screen, "Panel", UDim2.fromOffset(520, 360), UDim2.new(0.5, -260, 0.2, 0), Color3.fromRGB(14, 16, 22))
	coinsLabel = newLabel(built, "Header", UDim2.fromOffset(500, 22), UDim2.fromOffset(10, 8), "")
	rowsFrame =
		newFrame(built, "Rows", UDim2.new(1, -20, 1, -110), UDim2.fromOffset(10, 34), Color3.fromRGB(14, 16, 22))

	-- §6.2: SELL ALL lives in the same panel as the shop — §1 step 8 opens the stall, and the
	-- catch is turned into Coins at the same counter the upgrade is bought from.
	local sellAll = newButton(built, "SellAll", UDim2.fromOffset(240, 34), UDim2.fromOffset(10, 310), "SELL ALL")
	sellAll.Activated:Connect(function()
		ShopController:SellAll()
	end)

	local close = newButton(built, "Close", UDim2.fromOffset(120, 34), UDim2.fromOffset(260, 310), "CLOSE")
	close.Activated:Connect(function()
		ShopController:Close()
	end)

	-- §6.6: one disabled tab, no MarketplaceService call anywhere in the slice.
	local disabledTab = newButton(
		built,
		"DisabledTab",
		UDim2.fromOffset(60, 22),
		UDim2.fromOffset(440, 8),
		if EconomyConfig.DisabledShopTab ~= nil then EconomyConfig.DisabledShopTab.label else "—"
	)
	disabledTab.Active = false
	disabledTab.AutoButtonColor = false
	disabledTab.TextColor3 = Color3.fromRGB(120, 120, 130)

	return built
end

--- §9: redraw every row from the server's payload — name, effect, sticky cost-vs-cash, and the
--- recommended flag on the tank (§6.3/§6.5's ordering).
function ShopController:Render()
	if rowsFrame == nil then
		return
	end
	for _, child in rowsFrame:GetChildren() do
		child:Destroy()
	end
	if coinsLabel ~= nil then
		coinsLabel.Text = ("%s   C %d"):format(self:GetTabsLabel(), shopState.coins)
	end

	local index = 0
	for _, sku in shopState.skus do
		local top = index * 66
		local row = newFrame(
			rowsFrame,
			"Row_" .. sku.sku,
			UDim2.new(1, -10, 0, 60),
			UDim2.fromOffset(0, top),
			Color3.fromRGB(24, 27, 34)
		)
		local title = ("%s%s — %s"):format(sku.name, if sku.recommended then "  (RECOMMENDED)" else "", sku.category)
		newLabel(row, "Title", UDim2.new(1, -110, 0, 18), UDim2.fromOffset(6, 2), title)
		newLabel(row, "Effect", UDim2.new(1, -110, 0, 16), UDim2.fromOffset(6, 20), sku.effectLabel)
		newLabel(row, "Unlock", UDim2.new(1, -110, 0, 16), UDim2.fromOffset(6, 38), sku.unlockLabel)

		local price = newLabel(row, "Price", UDim2.fromOffset(100, 20), UDim2.new(1, -104, 0, 4), self:FormatPrice(sku))
		price.TextXAlignment = Enum.TextXAlignment.Right
		-- §9: the comparison is sticky and its colour is its meaning.
		price.TextColor3 = if sku.owned
			then Color3.fromRGB(150, 200, 255)
			elseif sku.affordable then Color3.fromRGB(120, 235, 130)
			else Color3.fromRGB(150, 150, 155)

		local buy = newButton(
			row,
			"Buy",
			UDim2.fromOffset(100, 26),
			UDim2.new(1, -104, 0, 28),
			if sku.owned then "OWNED" else "BUY"
		)
		-- §9: never show a purchase button that silently does nothing. A disabled row is
		-- visibly disabled and its label carries the shortfall.
		local purchasable = not sku.owned and sku.affordable
		buy.Active = purchasable
		buy.AutoButtonColor = purchasable
		buy.TextColor3 = if purchasable then Color3.fromRGB(240, 240, 245) else Color3.fromRGB(110, 110, 118)
		buy.Activated:Connect(function()
			ShopController:RequestPurchase(sku.sku)
		end)
		buy:SetAttribute("SkuId", sku.sku)
		buy:SetAttribute("Purchasable", purchasable)
		index += 1
	end
end

-- Public API ------------------------------------------------------------------

--- §1 step 8: open the shop UI. The server state arrives on ShopStateChanged.
function ShopController:Open()
	isOpen = true
	if panel == nil then
		panel = buildPanel()
	end
	local screen = panel:FindFirstChildOfClass("ScreenGui") or panel.Parent
	if screen ~= nil and (screen :: Instance):IsA("ScreenGui") then
		(screen :: ScreenGui).Enabled = true
	end
	self:Render()
end

function ShopController:Close()
	isOpen = false
	if panel ~= nil then
		local screen = panel.Parent
		if screen ~= nil and (screen :: Instance):IsA("ScreenGui") then
			(screen :: ScreenGui).Enabled = false
		end
	end
end

function ShopController:IsOpen(): boolean
	return isOpen
end

--- The last state the server pushed (§9: `280 C` in green when affordable, grey with the
--- shortfall shown when not).
function ShopController:GetState(): Types.ShopState
	return shopState
end

--- §6.2: SELL ALL. The server pays Σ(value x count) and clears the log — selling is
--- authoritative, so this asks the service rather than touching the log itself.
function ShopController:SellAll()
	local ok, service = pcall(function()
		return Knit.GetService("ShopService")
	end)
	if not ok or type(service) ~= "table" then
		return
	end
	local answered, promise = pcall(function()
		return (service :: any):SellAll()
	end)
	if not answered then
		return
	end
	if promise ~= nil and (promise :: any).andThen ~= nil then
		(promise :: any):andThen(function(result: Types.SellAllResult)
			-- The new state arrives on ShopStateChanged; this is only for an immediate redraw.
			if result ~= nil and result.soldCount ~= nil then
				ShopController:Render()
			end
		end)
	elseif type(promise) == "table" then
		ShopController:Render()
	end
end

--- §6.3: buy a SKU. Never a purchase button that silently does nothing.
function ShopController:RequestPurchase(sku: string): boolean
	local remote = remotes.ShopBuyRequest
	if remote == nil then
		return false
	end
	remote:FireServer(sku)
	return true
end

-- Knit lifecycle --------------------------------------------------------------

function ShopController:KnitStart()
	for _, name in { "ShopBuyRequest", "ShopStateChanged", "CoinsChanged" } do
		remotes[name] = Remotes.get(name)
	end

	remotes.ShopStateChanged.OnClientEvent:Connect(function(state: Types.ShopState)
		shopState = state
		-- The Tide Trader's verb is "open the shop": the panel appears when the state the
		-- server just pushed for that player lands, so there is no second open protocol.
		if not isOpen then
			ShopController:Open()
		else
			ShopController:Render()
		end
	end)

	remotes.CoinsChanged.OnClientEvent:Connect(function(coins: number)
		shopState.coins = coins
		-- §9: the cost-vs-cash comparison is sticky — a purchase redraws every row against the
		-- new balance.
		if isOpen then
			ShopController:Render()
		end
	end)

	UserInputService.InputBegan:Connect(function(input: InputObject, processed: boolean)
		if processed then
			return
		end
		if input.KeyCode == Enum.KeyCode.Escape and isOpen then
			ShopController:Close()
		end
	end)
end

return ShopController
]]></string>
            </Properties>
          </Item>
        </Item>
      </Item>
    </Item>
  </Item>
  <Item class="Workspace" referent="142">
